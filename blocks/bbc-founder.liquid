{%- comment -%}
  BBC theme block — Founder / team member. Re-homes the monolith `founder` block
  (sections/bbc-founders.liquid) onto the 2026 design system: a centred profile with
  a circular portrait, name, role and bio. Uses the shared .rd-card surface plus a
  small scoped {% stylesheet %} for the round photo + centring (the legacy
  .bbc-founders__* CSS is not revived). Image fallback = bundled asset via
  asset_img_url. Sits inside a grid container (.bbc-rd .rd-grid).
{%- endcomment -%}
{%- liquid
  assign fallback = block.settings.fallback | default: 'bbc-rd-cohort.jpg'
-%}
<div class="rd-card rd-founder" {{ block.shopify_attributes }}>
  <div class="rd-body rd-founder__body">
    <div class="rd-founder__ph">
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 400 | image_tag: widths: '200,400', sizes: '200px', alt: block.settings.name, loading: 'lazy' }}
      {%- else -%}
        <img src="{{ fallback | asset_img_url: '400x' }}" srcset="{{ fallback | asset_img_url: '200x' }} 200w, {{ fallback | asset_img_url: '400x' }} 400w" sizes="200px" alt="{{ block.settings.name | default: 'A member of the Bamboo Bicycle Club team' | escape }}" width="200" height="200" loading="lazy">
      {%- endif -%}
    </div>
    {%- if block.settings.name != blank -%}<h3 class="rd-founder__name">{{ block.settings.name }}</h3>{%- endif -%}
    {%- if block.settings.role != blank -%}<p class="rd-founder__role">{{ block.settings.role }}</p>{%- endif -%}
    {%- if block.settings.bio != blank -%}<div class="rd-founder__bio">{{ block.settings.bio }}</div>{%- endif -%}
  </div>
</div>

{% stylesheet %}
  .bbc-rd .rd-founder .rd-founder__body{ text-align:center; }
  .bbc-rd .rd-founder__ph{ width:160px; height:160px; margin:0 auto 18px; border-radius:50%; overflow:hidden;
    border:4px solid var(--lime); box-shadow:4px 4px 0 var(--forest-700); }
  .bbc-rd .rd-founder__ph img{ width:100%; height:100%; object-fit:cover; display:block; }
  .bbc-rd .rd-founder__name{ font-weight:800; font-size:20px; color:var(--forest); margin:0 0 2px; letter-spacing:-.01em; }
  .bbc-rd .rd-founder__role{ font-size:13px; font-weight:700; letter-spacing:.04em; text-transform:lowercase; color:var(--forest,#003C32); margin:0 0 12px; }
  .bbc-rd .rd-founder__bio{ font-size:14.5px; line-height:1.6; color:#2a332f; }
  .bbc-rd .rd-founder__bio p{ margin:0; }
{% endstylesheet %}

{% schema %}
{
  "name": "BBC Founder",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Photo" },
    { "type": "text", "id": "fallback", "label": "Fallback asset (if no photo picked)", "default": "bbc-rd-cohort.jpg" },
    { "type": "text", "id": "name", "label": "Name", "default": "James Marr" },
    { "type": "text", "id": "role", "label": "Role", "default": "Founder & CEO" },
    { "type": "richtext", "id": "bio", "label": "Bio", "default": "<p>James learned to build bamboo bicycles in Canada before returning to London to share the craft. He leads our mission to make sustainable making accessible to all.</p>" }
  ],
  "presets": [
    { "name": "BBC Founder" }
  ]
}
{% endschema %}
