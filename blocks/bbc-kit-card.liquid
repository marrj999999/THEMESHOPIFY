{%- comment -%}
  BBC theme block — Kit card (image + title + body + optional product/collection link).
  From the monolith `kit` block. Reuses a.rd-card / .rd-ph / .rd-body. Image fallback =
  bundled asset via asset_img_url (the brittle filename->CDN switch is removed).
  Sits inside a grid container (.bbc-rd .rd-grid).
{%- endcomment -%}
{%- liquid
  assign url = block.settings.link_url | default: '/collections/home-build-kits'
  assign fallback = block.settings.fallback | default: 'bbc-rd-prod-gravel.jpg'
-%}
<a class="rd-card" href="{{ url }}" {{ block.shopify_attributes }}>
  <div class="rd-ph">
    {%- if block.settings.image != blank -%}
      {{ block.settings.image
        | image_url: width: 900
        | image_tag:
          widths: '400,600,900,1200',
          sizes: '(max-width:749px) 92vw, 30vw',
          alt: block.settings.image_alt,
          loading: 'lazy' }}
    {%- else -%}
      <img src="{{ fallback | asset_img_url: '900x' }}" srcset="{{ fallback | asset_img_url: '400x' }} 400w, {{ fallback | asset_img_url: '600x' }} 600w, {{ fallback | asset_img_url: '900x' }} 900w, {{ fallback | asset_img_url: '1400x' }} 1400w" sizes="(max-width:749px) 92vw, 30vw" alt="{{ block.settings.image_alt | default: 'A bamboo frame kit' | escape }}" width="1600" height="1000" loading="lazy">
    {%- endif -%}
  </div>
  <div class="rd-body"><h3 class="rd-fs-18px">{{ block.settings.title }}</h3><p>{{ block.settings.body }}</p></div>
</a>

{% schema %}
{
  "name": "BBC Kit card",
  "tag": null,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "fallback", "label": "Fallback asset (if no image picked)", "default": "bbc-rd-prod-gravel.jpg" },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "A bamboo frame kit" },
    { "type": "text", "id": "title", "label": "Title", "default": "Road & Gravel" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "Lugged or flax-joined kits with full video tutorials." },
    { "type": "url", "id": "link_url", "label": "Link (product or collection)" }
  ],
  "presets": [
    { "name": "BBC Kit card" }
  ]
}
{% endschema %}
