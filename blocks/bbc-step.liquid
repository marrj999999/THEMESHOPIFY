{%- comment -%}
  BBC theme block — Build step. From the monolith `step` block in
  sections/bbc-workshops-2026.liquid. Reuses the .rd-steps <ol> markup: the STEP
  NUMBER is drawn by the container's <ol class="rd-steps"> counter (CSS ::before),
  so this block is just the <li> content — title + body, with an optional photo.
  MUST sit inside an <ol class="rd-steps"> (sections/bbc-section.liquid won't number
  it; use a steps container). Image fallback = bundled asset via asset_img_url.
{%- endcomment -%}
{%- liquid
  assign fallback = block.settings.fallback | default: 'bbc-rd-frame-build.jpg'
-%}
<li {{ block.shopify_attributes }}>
  {%- if block.settings.title != blank -%}<h3>{{ block.settings.title }}</h3>{%- endif -%}
  {%- if block.settings.body != blank -%}<div class="rd-step-body">{{ block.settings.body }}</div>{%- endif -%}
  {%- if block.settings.image != blank -%}
    <div class="rd-step-ph rd-ph rd-ar-43 rd-mt2">
      {{ block.settings.image
        | image_url: width: 800
        | image_tag:
          widths: '400,600,800',
          sizes: '(max-width:749px) 92vw, 40vw',
          alt: block.settings.image_alt,
          loading: 'lazy' }}
    </div>
  {%- elsif block.settings.show_fallback_image -%}
    <div class="rd-step-ph rd-ph rd-ar-43 rd-mt2">
      <img src="{{ fallback | asset_img_url: '800x' }}" srcset="{{ fallback | asset_img_url: '400x' }} 400w, {{ fallback | asset_img_url: '600x' }} 600w, {{ fallback | asset_img_url: '800x' }} 800w" sizes="(max-width:749px) 92vw, 40vw" alt="{{ block.settings.image_alt | default: 'A bamboo frame mid-build' | escape }}" width="800" height="600" loading="lazy">
    </div>
  {%- endif -%}
</li>

{% stylesheet %}
  .bbc-rd .rd-steps li .rd-step-ph{ overflow:hidden; border-radius:6px; }
  .bbc-rd .rd-steps li .rd-step-body p{ margin:0; }
{% endstylesheet %}

{% schema %}
{
  "name": "BBC Step",
  "tag": null,
  "settings": [
    { "type": "text", "id": "title", "label": "Step title", "default": "Select & cut your bamboo" },
    { "type": "richtext", "id": "body", "label": "Step body", "default": "<p>Choose your culms and mitre them to your personalised frame drawing.</p>" },
    { "type": "image_picker", "id": "image", "label": "Photo (optional)" },
    { "type": "checkbox", "id": "show_fallback_image", "label": "Show a placeholder photo when none is picked", "default": false },
    { "type": "text", "id": "fallback", "label": "Fallback asset (if placeholder enabled)", "default": "bbc-rd-frame-build.jpg" },
    { "type": "text", "id": "image_alt", "label": "Photo alt text", "default": "A bamboo frame mid-build" }
  ],
  "presets": [
    { "name": "BBC Step" }
  ]
}
{% endschema %}
