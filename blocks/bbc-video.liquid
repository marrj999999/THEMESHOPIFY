{%- comment -%}
  BBC theme block — Video band (YouTube id + poster + eyebrow + heading + body + dark toggle).
  Adapted from sections/bbc-rd-video-embed.liquid. Reuses .rd-video / .rd-video-el / .rd-eyebrow /
  .rd-lede / .rd-src / .rd-play and the .rd-dark / .rd-on-dark dark-mode treatment.
  Renders its own .bbc-rd wrapper so it also works standalone; inside a .bbc-rd section that is
  harmless (the class just nests).
{%- endcomment -%}
{%- liquid
  assign dark = block.settings.dark
  assign poster = block.settings.poster_fallback | default: 'bbc-rd-home-poster.jpg' | asset_url
  if block.settings.poster != blank
    assign poster = block.settings.poster | image_url: width: 1600
  endif
-%}
<div class="rd-reveal bbc-rd bbc-rd-videoblock" {{ block.shopify_attributes }}>
  {%- if block.settings.eyebrow != blank -%}<span class="rd-eyebrow{% if dark %} rd-on-dark{% endif %}">{{ block.settings.eyebrow }}</span>{%- endif -%}
  {%- if block.settings.heading != blank -%}<h2 class="rd-mt2">{{ block.settings.heading }}</h2>{%- endif -%}
  <div class="rd-video rd-mt3">
    {%- if block.settings.video_youtube != blank -%}
      <iframe class="rd-video-el" style="aspect-ratio:16/9;width:100%;height:auto;border:0;display:block;" src="https://www.youtube-nocookie.com/embed/{{ block.settings.video_youtube }}?rel=0" title="{{ block.settings.heading | escape }}" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
    {%- elsif block.settings.video_mp4 != blank -%}
      <video class="rd-video-el" poster="{{ poster }}" controls preload="none" playsinline aria-label="{{ block.settings.heading | default: 'From bare bamboo to the open road — building a bamboo bike frame' | escape }}">
        <source src="{{ block.settings.video_mp4 }}" type="video/mp4">
      </video>
    {%- else -%}
      <img class="rd-video-el" src="{{ poster }}" alt="{{ block.settings.heading | escape }}" loading="lazy">
      <span class="rd-play" aria-hidden="true"></span>
    {%- endif -%}
  </div>
  {%- if block.settings.caption != blank -%}<p class="rd-src rd-mt1">{{ block.settings.caption }}</p>{%- endif -%}
  {%- if block.settings.body != blank -%}<p class="rd-lede rd-maxw rd-mt2">{{ block.settings.body }}</p>{%- endif -%}
  {%- if block.settings.cta_label != blank -%}
    <p class="rd-mt2"><a class="rd-btn {% if dark %}rd-on-dark{% else %}rd-ghost{% endif %}" href="{{ block.settings.cta_url | default: '#' }}">{{ block.settings.cta_label }} <span class="rd-arrow">&rarr;</span></a></p>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "BBC Video",
  "tag": null,
  "settings": [
    { "type": "text", "id": "video_youtube", "label": "YouTube video ID", "default": "ckCwJXJGKD0" },
    { "type": "url", "id": "video_mp4", "label": "MP4 video URL (if no YouTube ID)" },
    { "type": "image_picker", "id": "poster", "label": "Poster image (for MP4 / no YouTube)" },
    { "type": "text", "id": "poster_fallback", "label": "Bundled fallback poster asset", "default": "bbc-rd-home-poster.jpg" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Watch" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See a bamboo bike come together" },
    { "type": "textarea", "id": "body", "label": "Body", "default": "From raw bamboo to a frame that rides — in a couple of days, with no factory in sight." },
    { "type": "text", "id": "caption", "label": "Caption" },
    { "type": "text", "id": "cta_label", "label": "CTA label" },
    { "type": "url", "id": "cta_url", "label": "CTA link" },
    { "type": "checkbox", "id": "dark", "label": "Dark text treatment (use on a dark section)", "default": false }
  ],
  "presets": [
    { "name": "BBC Video" }
  ]
}
{% endschema %}
