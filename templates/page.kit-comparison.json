    "faq": {
      "type": "bbc-quick-faq",
      "blocks": {
        "faq-1": {
          "type": "faq",
          "settings": {
            "question": "Which kit should I choose as a beginner?",
            "answer": "The Gravel Kit is our most popular choice for first-time builders. It offers versatile geometry, moderate build complexity, and works well for most riding styles."
          }
        },
        "faq-2": {
          "type": "faq",
          "settings": {
            "question": "What's the difference between lugged and bonded construction?",
            "answer": "Lugged kits use pre-made aluminum joints (easier, faster build). Bonded kits require wrapping joints with carbon fiber (more hands-on, traditional method)."
          }
        },
        "faq-3": {
          "type": "faq",
          "settings": {
            "question": "Can I modify the geometry?",
            "answer": "Standard kits have fixed geometry optimized for each style. For custom geometry, choose our Custom Kit option with personalized specifications."
          }
        },
        "faq-4": {
          "type": "faq",
          "settings": {
            "question": "What tools do I need?",
            "answer": "Basic hand tools only: hacksaw, files, sandpaper, measuring tape. No power tools required. Full tool list included with kit."
          }
        }
      },
