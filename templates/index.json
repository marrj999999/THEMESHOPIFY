            "body": "Accredited programmes for prisons, schools and colleges — plus corporate team-building days.",
            "link_label": "Our programmes →"
          }
        },
        "b7": {
          "type": "door",
          "settings": {
            "fallback": "bbc-rd-cohort.jpg",
            "image_alt": "The Bamboo Bicycle Club team in the London workshop",
            "tag": "Support",
            "title": "Back the mission",
            "body": "Fund a cohort, offer placements, or champion our work. £11.41 of social value for every £1.",
            "link_label": "Get involved →"
          }
        },
        "b8": {
          "type": "why",
          "settings": {
            "title": "Strong as steel",
            "body": "As strong as steel for its weight — yet workable with hand tools alone."
          }
        },
        "b9": {
          "type": "why",
          "settings": {
            "title": "Kinder ride",
            "body": "Absorbs road vibration better than carbon fibre."
          }
        },
        "b10": {
          "type": "why",
          "settings": {
            "title": "Made to be mended",
            "body": "Because you built it, you can fix it — so you keep it. Renewable bamboo, made by hand, not mass-produced."
          }
        },
        "b11": {
          "type": "why",
          "settings": {
            "title": "Built to last",
            "body": "Our earliest 2012 frames are still ridden daily — looked after, a bamboo bike goes the distance."
          }
        },
        "b12": {
          "type": "kit",
          "settings": {
