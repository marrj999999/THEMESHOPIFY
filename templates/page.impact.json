    "build-to-bond-intro": {
      "type": "rich-text",
      "settings": {
        "desktop_content_position": "center",
        "content_alignment": "center",
        "color_scheme": "scheme-1",
        "full_width": false,
        "padding_top": 80,
        "padding_bottom": 40
      },
      "blocks": {
        "heading": {
          "type": "heading",
          "settings": {
            "heading": "Build to Bond"
          }
        },
        "text": {
          "type": "text",
          "settings": {
            "text": "<p>Our flagship prison rehabilitation programme. Parents in prison build bamboo balance bikes as gifts for their children — creating tangible connections that last beyond prison walls.</p>"
          }
        }
      },
      "block_order": [
        "heading",
        "text"
      ]
    },
    "how-it-works": {
      "type": "bbc-how-it-works",
      "settings": {
        "eyebrow": "The Programme",
        "heading": "How Build to Bond Works",
        "intro": "A structured 6-week programme that creates lasting connections between parents in prison and their children.",
        "background_color": "#ffffff"
      },
      "blocks": {
        "step-1": {
          "type": "step",
          "settings": {
            "title": "Learn",
            "description": "Gain OCN Level 2 accreditation in Sustainable Manufacturing — a real qualification that counts towards employment.",
            "duration": "6-week programme"
          }
        },
        "step-2": {
          "type": "step",
          "settings": {
            "title": "Build",
            "description": "Create a bamboo balance bike with your hands. Every joint, every layer — skills that transfer beyond prison.",
            "duration": "Hands-on training"
          }
        },
        "step-3": {
          "type": "step",
          "settings": {
            "title": "Connect",
            "description": "Present the bike to your child during a family visit. A tangible gift that represents presence, not absence.",
            "duration": "Family handover"
          }
        },
        "step-4": {
          "type": "step",
          "settings": {
            "title": "Thrive",
            "description": "A nationally-recognised qualification, improved confidence, and direct pathways to employer interviews after release.",
            "duration": "Employment pathway"
          }
        }
      },
      "block_order": [
        "step-1",
        "step-2",
        "step-3",
        "step-4"
      ]
    },
