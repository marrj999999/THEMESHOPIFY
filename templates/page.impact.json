    "theory": {
      "type": "bbc-theory-of-change",
      "settings": {
        "heading": "Why Building Bikes Rebuilds Lives",
        "intro": "Our rehabilitation programmes aren't just about learning a craft. They're built on proven principles of behavioural change and family connection."
      },
      "blocks": {
        "pillar-1": {
          "type": "pillar",
          "settings": {
            "title": "The IKEA Effect",
            "description": "Research shows we value things more when we build them ourselves. When a parent builds a bike for their child, that emotional investment creates lasting bonds.",
            "evidence": "Featured in Financial Times"
          }
        },
        "pillar-2": {
          "type": "pillar",
          "settings": {
            "title": "Family Ties Matter",
            "description": "Prisoners who maintain family contact are 39% less likely to reoffend. Building a bicycle creates a tangible connection — a present that represents presence.",
            "evidence": "Farmer Review (MoJ Research)"
          }
        },
        "pillar-3": {
          "type": "pillar",
          "settings": {
            "title": "Hands-On Learning",
            "description": "Many people in prison struggled in traditional education. Working with their hands, solving real problems — this is how they learn best.",
            "evidence": "OCN Level 2 Accredited"
          }
        },
        "pillar-4": {
          "type": "pillar",
          "settings": {
            "title": "Sustainable Self-Delivery",
            "description": "We train prison staff to deliver the programme independently. No ongoing dependency — a one-time investment that keeps delivering value for years.",
            "evidence": "Self-delivery model"
          }
        }
      },
      "block_order": [
        "pillar-1",
        "pillar-2",
        "pillar-3",
        "pillar-4"
      ]
    },
