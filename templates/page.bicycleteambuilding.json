        "f1": {
          "type": "faq",
          "settings": {
            "q": "How many people can take part?",
            "a": "From a team of 5 to 50+ — we scale facilitators and build stations to your group."
          }
        },
        "f2": {
          "type": "faq",
          "settings": {
            "q": "How long does it take?",
            "a": "Anywhere from a focused 3-hour session to a full day, depending on group size and how much you want to build."
          }
        },
        "f3": {
          "type": "faq",
          "settings": {
            "q": "Do we need any experience?",
            "a": "None at all. If you can hold a tool you can build — our facilitators guide every step."
          }
        },
        "f4": {
          "type": "faq",
          "settings": {
            "q": "Where can we do it?",
            "a": "At your office or away-day venue anywhere in the UK, or at our London workshop. Indoor or outdoor — we bring the whole workshop."
          }
        },
        "f5": {
          "type": "faq",
          "settings": {
            "q": "What happens to the bikes?",
            "a": "Keep them, or donate them to a community charity — your choice. We'll arrange the handover."
          }
        },
        "f6": {
          "type": "faq",
          "settings": {
            "q": "How much does it cost?",
            "a": "Every day is tailored to your team, so we quote per group. Tell us your size, date and venue and we'll come back within one working day."
          }
        }
      },
