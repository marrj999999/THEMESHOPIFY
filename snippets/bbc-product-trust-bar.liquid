{%- comment -%}
  BBC Product Trust Bar
  Research-backed: 8/10 product pages have trust signals below price
  Sites: Rapha, Patagonia, Warby Parker, Everlane
{%- endcomment -%}

<div class="bbc-product-trust-bar">
  <div class="bbc-product-trust-bar__item">
    {% render 'bbc-icons', icon: 'local_shipping' %}
    <span>Free UK Shipping</span>
  </div>
  <div class="bbc-product-trust-bar__item">
    {% render 'bbc-icons', icon: 'verified' %}
    <span>OCN Accredited</span>
  </div>
  <div class="bbc-product-trust-bar__item">
    {% render 'bbc-icons', icon: 'support_agent' %}
    <span>Expert Support</span>
  </div>
  <div class="bbc-product-trust-bar__item">
    {% render 'bbc-icons', icon: 'eco' %}
    <span>50% Less CO₂</span>
  </div>
</div>

<style>
  .bbc-product-trust-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 16px 0;
    margin: 16px 0;
    border-top: 1px solid rgba(0,0,0,0.1);
    border-bottom: 1px solid rgba(0,0,0,0.1);
  }

  .bbc-product-trust-bar__item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    color: #1a3a1a;
  }

  .bbc-product-trust-bar__item svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  @media (max-width: 749px) {
    .bbc-product-trust-bar {
      gap: 12px;
    }
    
    .bbc-product-trust-bar__item {
      flex: 1 1 45%;
      font-size: 12px;
    }
  }
</style>
