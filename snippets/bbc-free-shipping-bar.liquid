{% comment %}
  BBC Free Shipping Progress Bar
  Goal-Gradient Effect: Shows progress toward free shipping threshold
  Include in cart drawer or cart page
{% endcomment %}

{% assign threshold = section.settings.threshold | default: 100 %}
{% assign cart_total = cart.total_price | divided_by: 100.0 %}
{% assign remaining = threshold | minus: cart_total %}
{% assign progress = cart_total | divided_by: threshold | times: 100 | at_most: 100 %}

<div class="bbc-shipping-bar" role="status" aria-live="polite">
  {% if cart_total >= threshold %}
    <div class="bbc-shipping-bar__success">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
        <polyline points="22 4 12 14.01 9 11.01"/>
      </svg>
      <span>You've unlocked <strong>free UK shipping!</strong></span>
    </div>
  {% else %}
    <div class="bbc-shipping-bar__progress-container">
      <div class="bbc-shipping-bar__text">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="1" y="3" width="15" height="13"/>
          <polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/>
          <circle cx="5.5" cy="18.5" r="2.5"/>
          <circle cx="18.5" cy="18.5" r="2.5"/>
        </svg>
        <span>Add <strong>£{{ remaining | round: 2 }}</strong> more for <strong>free UK shipping</strong></span>
      </div>
      <div class="bbc-shipping-bar__track" role="progressbar" aria-valuenow="{{ progress | round }}" aria-valuemin="0" aria-valuemax="100" aria-label="Free shipping progress">
        <div class="bbc-shipping-bar__fill" style="width: {{ progress }}%"></div>
      </div>
    </div>
  {% endif %}
</div>

<style>
  .bbc-shipping-bar {
    background: var(--bbc-cream, #f8f7f4);
    padding: 12px 16px;
    border-radius: 8px;
    margin-bottom: 16px;
    font-family: var(--font-body-family, 'Plus Jakarta Sans', sans-serif);
    font-size: 14px;
  }
  
  .bbc-shipping-bar__success {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--bbc-teal, #3f8b66);
  }
  
  .bbc-shipping-bar__success svg {
    flex-shrink: 0;
    color: var(--bbc-teal, #3f8b66);
  }
  
  .bbc-shipping-bar__success strong {
    font-weight: 600;
  }
  
  .bbc-shipping-bar__progress-container {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  
  .bbc-shipping-bar__text {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--bbc-forest, #073e27);
  }
  
  .bbc-shipping-bar__text svg {
    flex-shrink: 0;
    color: var(--bbc-teal, #3f8b66);
  }
  
  .bbc-shipping-bar__text strong {
    font-weight: 600;
    color: var(--bbc-teal, #3f8b66);
  }
  
  .bbc-shipping-bar__track {
    height: 6px;
    background: rgba(7, 62, 39, 0.12);
    border-radius: 3px;
    overflow: hidden;
  }
  
  .bbc-shipping-bar__fill {
    height: 100%;
    background: linear-gradient(90deg, var(--bbc-teal, #3f8b66), var(--bbc-gold, #ffa900));
    border-radius: 3px;
    transition: width 0.3s ease-out;
  }
  
  @media (prefers-reduced-motion: reduce) {
    .bbc-shipping-bar__fill {
      transition: none;
    }
  }
</style>
