{% comment %}
  Enhanced Social Media Meta Tags
  Improves sharing on all major platforms
  
  Usage: {% render 'social-meta-enhanced' %}
  
  Features:
  - Twitter Card optimization
  - Pinterest Rich Pins
  - Enhanced image handling
  - Product-specific meta data
  - Workshop/page specific optimization
{% endcomment %}

{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name
  assign og_image = settings.logo | default: shop.brand.logo
  assign og_image_width = 1200
  assign og_image_height = 630

  if request.page_type == 'product'
    assign og_type = 'product'
    assign og_title = product.title | append: ' | ' | append: shop.name
    assign og_description = product.description | strip_html | truncatewords: 25
    if product.featured_media
      assign og_image = product.featured_media | image_url: width: 1200, height: 630
    endif
  elsif request.page_type == 'article'
    assign og_type = 'article'
    assign og_title = article.title | append: ' | ' | append: shop.name
    assign og_description = article.excerpt | strip_html | truncatewords: 25
    if article.image
      assign og_image = article.image | image_url: width: 1200, height: 630
    endif
  elsif request.page_type == 'collection'
    assign og_title = collection.title | append: ' | ' | append: shop.name
    assign og_description = collection.description | strip_html | truncatewords: 25
    if collection.image
      assign og_image = collection.image | image_url: width: 1200, height: 630
    endif
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
-%}

<!-- Core Open Graph -->
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | escape }}">
<meta property="og:locale" content="{{ request.locale.iso_code }}">

<!-- Enhanced Image Handling -->
{%- if og_image -%}
  <meta property="og:image" content="{{ og_image }}">
  <meta property="og:image:secure_url" content="{{ og_image }}">
  <meta property="og:image:width" content="{{ og_image_width }}">
  <meta property="og:image:height" content="{{ og_image_height }}">
  <meta property="og:image:alt" content="{{ og_title | escape }}">
{%- endif -%}

<!-- Enhanced Twitter Cards -->
{%- if settings.social_twitter_link != blank -%}
  <meta name="twitter:site" content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}">
{%- else -%}
  <meta name="twitter:site" content="@bamboobicycleclub">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | escape }}">
{%- if og_image -%}
  <meta name="twitter:image" content="{{ og_image }}">
{%- endif -%}

<!-- Pinterest Rich Pins -->
{%- if request.page_type == 'product' -%}
  <meta property="product:brand" content="{{ product.vendor | escape }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
  <meta property="product:condition" content="new">
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:retailer_item_id" content="{{ product.id }}">
  
  {%- for tag in product.tags -%}
    <meta property="product:category" content="{{ tag | escape }}">
  {%- endfor -%}
{%- endif -%}

<!-- Article/Blog Rich Pins -->
{%- if request.page_type == 'article' -%}
  <meta property="article:author" content="{{ article.author | escape }}">
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%d' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%d' }}">
  <meta property="article:section" content="{{ blog.title | escape }}">
  
  {%- for tag in article.tags -%}
    <meta property="article:tag" content="{{ tag | escape }}">
  {%- endfor -%}
{%- endif -%}

<!-- Schema.org Structured Data -->
{%- comment -%}
  Structured Data — only output Organization schema on non-product/article pages.
  Product pages use Dawn's built-in {{ product | structured_data }} in main-product.liquid.
  Article pages use the schema in main-article.liquid.
  Avoid duplicate/conflicting schemas.
{%- endcomment -%}
{%- unless request.page_type == 'product' or request.page_type == 'article' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "description": {{ shop.description | json }},
  "url": {{ shop.secure_url | json }},
  {%- if settings.logo -%}
  "logo": "https:{{ settings.logo | image_url: width: 500 }}",
  {%- endif -%}
  {%- if settings.social_instagram_link != blank -%}
  "sameAs": [
    {{ settings.social_instagram_link | json }}
    {%- if settings.social_facebook_link != blank -%},{{ settings.social_facebook_link | json }}{% endif -%}
    {%- if settings.social_twitter_link != blank -%},{{ settings.social_twitter_link | json }}{% endif -%}
    {%- if settings.social_youtube_link != blank -%},{{ settings.social_youtube_link | json }}{% endif -%}
  ],
  {%- endif -%}
  "url": {{ shop.secure_url | json }}
}
</script>
{%- endunless -%}

<!-- Instagram Specific -->
{%- if settings.social_instagram_link != blank -%}
  <meta property="instapp:url" content="{{ og_url }}">
  <meta property="instapp:owner_user_id" content="bamboobicycleclub">
{%- endif -%}

<!-- TikTok Integration -->
<meta name="tiktok:app_id" content="{% if settings.tiktok_app_id %}{{ settings.tiktok_app_id }}{% endif %}">

<!-- Workshop/Page Specific Meta -->
{%- if template contains 'workshop' -%}
  <meta property="event:type" content="workshop">
  <meta property="event:location" content="London, UK">
  <meta name="twitter:label1" content="Duration">
  <meta name="twitter:data1" content="2-3 days">
  <meta name="twitter:label2" content="Price">
  <meta name="twitter:data2" content="From £500">
{%- endif -%}

{%- if template contains 'kit' -%}
  <meta name="twitter:label1" content="Build Time">
  <meta name="twitter:data1" content="35-40 hours">
  <meta name="twitter:label2" content="Shipping">
  <meta name="twitter:data2" content="Worldwide">
{%- endif -%}