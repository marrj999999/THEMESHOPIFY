{% comment %}
  BBC Newsletter Form
  Accessible form with loading states
  Usage: {% render 'bbc-newsletter-form' %}
{% endcomment %}

<form method="post" action="/contact#contact_form" id="bbc-newsletter-form" 
      accept-charset="UTF-8" 
      class="bbc-newsletter"
      aria-labelledby="bbc-newsletter-heading">
  
  <input type="hidden" name="form_type" value="customer">
  <input type="hidden" name="utf8" value="✓">
  <input type="hidden" name="contact[tags]" value="newsletter">
  
  <h2 class="bbc-newsletter__heading" id="bbc-newsletter-heading">
    {{ section.settings.newsletter_heading | default: 'Join the Club' }}
  </h2>
  
  {% if section.settings.newsletter_text %}
    <p class="bbc-newsletter__text">{{ section.settings.newsletter_text }}</p>
  {% endif %}
  
  <div class="bbc-newsletter__field">
    <label for="bbc-newsletter-email" class="visually-hidden">Email address</label>
    <input type="email" 
           id="bbc-newsletter-email"
           name="contact[email]" 
           class="bbc-newsletter__input"
           placeholder="Your email address…"
           autocomplete="email"
           autocapitalize="off"
           autocorrect="off"
           spellcheck="false"
           required
           aria-describedby="bbc-newsletter-hint">
    
    <button type="submit" class="bbc-newsletter__button" aria-label="Subscribe to newsletter">
      <span class="bbc-newsletter__button-text">Subscribe</span>
      <span class="bbc-newsletter__button-loading" aria-hidden="true">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10" stroke-dasharray="60" stroke-dashoffset="20"/>
        </svg>
      </span>
      <svg class="bbc-newsletter__button-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12"/>
        <polyline points="12 5 19 12 12 19"/>
      </svg>
    </button>
  </div>
  
  <p id="bbc-newsletter-hint" class="bbc-newsletter__hint">
    Build tips, new products &amp; workshop dates. No spam, unsubscribe anytime.
  </p>
</form>

<style>
  .bbc-newsletter {
    max-width: 440px;
    font-family: var(--font-body-family, 'Plus Jakarta Sans', sans-serif);
  }
  
  .bbc-newsletter__heading {
    font-size: 20px;
    font-weight: 700;
    color: var(--bbc-forest, #073e27);
    margin: 0 0 8px 0;
  }
  
  .bbc-newsletter__text {
    font-size: 14px;
    color: var(--bbc-forest, #073e27);
    opacity: 0.75;
    margin: 0 0 16px 0;
  }
  
  .bbc-newsletter__field {
    display: flex;
    gap: 8px;
  }
  
  .bbc-newsletter__input {
    flex: 1;
    padding: 14px 16px;
    border: 2px solid rgba(7, 62, 39, 0.15);
    border-radius: 8px;
    font-size: 15px;
    font-family: inherit;
    background: white;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  
  .bbc-newsletter__input::placeholder {
    color: rgba(7, 62, 39, 0.4);
  }
  
  .bbc-newsletter__input:focus {
    outline: none;
    border-color: var(--bbc-teal, #3f8b66);
    box-shadow: 0 0 0 3px rgba(63, 139, 102, 0.15);
  }
  
  .bbc-newsletter__input:focus-visible {
    outline: 2px solid var(--bbc-gold, #ffa900);
    outline-offset: 2px;
  }
  
  .bbc-newsletter__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    padding: 14px 20px;
    background: var(--bbc-forest, #073e27);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 15px;
    font-weight: 600;
    font-family: inherit;
    cursor: pointer;
    transition: background 0.2s ease, transform 0.2s ease;
    min-width: 130px;
  }
  
  .bbc-newsletter__button:hover {
    background: var(--bbc-teal, #3f8b66);
    transform: translateY(-1px);
  }
  
  .bbc-newsletter__button:focus-visible {
    outline: 3px solid var(--bbc-gold, #ffa900);
    outline-offset: 2px;
  }
  
  .bbc-newsletter__button:disabled {
    opacity: 0.7;
    cursor: not-allowed;
    transform: none;
  }
  
  .bbc-newsletter__button-loading {
    display: none;
  }
  
  .bbc-newsletter__button-loading svg {
    animation: bbc-spin 1s linear infinite;
  }
  
  .bbc-newsletter__button.is-loading .bbc-newsletter__button-text,
  .bbc-newsletter__button.is-loading .bbc-newsletter__button-icon {
    display: none;
  }
  
  .bbc-newsletter__button.is-loading .bbc-newsletter__button-loading {
    display: block;
  }
  
  @keyframes bbc-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }
  
  @media (prefers-reduced-motion: reduce) {
    .bbc-newsletter__input,
    .bbc-newsletter__button {
      transition: none;
    }
    .bbc-newsletter__button:hover {
      transform: none;
    }
    .bbc-newsletter__button-loading svg {
      animation: none;
    }
  }
  
  .bbc-newsletter__hint {
    font-size: 12px;
    color: var(--bbc-forest, #073e27);
    opacity: 0.6;
    margin: 10px 0 0 0;
  }
  
  /* Screen reader only */
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  
  @media (max-width: 480px) {
    .bbc-newsletter__field {
      flex-direction: column;
    }
    
    .bbc-newsletter__button {
      width: 100%;
    }
  }
</style>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const form = document.getElementById('bbc-newsletter-form');
  if (!form) return;
  
  const button = form.querySelector('.bbc-newsletter__button');
  
  form.addEventListener('submit', function() {
    button.classList.add('is-loading');
    button.disabled = true;
  });
});
</script>
