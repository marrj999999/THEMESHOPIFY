{%- comment -%} Bamboo Bicycle Club — 404 (2026 redesign). Styling in assets/bbc-redesign-2026.css. {%- endcomment -%}

<div class="bbc-rd bbc-rd-404">
  <section class="rd-pad">
    <div class="rd-wrap rd-404">
      <div class="rd-big404">404</div>
      <h1 class="rd-cmp-77472">{{ section.settings.heading | default: 'This page took a wrong turn.' }}</h1>
      <p class="rd-lede rd-mt2">{{ section.settings.body | default: "The page you're after isn't here — but there's plenty more to build." }}</p>
      <form class="rd-search rd-search-center" action="{{ routes.search_url }}" method="get" role="search">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="11" cy="11" r="7"></circle><line x1="21" y1="21" x2="16.5" y2="16.5"></line></svg>
        <input type="search" name="q" placeholder="Search the site" aria-label="Search the site">
      </form>
      <div class="rd-flex rd-mt3 rd-jc-center">
        <a class="rd-btn rd-lime" href="{{ routes.root_url }}">Home</a>
        <a class="rd-btn rd-ghost" href="{{ section.settings.link1_url | default: '/collections/home-build-kits' }}">{{ section.settings.link1_label | default: 'Frame kits' }}</a>
        <a class="rd-btn rd-ghost" href="{{ section.settings.link2_url | default: '/pages/bicycle-frame-building-workshop' }}">{{ section.settings.link2_label | default: 'Workshops' }}</a>
      </div>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "404 2026 (new)",
  "tag": "div",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "this page took a wrong turn."
    },
    {
      "type": "textarea",
      "id": "body",
      "label": "Body",
      "default": "The page you're after isn't here — but there's plenty more to build."
    },
    {
      "type": "text",
      "id": "link1_label",
      "label": "Link 1 label",
      "default": "Frame kits"
    },
    {
      "type": "url",
      "id": "link1_url",
      "label": "Link 1 (defaults to the kits collection)"
    },
    {
      "type": "text",
      "id": "link2_label",
      "label": "Link 2 label",
      "default": "Workshops"
    },
    {
      "type": "url",
      "id": "link2_url",
      "label": "Link 2 (defaults to the workshop page)"
    }
  ],
  "presets": [
    {
      "name": "404 2026 (new)"
    }
  ]
}
{% endschema %}
