{%- comment -%}
  BBC New Design (2026) — THEORY OF CHANGE public page (/pages/theory-of-change).
  Modelled on Fine Cell Work's public ToC page (2026-07-06 benchmark research).
  Single self-contained section, schema-driven, scoped under .bbc-rd.
  Structure: header → the problem (3 sourced national stats, dark) → two arms
  (Prevention / Rehabilitation cards) → the chain (input→activity→output→
  outcome→impact steps) → what we measure → CTA row.

  CONTENT POLICY (hard rules):
  - National comparators MUST carry their source (MoJ 2024–25 / Farmer Review 2017).
  - Impact framed as CONTRIBUTION, never attribution ("built around the evidence").
  - Stats canon + Maker language rules as per qa/README.md.
{%- endcomment -%}

{%- liquid
  assign cta1 = section.settings.cta1_url | default: '/pages/impact'
  assign cta2 = section.settings.cta2_url | default: '/pages/prisons'
  assign cta3 = section.settings.cta3_url | default: '/pages/schools'
-%}

<div class="bbc-rd bbc-rd-toc">

  {%- comment -%} ---------- HEADER ---------- {%- endcomment -%}
  <section class="rd-pad rd-paper">
    <div class="rd-wrap rd-mw-820px">
      <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><a href="/pages/impact">Impact</a><span class="rd-sep">/</span><span class="rd-here">{{ section.settings.tx_crumb_toc | default: "Theory of change" }}</span></nav>
      {%- if section.settings.eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="rd-mw-16ch">{{ section.settings.title }}</h1>
      {%- if section.settings.lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.lede }}</p>{%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- THE PROBLEM (sourced national stats, dark) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-dark">
    <div class="rd-wrap">
      {%- if section.settings.problem_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.problem_eyebrow }}</span>{%- endif -%}
      <div class="rd-stats rd-mt3">
        {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}
          <div class="rd-reveal rd-stat" {{ block.shopify_attributes }}>
            <div class="rd-num bbc-counted">{{ block.settings.number }}</div>
            <div class="rd-lbl">{{ block.settings.label }}</div>
            {%- if block.settings.source != blank -%}<div class="rd-src">{{ block.settings.source }}</div>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- TWO ARMS ---------- {%- endcomment -%}
  <section class="rd-pad">
    <div class="rd-wrap">
      {%- if section.settings.arms_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.arms_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal rd-mw-20ch">{{ section.settings.arms_title }}</h2>
      <div class="rd-grid rd-g2 rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'arm' -%}
          <div class="rd-reveal rd-card rd-stamp" {{ block.shopify_attributes }}>
            <div class="rd-body">
              {%- if block.settings.tag != blank -%}<span class="rd-tag rd-lime">{{ block.settings.tag }}</span>{%- endif -%}
              <h3 class="rd-mt2 rd-fs-21px">{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
              {%- if block.settings.link_label != blank -%}<a class="rd-btn rd-ghost rd-mt3" href="{{ block.settings.link_url | default: '/pages/impact' }}">{{ block.settings.link_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- THE CHAIN ---------- {%- endcomment -%}
  <section class="rd-pad rd-paper">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.chain_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.chain_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.chain_title }}</h2>
      <ol class="rd-steps rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'step' -%}
          <li {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
          </li>
        {%- endif -%}{%- endfor -%}
      </ol>
    </div>
  </section>

  {%- comment -%} ---------- WHAT WE MEASURE ---------- {%- endcomment -%}
  {%- if section.settings.measure_title != blank -%}
  <section class="rd-pad-sm">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.measure_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.measure_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.measure_title }}</h2>
      {%- if section.settings.measure_body != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.measure_body }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- CTA ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-680px">
      {%- if section.settings.cta_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.cta_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.cta_title }}</h2>
      <div class="rd-flex rd-mt3 rd-jc-center">
        {%- if section.settings.cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ cta1 }}">{{ section.settings.cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ cta2 }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
        {%- if section.settings.cta3_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ cta3 }}">{{ section.settings.cta3_label }}</a>{%- endif -%}
      </div>
    </div>
  </section>


  {%- comment -%} Stories band — snippets/bbc-stories-band.liquid (2026-08-01). This section
     had no `story` block type, which is why the page carried zero case-study cards. {%- endcomment -%}
  {%- render 'bbc-stories-band', section: section -%}
</div>

