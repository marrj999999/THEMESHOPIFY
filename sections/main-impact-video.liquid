{% comment %} Workshop Spotlight — shows video if URL set, otherwise image + quote {% endcomment %}

{% if section.settings.video_url != blank %}
<section class="impact-video-section" style="background: #1a1a1a; padding: 60px 20px; text-align: center;">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <h2 style="color: #fff; margin-bottom: 30px;">{{ section.settings.heading }}</h2>
    {% endif %}
    <div style="position: relative; padding-bottom: 56.25%; height: 0; max-width: 900px; margin: 0 auto;">
      <iframe
        src="{{ section.settings.video_url }}"
        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: none; border-radius: 8px;"
        allowfullscreen loading="lazy">
      </iframe>
    </div>
  </div>
</section>

{% else %}
<section class="impact-spotlight-section" style="background: #1a1a1a; padding: 60px 20px;">
  <div class="page-width" style="max-width: 1100px; margin: 0 auto; display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center;">
    {% if section.settings.image != blank %}
      <div>
        <img src="{{ section.settings.image | image_url: width: 700 }}"
             alt="{{ section.settings.image_alt | default: 'BBC workshop' }}"
             style="width: 100%; border-radius: 8px; display: block;"
             loading="lazy">
      </div>
    {% endif %}
    <div style="color: #fff;">
      {% if section.settings.heading != blank %}
        <h2 style="color: #fff; margin-bottom: 24px; font-size: 1.5rem;">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.quote != blank %}
        <blockquote style="border-left: 4px solid #8BC34A; padding-left: 24px; margin: 0 0 20px;">
          <p style="font-size: 1.2rem; line-height: 1.7; font-style: italic;">"{{ section.settings.quote }}"</p>
        </blockquote>
      {% endif %}
      {% if section.settings.attribution != blank %}
        <p style="color: #aaa; font-size: 0.9rem;">— {{ section.settings.attribution }}</p>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

<style>
  @media (max-width: 768px) {
    .impact-spotlight-section .page-width {
      grid-template-columns: 1fr !important;
      gap: 30px !important;
    }
  }
</style>

{% schema %}
{
  "name": "Workshop Spotlight",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section heading",
      "default": "See It In Action"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video embed URL (optional)",
      "info": "Paste a YouTube or Vimeo embed URL. If empty, shows the image + quote instead."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fallback image (shown when no video URL)"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "default": "BBC workshop session"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote text",
      "default": "The bike was the first thing I ever made with my own hands. When my daughter rode it on family visit day, I felt like a dad again."
    },
    {
      "type": "text",
      "id": "attribution",
      "label": "Quote attribution",
      "default": "A Build to Bond participant, HMP Lowdham Grange"
    }
  ],
  "presets": [
    {
      "name": "Workshop Spotlight"
    }
  ]
}
{% endschema %}
