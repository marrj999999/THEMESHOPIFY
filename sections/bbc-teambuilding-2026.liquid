{%- comment -%}
  BBC New Design (2026) — TEAM BUILDING page (corporate). A public advert that sells the
  corporate team-build (a team builds a real bamboo bike together, in ~3 hrs to a full day,
  and can donate it to a community charity). Mirrors the Education page pattern + reuses the
  .bbc-rd CSS. Real clients (Four Seasons, General Motors, The Macallan, Hilton) + real case
  studies linked to our blog. Social-enterprise CIC + donate-the-bike is the moat. Generic by
  design (no prison named). Request-a-quote, no public price. Scoped under .bbc-rd.
{%- endcomment -%}

{%- liquid
  assign enquire = section.settings.enquiry_url | default: '#team-enquiry'
  assign email_url = section.settings.enquiry_email | default: 'mailto:info@bamboobicycleclub.org'
-%}

<div class="bbc-rd bbc-rd-tb">

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  <header class="rd-hero rd-mh-70">
    <div class="rd-bg"><img src="{{ section.settings.hero_image | default: 'bbc-rd-tb-hero.jpg' | asset_url }}" alt="{{ section.settings.hero_alt | default: 'A corporate team building bamboo bikes together' | escape }}" width="1400" height="933" fetchpriority="high"></div>
    <div class="rd-scrim"></div>
    <div class="rd-inner"><div class="rd-wrap">
      <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><span class="rd-here">Team Building</span></nav>
      <span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>
      <h1 class="rd-mt2 rd-mw-18ch">{{ section.settings.hero_title }}</h1>
      <div class="rd-lede">{{ section.settings.hero_lede }}</div>
      <div class="rd-cta-row">
        <a class="rd-btn rd-lime" href="{{ enquire }}">{{ section.settings.hero_cta1 | default: 'Request a quote' }} <span class="rd-arrow">&rarr;</span></a>
        <a class="rd-btn rd-on-dark" href="#how">{{ section.settings.hero_cta2 | default: 'How it works' }}</a>
      </div>
    </div></div>
  </header>

  {%- comment -%} ---------- CLIENT LOGO STRIP ---------- {%- endcomment -%}
  {%- assign clients = section.blocks | where: 'type', 'client' -%}
  {%- if clients.size > 0 -%}
    <section class="rd-pad-sm rd-paper rd-center">
      <div class="rd-wrap">
        <p class="rd-partnerlabel">{{ section.settings.clients_label }}</p>
        <div class="rd-logogrid rd-mt2">
          {%- for b in clients -%}
            {%- comment -%} real logos only (qa/PRESS-BLOCK.md) — clients without a logo asset
               don't render in the wall. Assets ready: investec/macallan/fourseasons/hilton.
               GM · Google · McLaren stay OUT until James resolves the vault verification hold. {%- endcomment -%}
            {%- capture cell -%}{%- if b.settings.logo_asset != blank -%}<img class="rd-logoimg" src="{{ b.settings.logo_asset | asset_url }}" alt="{{ b.settings.name | escape }}" loading="lazy">{%- endif -%}{%- endcapture -%}
            {%- if b.settings.url != blank -%}<a class="rd-logocell" href="{{ b.settings.url }}" target="_blank" rel="noopener" aria-label="{{ b.settings.name | escape }} — read the case study">{{ cell }}</a>{%- else -%}<div class="rd-logocell">{{ cell }}</div>{%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- KEY FACTS ---------- {%- endcomment -%}
  <section class="rd-pad-sm">
    <div class="rd-wrap">
      <div class="rd-facts">
        <div class="rd-reveal rd-fact"><span class="rd-reveal rd-fact-n">5–50+</span><span class="rd-reveal rd-fact-l">people per team day</span></div>
        <div class="rd-reveal rd-fact"><span class="rd-reveal rd-fact-n">3 hrs–full day</span><span class="rd-reveal rd-fact-l">flexible format</span></div>
        <div class="rd-reveal rd-fact"><span class="rd-reveal rd-fact-n">Your venue</span><span class="rd-reveal rd-fact-l">UK-wide, or come to us</span></div>
        <div class="rd-reveal rd-fact"><span class="rd-reveal rd-fact-n">No experience</span><span class="rd-reveal rd-fact-l">needed — we guide every step</span></div>
        <div class="rd-reveal rd-fact"><span class="rd-reveal rd-fact-n">Indoor / outdoor</span><span class="rd-reveal rd-fact-l">we bring the workshop</span></div>
        <div class="rd-reveal rd-fact"><span class="rd-reveal rd-fact-n">Donate the bikes</span><span class="rd-reveal rd-fact-l">to a community charity</span></div>
      </div>
    </div>
        <p class="rd-ship-note rd-mt3">Fewer than five people? <a href="/pages/bicycle-frame-building-workshop">Join an open build weekend instead &rarr;</a> Five or more — request a quote below.</p>
</section>

  {%- comment -%} ---------- WHAT THE DAY IS (split) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-steel" id="how">
    <div class="rd-wrap">
      <div class="rd-split rd-tight rd-gap48-ac">
        <div>
          <span class="rd-eyebrow">The real thing</span>
          <h2 class="rd-reveal">a real bike. not a flat-pack kit.</h2>
          <p class="rd-lede rd-mt2">Most “build-a-bike” days bolt together a children’s kit in an hour. On ours, your team works raw bamboo — cutting, mitring, binding and finishing — into a frame that genuinely rides.</p>
          <ul class="rd-list rd-mt3">
            <li>A proper hands-on engineering challenge that needs the whole team</li>
            <li>Every step guided by our facilitators — no DIY skill required</li>
            <li>You finish the day with a real, rideable bamboo bike</li>
            <li>Run it at your office, an away-day venue, or our London workshop</li>
          </ul>
        </div>
        <div class="rd-reveal rd-card rd-stamp rd-lime">
          <div class="rd-ph rd-ar-43">{%- render "bbc-media", src: section.settings.day_image, fallback: "bbc-rd-tb-gm.jpg", video: section.settings.video_file, youtube: section.settings.video_url, alt: "A corporate team building bamboo bike frames together" -%}</div>
          <div class="rd-body"><p class="rd-cmp-35205">Cut, mitre, bind, finish — a frame made by hand, by your team.</p></div>
        </div>
      </div>
    </div>
  </section>

    {%- comment -%} ---------- PACKAGES (benchmark: Swingers transparent tiers) ---------- {%- endcomment -%}
  <section class="rd-pad">
    <div class="rd-wrap">
      <div class="rd-center">
        <span class="rd-eyebrow">{{ section.settings.pkg_eyebrow | default: 'Choose your build day' }}</span>
        <h2 class="rd-reveal">{{ section.settings.pkg_title | default: 'two ways to build together.' }}</h2>
      </div>
      <div class="rd-grid rd-g2 rd-mt4">
        <div class="rd-reveal rd-card rd-stamp"><div class="rd-body">
          <span class="rd-tag rd-lime">{{ section.settings.pkg1_tag }}</span>
          <h3 class="rd-mt2 rd-fs-21px">{{ section.settings.pkg1_title }}</h3>
          <p>{{ section.settings.pkg1_body }}</p>
          <ul class="rd-list rd-mt2">
            {%- assign p1b = section.settings.pkg1_bullets | split: '|' -%}
            {%- for b in p1b -%}<li>{{ b | strip }}</li>{%- endfor -%}
          </ul>
          <p class="rd-mt3" style="font-weight:800;color:var(--forest);">{{ section.settings.pkg1_price }}</p>
          <a class="rd-btn rd-lime rd-mt2" href="{{ section.settings.pkg1_url | default: '#team-enquiry' }}">{{ section.settings.pkg1_cta | default: 'Request a quote' }} <span class="rd-arrow">&rarr;</span></a>
        </div></div>
        <div class="rd-reveal rd-card rd-stamp"><div class="rd-body">
          <span class="rd-tag rd-lime">{{ section.settings.pkg2_tag }}</span>
          <h3 class="rd-mt2 rd-fs-21px">{{ section.settings.pkg2_title }}</h3>
          <p>{{ section.settings.pkg2_body }}</p>
          <ul class="rd-list rd-mt2">
            {%- assign p2b = section.settings.pkg2_bullets | split: '|' -%}
            {%- for b in p2b -%}<li>{{ b | strip }}</li>{%- endfor -%}
          </ul>
          <p class="rd-mt3" style="font-weight:800;color:var(--forest);">{{ section.settings.pkg2_price }}</p>
          <a class="rd-btn rd-lime rd-mt2" href="{{ section.settings.pkg2_url | default: '#team-enquiry' }}">{{ section.settings.pkg2_cta | default: 'Request a quote' }} <span class="rd-arrow">&rarr;</span></a>
        </div></div>
      </div>
    </div>
  </section>

{%- comment -%} ---------- CHARITY / CIC MOAT ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-820px">
      <span class="rd-eyebrow rd-on-dark">Build it, then give it away</span>
      <h2 class="rd-reveal">The best team day you’ll do all year — and a bike for a child who needs one.</h2>
      <p class="rd-lede rd-mt2 rd-mx-auto">We're a social enterprise: the fee for your day funds our accredited skills work in schools and prisons. And the bikes your team makes can be donated to a community charity — one company built balance bikes that went to Upcycle, a Brixton charity getting more children cycling.</p>
      <div class="rd-cta-row rd-jc-center rd-mt3"><a class="rd-btn rd-lime" href="{{ enquire }}">Request a quote <span class="rd-arrow">&rarr;</span></a></div>
    </div>
  </section>

  {%- comment -%} ---------- CASE STUDIES ---------- {%- endcomment -%}
  {%- assign cs = section.blocks | where: 'type', 'casestudy' -%}
  {%- if cs.size > 0 -%}
    <section class="rd-pad-sm">
      <div class="rd-wrap">
        <span class="rd-eyebrow">{{ section.settings.cs_eyebrow }}</span>
        <h2 class="rd-reveal rd-mw-16ch">{{ section.settings.cs_title }}</h2>
        {%- if section.settings.cs_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.cs_lede }}</p>{%- endif -%}
        <ul class="rd-csgrid rd-mt4" role="list">
          {%- comment -%} Renders THE standard card (snippets/bbc-cscard.liquid), 2026-07-31.
             Was 12 lines of bespoke markup with a wrapper <a> and no heading element — the same
             copy that had drifted apart on six pages. heading = outcome, falling back to the
             company name so a half-filled block still produces a usable link. {%- endcomment -%}
          {%- for b in cs -%}
            {%- assign _img = b.settings.image | default: 'bbc-rd-tb-fourseasons.jpg' -%}
            {%- assign _head = b.settings.outcome | default: b.settings.company -%}
            {%- render 'bbc-cscard',
                 variant: 'grid',
                 kind: b.settings.kind,
                 heading: _head,
                 url: b.settings.url,
                 context: b.settings.blurb,
                 attr: b.settings.company,
                 image: _img,
                 youtube: b.settings.video_url,
                 video_file: b.settings.video_file,
                 cta: b.settings.link_label -%}
          {%- endfor -%}
        </ul>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- CREDIBILITY STRIP ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-paper rd-center">
    <div class="rd-wrap">
      <span class="rd-eyebrow">Accountable & insured</span>
      <h2 class="rd-reveal rd-mt2">a team day you can stand behind.</h2>
      <div class="rd-flex rd-mt4 rd-jc-center">
        <span class="rd-tag rd-lime">Social enterprise · Bamboo Mobility Project CIC</span>
        <span class="rd-tag">Enhanced-DBS facilitators</span>
        <span class="rd-tag">Public-liability insured</span>
        <span class="rd-tag">Investec Beyond Business 2025</span>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- FAQ ---------- {%- endcomment -%}
  {%- assign faqs = section.blocks | where: 'type', 'faq' -%}
  {%- if faqs.size > 0 -%}
    <section class="rd-pad-sm">
      <div class="rd-wrap rd-mw-820px">
        <span class="rd-eyebrow">Good to know</span>
        <h2 class="rd-reveal rd-mt2">questions teams ask.</h2>
        <div class="rd-faqs rd-mt3">
          {%- for b in faqs -%}
            <details class="rd-faq" {{ b.shopify_attributes }}>
              <summary>{{ b.settings.q }}</summary>
              <div class="rd-faq-a">{{ b.settings.a }}</div>
            </details>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

    {%- comment -%} ---------- INLINE ENQUIRY (benchmark: Go Ape on-page form) ---------- {%- endcomment -%}
  <section class="rd-pad rd-paper" id="team-enquiry">
    <div class="rd-wrap rd-mw-820px">
      <span class="rd-eyebrow">Request a quote</span>
      <h2 class="rd-reveal">tell us team size and a rough date. we do the rest.</h2>
      <ol class="rd-steps rd-mt3">
        <li><h3>tell us the basics</h3><p>Team size and a rough month — nothing else needed yet.</p></li>
        <li><h3>quote within one working day</h3><p>A scoped plan and price you can forward internally.</p></li>
        <li><h3>we bring the workshop</h3><p>Your office, an away-day venue, or our London workshop.</p></li>
        <li><h3>build, ride, hand over</h3><p>A real bike your team made — ride it or donate it.</p></li>
      </ol>
      {% form 'contact', id: 'team-enquiry-form', class: 'rd-form rd-mt4' %}
        {%- if form.posted_successfully? -%}<p class="rd-lede">Thanks — we'll come back within one working day.</p>{%- endif -%}
        {%- if form.errors -%}<p class="rd-err">Please check the email address and try again.</p>{%- endif -%}
        <div class="rd-grid rd-g2">
          <label>Company<br><input type="text" name="contact[company]" autocomplete="organization"></label>
          <label>Work email<br><input type="email" name="contact[email]" required autocomplete="email"></label>
          <label>Team size<br><select name="contact[team_size]"><option>5–10</option><option>11–20</option><option>21–50</option><option>50+</option></select></label>
          <label>Rough date<br><input type="month" name="contact[preferred_month]"></label>
        </div>
        <label class="rd-mt2" style="display:block;">Anything else? (optional)<br><textarea name="contact[body]" rows="3"></textarea></label>
        <button type="submit" class="rd-btn rd-lime rd-mt3">Request a quote <span class="rd-arrow">&rarr;</span></button>
        <p class="rd-ship-note rd-mt2">We reply within one working day. No obligation, no spam.</p>
      {% endform %}
    </div>
  </section>

{%- comment -%} ---------- FINAL CTA ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-680px">
      <span class="rd-eyebrow rd-on-dark">Bring it to your team</span>
      <h2 class="rd-reveal">let’s build something your team will remember.</h2>
      <p class="rd-lede rd-mt2 rd-mx-auto">Tell us your team size, a rough date and your venue — we’ll send a proper quote within one working day. Materials, facilitation and the charity handover are all included.</p>
      <div class="rd-flex rd-mt3 rd-jc-center">
        <a class="rd-btn rd-lime" href="{{ enquire }}">Request a quote <span class="rd-arrow">&rarr;</span></a>
        <a class="rd-btn rd-on-dark" href="{{ email_url }}">Email us</a>
      </div>
    </div>
  </section>

</div>

