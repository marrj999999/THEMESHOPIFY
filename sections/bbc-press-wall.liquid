{% comment %}
  BBC Press Wall — Distinctive Brand Version
  
  Design Principles:
  - Sharp card edges
  - Featured card with offset shadow
  - Publication names in serif (authority)
  - Left-aligned layout
  - Gold accent on hover
{% endcomment %}

<section class="bbc-press">
  <div class="bbc-press__container page-width">
    <header class="bbc-press__header">
      {% if section.settings.eyebrow != blank %}
        <span class="bbc-press__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 class="bbc-press__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="bbc-press__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>
    
    <div class="bbc-press__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'press_item' -%}
          <article class="bbc-press-card{% if block.settings.featured %} bbc-press-card--featured{% endif %}" {{ block.shopify_attributes }}>
            <span class="bbc-press-card__publication">{{ block.settings.publication }}</span>
            <h3 class="bbc-press-card__title">{{ block.settings.title }}</h3>
            {% if block.settings.excerpt != blank %}
              <p class="bbc-press-card__excerpt">"{{ block.settings.excerpt }}"</p>
            {% endif %}
            <footer class="bbc-press-card__footer">
              <time class="bbc-press-card__date">{{ block.settings.date }}</time>
              {% if block.settings.url != blank %}
                <a href="{{ block.settings.url }}" target="_blank" rel="noopener" class="bbc-press-card__link">
                  Read →
                </a>
              {% endif %}
            </footer>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    
    {% if section.settings.additional_publications != blank %}
      <footer class="bbc-press__additional">
        <span>Also featured in:</span>
        <strong>{{ section.settings.additional_publications }}</strong>
      </footer>
    {% endif %}
  </div>
</section>

<style>
  .bbc-press {
    padding: 100px 20px;
    background: white;
    position: relative;
  }
  
  /* Bamboo stripe accent */
  .bbc-press::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: linear-gradient(
      to right,
      var(--bbc-gold, var(--bbc-gold)) 0%,
      var(--bbc-gold, var(--bbc-gold)) 30%,
      transparent 30%,
      transparent 40%,
      var(--bbc-teal, var(--bbc-teal)) 40%,
      var(--bbc-teal, var(--bbc-teal)) 100%
    );
  }
  
  .bbc-press__header {
    margin-bottom: 48px;
    max-width: 600px;
  }
  
  .bbc-press__eyebrow {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--bbc-teal, var(--bbc-teal));
    margin-bottom: 12px;
  }
  
  .bbc-press__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--bbc-forest, var(--bbc-forest));
    letter-spacing: -0.02em;
    margin: 0 0 12px 0;
    line-height: 1.1;
  }
  
  .bbc-press__subheading {
    font-size: 1.125rem;
    color: var(--bbc-forest, var(--bbc-forest));
    opacity: 0.7;
    margin: 0;
    line-height: 1.5;
  }
  
  .bbc-press__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  
  /* Press card - sharp, authoritative */
  .bbc-press-card {
    padding: 32px;
    background: var(--bbc-cream, var(--bbc-cream));
    border-left: 4px solid transparent;
    display: flex;
    flex-direction: column;
    transition: border-color 0.2s ease;
  }
  
  .bbc-press-card:hover {
    border-left-color: var(--bbc-gold, var(--bbc-gold));
  }
  
  .bbc-press-card--featured {
    border-left-color: var(--bbc-gold, var(--bbc-gold));
    box-shadow: 8px 8px 0 var(--bbc-gold, var(--bbc-gold));
    background: white;
  }
  
  @media (prefers-reduced-motion: reduce) {
    .bbc-press-card {
      transition: none;
    }
  }
  
  .bbc-press-card__publication {
    font-family: var(--font-body-family);
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--bbc-teal, var(--bbc-teal));
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 12px;
  }
  
  .bbc-press-card--featured .bbc-press-card__publication {
    color: var(--bbc-forest, var(--bbc-forest));
  }
  
  .bbc-press-card__title {
    font-family: var(--font-heading-family);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--bbc-forest, var(--bbc-forest));
    line-height: 1.3;
    margin: 0 0 12px 0;
  }
  
  .bbc-press-card__excerpt {
    font-size: 0.9375rem;
    font-style: italic;
    line-height: 1.6;
    color: var(--bbc-forest, var(--bbc-forest));
    opacity: 0.8;
    margin: 0;
    flex: 1;
  }
  
  .bbc-press-card__footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 20px;
    padding-top: 16px;
    border-top: 1px solid rgba(7, 62, 39, 0.1);
  }
  
  .bbc-press-card__date {
    font-size: 0.8125rem;
    color: var(--bbc-forest, var(--bbc-forest));
    opacity: 0.6;
  }
  
  .bbc-press-card__link {
    font-size: 0.8125rem;
    font-weight: 700;
    color: var(--bbc-forest, var(--bbc-forest));
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: color 0.2s ease;
  }
  
  .bbc-press-card__link:hover {
    color: var(--bbc-teal, var(--bbc-teal));
  }
  
  .bbc-press-card__link:focus-visible {
    outline: 2px solid var(--bbc-gold, var(--bbc-gold));
    outline-offset: 4px;
  }
  
  @media (prefers-reduced-motion: reduce) {
    .bbc-press-card__link {
      transition: none;
    }
  }
  
  /* Additional publications */
  .bbc-press__additional {
    margin-top: 48px;
    padding: 24px 32px;
    background: var(--bbc-forest, var(--bbc-forest));
    color: white;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    align-items: baseline;
  }
  
  .bbc-press__additional span {
    font-size: 0.875rem;
    opacity: 0.7;
  }
  
  .bbc-press__additional strong {
    font-size: 0.9375rem;
    font-weight: 600;
    opacity: 0.9;
  }
  
  @media (max-width: 768px) {
    .bbc-press {
      padding: 60px 16px;
    }
    
    .bbc-press__grid {
      grid-template-columns: 1fr;
    }
    
    .bbc-press-card {
      padding: 24px;
    }
    
    .bbc-press-card--featured {
      box-shadow: 6px 6px 0 var(--bbc-gold, var(--bbc-gold));
    }
    
    .bbc-press__additional {
      flex-direction: column;
      gap: 8px;
    }
  }
</style>

{% schema %}
{
  "name": "BBC Press Wall",
  "tag": "section",
  "class": "bbc-press-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Press"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "In The Press"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "12 years of coverage from major publications"
    },
    {
      "type": "textarea",
      "id": "additional_publications",
      "label": "Additional publications",
      "default": "BIKE Magazine • Gravel Cyclist • Country & Town House • Inside Time"
    }
  ],
  "blocks": [
    {
      "type": "press_item",
      "name": "Press Item",
      "settings": [
        {
          "type": "text",
          "id": "publication",
          "label": "Publication name"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Article title"
        },
        {
          "type": "textarea",
          "id": "excerpt",
          "label": "Excerpt/Quote"
        },
        {
          "type": "text",
          "id": "date",
          "label": "Date"
        },
        {
          "type": "url",
          "id": "url",
          "label": "Article URL"
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Featured",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Press Wall",
      "settings": {
        "eyebrow": "Press",
        "heading": "In The Press",
        "subheading": "12 years of coverage from major publications"
      },
      "blocks": [
        {
          "type": "press_item",
          "settings": {
            "publication": "Financial Times",
            "title": "How Bamboo Bicycle Club is helping to break the prison cycle",
            "excerpt": "Taps into 'the IKEA effect' — extra affection people reserve for objects they put together themselves.",
            "date": "September 2025",
            "featured": true
          }
        },
        {
          "type": "press_item",
          "settings": {
            "publication": "BikeRadar",
            "title": "First Ride Video Review",
            "excerpt": "How did it feel riding something that's mostly made from a member of the grass family?",
            "date": "April 2019",
            "featured": false
          }
        },
        {
          "type": "press_item",
          "settings": {
            "publication": "Design Museum",
            "title": "Cycle Revolution Exhibition",
            "excerpt": "The only bamboo bicycle maker of its kind in Europe.",
            "date": "2015-2016",
            "featured": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
