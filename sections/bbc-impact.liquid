{% comment %}
  BBC Impact Section — Clean v2
{% endcomment %}

<section class="bbc-section bbc-section--{{ section.settings.background }}">
  <div class="bbc-container">
    
    <div class="bbc-impact__grid {% render 'bbc-layout-classes', content_width: section.settings.content_width, visual_position: section.settings.visual_position, vertical_align: section.settings.vertical_align, mobile_order: section.settings.mobile_order, gap_size: section.settings.gap_size %}">

      <div class="bbc-impact__content bbc-layout__content">
        {% if section.settings.label != blank %}
          <p class="bbc-label">{{ section.settings.label }}</p>
        {% endif %}
        
        <h2 class="bbc-heading-lg bbc-mb-md">{{ section.settings.heading }}</h2>
        
        {% if section.settings.text != blank %}
          <div class="bbc-body-lg bbc-mb-lg">{{ section.settings.text }}</div>
        {% endif %}
        
        {% if section.blocks.size > 0 %}
          <ul class="bbc-impact__features bbc-mb-lg">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="bbc-impact__icon">{{ block.settings.icon }}</span>
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {% endif %}
        
        {% if section.settings.quote != blank %}
          <blockquote class="bbc-impact__quote bbc-mb-lg">
            <p>"{{ section.settings.quote }}"</p>
            <footer>
              <span class="bbc-quote__name">{{ section.settings.quote_name }}</span>
              <span class="bbc-quote__role">{{ section.settings.quote_role }}</span>
            </footer>
          </blockquote>
        {% endif %}
        
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="bbc-btn bbc-btn--{{ section.settings.button_style | default: 'primary' }}">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
      
      {% if section.settings.image %}
        <div class="bbc-impact__media bbc-layout__visual">
          <img 
            src="{{ section.settings.image | image_url: width: 600 }}"
            alt="{{ section.settings.image_alt }}"
            class="bbc-image bbc-image--rounded"
            loading="lazy"
          >
        </div>
      {% endif %}
      
    </div>
    
  </div>
</section>

<style>
  .bbc-impact__grid {
    /* Grid layout handled by shared bbc-layout classes */
  }
  
  .bbc-impact__content .bbc-body-lg p {
    margin: 0;
  }
  
  .bbc-impact__features {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  
  .bbc-impact__features li {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    font-size: 1rem;
    color: var(--bbc-text, #1a1a1a);
  }
  
  .bbc-impact__icon {
    font-size: 1.25rem;
  }
  
  .bbc-impact__quote {
    margin: 0;
    padding: 24px;
    background: var(--bbc-white, var(--bbc-white));
    border-radius: 12px;
    border-left: 4px solid var(--bbc-gold, var(--bbc-gold));
  }
  
  .bbc-section--white .bbc-impact__quote {
    background: var(--bbc-cream, var(--bbc-cream));
  }
  
  .bbc-impact__quote p {
    font-size: 1.125rem;
    font-weight: 500;
    font-style: italic;
    color: var(--bbc-black, #1a1a1a);
    margin: 0 0 12px 0;
  }
  
  /* Mobile handled by shared bbc-layout classes */
</style>

{% schema %}
{
  "name": "BBC Impact",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Social Impact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Building Bicycles. Rebuilding Lives."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Quote"
    },
    {
      "type": "text",
      "id": "quote_name",
      "label": "Quote name"
    },
    {
      "type": "text",
      "id": "quote_role",
      "label": "Quote role"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary (Gold)" },
        { "value": "secondary", "label": "Secondary (Forest)" },
        { "value": "outline", "label": "Outline" },
        { "value": "outline-light", "label": "Outline Light" },
        { "value": "white", "label": "White" },
        { "value": "gold", "label": "Gold" }
      ],
      "default": "primary"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "visual_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content/image width ratio",
      "options": [
        { "value": "50-50", "label": "Equal (50/50)" },
        { "value": "60-40", "label": "More text (60/40)" },
        { "value": "40-60", "label": "More image (40/60)" },
        { "value": "70-30", "label": "Mostly text (70/30)" }
      ],
      "default": "50-50"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile stack order",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first",
      "info": "Which appears first when stacked on mobile"
    },
    {
      "type": "select",
      "id": "gap_size",
      "label": "Gap between columns",
      "options": [
        { "value": "sm", "label": "Small (24px)" },
        { "value": "md", "label": "Medium (40px)" },
        { "value": "lg", "label": "Large (64px)" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "text", "id": "icon", "label": "Icon", "default": "check" },
        { "type": "text", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Impact"
    }
  ]
}
{% endschema %}
