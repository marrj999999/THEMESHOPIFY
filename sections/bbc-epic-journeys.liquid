{% comment %}
  BBC Epic Journeys — Customer adventure stories showcase
  Research-backed design inspired by cycling adventure storytelling patterns
{% endcomment %}

{%- style -%}
  .bbc-epic-journeys {
    padding: 100px 0;
    background: var(--bbc-forest, var(--bbc-forest));
    position: relative;
    overflow: hidden;
  }

  .bbc-epic-journeys::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: url("data:image/svg+xml,%3Csvg width='40' height='40' viewBox='0 0 40 40' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='%23ffa900' fill-opacity='0.05'%3E%3Cpath d='M20 20c0-5.5-4.5-10-10-10s-10 4.5-10 10 4.5 10 10 10 10-4.5 10-10zm10 0c0-5.5-4.5-10-10-10s-10 4.5-10 10 4.5 10 10 10 10-4.5 10-10z'/%3E%3C/g%3E%3C/svg%3E") repeat;
    pointer-events: none;
  }

  .bbc-epic-journeys__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    position: relative;
    z-index: 1;
  }

  .bbc-epic-journeys__header {
    text-align: center;
    margin-bottom: 80px;
  }

  .bbc-epic-journeys__eyebrow {
    font-family: var(--font-heading-family, "Plus Jakarta Sans", sans-serif);
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--bbc-gold, var(--bbc-gold));
    margin-bottom: 16px;
  }

  .bbc-epic-journeys__heading {
    font-family: var(--font-heading-family, "Plus Jakarta Sans", sans-serif);
    font-size: clamp(2.25rem, 5vw, 3.5rem);
    font-weight: 800;
    color: var(--bbc-white, var(--bbc-white));
    margin: 0 0 24px 0;
    line-height: 1.1;
  }

  .bbc-epic-journeys__intro {
    font-family: var(--font-body-family, system-ui, sans-serif);
    font-size: 1.25rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .bbc-epic-journeys__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(350px, 1fr));
    gap: 32px;
    margin-bottom: 80px;
  }

  .bbc-epic-journeys__story {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 20px;
    padding: 40px;
    transition: all 0.4s ease;
    position: relative;
    overflow: hidden;
  }

  .bbc-epic-journeys__story::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: linear-gradient(90deg, var(--bbc-gold, var(--bbc-gold)) 0%, var(--bbc-teal, var(--bbc-teal)) 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .bbc-epic-journeys__story:hover {
    transform: translateY(-8px);
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 169, 0, 0.3);
    box-shadow: 0 20px 40px rgba(0,0,0,0.2);
  }

  .bbc-epic-journeys__story:hover::before {
    opacity: 1;
  }

  .bbc-epic-journeys__story-header {
    display: flex;
    align-items: flex-start;
    gap: 20px;
    margin-bottom: 24px;
  }

  .bbc-epic-journeys__avatar {
    width: 60px;
    height: 60px;
    border-radius: 50%;
    border: 3px solid var(--bbc-gold, var(--bbc-gold));
    flex-shrink: 0;
    overflow: hidden;
  }

  .bbc-epic-journeys__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .bbc-epic-journeys__avatar-placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, var(--bbc-gold, var(--bbc-gold)) 0%, var(--bbc-teal, var(--bbc-teal)) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bbc-white, var(--bbc-white));
    font-family: var(--font-heading-family, "Plus Jakarta Sans", sans-serif);
    font-size: 1.5rem;
    font-weight: 700;
  }

  .bbc-epic-journeys__story-meta {
    flex: 1;
  }

  .bbc-epic-journeys__story-title {
    font-family: var(--font-heading-family, "Plus Jakarta Sans", sans-serif);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--bbc-white, var(--bbc-white));
    margin: 0 0 8px 0;
    line-height: 1.3;
  }

  .bbc-epic-journeys__story-details {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-bottom: 20px;
  }

  .bbc-epic-journeys__detail {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body-family, system-ui, sans-serif);
    font-size: 0.875rem;
    color: var(--bbc-gold, var(--bbc-gold));
    font-weight: 600;
  }

  .bbc-epic-journeys__detail-icon {
    width: 16px;
    height: 16px;
    opacity: 0.8;
  }

  .bbc-epic-journeys__quote {
    font-family: var(--font-body-family, system-ui, sans-serif);
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.6;
    margin-bottom: 20px;
    font-style: italic;
    position: relative;
  }

  .bbc-epic-journeys__quote::before {
    content: '"';
    font-size: 3rem;
    color: var(--bbc-gold, var(--bbc-gold));
    position: absolute;
    left: -20px;
    top: -10px;
    line-height: 1;
    opacity: 0.6;
  }

  .bbc-epic-journeys__author {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 20px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .bbc-epic-journeys__author-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .bbc-epic-journeys__author-name {
    font-family: var(--font-heading-family, "Plus Jakarta Sans", sans-serif);
    font-size: 1rem;
    font-weight: 600;
    color: var(--bbc-white, var(--bbc-white));
  }

  .bbc-epic-journeys__author-location {
    font-family: var(--font-body-family, system-ui, sans-serif);
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.7);
  }

  .bbc-epic-journeys__story-type {
    padding: 6px 12px;
    border-radius: 12px;
    font-family: var(--font-heading-family, "Plus Jakarta Sans", sans-serif);
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .bbc-epic-journeys__story-type--adventure {
    background: rgba(255, 169, 0, 0.2);
    color: var(--bbc-gold, var(--bbc-gold));
    border: 1px solid rgba(255, 169, 0, 0.3);
  }

  .bbc-epic-journeys__story-type--daily {
    background: rgba(63, 139, 102, 0.2);
    color: var(--bbc-teal, var(--bbc-teal));
    border: 1px solid rgba(63, 139, 102, 0.3);
  }

  .bbc-epic-journeys__story-type--challenge {
    background: rgba(115, 211, 147, 0.2);
    color: #73d393;
    border: 1px solid rgba(115, 211, 147, 0.3);
  }

  .bbc-epic-journeys__cta {
    text-align: center;
  }

  .bbc-epic-journeys__cta-text {
    font-family: var(--font-body-family, system-ui, sans-serif);
    font-size: 1.125rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 24px;
  }

  .bbc-epic-journeys__button {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 16px 32px;
    background: var(--bbc-gold, var(--bbc-gold));
    color: var(--bbc-forest, var(--bbc-forest));
    font-family: var(--font-heading-family, "Plus Jakarta Sans", sans-serif);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 50px;
    transition: all 0.3s ease;
    border: 2px solid var(--bbc-gold, var(--bbc-gold));
  }

  .bbc-epic-journeys__button:hover {
    background: transparent;
    color: var(--bbc-gold, var(--bbc-gold));
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(255, 169, 0, 0.3);
  }

  .bbc-epic-journeys__button-icon {
    width: 18px;
    height: 18px;
  }

  /* Mobile Optimizations */
  @media (max-width: 768px) {
    .bbc-epic-journeys {
      padding: 60px 0;
    }

    .bbc-epic-journeys__container {
      padding: 0 16px;
    }

    .bbc-epic-journeys__grid {
      grid-template-columns: 1fr;
      gap: 24px;
      margin-bottom: 60px;
    }

    .bbc-epic-journeys__story {
      padding: 30px;
    }

    .bbc-epic-journeys__story:hover {
      transform: none;
    }

    .bbc-epic-journeys__story-header {
      flex-direction: column;
      align-items: center;
      text-align: center;
      gap: 16px;
    }

    .bbc-epic-journeys__story-details {
      justify-content: center;
    }

    .bbc-epic-journeys__author {
      flex-direction: column;
      gap: 12px;
      text-align: center;
    }
  }

  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .bbc-epic-journeys__story:hover {
      transform: none;
    }

    .bbc-epic-journeys__button:hover {
      transform: none;
    }
  }
{%- endstyle -%}

<section class="bbc-epic-journeys">
  <div class="bbc-epic-journeys__container">
    {% if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.intro != blank %}
      <div class="bbc-epic-journeys__header">
        {% if section.settings.eyebrow != blank %}
          <p class="bbc-epic-journeys__eyebrow">{{ section.settings.eyebrow }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="bbc-epic-journeys__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        {% if section.settings.intro != blank %}
          <p class="bbc-epic-journeys__intro">{{ section.settings.intro }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="bbc-epic-journeys__grid">
      {% for block in section.blocks %}
        <article class="bbc-epic-journeys__story" {{ block.shopify_attributes }}>
          <div class="bbc-epic-journeys__story-header">
            <div class="bbc-epic-journeys__avatar">
              {% if block.settings.avatar != blank %}
                {{ block.settings.avatar | image_url: width: 120 | image_tag: 
                  alt: block.settings.rider_name | append: ' avatar',
                  loading: 'lazy'
                }}
              {% else %}
                <div class="bbc-epic-journeys__avatar-placeholder">
                  {{ block.settings.rider_name | slice: 0 | upcase }}
                </div>
              {% endif %}
            </div>
            
            <div class="bbc-epic-journeys__story-meta">
              <h3 class="bbc-epic-journeys__story-title">{{ block.settings.journey_title }}</h3>
              
              <div class="bbc-epic-journeys__story-details">
                {% if block.settings.distance != blank %}
                  <div class="bbc-epic-journeys__detail">
                    <svg class="bbc-epic-journeys__detail-icon" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
                    </svg>
                    {{ block.settings.distance }}
                  </div>
                {% endif %}
                
                {% if block.settings.duration != blank %}
                  <div class="bbc-epic-journeys__detail">
                    <svg class="bbc-epic-journeys__detail-icon" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                    </svg>
                    {{ block.settings.duration }}
                  </div>
                {% endif %}

                {% if block.settings.terrain != blank %}
                  <div class="bbc-epic-journeys__detail">
                    <svg class="bbc-epic-journeys__detail-icon" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M14 6l-3.75 5 2.85 3.8-1.6 1.2C9.81 13.75 7 10 7 10l-6 8h22L14 6z"/>
                    </svg>
                    {{ block.settings.terrain }}
                  </div>
                {% endif %}
              </div>
            </div>
            
            {% if block.settings.story_type != blank %}
              <div class="bbc-epic-journeys__story-type bbc-epic-journeys__story-type--{{ block.settings.story_type }}">
                {{ block.settings.story_type }}
              </div>
            {% endif %}
          </div>

          {% if block.settings.quote != blank %}
            <blockquote class="bbc-epic-journeys__quote">
              {{ block.settings.quote }}
            </blockquote>
          {% endif %}

          <div class="bbc-epic-journeys__author">
            <div class="bbc-epic-journeys__author-info">
              <span class="bbc-epic-journeys__author-name">{{ block.settings.rider_name }}</span>
              {% if block.settings.location != blank %}
                <span class="bbc-epic-journeys__author-location">{{ block.settings.location }}</span>
              {% endif %}
            </div>
            {% if block.settings.years_riding != blank %}
              <div class="bbc-epic-journeys__story-type bbc-epic-journeys__story-type--challenge">
                {{ block.settings.years_riding }} on bamboo
              </div>
            {% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.cta_text != blank or section.settings.cta_button_text != blank %}
      <div class="bbc-epic-journeys__cta">
        {% if section.settings.cta_text != blank %}
          <p class="bbc-epic-journeys__cta-text">{{ section.settings.cta_text }}</p>
        {% endif %}
        {% if section.settings.cta_button_text != blank %}
          <a href="{{ section.settings.cta_button_link }}" class="bbc-epic-journeys__button bbc-btn bbc-btn--{{ section.settings.button_style | default: 'primary' }}">
            {{ section.settings.cta_button_text }}
            <svg class="bbc-epic-journeys__button-icon" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8.59 16.59L13.17 12 8.59 7.41 10 6l6 6-6 6-1.41-1.41z"/>
            </svg>
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "BBC Epic Journeys",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Adventure"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where Our Bikes Go"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "From daily commutes to epic adventures, BBC-built bamboo bicycles have carried riders across continents, through challenges, and into unforgettable experiences."
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text",
      "default": "Have an epic journey story to share?"
    },
    {
      "type": "text",
      "id": "cta_button_text",
      "label": "CTA button text",
      "default": "Share Your Story"
    },
    {
      "type": "url",
      "id": "cta_button_link",
      "label": "CTA button link",
      "info": "Default: /pages/contact-us"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Gold Button" },
        { "value": "secondary", "label": "Forest Button" },
        { "value": "outline", "label": "Outline" },
        { "value": "outline-light", "label": "Outline Light" },
        { "value": "white", "label": "White Button" },
        { "value": "gold", "label": "Gold Hover" }
      ],
      "default": "primary"
    }
  ],
  "blocks": [
    {
      "type": "journey",
      "name": "Journey Story",
      "settings": [
        {
          "type": "image_picker",
          "id": "avatar",
          "label": "Rider avatar (optional)",
          "info": "Square image works best, 120x120px minimum"
        },
        {
          "type": "text",
          "id": "rider_name",
          "label": "Rider name",
          "default": "Kate Rawles"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "Environmental Advocate"
        },
        {
          "type": "text",
          "id": "journey_title",
          "label": "Journey title",
          "default": "Colombia to Tierra del Fuego"
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Woody turned out to be the most reliable bike I've ever owned. I had hardly any mechanical problems on the whole journey through the Andes."
        },
        {
          "type": "text",
          "id": "distance",
          "label": "Distance",
          "default": "8,288 miles",
          "info": "e.g., '8,288 miles' or '200km daily'"
        },
        {
          "type": "text",
          "id": "duration",
          "label": "Duration",
          "default": "6 months",
          "info": "e.g., '6 months' or '7+ years daily'"
        },
        {
          "type": "text",
          "id": "terrain",
          "label": "Terrain",
          "default": "Andes Mountains",
          "info": "e.g., 'Andes Mountains' or 'Urban commute'"
        },
        {
          "type": "text",
          "id": "years_riding",
          "label": "Years riding",
          "default": "8+ years",
          "info": "How long they've been riding their BBC bike"
        },
        {
          "type": "select",
          "id": "story_type",
          "label": "Story type",
          "options": [
            { "value": "adventure", "label": "Epic Adventure" },
            { "value": "daily", "label": "Daily Rider" },
            { "value": "challenge", "label": "Challenge" }
          ],
          "default": "adventure"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Epic Journeys",
      "blocks": [
        {
          "type": "journey",
          "settings": {
            "rider_name": "Kate Rawles",
            "location": "Environmental Advocate",
            "journey_title": "Colombia to Tierra del Fuego",
            "quote": "Woody turned out to be the most reliable bike I've ever owned. I had hardly any mechanical problems on the whole journey through the Andes.",
            "distance": "8,288 miles",
            "duration": "6 months",
            "terrain": "Andes Mountains",
            "years_riding": "8+ years",
            "story_type": "adventure"
          }
        },
        {
          "type": "journey",
          "settings": {
            "rider_name": "Jamie",
            "location": "Romania",
            "journey_title": "Daily Commute Champion",
            "quote": "Still riding mine daily after 7 years. Built it at home in Romania using the kit. It's outlasted two steel bikes I owned before.",
            "distance": "15km daily",
            "duration": "7+ years",
            "terrain": "City streets",
            "years_riding": "7+ years",
            "story_type": "daily"
          }
        },
        {
          "type": "journey",
          "settings": {
            "rider_name": "Adventure Rider",
            "location": "Central Asia",
            "journey_title": "Pamir Highway Winter",
