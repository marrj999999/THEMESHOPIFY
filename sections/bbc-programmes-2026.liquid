      <h2>{{ section.settings.cta_title }}</h2>
      {%- if section.settings.cta_lede != blank -%}<p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.cta_lede }}</p>{%- endif -%}
      <div class="rd-flex rd-mt3 rd-jc-center">
        <a class="rd-btn rd-lime" href="{{ contact_url }}">{{ section.settings.cta1_label | default: 'start a conversation' }} <span class="rd-arrow">&rarr;</span></a>
        <a class="rd-btn rd-on-dark" href="mailto:{{ enquiry_email }}">{{ section.settings.cta2_label | default: 'email us' }}</a>
      </div>
    </div>
  </section>


  {%- comment -%} Stories band — snippets/bbc-stories-band.liquid (2026-08-01). This section
