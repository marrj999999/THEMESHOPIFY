    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- THE INSTRUCTOR APP (2026-08-27, James: dashboard screenshots) ----------
     Screens are curriculum-delivery UI from the instructor app slide decks — run-of-day,
     safety checklist, evidence hand-in. NO learner data (lesson screens only; never
     screenshot live cohort views). {%- endcomment -%}
  {%- if section.settings.tools_title != blank -%}
  <section class="rd-pad" id="tools">
    <div class="rd-wrap">
      <span class="rd-eyebrow">{{ section.settings.tools_eyebrow }}</span>
      <h2 class="rd-mw-22ch">{{ section.settings.tools_title }}</h2>
      {%- if section.settings.tools_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.tools_lede }}</p>{%- endif -%}
      <div class="edt-tools rd-mt4">
        {%- for i in (1..3) -%}
          {%- assign _img = 'tools_img' | append: i -%}
          {%- assign _cap = 'tools_cap' | append: i -%}
          {%- if section.settings[_img] != blank -%}
          <figure class="edt-tool rd-reveal">
            <img src="{{ section.settings[_img] | image_url: width: 900 }}" alt="{{ section.settings[_cap] | escape }}" loading="lazy"
                 width="{{ section.settings[_img].width }}" height="{{ section.settings[_img].height }}">
            {%- if section.settings[_cap] != blank -%}<figcaption>{{ section.settings[_cap] }}</figcaption>{%- endif -%}
          </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}



  {%- comment -%} ---------- BUDGET GUIDE (grant framing) ---------- {%- endcomment -%}
  {%- if section.settings.budget_title != blank -%}
  <section class="rd-pad rd-paper">
    <div class="rd-wrap">
      {%- if section.settings.budget_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.budget_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-mw-22ch">{{ section.settings.budget_title }}</h2>
      {%- if section.settings.budget_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.budget_lede }}</p>{%- endif -%}
      <div class="rd-grid rd-g4 rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'budget' -%}
          <div class="rd-card rd-stamp" {{ block.shopify_attributes }}>
            <div class="rd-body">
              <div class="rd-num bbc-counted">{{ block.settings.figure }}</div>
              <p class="rd-statlbl rd-mt1">{{ block.settings.title }}</p>
              <p>{{ block.settings.body }}</p>
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- if section.settings.budget_note != blank -%}<p class="rd-ship-note rd-mt3">{{ section.settings.budget_note }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- SECURITY & COMPLIANCE ---------- {%- endcomment -%}
  {%- if section.settings.sec_title != blank -%}
  <section class="rd-pad">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.sec_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.sec_eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.sec_title }}</h2>
