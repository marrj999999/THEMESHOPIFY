  <section class="rd-pad rd-steel edu-band" id="outcomes">
    <div class="rd-wrap">
      <div class="rd-stations__head">
        <div>
          {%- if section.settings.out_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.out_eyebrow }}</span>{%- endif -%}
          <h2 class="rd-reveal rd-fs-stn">{{ section.settings.out_title }}</h2>
        </div>
        {%- if section.settings.out_lede != blank -%}<p class="rd-lede">{{ section.settings.out_lede }}</p>{%- endif -%}
      </div>
      <ul class="edo-grid" role="list">
        {%- for block in outcomes -%}
        <li class="edo rd-reveal" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.body }}</p></li>
        {%- endfor -%}
        {%- if section.settings.out_sum != blank -%}<li class="edo edo--sum rd-reveal"><h3>{{ section.settings.out_sum }}</h3>{%- if section.settings.out_sum_body != blank -%}<p>{{ section.settings.out_sum_body }}</p>{%- endif -%}</li>{%- endif -%}
      </ul>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- HOW COMMISSIONING WORKS (2026-08-27) ----------
     Stakeholder refocus (James): councils + education institutions. Steps mirror the
     REAL Camden commissioning thread (supplier setup, RA, safeguarding + photography
     agreed, SEND adjustments, surveys + report back) — practice claims only, no
     framework name-drops until James/Chris confirm (Gatsby/DfE Enrichment/YEF are in
     the workstream note as pending decisions). {%- endcomment -%}
  {%- if section.settings.hcw_title != blank -%}
  <section class="rd-pad-sm rd-paper" id="commissioning">
    <div class="rd-wrap">
      <span class="rd-eyebrow">{{ section.settings.hcw_eyebrow }}</span>
      <h2 class="rd-mw-22ch">{{ section.settings.hcw_title }}</h2>
      <ol class="rd-steps rd-mt4">
        <li><h3>{{ section.settings.hcw_s1_t }}</h3><p>{{ section.settings.hcw_s1_b }}</p></li>
        <li><h3>{{ section.settings.hcw_s2_t }}</h3><p>{{ section.settings.hcw_s2_b }}</p></li>
        <li><h3>{{ section.settings.hcw_s3_t }}</h3><p>{{ section.settings.hcw_s3_b }}</p></li>
