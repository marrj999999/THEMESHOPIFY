{%- comment -%}
  BBC New Design (2026) — PROGRAMMES page (/pages/programmes).
  THE EDUCATION PAGE (/pages/programmes, title "Education"). Audience: schools,
  colleges, councils and youth services. PRISONS REMOVED 2026-08-27 (James) —
  prison commissioning lives on /pages/build-to-bond and the impact page; home
  door_2 repointed there. The pri_*/step/budget/routes schema remains dormant.

  CONTENT POLICY (hard rules):
  - Prisons MAY be named. NEVER link a named/identifiable participant to a
    named prison. "Makers", never "prisoners"/"offenders".
  - Pricing = GRANT-BUDGET framing only (kit ~£180 · cohort ~£8,500 ·
    capex £7–10k · site-year ~£45k). No per-learner contract pricing.
  - OCN: two Level 2 courses (1130735, 1131207). No schools-award claim until OCN evidence is filed. 90%+ completion = BBC records only.
  - Every section ends in "start a conversation" → contact. Detail lives in the
    conversation, not a full advert.
{%- endcomment -%}

{%- liquid
  assign contact_url = section.settings.contact_url | default: '/pages/contact-us'
  assign enquiry_email = section.settings.enquiry_email | default: 'info@bamboobicycleclub.org'
-%}

<div class="bbc-rd bbc-rd-programmes">

  {%- comment -%} ---------- HERO (both arms) ----------
     FILM HERO added 2026-08-27 (James: "match the hero from other pages") — same
     hardened pattern as .wvh/.cvh: poster first, film starts on canplay, reveals on
     playing, pauses off-tab. Gates: prefers-reduced-motion + Save-Data honoured;
     NO phone gate (James 2026-08-24: films must play on mobile). Film default:
     bbc-rd-stopmotion-build.mp4 (20s frame-assembly stop-motion, no faces). {%- endcomment -%}
  <header class="rd-hero rd-mh-70 evh">
    <div class="rd-bg">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 1600 }} 1600w" sizes="100vw" alt="{{ section.settings.hero_image_alt | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high" loading="eager">
      {%- else -%}
        <img src="{{ section.settings.hero_fallback | default: 'bbc-rd-workshop.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | escape }}" width="1500" height="999" fetchpriority="high" loading="eager">
      {%- endif -%}
      {%- assign _evfilm = section.settings.evh_film_url -%}
      {%- if _evfilm == blank -%}{%- assign _evfilm = 'bbc-rd-stopmotion-build.mp4' | asset_url -%}{%- endif -%}
      {%- if section.settings.evh_film_on -%}
      <video class="evh-film" muted playsinline loop preload="metadata" poster="{{ section.settings.hero_fallback | default: 'bbc-rd-workshop.jpg' | asset_url }}" aria-hidden="true" tabindex="-1">
        <source src="{{ _evfilm }}" type="video/mp4">
      </video>
      {%- endif -%}
    </div>
    <div class="rd-scrim"></div>
    <div class="rd-inner">
      <div class="rd-wrap">
        <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><span class="rd-here">Education</span></nav>
        {%- if section.settings.hero_tb_a != blank or section.settings.hero_tb_b != blank -%}
          <div class="rd-tblock rd-tblock--hero" aria-hidden="true">
            <span class="k r">{{ section.settings.hero_tb_a_key | default: 'pathways' }}</span><span class="r">{{ section.settings.hero_tb_a }}</span>
            <span class="k">{{ section.settings.hero_tb_b_key | default: 'accredited' }}</span><span>{{ section.settings.hero_tb_b }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.hero_eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1 class="rd-mt2 rd-mw-18ch">{{ section.settings.hero_title }}</h1>
        <div class="rd-lede">{{ section.settings.hero_lede }}</div>
        {%- if section.settings.hero_proof_on != false -%}
        <ul class="rd-heroproof" aria-label="Education in numbers">
          <li><b>{{ section.settings.hero_proof1_num | default: '1,500+' }}</b><span>{{ section.settings.hero_proof1_label | default: 'students taught' }}</span></li>
          <li><b>{{ section.settings.hero_proof2_num | default: '22' }}</b><span>{{ section.settings.hero_proof2_label | default: 'schools, colleges & universities' }}</span></li>
          <li><b>{{ section.settings.hero_proof3_num | default: '2' }}</b><span>{{ section.settings.hero_proof3_label | default: 'OCN London Level 2 courses' }}</span></li>
        </ul>
        {%- endif -%}
        <div class="rd-cta-row">
          <a class="rd-btn rd-lime" href="{{ contact_url }}">{{ section.settings.hero_cta1_label | default: 'start a conversation' }} <span class="rd-arrow">&rarr;</span></a>
          <a class="rd-btn rd-on-dark" href="#schools">{{ section.settings.hero_cta2_label | default: 'for schools & colleges' }}</a>
          <a class="rd-btn rd-on-dark" href="#community">{{ section.settings.hero_cta3_label | default: 'for councils & youth services' }}</a>
        </div>
        {%- if section.settings.hero_quote != blank -%}
        <div class="rd-heroquote rd-mt3">
          <p class="rd-q">{{ section.settings.hero_quote }}</p>
          {%- if section.settings.hero_quote_cite != blank -%}<cite>{{ section.settings.hero_quote_cite }}</cite>{%- endif -%}
        </div>
        {%- endif -%}
      </div>
    </div>
  </header>
  <style>
    .evh .evh-film{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; opacity:0; transition:opacity .8s ease; }
    .evh .evh-film.evh-on{ opacity:1; }
    .evh .rd-bg img{ z-index:0; }
    @media (prefers-reduced-motion: reduce){ .evh .evh-film{ display:none; } }
    .bbc-rd-programmes .rd-hero h1,
    .bbc-rd-programmes .rd-hero .rd-lede,
    .bbc-rd-programmes .rd-hero .rd-heroproof,
    .bbc-rd-programmes .rd-hero .rd-cta-row,
    .bbc-rd-programmes .rd-hero .rd-heroquote,
    .bbc-rd-programmes .rd-hero .rd-crumb{ text-align:left !important; margin-left:0 !important; margin-right:0 !important; }
    .bbc-rd-programmes .rd-hero .rd-heroproof{ justify-content:flex-start !important; }
    .bbc-rd-programmes .rd-hero .rd-cta-row{ justify-content:flex-start !important; }
    .bbc-rd .rd-heroquote{ max-width:58ch; }
    .bbc-rd .rd-heroquote .rd-q{ font-size:clamp(14.5px,1.3vw,17px); line-height:1.55; margin:0 0 4px; opacity:.94; color:var(--bone,#E6DCC8); }
    .bbc-rd .rd-heroquote cite{ color:var(--bone,#E6DCC8); }
    .bbc-rd .rd-heroquote cite{ font-style:normal; font-size:11.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; opacity:.7; }
  
  .bbc-rd .edt-instgrp{ max-width:820px; margin-left:auto; margin-right:auto; }
  .bbc-rd .edt-instk{ display:block; font-size:11px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; opacity:.55; margin-bottom:6px; }
  .bbc-rd .edt-instnames{ font-size:15px; line-height:1.9; margin:0; }
</style>
  <script>
    (function () {
      var v = document.querySelector('.evh .evh-film');
      if (!v) return;
      if (navigator.connection && navigator.connection.saveData) { v.remove(); return; }
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.remove(); return; }
      v.muted = true; v.setAttribute('muted', '');
      var started = false;
      function go() {
        if (started) return; started = true;
        var p = v.play();
        if (p && p.catch) p.catch(function () { started = false; });
      }
      v.addEventListener('playing', function () { v.classList.add('evh-on'); });
      v.addEventListener('canplay', go);
      v.load();
      if (v.readyState >= 3) go();
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) { v.pause(); } else if (started) { v.play().catch(function(){}); }
      });
    })();
  </script>

  {%- comment -%} ---------- TWO PATHS (overview — the fork) ---------- {%- endcomment -%}
  <style>
    .edt-ic{ width:38px; height:38px; color:var(--forest,#003C32); display:block; margin:0 0 10px; }
    .edt-ic .edt-ic-a{ color:#7aa000; }
    .edt-media{ aspect-ratio:8/5; overflow:hidden; background:var(--forest-700,#002A23); }
    .edt-media img{ width:100%; height:100%; object-fit:cover; display:block; }
    .edt-tools{ display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    @media (max-width:860px){ .edt-tools{ grid-template-columns:1fr; } }
    .edt-tool{ border:2.5px solid var(--ink,#0E241E); border-radius:12px; overflow:hidden; background:#fff; }
    .edt-tool img{ width:100%; display:block; }
    .edt-tool figcaption{ padding:10px 14px; font-size:13.5px; font-weight:700; letter-spacing:.03em; }
  </style>
  {%- comment -%} ---------- FIVE WAYS IN (v3, 2026-09-02) — one device: the pathway ledger on a culm rail. Each
     row opens to its sheet (cohort, format, duration, pricing basis, build/tools/learning, progression, "seen in");
     01 carries the speaker-build film through bbc-media. Block type `pathway`. Copy gates: Claims Register — OCN
     courses by exact title only, no regulated-status wording; no ride, safety or conformity claims on the balance
     bike; no L1 wording. {%- endcomment -%}
  {%- assign pathways = section.blocks | where: 'type', 'pathway' -%}
  {%- if section.settings.pw_title != blank and pathways.size > 0 -%}
  <section class="rd-pad rd-paper rd-sheet rd-stations edp-stations" id="pathways">
    <div class="rd-wrap">
      <div class="rd-stations__head">
        <div>
          {%- if section.settings.pw_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.pw_eyebrow }}</span>{%- endif -%}
          <h2 class="rd-reveal rd-fs-stn">{{ section.settings.pw_title }}</h2>
        </div>
        {%- if section.settings.pw_lede != blank -%}<p class="rd-lede">{{ section.settings.pw_lede }}</p>{%- endif -%}
      </div>
      <div class="edp-ledger">
        <div class="edp-ledger__track" aria-hidden="true"></div>
        <div class="edp-ledger__culm" aria-hidden="true"></div>
        <ol class="edp-list" aria-label="Pathway details">
          {%- for block in pathways -%}
          {%- assign _num = block.settings.num -%}{%- if _num == blank -%}{%- assign _num = forloop.index | prepend: '0' | slice: -2, 2 -%}{%- endif -%}
          {%- assign _ia = block.settings.img_asset -%}
          <li {{ block.shopify_attributes }}>
            <details class="edp" id="pw-{{ forloop.index }}" name="pathway"{% if block.settings.open %} open{% endif %}>
              <summary class="edp__sum">
                <span class="edp__n">{{ _num }}</span>
                <span class="edp__thumb" aria-hidden="true">
                  {%- if block.settings.image != blank -%}<img src="{{ block.settings.image | image_url: width: 240 }}" alt="" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                  {%- elsif _ia contains '//' -%}<img src="{{ _ia }}{% if _ia contains '?' %}&amp;{% else %}?{% endif %}width=240" alt="" loading="lazy" width="240" height="180">
                  {%- elsif _ia != blank -%}<img src="{{ _ia | asset_url }}&amp;width=240" alt="" loading="lazy" width="240" height="180">
                  {%- elsif block.settings.youtube != blank -%}<img src="https://i.ytimg.com/vi/{{ block.settings.youtube }}/mqdefault.jpg" alt="" loading="lazy" width="320" height="180">{%- endif -%}
                </span>
                <h3 class="edp__t">{{ block.settings.title }}{%- if block.settings.tag != blank -%}<small>{{ block.settings.tag }}</small>{%- endif -%}</h3>
                <span class="edp__meta">{%- if block.settings.duration != blank -%}<span>{{ block.settings.duration }}</span>{%- endif -%}{%- if block.settings.cohort != blank -%}<span>{{ block.settings.cohort }}</span>{%- endif -%}{%- if block.settings.accred != blank -%}<span class="edp__chip--lime">{{ section.settings.pw_accred_chip | default: 'OCN Level 2' }}</span>{%- endif -%}<svg class="edp__caret" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
              </summary>
              <div class="edp__body">
                <div class="edp__side">
                {%- if block.settings.youtube != blank -%}
                <div class="edp__media edp__media--film">
                  {%- if block.settings.image != blank -%}
                    {%- render 'bbc-media', image: block.settings.image, youtube: block.settings.youtube, label: block.settings.film_label, alt: block.settings.image_alt, class: 'bbc-media--ar169', loading: 'lazy' -%}
                  {%- else -%}
                    {%- render 'bbc-media', src: _ia, youtube: block.settings.youtube, label: block.settings.film_label, alt: block.settings.image_alt, class: 'bbc-media--ar169', loading: 'lazy' -%}
                  {%- endif -%}
                </div>
                {%- else -%}
                <div class="edp__media">
                  {%- if block.settings.image != blank -%}
                    <img src="{{ block.settings.image | image_url: width: 900 }}" srcset="{{ block.settings.image | image_url: width: 500 }} 500w, {{ block.settings.image | image_url: width: 900 }} 900w" sizes="(max-width:989px) 92vw, 36vw" alt="{{ block.settings.image_alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                  {%- elsif _ia contains '//' -%}
                    <img src="{{ _ia }}{% if _ia contains '?' %}&amp;{% else %}?{% endif %}width=900" alt="{{ block.settings.image_alt | escape }}" loading="lazy" width="900" height="675">
                  {%- elsif _ia != blank -%}
                    <img src="{{ _ia | asset_url }}&amp;width=900" srcset="{{ _ia | asset_url }}&amp;width=500 500w, {{ _ia | asset_url }}&amp;width=900 900w" sizes="(max-width:989px) 92vw, 36vw" alt="{{ block.settings.image_alt | escape }}" loading="lazy" width="900" height="675">
                  {%- endif -%}
                  <span class="rd-path__ic">{%- render 'bbc-edu-pic', icon: block.settings.icon -%}</span>
                </div>
                {%- endif -%}
                  {%- if block.settings.seen_label != blank and block.settings.seen_url != blank -%}<p class="edp__seen"><span class="edp__seen-k">{{ section.settings.pw_seen_label | default: 'seen in' }}</span> <a href="{{ block.settings.seen_url }}">{{ block.settings.seen_label }} <span class="rd-arrow">&rarr;</span></a></p>{%- endif -%}
                  {%- if block.settings.tags != blank -%}
                  <ul class="edp__tags" aria-label="themes">{%- assign _tg = block.settings.tags | split: ',' -%}{%- for t in _tg -%}<li>{{ t | strip }}</li>{%- endfor -%}</ul>
                  {%- endif -%}
                </div>
                <div class="edp__txt">
                  {%- if block.settings.lede != blank -%}<p class="edp__lede">{{ block.settings.lede }}</p>{%- endif -%}
                  {%- if block.settings.body != blank -%}<p class="edp__copy">{{ block.settings.body }}</p>{%- endif -%}
                  <dl class="edp__facts">
                    {%- if block.settings.cohort != blank -%}<div><dt>cohort</dt><dd>{{ block.settings.cohort }}</dd></div>{%- endif -%}
                    {%- if block.settings.format != blank -%}<div><dt>format</dt><dd>{{ block.settings.format }}</dd></div>{%- endif -%}
                    {%- if block.settings.duration != blank -%}<div><dt>duration</dt><dd>{{ block.settings.duration }}</dd></div>{%- endif -%}
                    {%- if block.settings.pricing != blank -%}<div><dt>pricing</dt><dd>{{ block.settings.pricing }}</dd></div>{%- endif -%}
                    {%- if block.settings.accred != blank -%}<div class="edp__wide"><dt>accreditation</dt><dd>{{ block.settings.accred }}</dd></div>{%- endif -%}
                  </dl>
                  {%- if block.settings.s1k != blank or block.settings.s2k != blank or block.settings.s3k != blank -%}
                  <table class="edp__spec"><tbody>
                    {%- if block.settings.s1k != blank -%}<tr><th scope="row">{{ block.settings.s1k }}</th><td>{{ block.settings.s1v }}</td></tr>{%- endif -%}
                    {%- if block.settings.s2k != blank -%}<tr><th scope="row">{{ block.settings.s2k }}</th><td>{{ block.settings.s2v }}</td></tr>{%- endif -%}
                    {%- if block.settings.s3k != blank -%}<tr><th scope="row">{{ block.settings.s3k }}</th><td>{{ block.settings.s3v }}</td></tr>{%- endif -%}
                  </tbody></table>
                  {%- endif -%}
                  {%- if block.settings.progression != blank -%}<p class="edp__prog"><b>{{ section.settings.pw_prog_label | default: 'progression' }}</b> &mdash; {{ block.settings.progression }}</p>{%- endif -%}
                </div>
              </div>
            </details>
          </li>
          {%- endfor -%}
        </ol>
      </div>
      <div class="rd-flex rd-between rd-mt4 rd-gap-24 edp-foot">
        {%- if section.settings.pw_note != blank -%}<p class="rd-stations__note edp-foot__note">{{ section.settings.pw_note }}</p>{%- endif -%}
        <a class="rd-btn rd-lime" href="{{ contact_url }}">{{ section.settings.pw_cta_label | default: 'book a discovery call' }} <span class="rd-arrow">&rarr;</span></a>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- FACTS STRIP (shared proof) ----------
    Moved below TWO PATHS (was directly under the hero). Hero and facts strip are both dark, so
    the page opened with two dark bands run together — PAGE-STANDARD S3. Impact's order is
    hero -> light band -> dark stats, and that light band is what lets the stat band stay dark,
    which is what keeps the figures lime. Reordered, not recoloured: no content changed.
    (2026-08-04)
  {%- endcomment -%}
  <section class="rd-pad-sm rd-dark rd-band--stats">
    <div class="rd-wrap">
      {%- if section.settings.ghost_stat != blank -%}<span class="rd-ghostnum" aria-hidden="true">{{ section.settings.ghost_stat }}</span>{%- endif -%}
      {%- if section.settings.stats_label != blank -%}<span class="rd-eyebrow">{{ section.settings.stats_label }}</span>{%- endif -%}
      <div class="rd-stats">
        {%- for block in section.blocks -%}{%- if block.type == 'fact' -%}
          <div class="rd-reveal rd-stat" {{ block.shopify_attributes }}>
            <div class="rd-num bbc-counted">{{ block.settings.number }}</div>
            <div class="rd-lbl">{{ block.settings.label }}</div>
            {%- if block.settings.source != blank -%}<div class="rd-src">{{ block.settings.source }}</div>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- if section.settings.facts_note != blank -%}<p class="rd-dataasof rd-on-dark">{{ section.settings.facts_note }}</p>{%- endif -%}
      {%- if section.settings.facts_cta_label != blank -%}<div class="rd-mt3"><a class="rd-btn rd-on-dark" href="{{ section.settings.facts_cta_url | default: '#institutions' }}">{{ section.settings.facts_cta_label }} <span class="rd-arrow">&rarr;</span></a></div>{%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- CASE STUDIES (v3, 2026-09-02) — real deliveries from the blog, each card with the
     article's OWN featured image (same device as Build to Bond). cs_handles = one "blog/handle | kind | youtubeId"
     per line, editorial order, first featured. Only stories whose featured image is their own photograph. {%- endcomment -%}
  {%- if section.settings.cs_handles != blank -%}
  {%- assign cs_lines = section.settings.cs_handles | newline_to_br | split: '<br />' -%}
  <section class="rd-pad rd-edu-cs" id="stories">
    <div class="rd-wrap">
      <div class="rd-stations__head">
        <div>
          {%- if section.settings.cs_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.cs_eyebrow }}</span>{%- endif -%}
          <h2 class="rd-reveal rd-fs-stn">{{ section.settings.cs_title | default: 'the same bench, in very different rooms.' }}</h2>
        </div>
        {%- if section.settings.cs_lede != blank -%}<p class="rd-lede">{{ section.settings.cs_lede }}</p>{%- endif -%}
      </div>
      <ul class="rd-csgrid rd-mt4" role="list">
        {%- for line in cs_lines -%}
          {%- assign raw = line | strip -%}{%- if raw == blank -%}{%- continue -%}{%- endif -%}
          {%- assign parts = raw | split: '|' -%}
          {%- assign key = parts[0] | strip -%}
          {%- assign _kind = parts[1] | strip -%}{%- if _kind == blank -%}{%- assign _kind = section.settings.cs_kind -%}{%- endif -%}
          {%- assign _yt = parts[2] | strip -%}
          {%- assign _out = parts[3] | strip -%}
          {%- assign _attr = parts[4] | strip -%}
          {%- assign article = articles[key] -%}
          {%- if article == blank or article.title == blank -%}{%- continue -%}{%- endif -%}
          {%- assign _v = 'grid' -%}{%- if forloop.first and section.settings.cs_first_featured -%}{%- assign _v = 'featured' -%}{%- endif -%}
          {%- assign _date = article.published_at | date: '%B %Y' -%}
          {%- if _attr != blank -%}{%- assign _date = _attr -%}{%- endif -%}
          {%- assign _ctx = article.excerpt_or_content | replace: '</p>', '. ' | replace: '<br>', ' ' | strip_html | replace: '..', '.' | truncatewords: 28 -%}
          {%- if _out != blank -%}{%- assign _ctx = _out -%}{%- endif -%}
          {%- render 'bbc-cscard', variant: _v, kind: _kind, heading: article.title, url: article.url, context: _ctx, attr: _date, image_pic: article.image, youtube: _yt, cta: section.settings.cs_link_label -%}
        {%- endfor -%}
      </ul>
      {% render 'bbc-video-lightbox' %}
      {%- if section.settings.cs_all_label != blank -%}<div class="rd-mt4"><a class="rd-btn rd-ghost" href="{{ section.settings.cs_all_url | default: '/blogs/schools-and-education' }}">{{ section.settings.cs_all_label }} <span class="rd-arrow">&rarr;</span></a></div>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- FOR SCHOOLS (v3) — the timetable (deck slide 11) beside the four things teachers ask
     first, and the Head of Design's line. Blocks `ttrow` + `sstep`. {%- endcomment -%}
  {%- assign ttrows = section.blocks | where: 'type', 'ttrow' -%}
  {%- assign ssteps = section.blocks | where: 'type', 'sstep' -%}
  {%- if section.settings.sch_title != blank -%}
  <section id="schools" class="rd-pad rd-paper edu-band">
    <div class="rd-wrap">
      {%- if section.settings.sch_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.sch_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal rd-fs-stn">{{ section.settings.sch_title }}</h2>
      {%- if section.settings.sch_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.sch_lede }}</p>{%- endif -%}
      <div class="eds-grid">
        <div>
          {%- if ttrows.size > 0 -%}
          {%- assign _h1 = section.settings.tt_h1 | default: 'school format' -%}{%- assign _h2 = section.settings.tt_h2 | default: 'typical time' -%}{%- assign _h3 = section.settings.tt_h3 | default: 'typical use' -%}{%- assign _h4 = section.settings.tt_h4 | default: 'best suited pathway' -%}
          <table class="edt-tt">
            <thead><tr><th scope="col">{{ _h1 }}</th><th scope="col">{{ _h2 }}</th><th scope="col">{{ _h3 }}</th><th scope="col">{{ _h4 }}</th></tr></thead>
            <tbody>
              {%- for block in ttrows -%}
              <tr {{ block.shopify_attributes }}><td data-k="{{ _h1 | escape }}">{{ block.settings.format }}</td><td data-k="{{ _h2 | escape }}">{{ block.settings.time }}</td><td data-k="{{ _h3 | escape }}">{{ block.settings.use }}</td><td data-k="{{ _h4 | escape }}">{{ block.settings.best }}</td></tr>
              {%- endfor -%}
            </tbody>
          </table>
          {%- endif -%}
          {%- if section.settings.tt_foot != blank -%}<p class="edt-tt__foot">{{ section.settings.tt_foot }}</p>{%- endif -%}
          {%- if section.settings.sch_quote != blank -%}
          <blockquote class="eds-quote"><p>{{ section.settings.sch_quote }}</p>{%- if section.settings.sch_quote_cite != blank -%}<cite>{{ section.settings.sch_quote_cite }}</cite>{%- endif -%}</blockquote>
          {%- endif -%}
        </div>
        <div>
          {%- if ssteps.size > 0 -%}
          <ol class="eds-facts">
            {%- for block in ssteps -%}
            <li {{ block.shopify_attributes }}><span class="edp__n">{{ forloop.index }}</span><div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.body }}</p></div></li>
            {%- endfor -%}
          </ol>
          {%- endif -%}
          <div class="rd-cta-row rd-mt3"><a class="rd-btn rd-lime" href="{{ contact_url }}?subject=schools">{{ section.settings.sch_cta_label | default: 'book a discovery call' }} <span class="rd-arrow">&rarr;</span></a></div>
        </div>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- WHY BAMBOO (v3) — the material as a FILM: a frame under load in a university test rig
     (bbc-whybamboo-film, 42 s), native player; three lines and the range chips beside it. No carbon figure. {%- endcomment -%}
  {%- if section.settings.mat_title != blank -%}
  <section class="rd-pad rd-dark edu-band" id="material">
    <div class="rd-wrap edf-grid">
      {%- assign film = section.settings.mat_film -%}
      {%- if film != blank or section.settings.mat_film_url != blank -%}
      <div class="edf-film">
        {%- if section.settings.mat_film_label != blank -%}<span class="b2b-film__ticket">{{ section.settings.mat_film_label }}</span>{%- endif -%}
        {%- if film != blank -%}
        <video controls playsinline preload="metadata" poster="{{ film.preview_image | image_url: width: 1200 }}" aria-label="{{ section.settings.mat_film_alt | escape }}">
          {%- for src in film.sources -%}{%- if src.format == 'mp4' and src.height >= 720 -%}<source src="{{ src.url }}" type="{{ src.mime_type }}">{%- endif -%}{%- endfor -%}
          {%- for src in film.sources -%}{%- if src.format == 'mp4' and src.height < 720 -%}<source src="{{ src.url }}" type="{{ src.mime_type }}">{%- endif -%}{%- endfor -%}
        </video>
        {%- else -%}
        <video controls playsinline preload="metadata"{% if section.settings.mat_film_poster != blank %} poster="{{ section.settings.mat_film_poster | asset_url }}"{% endif %} aria-label="{{ section.settings.mat_film_alt | escape }}"><source src="{{ section.settings.mat_film_url }}" type="video/mp4"></video>
        {%- endif -%}
      </div>
      {%- endif -%}
      <div>
        {%- if section.settings.mat_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.mat_eyebrow }}</span>{%- endif -%}
        <h2 class="rd-reveal rd-fs-stn">{{ section.settings.mat_title }}</h2>
        {%- if section.settings.mat_lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.mat_lede }}</p>{%- endif -%}
        <ul class="edf-list">
          {%- for i in (1..3) -%}
            {%- assign _t = 'mat' | append: i | append: '_t' -%}{%- assign _b = 'mat' | append: i | append: '_b' -%}{%- assign _i = 'mat' | append: i | append: '_icon' -%}
            {%- if section.settings[_t] != blank -%}
            <li>{%- render 'bbc-edu-pic', icon: section.settings[_i] -%}<p><b>{{ section.settings[_t] }}</b> &mdash; {{ section.settings[_b] }}</p></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if section.settings.mat_range != blank -%}
        <ul class="edf-range">
          <li class="edf-range__k">{{ section.settings.mat_range_label | default: 'one frame, many entry points' }}</li>
          {%- assign _rng = section.settings.mat_range | split: ',' -%}{%- for r in _rng -%}<li>{{ r | strip }}</li>{%- endfor -%}
        </ul>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ========== COUNCILS & YOUTH SERVICES (v3) — photo + proof; the five pathways are the single spine
     above, so no ladder here. Camden is a PILOT — Register wording only. {%- endcomment -%}
  {%- if section.settings.com_title != blank -%}
  <section id="community" class="rd-pad edu-band">
    <div class="rd-wrap edc-grid">
      {%- if section.settings.com_image != blank or section.settings.com_img_asset != blank -%}
      <div class="edc-photo">
        {%- if section.settings.com_image != blank -%}
          <img src="{{ section.settings.com_image | image_url: width: 900 }}" srcset="{{ section.settings.com_image | image_url: width: 500 }} 500w, {{ section.settings.com_image | image_url: width: 900 }} 900w" sizes="(max-width:989px) 92vw, 36vw" alt="{{ section.settings.com_image_alt | escape }}" loading="lazy" width="{{ section.settings.com_image.width }}" height="{{ section.settings.com_image.height }}">
        {%- else -%}
          <img src="{{ section.settings.com_img_asset | asset_url }}&amp;width=900" alt="{{ section.settings.com_image_alt | escape }}" loading="lazy" width="900" height="1125">
        {%- endif -%}
      </div>
      {%- endif -%}
      <div>
        {%- if section.settings.com_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.com_eyebrow }}</span>{%- endif -%}
        <h2 class="rd-reveal rd-fs-stn">{{ section.settings.com_title }}</h2>
        {%- if section.settings.com_lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.com_lede }}</p>{%- endif -%}
        {%- if section.settings.com_audiences != blank -%}
          <ul class="cml-aud rd-mt3" role="list">
            {%- assign _auds = section.settings.com_audiences | split: ',' -%}
            {%- for a in _auds -%}<li>{{ a | strip }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
        {%- if section.settings.com_proof != blank -%}
          <p class="edc-proof">{{ section.settings.com_proof }}
            {%- if section.settings.com_proof_label != blank and section.settings.com_proof_url != blank %} <a href="{{ section.settings.com_proof_url }}">{{ section.settings.com_proof_label }} <span class="rd-arrow">&rarr;</span></a>{% endif -%}
          </p>
        {%- endif -%}
        <div class="rd-cta-row rd-mt3">
          <a class="rd-btn rd-ghost" href="{{ contact_url }}?subject=community">{{ section.settings.com_cta_label | default: 'start a conversation' }} <span class="rd-arrow">&rarr;</span></a>
        </div>
      </div>
    </div>
  </section>
  <style>
    /* Community culm ladder — self-owned .cml-* classes (estate cascade lesson) */
    .cml-aud{ list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:8px; }
    .cml-aud li{ font-size:12.5px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:var(--forest,#003C32); background:rgba(0,60,50,.08); border:1.5px solid rgba(0,60,50,.25); border-radius:999px; padding:5px 12px; }
    .cml-ladder{ list-style:none; margin:0; padding:0 0 0 46px; position:relative; }
    .cml-ladder::before{ content:""; position:absolute; left:13px; top:8px; bottom:8px; width:4px; border-radius:2px;
      background:repeating-linear-gradient(to bottom, var(--forest,#003C32) 0 16px, rgba(0,60,50,.16) 16px 22px); }
    .cml-rung{ position:relative; padding:0 0 26px; }
    .cml-rung:last-child{ padding-bottom:0; }
    .cml-n{ position:absolute; left:-46px; top:0; width:30px; height:30px; border-radius:50%; background:var(--lime,#D4FD62); color:var(--forest,#003C32); font-weight:800; font-size:13px; display:flex; align-items:center; justify-content:center; box-shadow:0 0 0 3px rgba(0,60,50,.9); }
    .cml-t{ margin:2px 0 2px; font-size:20px; line-height:1.2; }
    .cml-tag{ display:inline-block; font-size:12px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--forest,#003C32); opacity:.65; margin:0 0 6px; }
    .cml-b{ margin:4px 0 0; font-size:15.5px; line-height:1.55; max-width:52ch; }
    .cml-dev .cml-card{ opacity:.62; }
    .cml-dev .cml-n{ background:transparent; color:var(--forest,#003C32); border:2px dashed var(--forest,#003C32); box-shadow:none; }
    .cml-devtag{ font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--forest,#003C32); background:rgba(0,60,50,.1); border-radius:999px; padding:3px 9px; vertical-align:middle; margin-left:6px; }
    .cml-ic{ width:40px; height:40px; color:var(--forest,#003C32); display:block; margin:0 0 8px; }
    .cml-ic .cml-ic-a{ color:inherit; }
    .cml-rung:not(.cml-dev) .cml-ic .cml-ic-a{ color:#7aa000; }
    .cml-proofcard{ display:flex; gap:18px; align-items:center; max-width:760px; background:rgba(0,60,50,.06); border-radius:14px; padding:14px; }
    .cml-proofimg{ width:190px; aspect-ratio:4/3; object-fit:cover; border-radius:10px; flex:none; }
    .cml-proof{ font-size:15.5px; max-width:64ch; border-left:4px solid var(--lime,#D4FD62); padding-left:14px; margin:0; }
    .cml-proof a{ font-weight:700; white-space:nowrap; }
    @media (max-width:600px){ .cml-proofcard{ flex-direction:column; align-items:stretch; } .cml-proofimg{ width:100%; } }
    @media (min-width:900px){
      /* rising staircase: cards share a baseline, each rung starts higher */
      .cml-ladder{ display:grid; grid-template-columns:repeat(5,1fr); gap:14px; padding:0; align-items:start; }
      .cml-ladder::before{ content:none; }
      .cml-rung{ padding:0; display:flex; flex-direction:column; height:100%; }
      .cml-rung:nth-child(1){ margin-top:120px; } .cml-rung:nth-child(2){ margin-top:90px; }
      .cml-rung:nth-child(3){ margin-top:60px; } .cml-rung:nth-child(4){ margin-top:30px; }
      .cml-rung:nth-child(5){ margin-top:0; }
      .cml-n{ position:static; margin-bottom:10px; }
      .cml-card{ border-top:3px solid var(--forest,#003C32); padding-top:10px; flex:1; }
      .cml-dev .cml-card{ border-top-style:dashed; }
      .cml-t{ font-size:19px; }
      .cml-b{ font-size:14.5px; }
    }
    @media (min-width:900px) and (max-width:1100px){ .cml-ladder{ grid-template-columns:repeat(5,1fr); gap:10px; } .cml-t{ font-size:17px; } }
  </style>
  {%- endif -%}

  {%- comment -%} ---------- OUTCOMES (2026-09-02, deck slide 12) — "one vehicle, five outcomes".
     Block type `outcome`. Copy gates: Claims Register — no unevidenced framework or scheme claims. {%- endcomment -%}
  {%- assign outcomes = section.blocks | where: 'type', 'outcome' -%}
