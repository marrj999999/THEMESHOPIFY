{%- comment -%}
  BBC New Design (2026) — PROGRAMMES page (/pages/programmes).
  Consolidates schools (Make Engineers) + prisons (Build to Bond) into ONE
  lead-gen page: lean up top, drives to contact; commissioner DEPTH kept on
  demand (delivery model, budget, security, routes). Replaces the standalone
  schools + prisons + build-to-bond pages. Impact-quality, reuses rd- system.

  CONTENT POLICY (hard rules):
  - Prisons MAY be named. NEVER link a named/identifiable participant to a
    named prison. "Makers", never "prisoners"/"offenders".
  - Pricing = GRANT-BUDGET framing only (kit ~£180 · cohort ~£8,500 ·
    capex £7–10k · site-year ~£45k). No per-learner contract pricing.
  - OCN: schools = Level 1, prisons = Level 2. 90% completion = BBC records only.
  - Every section ends in "start a conversation" → contact. Detail lives in the
    conversation, not a full advert.
{%- endcomment -%}

{%- liquid
  assign contact_url = section.settings.contact_url | default: '/pages/contact-us'
  assign enquiry_email = section.settings.enquiry_email | default: 'info@bamboobicycleclub.org'
-%}

<div class="bbc-rd bbc-rd-programmes">

  {%- comment -%} ---------- HERO (both arms) ---------- {%- endcomment -%}
  <header class="rd-hero rd-mh-70">
    <div class="rd-bg">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 1600 }} 1600w" sizes="100vw" alt="{{ section.settings.hero_image_alt | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high" loading="eager">
      {%- else -%}
        <img src="{{ section.settings.hero_fallback | default: 'bbc-rd-workshop.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | escape }}" width="1500" height="999" fetchpriority="high" loading="eager">
      {%- endif -%}
    </div>
    <div class="rd-scrim"></div>
    <div class="rd-inner">
      <div class="rd-wrap">
        <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><span class="rd-here">Programmes</span></nav>
        {%- if section.settings.hero_eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1 class="rd-mt2 rd-mw-18ch">{{ section.settings.hero_title }}</h1>
        <div class="rd-lede">{{ section.settings.hero_lede }}</div>
        <div class="rd-cta-row">
          <a class="rd-btn rd-lime" href="{{ contact_url }}">{{ section.settings.hero_cta1_label | default: 'start a conversation' }} <span class="rd-arrow">&rarr;</span></a>
          <a class="rd-btn rd-on-dark" href="#schools">{{ section.settings.hero_cta2_label | default: 'for schools' }}</a>
          <a class="rd-btn rd-on-dark" href="#prisons">{{ section.settings.hero_cta3_label | default: 'for prisons' }}</a>
        </div>
      </div>
    </div>
  </header>

  {%- comment -%} ---------- FACTS STRIP (shared proof) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-dark">
    <div class="rd-wrap">
      <div class="rd-facts">
        {%- for block in section.blocks -%}{%- if block.type == 'fact' -%}
          <div class="rd-fact" {{ block.shopify_attributes }}><span class="rd-fact-n bbc-counted">{{ block.settings.number }}</span><span class="rd-fact-l">{{ block.settings.label }}</span></div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- TWO PATHS (overview — the fork) ---------- {%- endcomment -%}
  <section class="rd-pad rd-paper">
    <div class="rd-wrap">
      <div class="rd-center">
        {%- if section.settings.paths_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.paths_eyebrow }}</span>{%- endif -%}
        <h2 class="rd-mw-22ch rd-mx-auto">{{ section.settings.paths_title }}</h2>
        {%- if section.settings.paths_lede != blank -%}<p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.paths_lede }}</p>{%- endif -%}
      </div>
      <div class="rd-grid rd-g2 rd-mt4">
        <a class="rd-card rd-stamp rd-cardlink" href="#schools">
          <div class="rd-body">
            <span class="rd-tag rd-lime">{{ section.settings.sch_tag | default: 'in schools · ages 11–19' }}</span>
            <h3 class="rd-mt2 rd-fs-21px">{{ section.settings.sch_card_title | default: 'real engineering' }}</h3>
            <p>{{ section.settings.sch_card_body | default: "A free bamboo-speaker STEM build for schools and colleges — OCN Level 1 when you build up. Teachers run it; no engineering background needed." }}</p>
            <span class="rd-arrow-link">for schools <span class="rd-arrow">&rarr;</span></span>
          </div>
        </a>
        <a class="rd-card rd-stamp rd-cardlink" href="#prisons">
          <div class="rd-body">
            <span class="rd-tag rd-lime">{{ section.settings.pri_tag | default: 'in prisons · accredited' }}</span>
            <h3 class="rd-mt2 rd-fs-21px">{{ section.settings.pri_card_title | default: 'vocational skills' }}</h3>
            <p>{{ section.settings.pri_card_body | default: "An OCN Level 2 accredited course you run in your own workshop — we set up and train your staff, no ongoing fees. Ends on family visit day." }}</p>
            <span class="rd-arrow-link">for prisons &amp; commissioners <span class="rd-arrow">&rarr;</span></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} ========== SCHOOLS ARM ========== {%- endcomment -%}
  <section id="schools" class="rd-pad">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.sch_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.sch_eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.sch_title }}</h2>
      {%- if section.settings.sch_lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.sch_lede }}</p>{%- endif -%}
      {%- assign ssteps = section.blocks | where: 'type', 'sstep' -%}
      {%- if ssteps.size > 0 -%}
      <ol class="rd-steps rd-mt4">
        {%- for block in ssteps -%}
          <li {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.body }}</p></li>
        {%- endfor -%}
      </ol>
      {%- endif -%}
      <div class="rd-cta-row rd-mt4">
        <a class="rd-btn rd-ghost" href="{{ contact_url }}?subject=schools">{{ section.settings.sch_cta_label | default: 'enquire for your school' }} <span class="rd-arrow">&rarr;</span></a>
      </div>
    </div>
  </section>

  {%- comment -%} ========== PRISONS ARM (commissioner depth) ========== {%- endcomment -%}
  <section id="prisons" class="rd-pad rd-dark">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.pri_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.pri_eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.pri_title }}</h2>
      {%- if section.settings.pri_lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.pri_lede }}</p>{%- endif -%}
      <ol class="rd-steps rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'step' -%}
          <li {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.body }}</p></li>
        {%- endif -%}{%- endfor -%}
      </ol>
    </div>
  </section>

  {%- comment -%} ---------- BUDGET GUIDE (grant framing) ---------- {%- endcomment -%}
  {%- if section.settings.budget_title != blank -%}
  <section class="rd-pad rd-paper">
    <div class="rd-wrap">
      {%- if section.settings.budget_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.budget_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-mw-22ch">{{ section.settings.budget_title }}</h2>
      {%- if section.settings.budget_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.budget_lede }}</p>{%- endif -%}
      <div class="rd-grid rd-g4 rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'budget' -%}
          <div class="rd-card rd-stamp" {{ block.shopify_attributes }}>
            <div class="rd-body">
              <div class="rd-num bbc-counted">{{ block.settings.figure }}</div>
              <p class="rd-statlbl rd-mt1">{{ block.settings.title }}</p>
              <p>{{ block.settings.body }}</p>
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- if section.settings.budget_note != blank -%}<p class="rd-ship-note rd-mt3">{{ section.settings.budget_note }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- SECURITY & COMPLIANCE ---------- {%- endcomment -%}
  {%- if section.settings.sec_title != blank -%}
  <section class="rd-pad">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.sec_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.sec_eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.sec_title }}</h2>
      {%- if section.settings.sec_lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.sec_lede }}</p>{%- endif -%}
      <ul class="rd-list rd-mt3">
        {%- for block in section.blocks -%}{%- if block.type == 'check' -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endif -%}{%- endfor -%}
      </ul>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- ROUTES TO COMMISSION ---------- {%- endcomment -%}
  {%- if section.settings.routes_title != blank -%}
  <section class="rd-pad rd-steel">
    <div class="rd-wrap">
      <div class="rd-center">
        {%- if section.settings.routes_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.routes_eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.routes_title }}</h2>
        {%- if section.settings.routes_lede != blank -%}<p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.routes_lede }}</p>{%- endif -%}
      </div>
      <div class="rd-grid rd-g3 rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'route' -%}
          <div class="rd-card rd-stamp" {{ block.shopify_attributes }}>
            <div class="rd-body">
              {%- if block.settings.tag != blank -%}<span class="rd-tag rd-lime">{{ block.settings.tag }}</span>{%- endif -%}
              <h3 class="rd-mt2 rd-fs-21px">{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- CREDIBILITY (quote + sites + logos) ---------- {%- endcomment -%}
  {%- if section.settings.cred_quote != blank -%}
  <section class="rd-pad-sm rd-paper rd-center">
    <div class="rd-wrap rd-mw-680px">
      <div class="rd-pull rd-mx-auto">
        <p class="rd-q">{{ section.settings.cred_quote }}</p>
        {%- if section.settings.cred_cite != blank -%}<cite>{{ section.settings.cred_cite }}</cite>{%- endif -%}
      </div>
      {%- if section.settings.sites_list != blank -%}<div class="rd-sitenames rd-mt4">{{ section.settings.sites_list }}</div>{%- endif -%}
      {%- if section.settings.funder_logo != blank or section.settings.accred_logo != blank -%}<div class="rd-mt3 rd-flex rd-jc-center" style="gap:32px;align-items:center;">{%- if section.settings.funder_logo != blank -%}<img src="{{ section.settings.funder_logo | asset_url }}" alt="{{ section.settings.funder_logo_alt | escape }}" loading="lazy" style="height:56px !important;width:auto !important;max-width:220px;object-fit:contain;">{%- endif -%}{%- if section.settings.accred_logo != blank -%}<img src="{{ section.settings.accred_logo | asset_url }}" alt="{{ section.settings.accred_logo_alt | escape }}" loading="lazy" style="height:48px !important;width:auto !important;max-width:180px;object-fit:contain;">{%- endif -%}</div>{%- endif -%}
      {%- if section.settings.funder_line != blank -%}<p class="rd-ship-note rd-mt1">{{ section.settings.funder_line }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- ENQUIRY CTA (dark, centred) ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-680px">
      {%- if section.settings.cta_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.cta_eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.cta_title }}</h2>
      {%- if section.settings.cta_lede != blank -%}<p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.cta_lede }}</p>{%- endif -%}
      <div class="rd-flex rd-mt3 rd-jc-center">
        <a class="rd-btn rd-lime" href="{{ contact_url }}">{{ section.settings.cta1_label | default: 'start a conversation' }} <span class="rd-arrow">&rarr;</span></a>
        <a class="rd-btn rd-on-dark" href="mailto:{{ enquiry_email }}">{{ section.settings.cta2_label | default: 'email us' }}</a>
      </div>
    </div>
  </section>


  {%- comment -%} Stories band — snippets/bbc-stories-band.liquid (2026-08-01). This section
     had no `story` block type, which is why the page carried zero case-study cards. {%- endcomment -%}
  {%- render 'bbc-stories-band', section: section -%}
</div>

{% schema %}
