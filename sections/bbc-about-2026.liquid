{%- comment -%}
  BBC New Design (2026) — "Our Story / About" page. Single self-contained section.
  Built from the Claude Design handoff (about.html) and scoped under
  .bbc-rd / .bbc-rd-about via bbc-redesign-2026.css so it cannot affect other
  sections. Real BBC content (milestones, founder voice, model, recognition)
  folded in from the existing theme sections + page.our-story-2.json.

  Content policy (hard rules):
    - No prison is ever named — generic descriptors only.
    - Only source-of-truth figures are hardcoded as defaults
      (4,000+ since 2012 · 90% prison course completion · £11.41 SROI per £1 (PACT)
       · 36 countries · frame kits from £375 · Bamboo Mobility Project CIC, Reg 16257348).
    - Image fields fall back to bundled bbc-rd-*.jpg assets until real photos are set.

  Structure: full-bleed hero → mission intro → "13 years, one through-line"
  timeline → "a shop and a mission, one engine" model split → three values
  cards → recognition (press logos) → final CTA. Every string/image/link/row
  is editable via {% schema %}.
{%- endcomment -%}


{%- liquid
  assign crumb_home = section.settings.crumb_home_url | default: '/'
  assign cta1 = section.settings.cta1_url | default: '/pages/bicycle-frame-building-workshop'
  assign cta2 = section.settings.cta2_url | default: '/pages/impact'
-%}

<div class="bbc-rd bbc-rd-about">

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  <header class="rd-hero">
    <div class="rd-bg">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 1600 }} 1600w, {{ section.settings.hero_image | image_url: width: 2000 }} 2000w, {{ section.settings.hero_image | image_url: width: 2600 }} 2600w" sizes="100vw" alt="{{ section.settings.hero_image_alt | default: 'The Bamboo Bicycle Club workshop and community' | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high" loading="eager">
      {%- else -%}
        <img src="{{ section.settings.hero_fallback | default: 'bbc-rd-cohort.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | default: 'The Bamboo Bicycle Club workshop and community' | escape }}" width="1200" height="800" fetchpriority="high" loading="eager">
      {%- endif -%}
    </div>
    <div class="rd-scrim"></div>
    <div class="rd-inner">
      <div class="rd-wrap">
        <nav class="rd-crumb">
          <a href="{{ crumb_home }}">{{ section.settings.crumb_home_label | default: 'Home' }}</a>
          <span class="rd-sep">/</span>
          <span class="rd-here">{{ section.settings.crumb_here | default: 'Our Story' }}</span>
        </nav>
        {%- if section.settings.hero_eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1 class="rd-mt2 rd-mw-18ch">{{ section.settings.hero_title }}</h1>
        {%- if section.settings.hero_lede != blank -%}<p class="rd-lede">{{ section.settings.hero_lede }}</p>{%- endif -%}
      </div>
    </div>
  </header>

  {%- comment -%} ---------- MISSION INTRO ---------- {%- endcomment -%}
  <section class="rd-pad">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.intro_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.intro_eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.intro_title }}</h2>
      {%- if section.settings.intro_body_1 != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.intro_body_1 }}</p>{%- endif -%}
      {%- if section.settings.intro_body_2 != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.intro_body_2 }}</p>{%- endif -%}
      {%- if section.settings.intro_quote != blank -%}
        <div class="rd-pull rd-mt4">
          <p class="rd-q">{{ section.settings.intro_quote }}</p>
          {%- if section.settings.intro_cite != blank -%}<cite>{{ section.settings.intro_cite }}</cite>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- TIMELINE ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark">
    <div class="rd-wrap">
      {%- if section.settings.tl_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.tl_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-mw-18ch">{{ section.settings.tl_title }}</h2>
      {%- if section.settings.tl_intro != blank -%}<p class="rd-lede rd-maxw rd-mt2">{{ section.settings.tl_intro }}</p>{%- endif -%}
      <div class="rd-timeline rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'milestone' -%}
          {%- if block.settings.hot -%}{%- assign tl_class = 'rd-tl rd-hot' -%}{%- else -%}{%- assign tl_class = 'rd-tl' -%}{%- endif -%}
          <div class="{{ tl_class }}" {{ block.shopify_attributes }}>
            <div class="rd-yr">{{ block.settings.year }}</div>
            <div>
              <h3>{{ block.settings.title }}</h3>
              {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- THE MODEL (split + funding loop) ---------- {%- endcomment -%}
  <section class="rd-split rd-rev">
    <div class="rd-media">
      {%- if section.settings.model_image != blank -%}
        <img src="{{ section.settings.model_image | image_url: width: 1500 }}" alt="{{ section.settings.model_image_alt | default: 'The Bamboo Bicycle Club workshop and community' | escape }}" width="{{ section.settings.model_image.width }}" height="{{ section.settings.model_image.height }}">
      {%- else -%}
        <img src="{{ section.settings.model_fallback | default: 'bbc-rd-workshop.jpg' | asset_url }}" alt="{{ section.settings.model_image_alt | default: 'The Bamboo Bicycle Club workshop and community' | escape }}" width="1500" height="999">
      {%- endif -%}
    </div>
    <div class="rd-txt">
      {%- if section.settings.model_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.model_eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.model_title }}</h2>
      {%- if section.settings.model_body != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.model_body }}</p>{%- endif -%}
      <div class="rd-loop rd-mt3 rd-mw-none">
        <div class="rd-step"><div class="rd-big">{{ section.settings.loop_s1_big }}</div><div class="rd-sm">{{ section.settings.loop_s1_sm }}</div></div>
        <div class="rd-arr">&rarr;</div>
        <div class="rd-step"><div class="rd-big">{{ section.settings.loop_s2_big }}</div><div class="rd-sm">{{ section.settings.loop_s2_sm }}</div></div>
        <div class="rd-arr">&rarr;</div>
        <div class="rd-step"><div class="rd-big">{{ section.settings.loop_s3_big }}</div><div class="rd-sm">{{ section.settings.loop_s3_sm }}</div></div>
      </div>
      {%- if section.settings.model_reg != blank -%}<p class="rd-mt3 rd-c-charcoal">{{ section.settings.model_reg }}</p>{%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- VALUES ---------- {%- endcomment -%}
  <section class="rd-pad rd-paper">
    <div class="rd-wrap">
      <div class="rd-center rd-cmp-84401">
        {%- if section.settings.values_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.values_eyebrow }}</span>{%- endif -%}
        <h2>{{ section.settings.values_title }}</h2>
      </div>
      <div class="rd-grid rd-g3">
        {%- for block in section.blocks -%}{%- if block.type == 'value' -%}
          {%- if block.settings.lime -%}{%- assign card_class = 'rd-card rd-stamp rd-lime' -%}{%- else -%}{%- assign card_class = 'rd-card rd-stamp' -%}{%- endif -%}
          <div class="{{ card_class }}" {{ block.shopify_attributes }}>
            <div class="rd-body">
              {%- if block.settings.tag != blank -%}<span class="rd-tag rd-lime">{{ block.settings.tag }}</span>{%- endif -%}
              <h3 class="rd-mt2 rd-fs-21px">{{ block.settings.title }}</h3>
              {%- if block.settings.body != blank -%}<p>{{ block.settings.body }}</p>{%- endif -%}
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- STORIES (editable cards) ---------- {%- endcomment -%}
  {%- assign story_blocks = section.blocks | where: 'type', 'story' -%}
  {%- if story_blocks.size > 0 -%}
  <section class="rd-pad">
    <div class="rd-wrap">
      {%- if section.settings.stories_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.stories_eyebrow }}</span>{%- endif -%}
      {%- if section.settings.stories_title != blank -%}<h2 class="rd-mw-20ch">{{ section.settings.stories_title }}</h2>{%- endif -%}
      {%- if section.settings.stories_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.stories_lede }}</p>{%- endif -%}
      <div class="rd-csgrid rd-mt4">
        {%- for block in story_blocks -%}
          {%- assign cimg = block.settings.image | default: 'bbc-rd-cohort.jpg' -%}
          <a class="rd-cscard" href="{{ block.settings.url | default: '/blogs/impact' }}" {{ block.shopify_attributes }}>
            <div class="rd-cscard__media"><img src="{% if cimg contains '//' %}{{ cimg }}{% else %}{{ cimg | asset_url }}{% endif %}" alt="{{ block.settings.title | escape }}" loading="lazy" width="600" height="375">{%- if block.settings.kind != blank -%}<span class="rd-cscard__kind">{{ block.settings.kind }}</span>{%- endif -%}</div>
            <div class="rd-cscard__body"><p class="rd-cscard__ctx">{{ block.settings.blurb }}</p><div class="rd-cscard__foot"><span class="rd-cscard__inst">{{ block.settings.title }}</span><span class="rd-cscard__more">Read the story <span class="rd-arrow">&rarr;</span></span></div></div>
          </a>
        {%- endfor -%}
      </div>
      {%- if section.settings.stories_all_label != blank -%}<div class="rd-mt4"><a class="rd-btn rd-ghost" href="{{ section.settings.stories_all_url | default: '/blogs/impact' }}">{{ section.settings.stories_all_label }} <span class="rd-arrow">&rarr;</span></a></div>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- RECOGNITION (press logos + stats) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-steel">
    <div class="rd-wrap rd-center">
      {%- if section.settings.press_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.press_eyebrow }}</span>{%- endif -%}
      {%- assign press_blocks = section.blocks | where: 'type', 'press' -%}
      {%- if press_blocks.size > 0 -%}
        <div class="rd-logogrid rd-mt3">
          {%- for block in press_blocks -%}
            {%- if block.settings.logo_asset != blank -%}
              <span class="rd-logocell" {{ block.shopify_attributes }}><img class="rd-logoimg" src="{{ block.settings.logo_asset | asset_url }}" alt="{{ block.settings.text | escape }}" loading="lazy"></span>
            {%- else -%}
              <span class="rd-logocell" {{ block.shopify_attributes }}><span class="rd-logotext">{{ block.settings.text }}</span></span>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if section.settings.press_more != blank -%}<p class="rd-ship-note rd-mt3"><a href="{{ section.settings.press_more_url | default: '/pages/media-page' }}">{{ section.settings.press_more }}</a></p>{%- endif -%}
      {%- endif -%}

      {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
      {%- if stat_blocks.size > 0 -%}
        <div class="rd-stats rd-mt4">
          {%- for block in stat_blocks -%}
            <div class="rd-stat" {{ block.shopify_attributes }}>
              <div class="rd-num">{{ block.settings.number }}</div>
              <div class="rd-lbl">{{ block.settings.label }}</div>
              {%- if block.settings.source != blank -%}<div class="rd-src">{{ block.settings.source }}</div>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- FINAL CTA ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-680px">
      {%- if section.settings.cta_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.cta_eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.cta_title }}</h2>
      {%- if section.settings.cta_lede != blank -%}<p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.cta_lede }}</p>{%- endif -%}
      <div class="rd-flex rd-mt3 rd-jc-center">
        {%- if section.settings.cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ cta1 }}">{{ section.settings.cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ cta2 }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "About 2026 (new design)",
  "tag": "section",
  "class": "section bbc-about-2026-wrap",
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero image" },
    { "type": "text", "id": "hero_fallback", "label": "Default hero photo filename", "default": "bbc-rd-cohort.jpg" },
    { "type": "text", "id": "hero_image_alt", "label": "Hero image alt text", "default": "A group of builders with their finished bamboo bikes and build plans" },
    { "type": "text", "id": "crumb_home_label", "label": "Breadcrumb: home label", "default": "Home" },
    { "type": "url", "id": "crumb_home_url", "label": "Breadcrumb: home link (defaults to /)" },
    { "type": "text", "id": "crumb_here", "label": "Breadcrumb: current page", "default": "Our Story" },
    { "type": "text", "id": "hero_eyebrow", "label": "Eyebrow", "default": "Our story" },
    { "type": "text", "id": "hero_title", "label": "Headline", "default": "It started with one frame and a stubborn idea." },
    { "type": "textarea", "id": "hero_lede", "label": "Lede", "default": "That anyone — given the right tools and a bit of belief — can build a bicycle. Fourteen years on, that idea is changing lives." },

    { "type": "header", "content": "Mission intro" },
    { "type": "text", "id": "intro_eyebrow", "label": "Eyebrow", "default": "The idea" },
    { "type": "text", "id": "intro_title", "label": "Title", "default": "We believe building things is powerful." },
    { "type": "textarea", "id": "intro_body_1", "label": "Paragraph 1", "default": "In 2012, design engineers James Marr and Ian McMillan opened a small workshop in Hackney with a single goal: prove that anyone can build a bicycle frame. They started with bamboo — a grass with the tensile strength of steel that you can shape with hand tools." },
    { "type": "textarea", "id": "intro_body_2", "label": "Paragraph 2", "default": "What began as a maker's hobby became something bigger. Today the same craft runs inside prisons, schools and community workshops — turning a bike into a route to skills, confidence and a second chance." },
    { "type": "textarea", "id": "intro_quote", "label": "Pull quote", "default": "If we want people to choose sustainable options, we need to offer something better than what polluting products can be." },
    { "type": "text", "id": "intro_cite", "label": "Quote attribution", "default": "— James Marr, Founder" },

    { "type": "header", "content": "Timeline (add rows below as Milestone blocks)" },
    { "type": "text", "id": "tl_eyebrow", "label": "Eyebrow", "default": "The journey" },
    { "type": "text", "id": "tl_title", "label": "Title", "default": "Fourteen years, one through-line." },
    { "type": "textarea", "id": "tl_intro", "label": "Intro", "default": "Every chapter widened who gets to build — and the mission grew naturally out of the craft, not bolted on beside it." },

    { "type": "header", "content": "The model (split + funding loop)" },
    { "type": "image_picker", "id": "model_image", "label": "Image (workshop, no identifiable learners)" },
    { "type": "text", "id": "model_fallback", "label": "Default model photo filename", "default": "bbc-rd-workshop.jpg" },
    { "type": "text", "id": "model_image_alt", "label": "Image alt text", "default": "Inside the bamboo bicycle workshop" },
    { "type": "text", "id": "model_eyebrow", "label": "Eyebrow", "default": "How we're built" },
    { "type": "text", "id": "model_title", "label": "Title", "default": "A shop and a mission, one engine." },
    { "type": "textarea", "id": "model_body", "label": "Body", "default": "We're a Community Interest Company, not a charity with a gift shop or a brand with a cause bolted on. The money flows in one loop." },
    { "type": "text", "id": "loop_s1_big", "label": "Loop step 1 title", "default": "You build" },
    { "type": "text", "id": "loop_s1_sm", "label": "Loop step 1 detail", "default": "a bamboo bike · from £375" },
    { "type": "text", "id": "loop_s2_big", "label": "Loop step 2 title", "default": "Profits fund" },
    { "type": "text", "id": "loop_s2_sm", "label": "Loop step 2 detail", "default": "skills courses" },
    { "type": "text", "id": "loop_s3_big", "label": "Loop step 3 title", "default": "A life changes" },
    { "type": "text", "id": "loop_s3_sm", "label": "Loop step 3 detail", "default": "skills & family" },
    { "type": "text", "id": "model_reg", "label": "Company line", "default": "Bamboo Mobility Project CIC · Reg 16257348" },

    { "type": "header", "content": "Values (add cards below as Value blocks)" },
    { "type": "text", "id": "values_eyebrow", "label": "Eyebrow", "default": "What we stand for" },
    { "type": "text", "id": "values_title", "label": "Title", "default": "Three things we won't compromise." },

    { "type": "header", "content": "Recognition (logos + stats below as blocks)" },
    { "type": "text", "id": "press_eyebrow", "label": "Eyebrow", "default": "Recognised by" },
    { "type": "text", "id": "press_more", "label": "Press 'see more' link text", "default": "…and featured in 40+ publications — see all coverage →" },
    { "type": "url", "id": "press_more_url", "label": "Press 'see more' link" },

    { "type": "header", "content": "Stories band (add Story cards below)" },
    { "type": "text", "id": "stories_eyebrow", "label": "Eyebrow", "default": "Real people, real builds" },
    { "type": "text", "id": "stories_title", "label": "Heading", "default": "Every bike is somebody's story." },
    { "type": "textarea", "id": "stories_lede", "label": "Lede", "default": "From first-time makers to 8,000-mile expeditions — a few of the people who've built with us." },
    { "type": "url", "id": "stories_all_url", "label": "See-all link" },
    { "type": "text", "id": "stories_all_label", "label": "See-all label", "default": "Read more stories" },

    { "type": "header", "content": "Final CTA" },
    { "type": "text", "id": "cta_eyebrow", "label": "Eyebrow", "default": "Join in" },
    { "type": "text", "id": "cta_title", "label": "Title", "default": "Be part of the next chapter." },
    { "type": "textarea", "id": "cta_lede", "label": "Lede", "default": "Build a bike, bring a programme to your institution, or back the mission." },
    { "type": "text", "id": "cta1_label", "label": "Primary CTA label", "default": "Book a build" },
    { "type": "url", "id": "cta1_url", "label": "Primary CTA link (defaults to the workshop page)" },
    { "type": "text", "id": "cta2_label", "label": "Secondary CTA label", "default": "See our impact" },
    { "type": "url", "id": "cta2_url", "label": "Secondary CTA link (defaults to the impact page)" }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story card",
      "settings": [
        { "type": "text", "id": "kind", "label": "Tag" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "blurb", "label": "Short text" },
        { "type": "text", "id": "image", "label": "Image filename or full URL" },
        { "type": "url", "id": "url", "label": "Link to the full story" }
      ]
    },
    {
      "type": "milestone",
      "name": "Timeline milestone",
      "settings": [
        { "type": "text", "id": "year", "label": "Year", "default": "2012" },
        { "type": "text", "id": "title", "label": "Title", "default": "A workshop in Hackney" },
        { "type": "textarea", "id": "body", "label": "Description", "default": "James and Ian open the UK's first bamboo bike workshop. Within months, hundreds of people are building their own frames." },
        { "type": "checkbox", "id": "hot", "label": "Highlight this row (forest-green year)", "default": false }
      ]
    },
    {
      "type": "value",
      "name": "Value card",
      "settings": [
        { "type": "text", "id": "tag", "label": "Number tag", "default": "01" },
        { "type": "text", "id": "title", "label": "Title", "default": "Craft over consumption" },
        { "type": "textarea", "id": "body", "label": "Body", "default": "A bike you build yourself is a bike you never throw away. We teach making, not buying." },
        { "type": "checkbox", "id": "lime", "label": "Lime stamp shadow", "default": false }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        { "type": "text", "id": "number", "label": "Number", "default": "4,000+" },
        { "type": "text", "id": "label", "label": "Label", "default": "people have built a bike" },
        { "type": "text", "id": "source", "label": "Source / footnote", "default": "since 2012" }
      ]
    },
    {
      "type": "press",
      "name": "Press / recognition logo",
      "settings": [
        { "type": "text", "id": "text", "label": "Wordmark text (also logo alt)", "default": "The Guardian" },
        { "type": "text", "id": "logo_asset", "label": "Real logo filename (e.g. logo-guardian.svg)", "info": "Overrides the text wordmark when set." },
        {
          "type": "select", "id": "style", "label": "Style", "default": "serif",
          "options": [
            { "value": "ft", "label": "Peach box, serif (Financial Times)" },
            { "value": "serif", "label": "Serif (The Guardian)" },
            { "value": "serif-italic", "label": "Serif italic (Inside Time)" },
            { "value": "bbc", "label": "Boxed letters (BBC)" },
            { "value": "caps", "label": "Spaced caps (Investec)" },
            { "value": "disc", "label": "Bold (Discovery)" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "About 2026 (new design)",
      "blocks": [
        { "type": "milestone", "settings": { "year": "2012", "hot": false, "title": "A workshop in Hackney", "body": "Design engineers James Marr and Ian McMillan open the UK's first bamboo bike workshop. Within months, hundreds of people are building their own frames." } },
        { "type": "milestone", "settings": { "year": "2015", "hot": false, "title": "The Design Museum, and kits worldwide", "body": "Featured in the Cycle Revolution exhibition at London's Design Museum. The home-build kit ships internationally — builders make frames at their kitchen tables, backed by video tutorials." } },
        { "type": "milestone", "settings": { "year": "2018", "hot": false, "title": "Kevin McCloud's Green Heroes", "body": "Selected at Grand Designs Live, ExCeL London, as one of Kevin McCloud's Green Heroes for sustainable design." } },
