{%- comment -%}
  BBC Chapter pills — sticky jump-nav for long editorial pages (why-bamboo first).
  Mirrors the impact page's chapter grammar and the estate's evfilter pill anatomy
  (lowercase, 2px border, lime hover). Pure anchors, no JS — reduced-motion safe by
  construction. Added 2026-08-19 (James: align why-bamboo with the impact page).
  chapters setting: "label~#anchor|label~#anchor|…"
{%- endcomment -%}
{%- if section.settings.chapters != blank -%}
<nav class="bbc-rd rd-chapters" aria-label="Page chapters">
  <div class="rd-chapters__wrap">
    {%- assign items = section.settings.chapters | split: '|' -%}
    {%- for item in items -%}
      {%- assign parts = item | split: '~' -%}
      {%- if parts[1] != blank -%}<a class="rd-chapters__pill" href="{{ parts[1] | strip }}">{{ parts[0] | strip }}</a>{%- endif -%}
    {%- endfor -%}
  </div>
</nav>
{%- endif -%}

{% stylesheet %}
  .rd-chapters{position:sticky;top:0;z-index:90;background:rgba(230,220,200,.96);border-bottom:1.5px solid rgba(14,26,23,.14)}
  .rd-chapters__wrap{max-width:1200px;margin:0 auto;padding:10px 24px;display:flex;gap:10px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none}
  .rd-chapters__wrap::-webkit-scrollbar{display:none}
  .rd-chapters__pill,.bbc-rd .rd-chapters__pill,a.rd-chapters__pill{flex:none;font-size:14px;font-weight:800;letter-spacing:.02em;text-transform:lowercase;padding:7px 16px;border:2px solid currentColor;border-radius:999px;color:#2A332F;text-decoration:none !important;background:transparent}
  .rd-chapters__pill:hover,.rd-chapters__pill:focus-visible{background:#D4FD62;border-color:#0E1A17;color:#003C32}
  @media (prefers-reduced-motion: no-preference){
    html{scroll-behavior:smooth}
    .rd-chapters__pill{transition:background .15s cubic-bezier(.2,.7,.2,1),color .15s cubic-bezier(.2,.7,.2,1)}
  }
  .shopify-section{scroll-margin-top:64px}
  @media (max-width:749px){.rd-chapters__wrap{padding:8px 14px;gap:8px}.rd-chapters__pill{font-size:12.5px;padding:6px 13px}}
{% endstylesheet %}

{% schema %}
{
  "name": "BBC Chapter pills",
  "tag": "section",
  "class": "bbc-chapters-wrap",
  "settings": [
    { "type": "textarea", "id": "chapters", "label": "Chapters (label~#anchor|label~#anchor)", "default": "the datasheet~#datasheet|the research~#research" }
  ],
  "presets": [{ "name": "BBC Chapter pills" }]
}
{% endschema %}
