{{ 'bbc-why-bamboo.css' | asset_url | stylesheet_tag }}

<style>
  /* Hide the default main-page title + body on this template */
  h1.main-page-title { display: none !important; }
  h1.main-page-title + .rte { display: none !important; }
  /* Kill the 48px bottom padding Dawn's .section class adds to the main-page wrapper */
  .shopify-section:has(h1.main-page-title) {
    padding: 0 !important;
    overflow: hidden;
    line-height: 0;
    font-size: 0;
  }
</style>

<section class="bbc-wb-hero" aria-label="{{ section.settings.heading | escape }}">

  {%- if section.settings.video_url != blank -%}
    {%- comment -%} Background video (autoplay, muted, looping) {%- endcomment -%}
    <div class="bbc-wb-hero__bg bbc-wb-hero__bg--video" aria-hidden="true">
      {%- if section.settings.video_url.type == 'youtube' -%}
        <iframe
          src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&showinfo=0&rel=0&disablekb=1&modestbranding=1&iv_load_policy=3"
          frameborder="0"
          allow="autoplay"
          tabindex="-1">
        </iframe>
      {%- elsif section.settings.video_url.type == 'vimeo' -%}
        <iframe
          src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1&title=0&byline=0&portrait=0"
          frameborder="0"
          allow="autoplay"
          tabindex="-1">
        </iframe>
      {%- endif -%}
    </div>
  {%- elsif section.settings.image -%}
    <div class="bbc-wb-hero__bg">
      {{
        section.settings.image
        | image_url: width: 1920
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          alt: '',
          widths: '750, 1100, 1500, 1920',
          sizes: '100vw'
      }}
    </div>
  {%- endif -%}

  <div class="bbc-wb-hero__content">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bbc-wb-hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h1 class="bbc-wb-hero__title">{{ section.settings.heading }}</h1>

    {%- if section.settings.subtitle != blank -%}
      <p class="bbc-wb-hero__subtitle">{{ section.settings.subtitle }}</p>
    {%- endif -%}

    {%- if section.settings.button_text != blank or section.settings.button2_text != blank -%}
      <div class="bbc-wb-hero__cta">
        {%- if section.settings.button_text != blank -%}
          {%- assign hs1 = section.settings.btn1_style | default: 'white' -%}
          <a href="{{ section.settings.button_link }}" class="bbc-wb-btn bbc-wb-btn--{{ hs1 }}">
            {{ section.settings.button_text }}
          </a>
        {%- endif -%}
        {%- if section.settings.button2_text != blank -%}
          {%- assign hs2 = section.settings.btn2_style | default: 'outline-light' -%}
          <a href="{{ section.settings.button2_link }}" class="bbc-wb-btn bbc-wb-btn--{{ hs2 }}">
            {{ section.settings.button2_text }}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="bbc-wb-hero__scroll" aria-hidden="true"></div>
  </div>
</section>

{%- if section.blocks.size > 0 -%}
  <div class="bbc-wb-stats" role="list" aria-label="Key facts about bamboo bicycle frames">
    {%- for block in section.blocks -%}
      <div class="bbc-wb-stats__item" role="listitem" {{ block.shopify_attributes }}>
        <p class="bbc-wb-stats__number">{{ block.settings.number }}</p>
        <p class="bbc-wb-stats__label">{{ block.settings.label }}</p>
      </div>
    {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Why Bamboo Hero",
  "tag": "div",
  "class": "bbc-why-bamboo-page",
  "settings": [
    {
      "type": "header",
      "content": "Background media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Background image",
      "info": "Used when no video is set. Recommended: 1920×1080px minimum."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Background video URL",
      "accept": ["youtube", "vimeo"],
      "info": "Optional. YouTube or Vimeo URL. Will autoplay muted on loop. Overrides the background image."
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Why Bamboo?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (H1)",
      "default": "The World's Most Accessible Bamboo Bike Frame"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "The bamboo bicycle frame grows on every continent except Europe and Antarctica — nearly 1,600 species. No factories, foundries, or billion-dollar supply chains. Anyone can build their own bamboo frame in two days."
    },
    {
      "type": "header",
      "content": "CTA buttons (optional)"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button 1 text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button 1 URL"
    },
    {
      "type": "select",
      "id": "btn1_style",
      "label": "Button 1 style",
      "options": [
        { "value": "white",         "label": "■ White — filled (recommended for dark hero)" },
        { "value": "primary",       "label": "■ Gold — filled" },
        { "value": "secondary",     "label": "■ Forest green — filled" },
        { "value": "outline-light", "label": "□ Outline white (dark backgrounds)" },
        { "value": "outline",       "label": "□ Outline green (light backgrounds)" },
        { "value": "link",          "label": "↗ Text link (with arrow)" }
      ],
      "default": "white",
      "info": "Hero has a dark background — white or gold fill looks best."
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Button 2 text"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Button 2 URL"
    },
    {
      "type": "select",
      "id": "btn2_style",
      "label": "Button 2 style",
      "options": [
        { "value": "outline-light", "label": "□ Outline white (recommended for dark hero)" },
        { "value": "white",         "label": "■ White — filled" },
        { "value": "primary",       "label": "■ Gold — filled" },
        { "value": "secondary",     "label": "■ Forest green — filled" },
        { "value": "outline",       "label": "□ Outline green" },
        { "value": "link",          "label": "↗ Text link (with arrow)" }
      ],
      "default": "outline-light"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number / value",
          "default": "28,000"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "PSI Tensile Strength"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Why Bamboo Hero",
      "blocks": [
        { "type": "stat", "settings": { "number": "28,000", "label": "PSI Tensile Strength" } },
        { "type": "stat", "settings": { "number": "<1%", "label": "Frame Failure Rate" } },
        { "type": "stat", "settings": { "number": "~50%", "label": "Less CO₂ Than Aluminium" } },
        { "type": "stat", "settings": { "number": "4,000+", "label": "Builders Since 2012" } }
      ]
    }
  ]
}
{% endschema %}
