    {
      "type": "text",
      "id": "cta_eyebrow",
      "label": "Kit-picker CTA eyebrow",
      "default": "Talk to us"
    },
    {
      "type": "header",
      "content": "Header"
    },
    {
      "type": "checkbox",
      "id": "show_header",
      "label": "Show this band",
