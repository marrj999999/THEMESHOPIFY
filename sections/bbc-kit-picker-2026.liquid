    {
      "type": "header",
      "content": "Kit grid"
    },
    {
      "type": "checkbox",
      "id": "show_picks",
      "label": "Show this band",
      "default": true
    },
    {
      "type": "header",
      "content": "Lugged vs wrapped"
    },
    {
      "type": "checkbox",
      "id": "show_lug",
      "label": "Show this band",
      "default": true
    },
    {
      "type": "text",
      "id": "lug_eyebrow",
