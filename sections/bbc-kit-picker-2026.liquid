{%- comment -%}
  BBC New Design (2026) — WHICH KIT? picker page (/pages/which-kit).
  Benchmark: Prusa comparison depth (2026-07-06 research). Quick-guide cards by
  rider need → full comparison table → lugged-vs-wrapped explainer → CTA.
  Build times and descriptions match the per-kit template data (ported 2026-07-06).
{%- endcomment -%}

<div class="bbc-rd bbc-rd-kitpicker">

  {%- if section.settings.show_header != false -%}
  <section class="rd-pad rd-paper">
    <div class="rd-wrap rd-mw-820px">
      <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><a href="/collections/home-build-kits">Frame kits</a><span class="rd-sep">/</span><span class="rd-here">Which kit?</span></nav>
      {%- if section.settings.eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="rd-mw-16ch">{{ section.settings.title }}</h1>
      {%- if section.settings.lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.lede }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- QUICK GUIDE CARDS ---------- {%- endcomment -%}
  {%- if section.settings.show_picks != false -%}
  <section class="rd-pad-sm">
    <div class="rd-wrap">
      {%- if section.settings.picks_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.picks_eyebrow }}</span>{%- endif -%}
      <div class="rd-grid rd-g3 rd-mt2">
        {%- for block in section.blocks -%}{%- if block.type == 'pick' -%}
          <a class="rd-reveal rd-card rd-stamp" href="{{ block.settings.url }}" {{ block.shopify_attributes }} style="text-decoration:none;">
            <div class="rd-body">
              <span class="rd-tag rd-lime">{{ block.settings.need }}</span>
              <h3 class="rd-mt2 rd-fs-21px">{{ block.settings.kit }}</h3>
              <p>{{ block.settings.body }}</p>
              <p class="rd-mt2" style="font-weight:800;color:var(--forest);">{{ block.settings.meta }}</p>
            </div>
          </a>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- LUGGED VS WRAPPED ---------- {%- endcomment -%}
  {%- if section.settings.lug_title != blank and section.settings.show_lug != false -%}
  <section class="rd-pad rd-steel">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.lug_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.lug_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.lug_title }}</h2>
      <div class="rd-grid rd-g2 rd-mt4">
        <div class="rd-reveal rd-card rd-stamp"><div class="rd-body">
          <h3 class="rd-fs-21px">{{ section.settings.wrapped_title }}</h3>
          <p>{{ section.settings.wrapped_body }}</p>
        </div></div>
        <div class="rd-reveal rd-card rd-stamp"><div class="rd-body">
          <h3 class="rd-fs-21px">{{ section.settings.lugged_title }}</h3>
          <p>{{ section.settings.lugged_body }}</p>
        </div></div>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- CTA ---------- {%- endcomment -%}
  {%- if section.settings.show_cta != false -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-680px">
      {%- if section.settings.cta_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.cta_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.cta_title }}</h2>
      {%- if section.settings.cta_lede != blank -%}<p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.cta_lede }}</p>{%- endif -%}
      <div class="rd-flex rd-mt3 rd-jc-center">
        <a class="rd-btn rd-lime" href="{{ section.settings.cta1_url | default: '/collections/home-build-kits' }}">{{ section.settings.cta1_label }} <span class="rd-arrow">&rarr;</span></a>
        <a class="rd-btn rd-on-dark" href="{{ section.settings.cta2_url | default: '/pages/contact-us' }}">{{ section.settings.cta2_label }}</a>
      </div>
    </div>
  </section>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Which Kit 2026",
  "settings": [
    {
      "type": "text",
      "id": "picks_eyebrow",
      "label": "Kit grid eyebrow",
      "default": "Choose your build"
