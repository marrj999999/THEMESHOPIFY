    },
    {
      "type": "header",
      "content": "CTA"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show this band",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_title",
      "label": "Heading",
      "default": "still not sure?"
    },
    {
      "type": "textarea",
      "id": "cta_lede",
