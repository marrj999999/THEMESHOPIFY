{%- comment -%}
  Bamboo Bicycle Club — Collections list / "Shop" landing (2026 redesign).
  Hero (eyebrow + heading + lede) then a stamp-card grid, one card per
  collection in {{ collections }}, sorted, skipping empties. Styling lives in
  assets/bbc-redesign-2026.css. Used by the list-collections template (/collections).
{%- endcomment -%}

<div class="bbc-rd bbc-rd-collections">

  <section class="rd-pad-sm rd-paper">
    <div class="rd-wrap rd-coll-head">
      <span class="rd-eyebrow">{{ section.settings.eyebrow | default: 'Shop' }}</span>
      <h1>{{ section.settings.heading | default: 'Everything we make' }}</h1>
      {%- if section.settings.lede != blank -%}
        <div class="rd-lede rd-mt2 rd-mw-62ch">{{ section.settings.lede }}</div>
      {%- endif -%}
    </div>
  </section>

  <section class="rd-pad">
    <div class="rd-wrap">

      {%- if section.settings.cause_line != blank -%}
        <div class="rd-cause-bar">{{ section.settings.cause_line }}</div>
      {%- endif -%}

      {%- assign sorted_collections = collections | sort: 'title' -%}
      <div class="rd-grid rd-g3">
        {%- assign shown = 0 -%}
        {%- for collection in sorted_collections -%}
          {%- if collection.all_products_count == 0 -%}{%- continue -%}{%- endif -%}
          {%- assign shown = shown | plus: 1 -%}

          {%- if collection.image != blank -%}
            {%- assign card_image = collection.image -%}
          {%- elsif collection.featured_image != blank -%}
            {%- assign card_image = collection.featured_image -%}
          {%- elsif collection.products.first.featured_image != blank -%}
            {%- assign card_image = collection.products.first.featured_image -%}
          {%- else -%}
            {%- assign card_image = blank -%}
          {%- endif -%}

          <a class="rd-card rd-stamp" href="{{ collection.url }}">
            <div class="rd-ph">
              {%- if card_image != blank -%}
                <img src="{{ card_image | image_url: width: 800 }}" srcset="{{ card_image | image_url: width: 400 }} 400w, {{ card_image | image_url: width: 800 }} 800w, {{ card_image | image_url: width: 1000 }} 1000w" sizes="(max-width: 700px) 100vw, 33vw" alt="{{ card_image.alt | escape | default: collection.title }}" width="{{ card_image.width }}" height="{{ card_image.height }}" loading="lazy">
              {%- else -%}
                <img src="{{ 'bbc-rd-prod-gravel.jpg' | asset_url }}" alt="{{ collection.title | escape }}" width="1000" height="1000" loading="lazy">
              {%- endif -%}
            </div>
            <div class="rd-body">
              <h2 class="rd-fs-18px">{{ collection.title }}</h2>
              {%- if section.settings.show_count and collection.all_products_count > 0 -%}
                <div class="rd-coll-count">{{ collection.all_products_count }} {% if collection.all_products_count == 1 %}product{% else %}products{% endif %}</div>
              {%- endif -%}
            </div>
          </a>
        {%- endfor -%}

        {%- if shown == 0 -%}
          <p class="rd-lede">No collections to show yet.</p>
        {%- endif -%}
      </div>

    </div>
  </section>
</div>

{% schema %}
{
  "name": "Collections list 2026",
  "tag": "section",
  "class": "bbc-rd-collections-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Everything we make" },
    { "type": "textarea", "id": "lede", "label": "Lede (intro paragraph under the heading)", "default": "Frame kits, finished bikes and the bits in between — every one made to be built by hand." },
    { "type": "text", "id": "cause_line", "label": "Funding cause line", "default": "Every kit funds accredited skills courses inside prisons and schools." },
    { "type": "checkbox", "id": "show_count", "label": "Show product count on each card", "default": true }
  ],
  "presets": [ { "name": "Collections list 2026" } ]
}
{% endschema %}
