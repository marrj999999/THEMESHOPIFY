{%- comment -%}
  BBC New Design (2026) — dedicated BUILD TO BOND programme page.
  Single self-contained section, fully schema-driven, scoped under .bbc-rd via
  bbc-redesign-2026.css. Structure: hero → 4-stat band (dark) → what happens in
  the workshop → why it works (MoJ family-ties framing) → how it works (steps)
  → Maker + staff quotes → where it runs (named sites) → case-study card →
  final CTA. Audience: mixed (funders, prison staff, press, public); the
  commissioner sales page is /pages/prisons.

  CONTENT POLICY (hard rules):
  - Prisons MAY be named. NEVER link a named/identifiable participant to a
    named prison (GDPR/safeguarding). Maker quotes stay anonymised.
  - "Makers", never "prisoners"/"offenders"/"beneficiaries".
  - Source-of-truth figures only: 90% completion (no attribution beyond BBC
    programme records) · OCN Level 2 — Workshop Skills and Sustainable Manufacturing.
  - The 39% lower-reoffending figure is MoJ RESEARCH on family ties — always
    framed as the evidence the programme is built on, never a BBC outcome.
  - No SROI figure. No "guaranteed interview" or unevidenced employer claims.
{%- endcomment -%}

{%- liquid
  assign hero_cta1 = section.settings.hero_cta1_url | default: '/pages/prisons'
  assign hero_cta2 = section.settings.hero_cta2_url | default: '/pages/support-mission'
  assign final_c1 = section.settings.cta1_url | default: '/pages/prisons'
  assign final_c2 = section.settings.cta2_url | default: '/pages/support-mission'
-%}

<div class="bbc-rd bbc-rd-b2b-page">

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  {%- if section.settings.show_hero != false -%}
  <header class="rd-hero rd-mh-74">
    <div class="rd-bg">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 1600 }} 1600w, {{ section.settings.hero_image | image_url: width: 2000 }} 2000w" sizes="100vw" alt="{{ section.settings.hero_image_alt | default: 'Inside the Build to Bond workshop' | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high" loading="eager">
      {%- else -%}
        <img src="{{ section.settings.hero_fallback | default: 'bbc-rd-prison-jig.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | default: 'Inside the Build to Bond workshop' | escape }}" width="1500" height="999" fetchpriority="high" loading="eager">
      {%- endif -%}
    </div>
    <div class="rd-scrim"></div>
    <div class="rd-inner">
      <div class="rd-wrap">
        <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><a href="/pages/impact">Impact</a><span class="rd-sep">/</span><span class="rd-here">Build to Bond</span></nav>
        {%- if section.settings.hero_eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1 class="rd-mt2 rd-mw-15ch">{{ section.settings.hero_title }}</h1>
        <div class="rd-lede">{{ section.settings.hero_lede }}</div>
        <div class="rd-cta-row">
          {%- if section.settings.hero_cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ hero_cta1 }}">{{ section.settings.hero_cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
          {%- if section.settings.hero_cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ hero_cta2 }}">{{ section.settings.hero_cta2_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </header>
  {%- endif -%}

  {%- comment -%} ---------- WHAT HAPPENS IN THE WORKSHOP ---------- {%- endcomment -%}
  {%- if section.settings.show_story != false -%}
  <section class="rd-pad">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.story_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.story_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.story_title }}</h2>
      {%- if section.settings.story_body_1 != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.story_body_1 }}</p>{%- endif -%}
      {%- if section.settings.story_body_2 != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.story_body_2 }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- WHY IT WORKS (split, dark) — MoJ family-ties framing ---------- {%- endcomment -%}
  {%- if section.settings.show_why != false -%}
  <section class="rd-split rd-dark">
    <div class="rd-reveal rd-media">
      {%- if section.settings.why_image != blank -%}
        <img src="{{ section.settings.why_image | image_url: width: 1400 }}" alt="{{ section.settings.why_image_alt | default: 'A finished bamboo balance bike' | escape }}" width="{{ section.settings.why_image.width }}" height="{{ section.settings.why_image.height }}">
      {%- else -%}
        <img src="{{ section.settings.why_fallback | default: 'bbc-rd-b2b.jpg' | asset_url }}" alt="{{ section.settings.why_image_alt | default: 'A finished bamboo balance bike' | escape }}" width="1400" height="933">
      {%- endif -%}
    </div>
    <div class="rd-txt">
      {%- if section.settings.why_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.why_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.why_title }}</h2>
      {%- if section.settings.why_body_1 != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.why_body_1 }}</p>{%- endif -%}
      {%- if section.settings.why_body_2 != blank -%}<p class="rd-mt2">{{ section.settings.why_body_2 }}</p>{%- endif -%}
      {%- if section.settings.maker_quote != blank -%}
        <div class="rd-reveal rd-pull rd-mt3">
          <p class="rd-q">{{ section.settings.maker_quote }}</p>
          {%- if section.settings.maker_cite != blank -%}<cite>{{ section.settings.maker_cite }}</cite>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- HOW IT WORKS (numbered steps) ---------- {%- endcomment -%}
  {%- if section.settings.steps_title != blank and section.settings.show_steps != false -%}
  <section class="rd-pad">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.steps_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.steps_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.steps_title }}</h2>
      <ol class="rd-steps rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'step' -%}
          <li {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
          </li>
        {%- endif -%}{%- endfor -%}
      </ol>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- STATS (dark) ----------
    Moved below HOW IT WORKS (was directly under the hero). Hero and stats are both dark, so the
    page opened with two dark bands run together — PAGE-STANDARD S3.

    Moved TWO bands rather than one, unlike the other three pages: WHY IT WORKS is also dark, so
    parking the stats directly after WHAT HAPPENS would only have relocated the collision. From
    here the page alternates cleanly — hero dark, workshop light, why-it-works dark, how-it-works
    light, stats dark, staff quote paper. Reordered, not recoloured, so nothing styled for a dark
    surface has to change. (2026-08-04)
  {%- endcomment -%}
  {%- if section.settings.show_stats != false -%}
  <section class="rd-pad-sm rd-dark">
    <div class="rd-wrap">
      <div class="rd-stats">
        {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}
          <div class="rd-reveal rd-stat" {{ block.shopify_attributes }}>
            <div class="rd-num bbc-counted">{{ block.settings.number }}</div>
            <div class="rd-lbl">{{ block.settings.label }}</div>
            {%- if block.settings.source != blank -%}<div class="rd-src">{{ block.settings.source }}</div>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- STAFF QUOTE (paper, centred) ---------- {%- endcomment -%}
  {%- if section.settings.staff_quote != blank and section.settings.show_staff != false -%}
  <section class="rd-pad-sm rd-paper rd-center">
    <div class="rd-wrap rd-mw-680px">
      <div class="rd-reveal rd-pull rd-mx-auto">
        <p class="rd-q">{{ section.settings.staff_quote }}</p>
        {%- if section.settings.staff_cite != blank -%}<cite>{{ section.settings.staff_cite }}</cite>{%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- WHERE IT RUNS (named prison sites) ---------- {%- endcomment -%}
  {%- if section.settings.sites_title != blank and section.settings.show_sites != false -%}
  <section class="rd-pad-sm rd-center">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.sites_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.sites_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal rd-mw-22ch rd-mx-auto">{{ section.settings.sites_title }}</h2>
      {%- if section.settings.sites_body != blank -%}<p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.sites_body }}</p>{%- endif -%}
      {%- if section.settings.sites_list != blank -%}<div class="rd-sitenames rd-mt3">{{ section.settings.sites_list }}</div>{%- endif -%}
      {%- if section.settings.sites_partner != blank -%}<p class="rd-frame-label rd-mt3">{{ section.settings.sites_partner }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- CASE STUDY CARD → full story ---------- {%- endcomment -%}
  {%- if section.settings.cs_quote != blank and section.settings.show_cs != false -%}
  <section class="rd-pad-sm">
    <div class="rd-wrap rd-mw-820px">
      {%- comment -%} THE standard card (snippets/bbc-cscard.liquid), 2026-07-31 — the featured
         variant, matching the flagship on /pages/impact. Was a bespoke wrapper <a> whose `kind`
         read "The full story" (a TYPE, not a category) and whose title sat in a non-linked span. {%- endcomment -%}
      {%- assign _b2b_url = section.settings.cs_url | default: '/blogs/impact/build-to-bond-the-full-story-of-how-bamboo-bikes-are-rebuilding-family-connections-in-prison-2' -%}
      {%- assign _b2b_head = section.settings.cs_heading | default: section.settings.cs_site -%}
      {%- if _b2b_head == blank -%}{%- assign _b2b_head = 'Build to Bond · HMP Lowdham Grange' -%}{%- endif -%}
      {%- assign _b2b_img = section.settings.cs_image | default: 'bbc-rd-prison-wide.jpg' -%}
      {%- assign _b2b_kind = section.settings.cs_kind | default: 'prisons' -%}
      {%- assign _b2b_cta = section.settings.cs_link_label | default: 'Read the full story' -%}
      <ul class="rd-csgrid" role="list">
        {%- render 'bbc-cscard',
             variant: 'featured',
             kind: _b2b_kind,
             heading: _b2b_head,
             url: _b2b_url,
             context: section.settings.cs_blurb,
             attr: section.settings.cs_site,
             image: _b2b_img,
             cta: _b2b_cta -%}
      </ul>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- FINAL CTA (dark, centred) ---------- {%- endcomment -%}
  {%- if section.settings.show_cta != false -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-680px">
      {%- if section.settings.cta_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.cta_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.cta_title }}</h2>
      {%- if section.settings.cta_lede != blank -%}<p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.cta_lede }}</p>{%- endif -%}
      <div class="rd-flex rd-mt3 rd-jc-center">
        {%- if section.settings.cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ final_c1 }}">{{ section.settings.cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ final_c2 }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

</div>

{% schema %}
{
  "name": "Build to Bond 2026",
  "class": "shopify-section--bbc-b2b-page",
  "settings": [
    {
      "type": "text",
      "id": "cs_heading",
      "label": "Case-study heading override (blank = site name)"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "checkbox",
      "id": "show_hero",
      "label": "Show this band",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image (workshop, no identifiable Makers)"
    },
    {
      "type": "text",
      "id": "hero_fallback",
      "label": "Default hero photo filename",
      "default": "bbc-rd-prison-jig.jpg"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text",
      "default": "A frame jig inside the Build to Bond prison workshop"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "Our prison programme"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Headline",
      "default": "a bike built inside. a bond that goes home."
    },
    {
      "type": "textarea",
      "id": "hero_lede",
      "label": "Lede",
      "default": "Build to Bond is a six-week bamboo bike-building course inside prison workshops. Makers learn real manufacturing skills, earn a recognised qualification — and finish by giving the bike they built to their own child on family visit day."
    },
    {
      "type": "text",
      "id": "hero_cta1_label",
      "label": "Primary CTA label",
      "default": "Run it in your prison"
    },
    {
      "type": "url",
      "id": "hero_cta1_url",
      "label": "Primary CTA link (defaults to the prisons page)"
    },
    {
      "type": "text",
      "id": "hero_cta2_label",
      "label": "Secondary CTA label",
      "default": "Back the mission"
    },
    {
      "type": "url",
      "id": "hero_cta2_url",
      "label": "Secondary CTA link (defaults to Back the mission)"
    },
    {
      "type": "header",
      "content": "What happens in the workshop"
    },
    {
      "type": "checkbox",
      "id": "show_story",
      "label": "Show this band",
      "default": true
    },
    {
      "type": "text",
      "id": "story_eyebrow",
      "label": "Eyebrow",
      "default": "Inside the workshop"
    },
    {
      "type": "text",
      "id": "story_title",
      "label": "Heading",
      "default": "real manufacturing, taught by hand."
    },
    {
      "type": "textarea",
      "id": "story_body_1",
      "label": "Paragraph 1",
      "default": "Inside a working prison workshop, small cohorts of Makers measure, mitre and bond bamboo frames by hand — the same craft we've taught in our London workshop since 2012. Sessions build real skills: precision marking-out, jig setup, structural bonding, finishing and quality checks."
    },
    {
      "type": "textarea",
      "id": "story_body_2",
      "label": "Paragraph 2",
      "default": "Along the way, each Maker builds a portfolio of work and earns an OCN Level 2 in Workshop Skills and Sustainable Manufacturing — a recognised qualification, earned hands-on."
    },
    {
      "type": "header",
      "content": "Why it works (MoJ evidence framing)"
    },
    {
      "type": "checkbox",
      "id": "show_why",
      "label": "Show this band",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "why_image",
      "label": "Feature image"
    },
    {
      "type": "text",
      "id": "why_fallback",
      "label": "Default feature photo filename",
      "default": "bbc-rd-b2b.jpg"
    },
    {
      "type": "text",
      "id": "why_image_alt",
      "label": "Feature image alt text",
      "default": "A finished bamboo balance bike from the Build to Bond workshop"
    },
    {
      "type": "text",
      "id": "why_eyebrow",
      "label": "Eyebrow",
      "default": "Why it works"
    },
    {
      "type": "text",
      "id": "why_title",
      "label": "Heading",
      "default": "the bike is for their child. that's the point."
    },
    {
      "type": "textarea",
      "id": "why_body_1",
      "label": "Paragraph 1",
      "default": "The finished build is a child's balance bike. On family visit day, the Maker hands it over themselves — the first thing many have ever made, given to the person who matters most."
    },
    {
      "type": "textarea",
      "id": "why_body_2",
      "label": "Paragraph 2",
      "default": "Ministry of Justice research shows that people in prison who maintain family ties are 39% less likely to reoffend. Build to Bond is built around that evidence: a six-week course where the skills are real, the qualification is recognised, and the finish line is a stronger family bond."
    },
    {
      "type": "textarea",
      "id": "maker_quote",
      "label": "Maker quote (anonymised only)",
