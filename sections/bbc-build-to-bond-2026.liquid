      "type": "header",
      "content": "Stats"
    },
    {
      "type": "checkbox",
      "id": "show_stats",
      "label": "Show this band",
      "default": true
    },
    {
      "type": "header",
      "content": "Staff quote"
    },
    {
      "type": "checkbox",
      "id": "show_staff",
      "label": "Show this band",
      "default": true
    },
    {
      "type": "textarea",
      "id": "staff_quote",
