    },
    {
      "type": "checkbox",
      "id": "show_cs",
      "label": "Show this band",
      "default": true
    },
    {
      "type": "text",
      "id": "cs_kind",
      "label": "Card tag",
      "info": "A category, not a type - e.g. prisons, schools.",
      "default": "prisons"
    },
    {
      "type": "text",
      "id": "cs_image",
