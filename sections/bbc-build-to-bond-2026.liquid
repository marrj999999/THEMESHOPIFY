    },
    {
      "type": "text",
      "id": "staff_cite",
      "label": "Attribution",
      "default": "Sally Allsopp, Industries Manager"
    },
    {
      "type": "header",
      "content": "Where it runs"
    },
    {
      "type": "checkbox",
      "id": "show_sites",
      "label": "Show this band",
      "default": true
    },
    {
      "type": "text",
      "id": "sites_eyebrow",
      "label": "Eyebrow",
      "default": "Where we work"
    },
