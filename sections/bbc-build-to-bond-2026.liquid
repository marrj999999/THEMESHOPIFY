{%- comment -%}
  BBC New Design (2026) — dedicated BUILD TO BOND programme page.
  Single self-contained section, fully schema-driven, scoped under .bbc-rd via
  bbc-redesign-2026.css. Structure: hero → 4-stat band (dark) → what happens in
  the workshop → why it works (MoJ family-ties framing) → how it works (steps)
  → Maker + staff quotes → where it runs (named sites) → case-study card →
  final CTA. Audience: mixed (funders, prison staff, press, public); the
  commissioner sales page is /pages/prisons.

  CONTENT POLICY (hard rules):
  - Prisons MAY be named. NEVER link a named/identifiable participant to a
    named prison (GDPR/safeguarding). Maker quotes stay anonymised.
  - "Makers", never "prisoners"/"offenders"/"beneficiaries".
  - Source-of-truth figures only: 90% completion (no attribution beyond BBC
    programme records) · OCN Level 2 — Workshop Skills and Sustainable Manufacturing.
  - The 39% lower-reoffending figure is MoJ RESEARCH on family ties — always
    framed as the evidence the programme is built on, never a BBC outcome.
  - No SROI figure. No "guaranteed interview" or unevidenced employer claims.
{%- endcomment -%}

{%- liquid
  assign hero_cta1 = section.settings.hero_cta1_url | default: '/pages/prisons'
  assign hero_cta2 = section.settings.hero_cta2_url | default: '/pages/support-mission'
  assign final_c1 = section.settings.cta1_url | default: '/pages/prisons'
  assign final_c2 = section.settings.cta2_url | default: '/pages/impact'
-%}

<div class="bbc-rd bbc-rd-b2b-page">

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  {%- if section.settings.show_hero != false -%}
  <header class="rd-hero rd-mh-74 evh">
    <div class="rd-bg">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 1600 }} 1600w, {{ section.settings.hero_image | image_url: width: 2000 }} 2000w" sizes="100vw" alt="{{ section.settings.hero_image_alt | default: 'Inside the Build to Bond workshop' | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high" loading="eager">
      {%- else -%}
        <img src="{{ section.settings.hero_fallback | default: 'bbc-rd-prison-jig.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | default: 'Inside the Build to Bond workshop' | escape }}" width="1500" height="999" fetchpriority="high" loading="eager">
      {%- endif -%}
      {%- comment -%} film hero (2026-08-27, estate .evh pattern) — default film bbc-rd-jig-reel.mp4
         (workshop jig footage, no faces — safeguarding: never people footage here without a
         blur-audited clearance). Poster = prison-jig still. {%- endcomment -%}
      {%- assign _evfilm = section.settings.evh_film_url -%}
      {%- if _evfilm == blank -%}{%- assign _evfilm = 'bbc-rd-jig-reel.mp4' | asset_url -%}{%- endif -%}
      {%- if section.settings.evh_film_on -%}
      <video class="evh-film" muted playsinline loop preload="metadata" poster="{{ section.settings.hero_fallback | default: 'bbc-rd-prison-jig.jpg' | asset_url }}" aria-hidden="true" tabindex="-1">
        <source src="{{ _evfilm }}" type="video/mp4">
      </video>
      {%- endif -%}
    </div>
    <div class="rd-scrim"></div>
    <div class="rd-inner">
      <div class="rd-wrap">
        <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><span class="rd-here">{{ section.settings.tx_crumb_b2b | default: "Build to Bond" }}</span></nav>
        {%- if section.settings.hero_tb_a != blank or section.settings.hero_tb_b != blank -%}
          <div class="rd-tblock rd-tblock--hero" aria-hidden="true">
            <span class="k r">{{ section.settings.hero_tb_a_key | default: 'runs in' }}</span><span class="r">{{ section.settings.hero_tb_a }}</span>
            <span class="k">{{ section.settings.hero_tb_b_key | default: 'accredited' }}</span><span>{{ section.settings.hero_tb_b }}</span>
          </div>
        {%- endif -%}
        {%- if section.settings.hero_eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1 class="rd-mt2 rd-mw-15ch">{{ section.settings.hero_title }}</h1>
        <div class="rd-lede">{{ section.settings.hero_lede }}</div>
        <div class="rd-cta-row">
          {%- if section.settings.hero_cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ hero_cta1 }}">{{ section.settings.hero_cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
          {%- if section.settings.hero_cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ hero_cta2 }}">{{ section.settings.hero_cta2_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </header>
  <style>
    .evh .evh-film{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; opacity:0; transition:opacity .8s ease; }
    .evh .evh-film.evh-on{ opacity:1; }
    .evh .rd-bg img{ z-index:0; }
    .bbc-rd .spr-card{ overflow:hidden; display:flex; flex-direction:column; }
    .bbc-rd .spr-media{ aspect-ratio:16/10; overflow:hidden; background:var(--forest-700,#002A23); }
    .bbc-rd .spr-media img{ width:100%; height:100%; object-fit:cover; display:block; transition:transform .5s ease; }
    .bbc-rd .spr-card:hover .spr-media img{ transform:scale(1.04); }
    @media (prefers-reduced-motion: reduce){ .evh .evh-film{ display:none; } }
    .b2b-ic{ width:38px; height:38px; color:var(--forest,#003C32); display:block; margin:0 0 10px; }
    .b2b-ic .b2b-ic-a{ color:#7aa000; }
  </style>
  <script>
    (function () {
      var v = document.querySelector('.evh .evh-film');
      if (!v) return;
      if (navigator.connection && navigator.connection.saveData) { v.remove(); return; }
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.remove(); return; }
      v.muted = true; v.setAttribute('muted', '');
      var started = false;
      function go() { if (started) return; started = true; var p = v.play(); if (p && p.catch) p.catch(function () { started = false; }); }
      v.addEventListener('playing', function () { requestAnimationFrame(function () { requestAnimationFrame(function () { v.classList.add('evh-on'); }); }); });
      /* 2026-09-02: on phones the reel waits for the first scroll or touch (largest-contentful-paint
         stops at first input, and a timer-started film scored as the page's largest paint on impact);
         desktop starts as before. The film still plays on mobile — James, 24 Aug. */
      var phone = window.matchMedia && window.matchMedia('(max-width: 767px), (pointer: coarse)').matches;
      if (phone) {
        v.setAttribute('preload', 'none');
        var armed = false;
        var arm = function () { if (armed) return; armed = true; v.addEventListener('canplay', go); v.load(); };
        ['scroll', 'touchstart', 'pointerdown', 'keydown', 'wheel'].forEach(function (ev) { window.addEventListener(ev, arm, { once: true, passive: true }); });
      } else {
        v.addEventListener('canplay', go);
      }
      v.load();
      if (v.readyState >= 3) go();
      document.addEventListener('visibilitychange', function () { if (document.hidden) { v.pause(); } else if (started) { v.play().catch(function(){}); } });
    })();
  </script>
  {%- endif -%}

  {%- comment -%} ---------- TWO PATHS (fork — education-page pattern, 2026-08-27) {%- endcomment -%}
  {%- if section.settings.show_fork != false -%}
  <section class="rd-pad rd-paper">
    <div class="rd-wrap">
      <div class="rd-grid rd-g2">
        <a class="rd-card rd-stamp rd-cardlink" href="{{ section.settings.f1_url | default: '/pages/prisons' }}">
          <div class="rd-body">
            <svg class="b2b-ic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="6" y="4" width="20" height="24" rx="3" stroke="currentColor" stroke-width="2"/><path d="M11 12h10M11 17h10M11 22h6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="24" cy="24" r="3" fill="currentColor" class="b2b-ic-a"/></svg>
            <span class="rd-tag rd-lime">{{ section.settings.f1_tag | default: 'for prisons & commissioners' }}</span>
            <h3 class="rd-mt2 rd-fs-21px">{{ section.settings.f1_title | default: 'run it in your prison' }}</h3>
            <p>{{ section.settings.f1_body | default: 'Self-delivery that fits a prison education budget: we set up the workshop, train your staff and peer instructors, and support every cohort.' }}</p>
            <span class="rd-arrow-link">{{ section.settings.f1_link | default: "costs & routes in" }} <span class="rd-arrow">&rarr;</span></span>
          </div>
        </a>
        <a class="rd-card rd-stamp rd-cardlink" href="{{ section.settings.f2_url | default: '/pages/support-mission' }}">
          <div class="rd-body">
            <svg class="b2b-ic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 27C9 22 4 17.5 4 12.2 4 8.7 6.7 6 10.1 6c2.3 0 4.4 1.2 5.9 3.2C17.5 7.2 19.6 6 21.9 6 25.3 6 28 8.7 28 12.2c0 5.3-5 9.8-12 14.8z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="22.5" cy="11" r="1.6" fill="currentColor" class="b2b-ic-a"/></svg>
            <span class="rd-tag rd-lime">{{ section.settings.f2_tag | default: 'for funders & supporters' }}</span>
            <h3 class="rd-mt2 rd-fs-21px">{{ section.settings.f2_title | default: 'back the mission' }}</h3>
            <p>{{ section.settings.f2_body | default: 'The programme grows site by site with backing from funders and partners. See what support builds — and where it goes next.' }}</p>
            <span class="rd-arrow-link">{{ section.settings.f2_link | default: "support the work" }} <span class="rd-arrow">&rarr;</span></span>
          </div>
        </a>
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- WHAT HAPPENS IN THE WORKSHOP ---------- {%- endcomment -%}
  {%- if section.settings.show_story != false -%}
  <section class="rd-pad">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.story_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.story_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.story_title }}</h2>
      {%- if section.settings.story_body_1 != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.story_body_1 }}</p>{%- endif -%}
      {%- if section.settings.story_body_2 != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.story_body_2 }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- WHY IT WORKS (split, dark) — MoJ family-ties framing ---------- {%- endcomment -%}
  {%- if section.settings.show_why != false -%}
  <section class="rd-split rd-dark">
    {%- liquid
      assign _film_poster = section.settings.film_poster_asset | default: 'bbc-rd-lowdham-poster.jpg'
      assign _has_film = false
      if section.settings.film != blank or section.settings.film_url != blank
        assign _has_film = true
      endif
    -%}
    <div class="rd-reveal rd-media{% if _has_film %} rd-media--film{% endif %}">
      {%- if section.settings.film != blank -%}
        {%- render 'bbc-media', video: section.settings.film, image: section.settings.film_poster, src: _film_poster, fallback: 'bbc-rd-lowdham-poster.jpg', label: section.settings.film_label, alt: section.settings.film_alt, class: 'bbc-media--ar169 b2b-film', sizes: '(max-width:749px) 100vw, 50vw', loading: 'lazy' -%}
      {%- elsif section.settings.film_url != blank -%}
        <div class="b2b-film b2b-film--plain">
          <video class="b2b-film__video" controls playsinline preload="none" poster="{{ _film_poster | asset_url }}" aria-label="{{ section.settings.film_alt | escape }}">
            <source src="{{ section.settings.film_url }}" type="video/mp4">
          </video>
        </div>
      {%- elsif section.settings.why_image != blank -%}
        <img src="{{ section.settings.why_image | image_url: width: 1400 }}" srcset="{{ section.settings.why_image | image_url: width: 700 }} 700w, {{ section.settings.why_image | image_url: width: 1400 }} 1400w" sizes="(max-width:749px) 100vw, 50vw" alt="{{ section.settings.why_image_alt | default: 'A finished bamboo balance bike' | escape }}" width="{{ section.settings.why_image.width }}" height="{{ section.settings.why_image.height }}" loading="lazy">
      {%- else -%}
        {%- assign _why_fb = section.settings.why_fallback | default: 'bbc-rd-b2b.jpg' | asset_url -%}
        <img src="{{ _why_fb }}&width=1400" srcset="{{ _why_fb }}&width=700 700w, {{ _why_fb }}&width=1400 1400w" sizes="(max-width:749px) 100vw, 50vw" alt="{{ section.settings.why_image_alt | default: 'A finished bamboo balance bike' | escape }}" width="1400" height="933" loading="lazy">
      {%- endif -%}
      {%- if _has_film and section.settings.film_caption != blank -%}<p class="b2b-film__cap">{{ section.settings.film_caption }}</p>{%- endif -%}
    </div>
    <div class="rd-txt">
      {%- if section.settings.why_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.why_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.why_title }}</h2>
      {%- if section.settings.why_body_1 != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.why_body_1 }}</p>{%- endif -%}
      {%- if section.settings.why_body_2 != blank -%}<p class="rd-mt2">{{ section.settings.why_body_2 }}</p>{%- endif -%}
      {%- if section.settings.maker_quote != blank -%}
        <div class="rd-reveal rd-pull rd-mt3">
          <p class="rd-q">{{ section.settings.maker_quote }}</p>
          {%- if section.settings.maker_cite != blank -%}<cite>{{ section.settings.maker_cite }}</cite>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- HOW IT WORKS (numbered steps) ---------- {%- endcomment -%}
  {%- if section.settings.steps_title != blank and section.settings.show_steps != false -%}
  <section class="rd-pad-sm rd-sheet rd-stations rd-b2b-steps">
    <div class="rd-wrap">
      <div class="rd-stations__head">
        <div>
          {%- if section.settings.steps_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.steps_eyebrow }}</span>{%- endif -%}
          <h2 class="rd-reveal rd-fs-stn">{{ section.settings.steps_title }}</h2>
        </div>
        {%- if section.settings.steps_lede != blank -%}<p class="rd-lede">{{ section.settings.steps_lede }}</p>{%- endif -%}
      </div>
      <div class="rd-stations__rail">
        <div class="rd-stations__track" aria-hidden="true"></div>
        <div class="rd-stations__culm" aria-hidden="true"></div>
        <ol class="rd-stations__grid">
          {%- for block in section.blocks -%}{%- if block.type == 'step' -%}
          {%- assign ic = block.settings.icon | default: 'tool' -%}
          <li class="rd-stations__item rd-reveal" {{ block.shopify_attributes }}>
            <span class="rd-stations__dot{% if forloop.last %} rd-stations__dot--lime{% endif %}">{%- case ic -%}
                {%- when 'tool' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M4 26L20 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M18 8l6 6-3 3-6-6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M22 4l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle class="rd-pic__a" cx="7" cy="7" r="2"/></svg>
                {%- when 'skills' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="8" y="3" width="16" height="26" rx="3" stroke="currentColor" stroke-width="2"/><path d="M12 10h8M12 15h8M12 20h5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle class="rd-pic__a" cx="26" cy="6" r="2"/></svg>
                {%- when 'confidence' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 4l3.5 7 7.5 1-5.5 5.3 1.3 7.7L16 21.4 9.2 25l1.3-7.7L5 12l7.5-1z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle class="rd-pic__a" cx="16" cy="16" r="2"/></svg>
                {%- when 'bike' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="8" cy="22" r="5" stroke="currentColor" stroke-width="2"/><circle cx="24" cy="22" r="5" stroke="currentColor" stroke-width="2"/><path d="M8 22l5-10h7l4 10M13 12l-2-4h4M20 12l3-5" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle class="rd-pic__a" cx="23.5" cy="6.5" r="2"/></svg>
                {%- when 'ladder' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M9 2v28M23 2v28" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M9 9h14M9 16h14M9 23h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle class="rd-pic__a" cx="26.5" cy="5" r="2"/></svg>
                {%- when 'balance' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="8" cy="22" r="5" stroke="currentColor" stroke-width="2"/><circle cx="24" cy="22" r="5" stroke="currentColor" stroke-width="2"/><path d="M8 22l4-9h6l6 9" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 13l-2-4h3M18 13l3-5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle class="rd-pic__a" cx="21.6" cy="7.4" r="1.8"/></svg>
                {%- when 'family' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="11" cy="9" r="4" stroke="currentColor" stroke-width="2"/><circle cx="23" cy="13" r="3" stroke="currentColor" stroke-width="2"/><path d="M3 28c0-6 3.5-9 8-9s8 3 8 9M17 28c0-4 2.5-6.5 6-6.5s6 2.5 6 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle class="rd-pic__a" cx="27" cy="5" r="2"/></svg>
              {%- endcase -%}</span>
            <h3 class="rd-stations__title">{{ block.settings.title }}</h3>
            {%- if block.settings.body != blank -%}<p class="rd-stations__body">{{ block.settings.body }}</p>{%- endif -%}
            {%- if block.settings.note != blank -%}<span class="rd-stations__note">{{ block.settings.note }}</span>{%- endif -%}
          </li>
          {%- endif -%}{%- endfor -%}
        </ol>
      </div>
    </div>
  </section>
  {%- endif -%}

    {%- comment -%} ---------- THE COURSES (pathway — education-page pattern, 2026-08-27)
     Wording gates: OCN courses named exactly per Claims Register; never "nationally
     recognised"/Ofqual; no cohort numbers (unresolved decision); peer-instructor count 3
     is Proof Bank-approved. {%- endcomment -%}
  {%- if section.settings.show_paths != false -%}
  <section class="rd-pad">
    <div class="rd-wrap">
      <div class="rd-center">
        {%- if section.settings.paths_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.paths_eyebrow }}</span>{%- endif -%}
        <h2 class="rd-mw-22ch rd-mx-auto">{{ section.settings.paths_title | default: 'two courses, one progression.' }}</h2>
      </div>
      <div class="rd-grid rd-g3 rd-mt4">
        {%- for n in (1..3) -%}
          {%- assign k_img = 'path' | append: n | append: '_img' -%}
          {%- assign k_tag = 'path' | append: n | append: '_tag' -%}
          {%- assign k_ttl = 'path' | append: n | append: '_title' -%}
          {%- assign k_bod = 'path' | append: n | append: '_body' -%}
          {%- assign k_ic = 'path' | append: n | append: '_icon' -%}{%- assign ic = section.settings[k_ic] -%}
          <article class="rd-card rd-stamp spr-card rd-reveal">
            {%- if ic != blank and ic != 'none' -%}<span class="rd-path__ic spr-ic">{%- case ic -%}
                {%- when 'tool' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M4 26L20 10" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M18 8l6 6-3 3-6-6z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M22 4l6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle class="rd-pic__a" cx="7" cy="7" r="2"/></svg>
                {%- when 'skills' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="8" y="3" width="16" height="26" rx="3" stroke="currentColor" stroke-width="2"/><path d="M12 10h8M12 15h8M12 20h5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle class="rd-pic__a" cx="26" cy="6" r="2"/></svg>
                {%- when 'confidence' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 4l3.5 7 7.5 1-5.5 5.3 1.3 7.7L16 21.4 9.2 25l1.3-7.7L5 12l7.5-1z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle class="rd-pic__a" cx="16" cy="16" r="2"/></svg>
                {%- when 'bike' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="8" cy="22" r="5" stroke="currentColor" stroke-width="2"/><circle cx="24" cy="22" r="5" stroke="currentColor" stroke-width="2"/><path d="M8 22l5-10h7l4 10M13 12l-2-4h4M20 12l3-5" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle class="rd-pic__a" cx="23.5" cy="6.5" r="2"/></svg>
                {%- when 'ladder' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M9 2v28M23 2v28" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M9 9h14M9 16h14M9 23h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle class="rd-pic__a" cx="26.5" cy="5" r="2"/></svg>
                {%- when 'balance' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="8" cy="22" r="5" stroke="currentColor" stroke-width="2"/><circle cx="24" cy="22" r="5" stroke="currentColor" stroke-width="2"/><path d="M8 22l4-9h6l6 9" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 13l-2-4h3M18 13l3-5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle class="rd-pic__a" cx="21.6" cy="7.4" r="1.8"/></svg>
                {%- when 'family' -%}<svg class="rd-pic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="11" cy="9" r="4" stroke="currentColor" stroke-width="2"/><circle cx="23" cy="13" r="3" stroke="currentColor" stroke-width="2"/><path d="M3 28c0-6 3.5-9 8-9s8 3 8 9M17 28c0-4 2.5-6.5 6-6.5s6 2.5 6 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle class="rd-pic__a" cx="27" cy="5" r="2"/></svg>
              {%- endcase -%}</span>{%- endif -%}
            {%- if section.settings[k_img] != blank -%}
            <div class="spr-media"><img src="{{ section.settings[k_img] | asset_url }}&width=900"
                 srcset="{{ section.settings[k_img] | asset_url }}&width=500 500w, {{ section.settings[k_img] | asset_url }}&width=900 900w"
                 sizes="(max-width:749px) 92vw, 30vw" alt="{{ section.settings[k_ttl] | escape }}" loading="lazy" width="900" height="563"></div>
            {%- endif -%}
            <div class="rd-body">
              <span class="rd-tag rd-lime">{{ section.settings[k_tag] }}</span>
