      "label": "CTA 1 link (defaults to the prisons page)"
    },
    {
      "type": "text",
      "id": "cta2_label",
      "label": "CTA 2 label",
      "default": "Fund a cohort"
    },
    {
      "type": "url",
      "id": "cta2_url",
      "label": "CTA 2 link (defaults to Back the mission)"
    },
    {
      "type": "text",
      "id": "fab_spec",
      "label": "Spec micro-line (fabrication device)",
      "default": "qualification — OCN Level 2 · Workshop Skills and Sustainable Manufacturing"
