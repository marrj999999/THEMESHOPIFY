{% comment %}
  BBC Complete Your Build - Upsell/Cross-sell Section
  Shows complementary products for the current product
{% endcomment %}

<div class="bbc-complete-build section-{{ section.id }}" style="background: {{ section.settings.background_color }}; padding: 3rem 2rem;">
  <div class="page-width">
    <div style="text-align: center; margin-bottom: 2rem;">
      <h2 style="font-family: var(--font-heading-family); color: #1A1A1A; margin-bottom: 0.5rem;">
        {{ section.settings.title | default: "Complete Your Build" }}
      </h2>
      <p style="color: var(--bbc-gray-500);">
        {{ section.settings.subtitle | default: "Everything you need to finish your bamboo bicycle" }}
      </p>
    </div>
    
    <div class="bbc-complete-build__grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.5rem;">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          <div class="bbc-complete-build__item" style="background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
            <a href="{{ product.url }}" style="display: block;">
              {% if product.featured_image %}
                <img src="{{ product.featured_image | image_url: width: 400 }}" 
                  alt="{{ product.title }}"
                  width="400"
                  height="400"
                  style="width: 100%; aspect-ratio: 1; object-fit: cover;"
                  loading="lazy">
              {% endif %}
            </a>
            <div style="padding: 1rem;">
              <a href="{{ product.url }}" style="text-decoration: none;">
                <h4 style="color: #1A1A1A; font-size: 0.9rem; margin-bottom: 0.25rem; line-height: 1.3;">
                  {{ product.title }}
                </h4>
              </a>
              <div style="color: #2D5A3D; font-weight: bold; margin-bottom: 0.75rem;">
                {{ product.price | money }}
              </div>
              <form method="post" action="{{ routes.cart_add_url }}">
                <input type="hidden" name="id" value="{{ product.variants.first.id }}">
                <button type="submit" style="
                  width: 100%;
                  background: #2D5A3D;
                  color: white;
                  border: none;
                  padding: 0.5rem;
                  border-radius: 4px;
                  font-size: 0.8rem;
                  cursor: pointer;
                ">
                  Add to Cart
                </button>
              </form>
            </div>
          </div>
        {% endfor %}
      {% else %}
        {% for block in section.blocks %}
          {% assign upsell_product = block.settings.product %}
          {% if upsell_product != blank %}
            <div class="bbc-complete-build__item" style="background: white; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08);">
              <a href="{{ upsell_product.url }}" style="display: block;">
                {% if upsell_product.featured_image %}
                  <img src="{{ upsell_product.featured_image | image_url: width: 400 }}" 
                    alt="{{ upsell_product.title }}"
                    width="400"
                    height="400"
                    style="width: 100%; aspect-ratio: 1; object-fit: cover;"
                    loading="lazy">
                {% endif %}
              </a>
              <div style="padding: 1rem;">
                <a href="{{ upsell_product.url }}" style="text-decoration: none;">
                  <h4 style="color: #1A1A1A; font-size: 0.9rem; margin-bottom: 0.25rem;">
                    {{ upsell_product.title }}
                  </h4>
                </a>
                <div style="color: #2D5A3D; font-weight: bold; margin-bottom: 0.75rem;">
                  {{ upsell_product.price | money }}
                </div>
                <form method="post" action="{{ routes.cart_add_url }}">
                  <input type="hidden" name="id" value="{{ upsell_product.variants.first.id }}">
                  <button type="submit" style="
                    width: 100%;
                    background: #2D5A3D;
                    color: white;
                    border: none;
                    padding: 0.5rem;
                    border-radius: 4px;
                    font-size: 0.8rem;
                    cursor: pointer;
                  ">
                    Add to Cart
                  </button>
                </form>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      {% endif %}
    </div>
    
    {% if section.settings.bundle_discount != blank %}
      <div style="text-align: center; margin-top: 2rem; padding: 1rem; background: #C9A959; border-radius: 8px;">
        <span style="color: #1A1A1A; font-weight: 500;">
          💰 {{ section.settings.bundle_discount }}
        </span>
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "BBC Complete Build",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "Complete Your Build"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Everything you need to finish your bamboo bicycle"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection (optional)"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4,
      "label": "Products to Show"
    },
    {
      "type": "text",
      "id": "bundle_discount",
      "label": "Bundle Discount Message",
      "default": "Buy a Frame Kit + Component Pack together and save 10%"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#F5F2EB"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Complete Build"
    }
  ]
}
{% endschema %}
