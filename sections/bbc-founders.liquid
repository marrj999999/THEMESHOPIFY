{% comment %}
  BBC Founders Section — Clean side-by-side founder cards
{% endcomment %}

{%- style -%}
  .bbc-founders {
    padding: 80px 24px;
    background: var(--bbc-white, var(--bbc-white));
  }

  .bbc-founders__container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .bbc-founders__header {
    text-align: center;
    margin-bottom: 56px;
  }

  .bbc-founders__label {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--bbc-teal, var(--bbc-teal));
    margin-bottom: 12px;
  }

  .bbc-founders__heading {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--bbc-forest, var(--bbc-forest));
    margin: 0 0 16px 0;
  }

  .bbc-founders__intro {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 1.125rem;
    color: var(--bbc-text-muted, #64748b);
    max-width: 700px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .bbc-founders__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 48px;
  }

  @media (min-width: 481px) {
    .bbc-founders__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 48px;
    }
  }

  @media (min-width: 769px) {
    .bbc-founders__grid--4 {
      grid-template-columns: repeat(4, 1fr);
      gap: 40px;
    }
  }

  .bbc-founders__card {
    text-align: center;
  }

  .bbc-founders__image-wrap {
    margin-bottom: 24px;
    display: flex;
    justify-content: center;
  }

  .bbc-founders__image-wrap img {
    border-radius: 50% !important;
  }

  .bbc-founders__image {
    width: 200px;
    height: 200px;
    border-radius: 50% !important;
    -webkit-border-radius: 50% !important;
    object-fit: cover;
    border: 4px solid var(--bbc-cream, var(--bbc-cream));
    box-shadow: 0 8px 24px rgba(0,0,0,0.1);
    display: block;
    margin: 0 auto;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .bbc-founders__placeholder {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--bbc-forest) 0%, var(--bbc-teal) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
  }

  .bbc-founders__placeholder .material-symbols-outlined {
    font-size: 64px;
    color: rgba(255,255,255,0.3);
  }

  .bbc-founders__name {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--bbc-forest, var(--bbc-forest));
    margin: 0 0 4px 0;
  }

  .bbc-founders__role {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--bbc-teal, var(--bbc-teal));
    margin-bottom: 8px;
  }

  .bbc-founders__location {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.8125rem;
    color: var(--bbc-text-muted, #64748b);
    margin-bottom: 16px;
  }

  .bbc-founders__location .material-symbols-outlined {
    font-size: 14px;
  }

  .bbc-founders__bio {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 1rem;
    color: var(--bbc-text-muted, #64748b);
    line-height: 1.7;
    max-width: 400px;
    margin: 0 auto;
  }

  .bbc-founders__social {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 20px;
  }

  .bbc-founders__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    background: var(--bbc-cream);
    border-radius: 50%;
    color: var(--bbc-forest);
    transition: background 0.2s ease, color 0.2s ease;
  }

  .bbc-founders__social a:hover {
    background: var(--bbc-forest);
    color: white;
  }

  .bbc-founders__social svg {
    width: 16px;
    height: 16px;
  }

  @media (max-width: 480px) {
    .bbc-founders {
      padding: 48px 16px;
    }

    .bbc-founders__image,
    .bbc-founders__placeholder {
      width: 140px;
      height: 140px;
      border-radius: 50% !important;
    }

    .bbc-founders__bio {
      font-size: 0.9375rem;
      line-height: 1.6;
    }
  }
{%- endstyle -%}

<section class="bbc-founders">
  <div class="bbc-founders__container">
    <div class="bbc-founders__header">
      {% if section.settings.label != blank %}
        <div class="bbc-founders__label">{{ section.settings.label }}</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="bbc-founders__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.intro != blank %}
        <p class="bbc-founders__intro">{{ section.settings.intro }}</p>
      {% endif %}
    </div>

    <div class="bbc-founders__grid{% if section.blocks.size >= 4 %} bbc-founders__grid--4{% endif %}">
      {% for block in section.blocks %}
        <div class="bbc-founders__card" {{ block.shopify_attributes }}>
          <div class="bbc-founders__image-wrap">
            {% if block.settings.image != blank %}
              <img 
                src="{{ block.settings.image | image_url: width: 400 }}" 
                alt="{{ block.settings.name }}"
                class="bbc-founders__image"
                width="200"
                height="200"
                loading="lazy"
              >
            {% else %}
              <div class="bbc-founders__placeholder">
                {% render 'bbc-icons', icon: 'person' %}
              </div>
            {% endif %}
          </div>
          <h3 class="bbc-founders__name">{{ block.settings.name }}</h3>
          <div class="bbc-founders__role">{{ block.settings.role }}</div>
          {% if block.settings.location != blank %}
            <div class="bbc-founders__location">
              {% render 'bbc-icons', icon: 'map-pin' %}
              {{ block.settings.location }}
            </div>
          {% endif %}
          <p class="bbc-founders__bio">{{ block.settings.bio }}</p>
          
          {% if block.settings.linkedin != blank or block.settings.instagram != blank %}
            <div class="bbc-founders__social">
              {% if block.settings.linkedin != blank %}
                <a href="{{ block.settings.linkedin }}" target="_blank" rel="noopener" aria-label="LinkedIn">
                  {% render 'bbc-icons', icon: 'linkedin', size: 16 %}
                </a>
              {% endif %}
              {% if block.settings.instagram != blank %}
                <a href="{{ block.settings.instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
                  {% render 'bbc-icons', icon: 'instagram', size: 16 %}
                </a>
              {% endif %}
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BBC Founders",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Section label",
      "default": "The Team"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Meet the Founders"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Two friends who believe everyone should have the chance to build something meaningful with their hands."
    }
  ],
  "blocks": [
    {
      "type": "founder",
      "name": "Founder",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Photo"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "James Marr"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Co-Founder & CEO"
        },
        {
          "type": "text",
          "id": "location",
          "label": "Location",
          "default": "London, UK"
        },
        {
          "type": "textarea",
          "id": "bio",
          "label": "Bio",
          "default": "James learned to build bamboo bicycles in Canada before returning to London to share this knowledge. He leads BBC's mission to make sustainable craftsmanship accessible to all."
        },
        {
          "type": "url",
          "id": "linkedin",
          "label": "LinkedIn URL"
        },
        {
          "type": "url",
          "id": "instagram",
          "label": "Instagram URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Founders",
      "blocks": [
        {
          "type": "founder",
          "settings": {
            "name": "James Marr",
            "role": "Founder & CEO",
            "location": "London, UK",
            "bio": "James learned to build bamboo bicycles in Canada before returning to London to share this knowledge. He leads BBC's mission to make sustainable craftsmanship accessible to all."
          }
        },
        {
          "type": "founder",
          "settings": {
            "name": "Toulouse Workshop",
            "role": "Workshop Partner",
            "location": "Toulouse, France",
            "bio": "BBC's French home, bringing bamboo bike building to the heart of cycling country. Workshops available in French and English."
          }
        },
        {
          "type": "founder",
          "settings": {
            "name": "Amersfoort Workshop",
            "role": "Workshop Partner",
            "location": "Amersfoort, Netherlands",
            "bio": "Our Dutch workshop serving the Netherlands and surrounding regions. Building a thriving community of European bamboo bike builders."
          }
        }
      ]
    }
  ]
}
{% endschema %}
