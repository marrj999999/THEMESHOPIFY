{%- comment -%}
  BBC New Design (2026) — PRODUCT page. Single self-contained section that
  renders on a Shopify product template and integrates the real {{ product }}
  object for commerce (JS-free {% form 'product' %} add-to-cart).
  Scoped under .bbc-rd / .bbc-rd-product via bbc-redesign-2026.css so it cannot
  affect other sections. Built from the Claude Design handoff (product.html —
  "Gravel Frame Build Kit") with verified BBC copy/specs folded in from the
  existing theme sections (bbc-kit-complete, bbc-kit-whats-included,
  bbc-kit-reviews, bbc-kit-confidence, bbc-product-build-time,
  bbc-product-durability) and templates/product.kit-gravel.json.

  Content policy (hard rules):
    - No prison is ever named — the funding tie-in is generic
      ("funds accredited skills courses inside prisons and schools").
    - Only source-of-truth figures are hardcoded as defaults:
        Gravel kit from £385 · component pack from £425 · 4,000+ builders
        · <1% failure · Swansea-tested · 8–12 yr life · build 25–35 hrs
        · Swansea-tested bamboo · ships ~2×/week · Cycle to Work.
    - The ★4.8 / 214 reviews / "98% would build again" numbers from the design
      are NOT verified — they are editable settings flagged for James to
      replace with real review data.
    - All non-product copy, ratings, links, images and repeating groups are
      editable via {% schema %}; images fall back to bundled bbc-rd-*.jpg.

  Structure: breadcrumb + 2-col top (gallery | buy box) → funding-loop tie-in
  (dark) → "complete your build" bundle → "what you'll need at home" 3 cards →
  spec strip (4) → build steps (4, numbered) → why-bamboo + what's-included
  split → in-kit / not-in-kit 2 cards → reviews → trust stats (4) → FAQ →
  related kits → sticky buy bar.

  NOTE: a literal {% schema %} string may appear in this header comment; the
  real, JSON-validatable schema is the LAST {% schema %}…{% endschema %} block.
{%- endcomment -%}


{%- comment -%} Defensive: load the redesign stylesheet here too, so kit pages are styled even when the active header group isn't bbc-header-2026 (idempotent — the browser dedupes by URL). {%- endcomment -%}
{{ 'bbc-redesign-2026.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign crumb_home = section.settings.crumb_home_url | default: '/'
  assign crumb_kits = section.settings.crumb_kits_url | default: '/collections/home-build-kits'
  assign loop_url   = section.settings.loop_url | default: '/pages/impact'
  assign bundle_url = section.settings.bundle_url | default: '/collections/component-packs'
  assign reviews_url = section.settings.reviews_url | default: '#bbc-rd-reviews'
-%}

<div class="bbc-rd bbc-rd-product">

  {%- comment -%} ============== TOP: BREADCRUMB + GALLERY/BUYBOX ============== {%- endcomment -%}
  {%- if product -%}
    {%- assign cv = product.selected_or_first_available_variant -%}
    <section class="rd-section rd-pad-sm">
      <div class="rd-wrap">

        <nav class="rd-crumb rd-cmp-61169" aria-label="Breadcrumb">
          <a class="rd-c-subtle-o1" href="{{ crumb_home }}">Home</a>
          <span class="rd-sep">/</span>
          <a class="rd-c-subtle-o1" href="{{ crumb_kits }}">Frame Kits</a>
          <span class="rd-sep">/</span>
          <span class="rd-here rd-c-ink">{{ product.title }}</span>
        </nav>

        <div class="rd-grid rd-cmp-45496">

          {%- comment -%} ---------- GALLERY ---------- {%- endcomment -%}
          <div>
            <div class="rd-cmp-22077">
              {%- if product.featured_image -%}
                <img class="rd-img-cover" id="bbc-rd-main-img"
                     src="{{ product.featured_image | image_url: width: 1200 }}"
                     srcset="{{ product.featured_image | image_url: width: 400 }} 400w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 800 }} 800w, {{ product.featured_image | image_url: width: 1200 }} 1200w, {{ product.featured_image | image_url: width: 1600 }} 1600w"
                     sizes="(min-width: 750px) 50vw, 100vw"
                     alt="{{ product.featured_image.alt | default: product.title | escape }}"
                     width="{{ product.featured_image.width }}"
                     height="{{ product.featured_image.height }}"
                    
                     fetchpriority="high" loading="eager">
              {%- else -%}
                <img class="rd-img-cover" id="bbc-rd-main-img"
                     src="{{ section.settings.gallery_fallback | default: 'bbc-rd-prod-gravel.jpg' | asset_url }}"
                     alt="{{ product.title | escape }}"
                     width="1000" height="1000"
                    
                     fetchpriority="high" loading="eager">
              {%- endif -%}
            </div>

            {%- if product.images.size > 1 -%}
              <div class="rd-cmp-31841" id="bbc-rd-thumbs">
                {%- for image in product.images limit: 8 -%}
                  <button type="button"
                          data-bbc-src="{{ image | image_url: width: 1200 }}"
                          aria-label="View image {{ forloop.index }}"
                          class="rd-thumb-btn{% if forloop.first %} rd-sel{% endif %}">
                    <img class="rd-img-cover" src="{{ image | image_url: width: 240 }}"
                         alt="{{ image.alt | default: product.title | escape }}"
                         width="{{ image.width }}" height="{{ image.height }}"
                        
                         loading="lazy">
                  </button>
                {%- endfor -%}
              </div>
            {%- endif -%}
          </div>

          {%- comment -%} ---------- BUY BOX ---------- {%- endcomment -%}
          <div class="rd-cmp-02745">
            {%- if section.settings.product_badge != blank -%}
              <span class="rd-tag rd-lime rd-mb-14px">{{ section.settings.product_badge }}</span>
            {%- endif -%}

            <h1 class="rd-cmp-62520">{{ product.title }}</h1>

            {%- if section.settings.difficulty_label != blank or section.settings.build_time_label != blank -%}
              <div class="rd-flex rd-mt-18px" style="gap:8px;flex-wrap:wrap;">
                {%- if section.settings.difficulty_label != blank -%}<span class="rd-tag">{{ section.settings.difficulty_label }}</span>{%- endif -%}
                {%- if section.settings.build_time_label != blank -%}<span class="rd-tag">{{ section.settings.build_time_label }}</span>{%- endif -%}
              </div>
            {%- endif -%}

            {%- if section.settings.rating_value != blank -%}
            <div class="rd-flex rd-cmp-08680">
              <span class="rd-cmp-99447" aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
              <b class="rd-fw-800">{{ section.settings.rating_value }}</b>
              <a class="rd-cmp-53515" href="{{ reviews_url }}">· {{ section.settings.review_count }} builder reviews</a>
            </div>
            {%- else -%}
            <div class="rd-flex rd-cmp-08680">
              <a class="rd-cmp-09075" href="{{ reviews_url }}">Builder reviews &rarr;</a>
            </div>
            {%- endif -%}

            {%- if section.settings.product_subtitle != blank -%}
              <p class="rd-lede rd-mt-18px">{{ section.settings.product_subtitle }}</p>
            {%- endif -%}

            <div class="rd-cmp-24279">
              <span class="rd-cmp-99566">
                {%- if product.price_varies -%}
                  From {{ product.price_min | money_without_trailing_zeros }}
                {%- else -%}
                  {{ cv.price | money_without_trailing_zeros }}
                {%- endif -%}
              </span>
              {%- if cv.compare_at_price and cv.compare_at_price > cv.price -%}
                <span class="rd-was-price">{{ cv.compare_at_price | money_without_trailing_zeros }}</span>
              {%- endif -%}
            </div>

            <div class="rd-flex rd-cmp-15126">
              <span class="rd-cmp-93984"></span>
              {{ section.settings.stock_line }}
            </div>

            {%- comment -%} ---------- ADD TO CART (JS-free) ---------- {%- endcomment -%}
            {% form 'product', product, id: 'bbc-buy-form' %}
              {%- if product.has_only_default_variant == false -%}
                <span class="rd-frame-label rd-cmp-04367">Choose your size / option</span>
                <div class="rd-cmp-30367">
                  {%- for v in product.variants -%}
                    <label class="rd-vbtn{% if v == cv %} rd-sel{% endif %}{% unless v.available %} rd-oos{% endunless %}">
                      <input class="rd-ac-forest" type="radio" name="id" value="{{ v.id }}" {% if v == cv %}checked{% endif %} {% unless v.available %}disabled{% endunless %}>
                      {{ v.title }} — {{ v.price | money_without_trailing_zeros }}
                    </label>
                  {%- endfor -%}
                </div>
              {%- else -%}
                <input type="hidden" name="id" value="{{ cv.id }}">
              {%- endif -%}

              <span class="rd-frame-label rd-cmp-21769">Quantity</span>
              <input class="rd-cmp-88753" type="number" name="quantity" value="1" min="1" aria-label="Quantity"
                    >

              <div class="rd-flex rd-cmp-44006">
                <button type="submit" name="add" class="rd-btn rd-lime rd-flex1-jc" {% unless product.available %}disabled{% endunless %}>
                  {%- if product.available -%}Add to cart{%- else -%}Sold out{%- endif -%}
                </button>
                {%- if section.settings.secondary_label != blank -%}
                  <a class="rd-btn rd-ghost" href="{{ section.settings.secondary_url | default: '/pages/bicycle-frame-building-workshop' }}">{{ section.settings.secondary_label }}</a>
                {%- endif -%}
              </div>
            {% endform %}

            {%- if section.settings.reassure_line != blank -%}
              <p class="rd-center rd-cmp-86881">{{ section.settings.reassure_line }}</p>
            {%- endif -%}

            {%- comment -%} Point-of-purchase mission line (social-value proof beside the buy button). {%- endcomment -%}
            {%- if section.settings.mission_line != blank -%}
              <p class="rd-product-mission">{{ section.settings.mission_line }}</p>
            {%- endif -%}

            {%- comment -%} ---------- BUILD WITH A BUDDY ---------- {%- endcomment -%}
            {%- if section.settings.buddy_text != blank -%}
              <div class="rd-cmp-58136">
                <span class="rd-fw-800" aria-hidden="true">&#128101;</span>
                <span>{{ section.settings.buddy_text }}</span>
              </div>
            {%- endif -%}

            {%- comment -%} ---------- PERKS (blocks) ---------- {%- endcomment -%}
            {%- assign perks = section.blocks | where: 'type', 'perk' -%}
            {%- if perks.size > 0 -%}
              <ul class="rd-list rd-mt-18px">
                {%- for block in perks -%}
                  <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

        </div>
      </div>
    </section>
  {%- else -%}
    {%- comment -%} Non-product context (degraded): editor placeholder only. {%- endcomment -%}
    {%- if request.design_mode -%}
      <section class="rd-section rd-pad-sm">
        <div class="rd-wrap rd-center">
          <span class="rd-eyebrow">Product section</span>
          <h2>Add this section to a product template</h2>
          <p class="rd-lede rd-maxw rd-m-14pxauto0">The gallery and buy box render once this section is on a product page. The content below is editable now.</p>
        </div>
      </section>
    {%- endif -%}
  {%- endif -%}

  {%- comment -%} ============== HIGHLIGHTS (image + headline + paragraph — Baymard pattern) ============== {%- endcomment -%}
  {%- assign highlights = section.blocks | where: 'type', 'highlight' -%}
  {%- if highlights.size > 0 -%}
    <section class="rd-section rd-pad-sm">
      <div class="rd-wrap">
        {%- if section.settings.highlights_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.highlights_eyebrow }}</span>{%- endif -%}
        {%- if section.settings.highlights_heading != blank -%}<h2 class="rd-mw-22ch">{{ section.settings.highlights_heading }}</h2>{%- endif -%}
        <div class="rd-highlights rd-mt4">
          {%- for block in highlights -%}
            <div class="rd-highlight" {{ block.shopify_attributes }}>
              <div class="rd-highlight__media">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 760 }}" alt="{{ block.settings.heading | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
                {%- else -%}
                  <img src="{{ block.settings.fallback | default: 'bbc-rd-bamboo-tubes.jpg' | asset_url }}" alt="{{ block.settings.heading | escape }}" width="760" height="500" loading="lazy">
                {%- endif -%}
              </div>
              <div class="rd-highlight__body">
                <h3 class="rd-fs-21px">{{ block.settings.heading }}</h3>
                <p class="rd-mt1">{{ block.settings.body }}</p>
              </div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ============== SIZE & FIT (real bands + build-to-fit honesty) ============== {%- endcomment -%}
  {%- if section.settings.show_sizing -%}
    <section class="rd-section rd-pad-sm" id="bbc-rd-sizing">
      <div class="rd-wrap">
        {%- if section.settings.sizing_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.sizing_eyebrow }}</span>{%- endif -%}
        <h2 class="rd-mw-22ch">{{ section.settings.sizing_heading | default: "Built to fit you" }}</h2>
        <div class="rd-grid rd-g2 rd-mt3">
          <div>{% render 'bbc-size-data' %}</div>
          <div class="rd-card rd-stamp"><div class="rd-body">
            {%- if section.settings.sizing_body != blank -%}<div class="rd-lede">{{ section.settings.sizing_body }}</div>{%- endif -%}
            <p class="rd-mt2">{{ section.settings.sizing_note | default: "Your frame's size is set on the jig you build on — so pick the size that matches your fit, then fine-tune with seatpost, stem and saddle. Being between sizes is normal: build the smaller one." }}</p>
            <a class="rd-btn rd-ghost rd-mt2" href="{{ section.settings.custom_url | default: '/products/custom-frame' }}">{{ section.settings.custom_cta | default: "Outside these sizes? Build a custom frame" }} <span class="rd-arrow" aria-hidden="true">&#8594;</span></a>
          </div></div>
        </div>
        {%- assign geo = section.blocks | where: 'type', 'geometry' -%}
        {%- if geo.size > 0 -%}
          <h3 class="rd-mt4 rd-fs-21px">{{ section.settings.geo_heading | default: "Frame geometry" }}</h3>
          <table class="bbc-geo-table rd-mt2">
            {%- for b in geo -%}
              <tr {{ b.shopify_attributes }}><th scope="row">{{ b.settings.label }}</th><td>{{ b.settings.value }}</td></tr>
            {%- endfor -%}
          </table>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ============== FUNDING LOOP TIE-IN (dark) ============== {%- endcomment -%}
  <section class="rd-section rd-pad-sm rd-dark">
    <div class="rd-wrap rd-center">
      {%- if section.settings.loop_eyebrow != blank -%}
        <span class="rd-eyebrow rd-on-dark">{{ section.settings.loop_eyebrow }}</span>
      {%- endif -%}
      <h2 class="rd-cmp-97576">{{ section.settings.loop_heading }}</h2>
      <div class="rd-loop rd-mt3">
        <div class="rd-step"><div class="rd-big">{{ section.settings.loop_step1_big }}</div><div class="rd-sm">{{ section.settings.loop_step1_sm }}</div></div>
        <div class="rd-arr" aria-hidden="true">&#8594;</div>
        <div class="rd-step"><div class="rd-big">{{ section.settings.loop_step2_big }}</div><div class="rd-sm">{{ section.settings.loop_step2_sm }}</div></div>
        <div class="rd-arr" aria-hidden="true">&#8594;</div>
        <div class="rd-step"><div class="rd-big">{{ section.settings.loop_step3_big }}</div><div class="rd-sm">{{ section.settings.loop_step3_sm }}</div></div>
      </div>
      {%- if section.settings.loop_cta_label != blank -%}
        <a class="rd-btn rd-on-dark rd-mt3" href="{{ loop_url }}">{{ section.settings.loop_cta_label }} <span class="rd-arrow" aria-hidden="true">&#8594;</span></a>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ============== COMPLETE YOUR BUILD (bundle) ============== {%- endcomment -%}
  <section class="rd-section rd-pad-sm rd-paper">
    <div class="rd-wrap">
      {%- if section.settings.bundle_eyebrow != blank -%}
        <span class="rd-eyebrow">{{ section.settings.bundle_eyebrow }}</span>
      {%- endif -%}
      <h2 class="rd-mw-20ch">{{ section.settings.bundle_heading }}</h2>
      {%- if section.settings.bundle_lede != blank -%}
        <p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.bundle_lede }}</p>
      {%- endif -%}

      <div class="rd-mt3 rd-cmp-00502">
        <div class="rd-card rd-stamp"><div class="rd-body">
          <div class="rd-frame-label">{{ section.settings.bundle_a_label }}</div>
          <div class="rd-cmp-57334">{% if product.price_varies %}From {{ product.price_min | money_without_trailing_zeros }}{% else %}{{ product.price | money_without_trailing_zeros }}{% endif %}</div>
          <p>{{ section.settings.bundle_a_text }}</p>
        </div></div>
        <div class="rd-cmp-76373" aria-hidden="true">+</div>
        <div class="rd-card rd-stamp"><div class="rd-body">
          <div class="rd-frame-label">{{ section.settings.bundle_b_label }}</div>
          <div class="rd-cmp-57334">{{ section.settings.bundle_b_price }}</div>
          <p>{{ section.settings.bundle_b_text }}</p>
        </div></div>
        <div class="rd-cmp-76373" aria-hidden="true">=</div>
        <div class="rd-card rd-stamp rd-lime"><div class="rd-body">
          <div class="rd-frame-label">{{ section.settings.bundle_total_label }}</div>
          <div class="rd-cmp-57334">{{ section.settings.bundle_total_price }}</div>
          <p>{{ section.settings.bundle_total_text }}</p>
          {%- if section.settings.bundle_cta_label != blank -%}
            <a class="rd-btn rd-lime rd-mt2" href="{{ bundle_url }}">{{ section.settings.bundle_cta_label }} <span class="rd-arrow" aria-hidden="true">&#8594;</span></a>
          {%- endif -%}
        </div></div>
      </div>

      {%- if section.settings.bundle_foot != blank -%}
        <p class="rd-mt2 rd-cmp-64793">{{ section.settings.bundle_foot }}</p>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ============== WHAT YOU'LL NEED AT HOME (3 cards) ============== {%- endcomment -%}
  {%- assign needs = section.blocks | where: 'type', 'need' -%}
  {%- if needs.size > 0 -%}
    <section class="rd-section rd-pad-sm">
      <div class="rd-wrap">
        {%- if section.settings.need_eyebrow != blank -%}
          <span class="rd-eyebrow">{{ section.settings.need_eyebrow }}</span>
        {%- endif -%}
        <h2 class="rd-mw-22ch">{{ section.settings.need_heading }}</h2>
        <div class="rd-grid rd-g3 rd-mt3">
          {%- for block in needs -%}
            <div class="rd-card rd-stamp" {{ block.shopify_attributes }}><div class="rd-body">
              <h3 class="rd-fs-21px">{{ block.settings.title }}</h3>
              <p class="rd-mt1">{{ block.settings.description }}</p>
            </div></div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ============== SPEC STRIP (4) ============== {%- endcomment -%}
  {%- assign specs = section.blocks | where: 'type', 'spec' -%}
  {%- if specs.size > 0 -%}
    <section class="rd-section rd-pad-sm">
      <div class="rd-wrap">
        <div class="rd-spectable" style="grid-template-columns:repeat({{ specs.size }},1fr);">
          {%- for block in specs -%}
            <div class="rd-spec-cell" {{ block.shopify_attributes }}>
              <div class="rd-frame-label">{{ block.settings.label }}</div>
              <div class="rd-cmp-43552">{{ block.settings.value }}</div>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ============== BUILD STEPS (4, numbered) ============== {%- endcomment -%}
  {%- assign steps = section.blocks | where: 'type', 'step' -%}
  {%- if steps.size > 0 -%}
    <section class="rd-section rd-pad">
      <div class="rd-wrap">
        {%- if section.settings.steps_eyebrow != blank -%}
          <span class="rd-eyebrow">{{ section.settings.steps_eyebrow }}</span>
        {%- endif -%}
        <h2 class="rd-mw-18ch">{{ section.settings.steps_heading }}</h2>
        <div class="rd-grid rd-g4 rd-mt4">
          {%- for block in steps -%}
            <div class="rd-card rd-stamp" {{ block.shopify_attributes }}><div class="rd-body">
              <span class="rd-tag rd-lime">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <h3 class="rd-mt2 rd-fs-18px">{{ block.settings.title }}</h3>
              <p class="rd-mt1">{{ block.settings.description }}</p>
            </div></div>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ============== WHY BAMBOO + INCLUDED (split) ============== {%- endcomment -%}
  <section class="rd-section rd-split rd-rev rd-steel">
    <div class="rd-media">
      {%- if section.settings.why_image != blank -%}
        <img src="{{ section.settings.why_image | image_url: width: 1400 }}"
             alt="{{ section.settings.why_image_alt | escape }}"
             width="{{ section.settings.why_image.width }}" height="{{ section.settings.why_image.height }}"
             loading="lazy">
      {%- else -%}
        <img src="{{ section.settings.why_fallback | default: 'bbc-rd-bamboo-tubes.jpg' | asset_url }}"
             alt="{{ section.settings.why_image_alt | escape }}"
             width="1200" height="800" loading="lazy">
      {%- endif -%}
    </div>
    <div class="rd-txt">
      {%- if section.settings.why_eyebrow != blank -%}
        <span class="rd-eyebrow">{{ section.settings.why_eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.why_heading }}</h2>
      {%- if section.settings.why_body != blank -%}
        <p class="rd-lede rd-mt2">{{ section.settings.why_body }}</p>
      {%- endif -%}
      {%- if section.settings.why_quote != blank -%}
        <div class="rd-pull rd-mt3">
          <p class="rd-q">{{ section.settings.why_quote }}</p>
          {%- if section.settings.why_quote_cite != blank -%}
            <cite>{{ section.settings.why_quote_cite }}</cite>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ============== IN-KIT / NOT-IN-KIT (2 cards) ============== {%- endcomment -%}
  <section class="rd-section rd-pad">
    <div class="rd-wrap">
      <div class="rd-grid rd-g2">
        <div class="rd-card rd-stamp"><div class="rd-body">
          <h3 class="rd-fs-21px">{{ section.settings.inkit_heading }}</h3>
          <p class="rd-mt2">{{ section.settings.inkit_body }}</p>
        </div></div>
        <div class="rd-card rd-stamp"><div class="rd-body">
          <h3 class="rd-fs-21px">{{ section.settings.notkit_heading }}</h3>
          <p class="rd-mt2">{{ section.settings.notkit_body }}</p>
        </div></div>
      </div>
    </div>
  </section>

  {%- comment -%} ============== BUILD WITH CONFIDENCE (de-risk: reversibility · tools · support) ============== {%- endcomment -%}
  {%- if section.settings.reversible_body != blank or section.settings.tools_text != blank or section.settings.support_text != blank -%}
    <section class="rd-section rd-pad-sm rd-paper">
      <div class="rd-wrap">
        {%- if section.settings.confidence_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.confidence_eyebrow }}</span>{%- endif -%}
        {%- if section.settings.confidence_heading != blank -%}<h2 class="rd-mw-22ch">{{ section.settings.confidence_heading }}</h2>{%- endif -%}
        <div class="rd-grid rd-g3 rd-mt3">
          {%- if section.settings.reversible_body != blank -%}
