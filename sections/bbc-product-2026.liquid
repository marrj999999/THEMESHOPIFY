        </span>
        <span class="rd-ml-auto"></span>
        <a class="rd-btn rd-lime rd-p-11px22px" href="#bbc-buy-form">Add to cart <span class="rd-arrow" aria-hidden="true">&#8594;</span></a>
      </div>
    </div>
  {%- endif -%}

</div>

{%- comment -%}
  Progressive enhancement only — the page is fully usable without this script:
  thumbnails are real buttons (main image already shows), the sticky bar simply
  stays hidden, and the form/anchors work natively.
{%- endcomment -%}
{%- if product -%}
<script>
  (function () {
    var root = document.getElementById('bbc-rd-thumbs');
    var main = document.getElementById('bbc-rd-main-img');
    if (root && main) {
      root.addEventListener('click', function (e) {
        var btn = e.target.closest('button[data-bbc-src]');
        if (!btn) return;
        main.removeAttribute('srcset'); // clear responsive candidates so the chosen image wins
        main.src = btn.getAttribute('data-bbc-src');
        root.querySelectorAll('button').forEach(function (b) {
          b.classList.toggle('rd-sel', b === btn);
        });
      });
    }
    var bar = document.getElementById('bbc-rd-stickybar');
    var form = document.getElementById('bbc-buy-form');
    if (bar && form && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (en) {
          var below = en.boundingClientRect.top < 0;
          bar.style.transform = (!en.isIntersecting && below) ? 'none' : 'translateY(110%)';
        });
      }, { threshold: 0 });
      io.observe(form);
    }
  })();
</script>
{%- endif -%}

