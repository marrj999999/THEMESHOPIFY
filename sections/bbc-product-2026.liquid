            </a>
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ============== PRODUCT STRUCTURED DATA (JSON-LD) — no aggregateRating (ratings hidden) ============== {%- endcomment -%}
  {%- if product -%}
    <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 300 | json }},
      {%- if product.featured_image -%}"image": [{{ product.featured_image | image_url: width: 1200 | json }}],{%- endif -%}
      "brand": { "@type": "Brand", "name": "Bamboo Bicycle Club" },
      {%- if cv.sku != blank -%}"sku": {{ cv.sku | json }},{%- endif -%}
      "offers": {
        "@type": "Offer",
        "url": {{ shop.url | append: product.url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ cv.price | divided_by: 100.0 }},
        "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}"
      }
    }
    </script>
  {%- endif -%}

