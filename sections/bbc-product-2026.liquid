              <div class="rd-ph">
                {%- if block.settings.image != blank -%}
                  <img src="{{ block.settings.image | image_url: width: 600 }}"
                       alt="{{ block.settings.title | escape }}"
                       width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"
                       loading="lazy">
                {%- else -%}
                  <img src="{{ block.settings.fallback | default: 'bbc-rd-prod-flax.jpg' | asset_url }}"
                       alt="{{ block.settings.title | escape }}"
                       width="1000" height="1000" loading="lazy">
