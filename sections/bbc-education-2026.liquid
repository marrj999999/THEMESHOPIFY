    },
    {
      "type": "text",
      "id": "vid_eyebrow",
      "label": "Eyebrow",
      "default": "See it first"
    },
    {
      "type": "text",
      "id": "vid_title",
      "label": "Heading",
      "default": "watch the free speaker build, start to finish."
    },
    {
      "type": "textarea",
      "id": "vid_lede",
      "label": "Lede",
      "default": "A complete STEM project on camera — so you can see exactly what your class would make before you ask for anything."
    },
    {
      "type": "text",
      "id": "video_id",
      "label": "YouTube video ID",
