{%- comment -%}
  BBC New Design (2026) — EDUCATION page ("Make Engineers"), single self-contained section.
  This is a PUBLIC ADVERT / POSTER for the schools/colleges/youth engineering programmes — NOT an
  operations page. It does NOT link into the separate instructor app; the app provides all the
  operational context (session plans, build guides, curriculum maps) to people once they're in it.
  The advert's only job: make a school/teacher want it and get in touch. The Speaker build is FREE
  (the hook); every other programme is a paid investment, priced by quote (no public price). Every
  CTA drives an ENQUIRY (contact page / on-page enquiry block / email). Prison work lives on the
  Impact page; corporate on Team-Building. Generic by design. Scoped under .bbc-rd.
{%- endcomment -%}

{%- liquid
  assign enquire_url = section.settings.enquiry_url | default: '/pages/contact-us'
  assign email_url   = section.settings.enquiry_email | default: 'mailto:info@bamboobicycleclub.org'
  assign hero_cta1   = section.settings.hero_cta1_url | default: '#enquire'
  assign hero_cta2   = section.settings.hero_cta2_url | default: enquire_url
  assign fund_cta    = section.settings.fund_cta_url | default: '#enquire'
  assign cta1_url    = section.settings.cta1_url | default: enquire_url
  assign cta2_url    = section.settings.cta2_url | default: email_url
-%}

<div class="bbc-rd bbc-rd-education">

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  <header class="rd-hero rd-mh-70">
    <div class="rd-bg">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 1600 }} 1600w, {{ section.settings.hero_image | image_url: width: 2000 }} 2000w" sizes="100vw" alt="{{ section.settings.hero_image_alt | default: 'Students building with bamboo' | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high" loading="eager">
      {%- else -%}
        <img src="{{ section.settings.hero_fallback | default: 'bbc-rd-workshop.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | default: 'Students building with bamboo' | escape }}" width="1400" height="933" fetchpriority="high" loading="eager">
      {%- endif -%}
    </div>
    <div class="rd-scrim"></div>
    <div class="rd-inner">
      <div class="rd-wrap">
        <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><span class="rd-here">Schools</span></nav>
        {%- if section.settings.hero_eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1 class="rd-mt2 rd-mw-18ch">{{ section.settings.hero_title }}</h1>
        <div class="rd-lede">{{ section.settings.hero_lede }}</div>
        <div class="rd-cta-row">
          {%- if section.settings.hero_cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ hero_cta1 }}">{{ section.settings.hero_cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
          {%- if section.settings.hero_cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ hero_cta2 }}">{{ section.settings.hero_cta2_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </header>

  {%- comment -%} ---------- PROOF STATS (dark) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-dark">
    <div class="rd-wrap">
      <div class="rd-stats">
        {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}
          <div class="rd-reveal rd-stat" {{ block.shopify_attributes }}>
            <div class="rd-num bbc-counted">{{ block.settings.number }}</div>
            <div class="rd-lbl">{{ block.settings.label }}</div>
            {%- if block.settings.source != blank -%}<div class="rd-src">{{ block.settings.source }}</div>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- AS TAUGHT AT (institution logo grid) ---------- {%- endcomment -%}
  {%- assign partner_blocks = section.blocks | where: 'type', 'partner' -%}
  {%- if partner_blocks.size > 0 -%}
    <section class="rd-pad-sm rd-paper rd-center">
      <div class="rd-wrap">
        <span class="rd-eyebrow">{{ section.settings.taught_eyebrow | default: 'As taught at' }}</span>
        {%- if section.settings.taught_title != blank -%}<h2 class="rd-reveal rd-mt2 rd-mx-auto rd-mw-18ch">{{ section.settings.taught_title }}</h2>{%- endif -%}
        <div class="rd-logogrid rd-mt4">
          {%- for block in partner_blocks -%}
            {%- capture cell -%}
              {%- if block.settings.logo != blank -%}<img width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}" class="rd-logoimg" src="{{ block.settings.logo | image_url: width: 480 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {%- elsif block.settings.logo_asset != blank -%}<img class="rd-logoimg" src="{{ block.settings.logo_asset | asset_url }}" alt="{{ block.settings.name | escape }}" loading="lazy">
              {%- else -%}<span class="rd-logotext">{{ block.settings.name }}</span>{%- endif -%}
            {%- endcapture -%}
            {%- if block.settings.url != blank -%}
              <a class="rd-logocell" href="{{ block.settings.url }}" target="_blank" rel="noopener" aria-label="{{ block.settings.name | escape }} — read the case study">{{ cell }}</a>
            {%- else -%}
              <div class="rd-logocell">{{ cell }}</div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- comment -%} ---------- THE PATHWAY (5 programmes — advert cards, not links) ---------- {%- endcomment -%}
  <section class="rd-pad">
    <div class="rd-wrap">
      <span class="rd-eyebrow">{{ section.settings.prog_eyebrow }}</span>
      <h2 class="rd-reveal rd-mw-16ch">{{ section.settings.prog_title }}</h2>
      {%- if section.settings.prog_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.prog_lede }}</p>{%- endif -%}

      <div class="rd-grid rd-g3 rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'programme' -%}
          <div class="rd-reveal rd-card rd-stamp{% if block.settings.free %} rd-card-free{% endif %}" {{ block.shopify_attributes }}>
            <div class="rd-body">
              <div class="rd-flex rd-between rd-gap-24">
                <span class="rd-frame-label rd-c-subtle">{{ block.settings.tier }}</span>
                {%- if block.settings.status == 'coming' -%}
                  <span class="rd-tag">In development</span>
                {%- elsif block.settings.free -%}
                  <span class="rd-tag rd-lime">Free</span>
                {%- else -%}
                  <span class="rd-tag">{{ block.settings.price_tag | default: 'Request a quote' }}</span>
                {%- endif -%}
              </div>
              <h3 class="rd-fs-21px rd-mt2">{{ block.settings.title }}</h3>
              {%- if block.settings.detail != blank -%}<p class="rd-c-subtle rd-mt-10px">{{ block.settings.detail }}</p>{%- endif -%}
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- TURNKEY (you don't need to be an engineer — NO app link) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-steel">
    <div class="rd-wrap">
      <div class="rd-split rd-tight rd-gap48-ac">
        <div>
          <span class="rd-eyebrow">{{ section.settings.plat_eyebrow }}</span>
          <h2 class="rd-reveal">{{ section.settings.plat_title }}</h2>
          <p class="rd-lede rd-mt2">{{ section.settings.plat_lede }}</p>
          <ul class="rd-list rd-mt3">
            {%- if section.settings.plat_point1 != blank -%}<li>{{ section.settings.plat_point1 }}</li>{%- endif -%}
            {%- if section.settings.plat_point2 != blank -%}<li>{{ section.settings.plat_point2 }}</li>{%- endif -%}
            {%- if section.settings.plat_point3 != blank -%}<li>{{ section.settings.plat_point3 }}</li>{%- endif -%}
            {%- if section.settings.plat_point4 != blank -%}<li>{{ section.settings.plat_point4 }}</li>{%- endif -%}
          </ul>
        </div>
        <div class="rd-reveal rd-card rd-stamp rd-lime">
          <div class="rd-ph rd-ar-43">
            <img src="{{ section.settings.plat_fallback | default: 'bbc-rd-wb-kit.jpg' | asset_url }}" alt="{{ section.settings.plat_image_alt | default: 'Students building with bamboo' | escape }}" width="1200" height="900">
          </div>
          <div class="rd-body">
            <p class="rd-cmp-35205">{{ section.settings.plat_quote }}</p>
            {%- if section.settings.plat_cite != blank -%}<p class="rd-mt-10px">{{ section.settings.plat_cite }}</p>{%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- CASE STUDIES (image-led cards) ---------- {%- endcomment -%}
  {%- assign cs_blocks = section.blocks | where: 'type', 'casestudy' -%}
  {%- if cs_blocks.size > 0 -%}
    <section class="rd-pad-sm">
      <div class="rd-wrap">
        <span class="rd-eyebrow">{{ section.settings.cs_eyebrow }}</span>
        <h2 class="rd-reveal rd-mw-16ch">{{ section.settings.cs_title }}</h2>
        {%- if section.settings.cs_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.cs_lede }}</p>{%- endif -%}

        <div class="rd-csgrid rd-mt4">
          {%- for block in cs_blocks -%}
            {%- assign cs_img = block.settings.image | default: 'bbc-rd-frame-build.jpg' -%}
            {%- assign vid = block.settings.video -%}
            <a class="rd-reveal rd-cscard" href="{{ block.settings.url }}" {{ block.shopify_attributes }}>
              <div class="rd-cscard__media">
                {%- render "bbc-media", src: cs_img, video: block.settings.video_file, youtube: block.settings.video_url | default: block.settings.video, alt: block.settings.institution -%}
                {%- if block.settings.kind != blank -%}<span class="rd-cscard__kind">{{ block.settings.kind }}</span>{%- endif -%}
              </div>
              <div class="rd-cscard__body">
                {%- if block.settings.quote != blank -%}
                  <p class="rd-cscard__quote">{{ block.settings.quote }}</p>
                  {%- if block.settings.attribution != blank -%}<p class="rd-cscard__attr">{{ block.settings.attribution }}</p>{%- endif -%}
                  {%- if block.settings.blurb != blank -%}<p class="rd-cscard__ctx">{{ block.settings.blurb }}</p>{%- endif -%}
                {%- elsif block.settings.blurb != blank -%}
                  <p class="rd-cscard__quote rd-noq">{{ block.settings.blurb }}</p>
                {%- endif -%}
                <div class="rd-cscard__foot">
                  {%- if block.settings.logo != blank -%}<img width="{{ block.settings.logo.width }}" height="{{ block.settings.logo.height }}" class="rd-cscard__logo" src="{{ block.settings.logo | image_url: width: 240 }}" alt="{{ block.settings.institution | escape }}" loading="lazy">
                  {%- elsif block.settings.logo_asset != blank -%}<img class="rd-cscard__logo" src="{{ block.settings.logo_asset | asset_url }}" alt="{{ block.settings.institution | escape }}" loading="lazy">
                  {%- else -%}<span class="rd-cscard__inst">{{ block.settings.institution }}</span>{%- endif -%}
                  <span class="rd-cscard__more">{% if vid != blank %}Watch the film{% else %}{{ block.settings.link_label | default: 'Read the case study' }}{% endif %} <span class="rd-arrow">&rarr;</span></span>
                </div>
              </div>
            </a>
          {%- endfor -%}
        </div>
      </div>
      {% render 'bbc-video-lightbox' %}
    </section>
  {%- endif -%}

  {%- comment -%} ---------- WATCH THE FREE BUILD (video) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-paper rd-center">
    <div class="rd-wrap rd-mw-820px">
      <span class="rd-eyebrow">{{ section.settings.vid_eyebrow | default: 'See it first' }}</span>
      <h2 class="rd-reveal rd-mt2">{{ section.settings.vid_title | default: 'watch the free speaker build, start to finish.' }}</h2>
      <p class="rd-lede rd-mt2">{{ section.settings.vid_lede | default: 'A complete STEM project on camera — so you can see exactly what your class would make before you ask for anything.' }}</p>
      {%- comment -%} standard player (2026-07-22): facade + auto YouTube thumbnail {%- endcomment -%}
      {%- assign ev = section.settings.video_id | default: 'uhN-yv90F_Y' -%}
      <div class="rd-mt3" style="border-radius:14px;overflow:hidden;">
        {%- render 'bbc-media', youtube: ev, label: 'watch the speaker build', alt: 'Bamboo Bicycle Club — schools Speaker build film', class: 'bbc-media--ar169', sizes: '(max-width:749px) 100vw, 900px' -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- FUNDING (reassurance — NO app link) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-center">
    <div class="rd-wrap rd-mw-680px">
      <span class="rd-eyebrow">{{ section.settings.fund_eyebrow }}</span>
      <h2 class="rd-reveal rd-mt2">{{ section.settings.fund_title }}</h2>
      <p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.fund_lede }}</p>
      {%- if section.settings.fund_cta_label != blank -%}<div class="rd-mt3"><a class="rd-btn rd-lime" href="{{ fund_cta }}">{{ section.settings.fund_cta_label }} <span class="rd-arrow">&rarr;</span></a></div>{%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- ACCREDITATION & RECOGNITION ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-paper rd-center">
    <div class="rd-wrap">
      {%- if section.settings.acc_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.acc_eyebrow }}</span>{%- endif -%}
      {%- if section.settings.acc_title != blank -%}<h2 class="rd-reveal rd-mt2">{{ section.settings.acc_title }}</h2>{%- endif -%}
      {%- assign press_blocks = section.blocks | where: 'type', 'press' -%}
      {%- if press_blocks.size > 0 -%}
        <div class="rd-logobar rd-mt3">
          {%- for block in press_blocks -%}
            {%- if block.settings.logo_asset != blank -%}
              {%- capture lg_inner -%}<img class="rd-lg-img" src="{{ block.settings.logo_asset | asset_url }}" alt="{{ block.settings.text | escape }}" loading="lazy">{%- endcapture -%}
              {%- assign lg_class = 'rd-lg rd-lg-real' -%}
            {%- else -%}
              {%- capture lg_inner -%}{%- if block.settings.style == 'bbc' -%}{%- assign letters = block.settings.text | strip | split: '' -%}{%- for ch in letters -%}{%- unless ch == ' ' -%}<b>{{ ch }}</b>{%- endunless -%}{%- endfor -%}{%- else -%}{{ block.settings.text }}{%- endif -%}{%- endcapture -%}
              {%- assign lg_class = 'rd-lg rd-lg-' | append: block.settings.style -%}
              {%- if block.settings.style == 'serif-italic' -%}{%- assign lg_class = 'rd-lg rd-lg-serif rd-it' -%}{%- endif -%}
            {%- endif -%}
            {%- if block.settings.url != blank -%}
              <a class="{{ lg_class }} rd-lg-link" href="{{ block.settings.url }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>{{ lg_inner }}</a>
            {%- else -%}
              <span class="{{ lg_class }}" {{ block.shopify_attributes }}>{{ lg_inner }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
      <div class="rd-flex rd-mt4 rd-jc-center">
        {%- for block in section.blocks -%}{%- if block.type == 'badge' -%}
          <span class="rd-tag{% if block.settings.lime %} rd-lime{% endif %}" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- ENQUIRY CTA (dark) ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark rd-center" id="enquire">
    <div class="rd-wrap rd-mw-680px">
      {%- if section.settings.cta_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.cta_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.cta_title }}</h2>
      <p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.cta_lede }}</p>
      <div class="rd-flex rd-mt3 rd-jc-center">
        {%- if section.settings.cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ cta1_url }}">{{ section.settings.cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ cta2_url }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
  </section>

</div>

{% schema %}
{
  "name": "Education 2026 (new)",
  "tag": "section",
  "class": "section bbc-education-2026-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Enquiry destinations (no app links)"
    },
    {
      "type": "url",
      "id": "enquiry_url",
      "label": "Enquiry / contact link",
      "info": "Where every enquiry CTA goes. Default: /pages/contact-us"
    },
    {
      "type": "url",
      "id": "enquiry_email",
      "label": "Enquiry email link (mailto:)",
      "info": "Default: mailto:info@bamboobicycleclub.org"
    },
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "hero_fallback",
      "label": "Default hero photo filename",
      "default": "bbc-rd-workshop.jpg"
    },
    {
      "type": "text",
      "id": "hero_image_alt",
      "label": "Hero image alt text",
      "default": "A finished bamboo gravel bike, engineered and built by hand"
    },
    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "Make Engineers · schools & colleges"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Headline",
      "default": "try real engineering in your classroom this term — free."
    },
    {
      "type": "textarea",
      "id": "hero_lede",
      "label": "Lede",
      "default": "Your students build a working bamboo speaker from scratch: a complete STEM project, mapped to the curriculum and to careers. No kit to fund, no risk to take."
    },
    {
      "type": "text",
      "id": "hero_cta1_label",
