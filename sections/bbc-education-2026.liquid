    },
    {
      "type": "text",
      "id": "hero_cta2_label",
      "label": "Secondary CTA label",
      "default": "Send us an enquiry"
    },
    {
      "type": "url",
      "id": "hero_cta2_url",
      "label": "Secondary CTA link (defaults to the contact page)"
    },
    {
      "type": "header",
      "content": "As taught at (logo grid)"
    },
    {
      "type": "text",
      "id": "taught_eyebrow",
      "label": "Eyebrow",
      "default": "As taught at"
    },
    {
      "type": "text",
      "id": "taught_title",
      "label": "Heading",
      "default": "built into schools, colleges and universities."
    },
    {
      "type": "header",
      "content": "The pathway (programmes)"
    },
    {
      "type": "text",
      "id": "prog_eyebrow",
      "label": "Eyebrow",
      "default": "The pathway"
    },
    {
      "type": "text",
      "id": "prog_title",
      "label": "Heading",
      "default": "start free. build up when your students ask for more."
    },
    {
