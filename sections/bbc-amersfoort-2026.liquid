{%- comment -%}
  BBC New Design (2026) — Amersfoort workshop page (single self-contained section).
  Dedicated Netherlands location page, hosted by Tim. Mirrors the 2026 design
  system and is scoped under .bbc-rd via bbc-redesign-2026.css.

  Structure: hero → meet Tim (story + real build quote + blog link)
  → what you'll build → how booking works (email-first) → final CTA.

  CONTENT NOTE: Tim's story + quote are from his real BBC blog build
  (/blogs/club-news/gravel-bike-by-tim). James confirms Tim runs Amersfoort.
  Booking is email-first to info@bamboobicycleclub.org (no instant checkout) —
  swap to Tim's own address if he has one. Default photo for "Meet Tim" is
  Tim's actual bamboo gravel bike (bbc-rd-tim-gravel.jpg); replace with a photo
  of Tim himself when available.
{%- endcomment -%}

{%- liquid
  assign hero_c1  = section.settings.hero_cta1_url | default: '#book'
  assign hero_c2  = section.settings.hero_cta2_url | default: '#tim'
  assign tim_link = section.settings.tim_link_url | default: '/blogs/club-news/gravel-bike-by-tim'
  assign book_cta = section.settings.book_cta_url  | default: 'mailto:info@bamboobicycleclub.org'
  assign final_c  = section.settings.cta_url       | default: 'mailto:info@bamboobicycleclub.org'
-%}

<div class="bbc-rd bbc-rd-amersfoort">

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  <header class="rd-hero">
    <div class="rd-bg">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 1600 }} 1600w, {{ section.settings.hero_image | image_url: width: 2000 }} 2000w" sizes="100vw" alt="{{ section.settings.hero_image_alt | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high" loading="eager">
      {%- else -%}
        <img src="{{ section.settings.hero_fallback | default: 'bbc-rd-ws-amersfoort.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | escape }}" width="1200" height="1500" fetchpriority="high" loading="eager">
      {%- endif -%}
    </div>
    <div class="rd-scrim"></div>
    <div class="rd-inner">
      <div class="rd-wrap">
        <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><a href="/pages/workshops">Workshops</a><span class="rd-sep">/</span><span class="rd-here">Amersfoort</span></nav>
        {%- if section.settings.hero_eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1 class="rd-mt2 rd-mw-14ch">{{ section.settings.hero_title }}</h1>
        <div class="rd-lede">{{ section.settings.hero_lede }}</div>
        <div class="rd-cta-row">
          {%- if section.settings.hero_cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ hero_c1 }}">{{ section.settings.hero_cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
          {%- if section.settings.hero_cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ hero_c2 }}">{{ section.settings.hero_cta2_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </header>

  {%- comment -%} ---------- MEET TIM ---------- {%- endcomment -%}
  <section class="rd-pad" id="tim">
    <div class="rd-wrap">
      <div class="rd-split rd-tight rd-gap48-as">
        <div class="rd-ph">
          {%- render "bbc-media", image: section.settings.tim_image, src: section.settings.tim_fallback, fallback: "bbc-rd-tim-gravel.jpg", video: section.settings.video_file, youtube: section.settings.video_url, alt: section.settings.tim_image_alt -%}
        </div>
        <div>
          <span class="rd-eyebrow">{{ section.settings.tim_eyebrow }}</span>
          <h2 class="rd-reveal">{{ section.settings.tim_title }}</h2>
          {%- assign tim_paras = section.settings.tim_body | split: '|' -%}
          {%- for p in tim_paras -%}<p class="rd-lede rd-mt2">{{ p | strip }}</p>{%- endfor -%}
          {%- if section.settings.tim_quote != blank -%}
            <blockquote class="rd-quote rd-mt3">
              <p>&ldquo;{{ section.settings.tim_quote }}&rdquo;</p>
              {%- if section.settings.tim_attrib != blank -%}<cite>{{ section.settings.tim_attrib }}</cite>{%- endif -%}
            </blockquote>
          {%- endif -%}
          {%- if section.settings.tim_link_label != blank -%}<a class="rd-btn rd-ghost rd-mt3" href="{{ tim_link }}">{{ section.settings.tim_link_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- WHAT YOU'LL BUILD ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-paper" id="book">
    <div class="rd-wrap">
      <span class="rd-eyebrow">{{ section.settings.build_eyebrow }}</span>
      <h2 class="rd-reveal">{{ section.settings.build_title }}</h2>
      {%- if section.settings.build_body != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.build_body }}</p>{%- endif -%}
      <div class="rd-flex rd-mt3">
        {%- if section.settings.tag1 != blank -%}<span class="rd-tag rd-lime">{{ section.settings.tag1 }}</span>{%- endif -%}
        {%- if section.settings.tag2 != blank -%}<span class="rd-tag">{{ section.settings.tag2 }}</span>{%- endif -%}
        {%- if section.settings.tag3 != blank -%}<span class="rd-tag">{{ section.settings.tag3 }}</span>{%- endif -%}
      </div>
      {%- if section.settings.serving_note != blank -%}<p class="rd-src rd-mt2">{{ section.settings.serving_note }}</p>{%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- HOW BOOKING WORKS ---------- {%- endcomment -%}
  <section class="rd-pad">
    <div class="rd-wrap">
      <div class="rd-split rd-tight rd-gap48-as">
        <div>
          <span class="rd-eyebrow">{{ section.settings.bk_eyebrow }}</span>
          <h2 class="rd-reveal">{{ section.settings.bk_title }}</h2>
          <p class="rd-lede rd-mt2">{{ section.settings.bk_lede }}</p>
          {%- if section.settings.book_cta_label != blank -%}<a class="rd-btn rd-lime rd-mt3" href="{{ book_cta }}">{{ section.settings.book_cta_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
          {%- if section.settings.bk_note != blank -%}<p class="rd-src rd-mt2">{{ section.settings.bk_note }}</p>{%- endif -%}
        </div>
        <ol class="rd-steps">
          {%- if section.settings.s1_title != blank -%}<li><h3>{{ section.settings.s1_title }}</h3><p>{{ section.settings.s1_body }}</p></li>{%- endif -%}
          {%- if section.settings.s2_title != blank -%}<li><h3>{{ section.settings.s2_title }}</h3><p>{{ section.settings.s2_body }}</p></li>{%- endif -%}
          {%- if section.settings.s3_title != blank -%}<li><h3>{{ section.settings.s3_title }}</h3><p>{{ section.settings.s3_body }}</p></li>{%- endif -%}
          {%- if section.settings.s4_title != blank -%}<li><h3>{{ section.settings.s4_title }}</h3><p>{{ section.settings.s4_body }}</p></li>{%- endif -%}
        </ol>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- FINAL CTA ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-760px">
      {%- if section.settings.cta_kicker != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.cta_kicker }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.cta_title }}</h2>
      <p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.cta_lede }}</p>
      <div class="rd-flex rd-mt3 rd-jc-center">
        {%- if section.settings.cta_label != blank -%}<a class="rd-btn rd-lime" href="{{ final_c }}">{{ section.settings.cta_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
      </div>
    </div>
  </section>

</div>

