{%- comment -%}
  BBC New Design (2026) — IMPACT REPORT page (/pages/impact-report).
  Benchmark: Redemption Roasters "Social Impact Report" + Fine Cell Work
  "Annual Report" pattern (2026-07-06 research). VERIFIED CONTENT ONLY — every
  figure from the stats canon or a cited national source. Honest-measurement
  framing throughout; impact = contribution, never attribution.
  Structure: header → year in numbers → the problem (sourced) → two arms →
  where we work → recognition quotes → what we measure → the year ahead → CTA.
{%- endcomment -%}

{%- liquid
  assign cta1 = section.settings.cta1_url | default: '/pages/impact'
  assign cta2 = section.settings.cta2_url | default: '/pages/prisons'
-%}

<div class="bbc-rd bbc-rd-report">

  <section class="rd-pad rd-paper">
    <div class="rd-wrap rd-mw-820px">
      <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><a href="{{ section.settings.url_pages_impact | default: '/pages/impact' }}">Impact</a><span class="rd-sep">/</span><span class="rd-here">{{ section.settings.tx_impact_report | default: "Impact report" }}</span></nav>
      {%- if section.settings.eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h1 class="rd-mt2 rd-mw-16ch">{{ section.settings.title }}</h1>
      {%- if section.settings.lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.lede }}</p>{%- endif -%}
      {%- if section.settings.pdf_url != blank -%}<div class="rd-cta-row"><a class="rd-btn rd-lime" href="{{ section.settings.pdf_url }}">{{ section.settings.pdf_label | default: 'Download the PDF' }} <span class="rd-arrow">&rarr;</span></a></div>{%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- YEAR IN NUMBERS ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-dark">
    <div class="rd-wrap">
      {%- if section.settings.numbers_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.numbers_eyebrow }}</span>{%- endif -%}
      <div class="rd-stats rd-mt3">
        {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}
          <div class="rd-reveal rd-stat" {{ block.shopify_attributes }}>
            <div class="rd-num bbc-counted">{{ block.settings.number }}</div>
            <div class="rd-lbl">{{ block.settings.label }}</div>
            {%- if block.settings.source != blank -%}<div class="rd-src">{{ block.settings.source }}</div>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- THE PROBLEM ---------- {%- endcomment -%}
  {%- if section.settings.problem_title != blank -%}
  <section class="rd-pad">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.problem_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.problem_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.problem_title }}</h2>
      {%- if section.settings.problem_body != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.problem_body }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- TWO ARMS ---------- {%- endcomment -%}
  <section class="rd-pad rd-paper">
    <div class="rd-wrap">
      {%- if section.settings.arms_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.arms_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal rd-mw-20ch">{{ section.settings.arms_title }}</h2>
      <div class="rd-grid rd-g2 rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'arm' -%}
          <div class="rd-reveal rd-card rd-stamp" {{ block.shopify_attributes }}>
            <div class="rd-body">
              {%- if block.settings.tag != blank -%}<span class="rd-tag rd-lime">{{ block.settings.tag }}</span>{%- endif -%}
              <h3 class="rd-mt2 rd-fs-21px">{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- if section.settings.sites_line != blank -%}<div class="rd-sitenames rd-mt4">{{ section.settings.sites_line }}</div>{%- endif -%}
      {%- if section.settings.partner_line != blank -%}<p class="rd-frame-label rd-mt2">{{ section.settings.partner_line }}</p>{%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- RECOGNITION ---------- {%- endcomment -%}
  {%- if section.settings.rec_title != blank -%}
  <section class="rd-pad-sm">
    <div class="rd-wrap">
      {%- if section.settings.rec_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.rec_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal rd-mw-22ch">{{ section.settings.rec_title }}</h2>
      <div class="rd-grid rd-g2 rd-mt3">
        {%- for block in section.blocks -%}{%- if block.type == 'quote' -%}
          <blockquote class="rd-reveal rd-card rd-stamp rd-cred-card" {{ block.shopify_attributes }}>
            <p class="rd-cred-q">&ldquo;{{ block.settings.quote }}&rdquo;</p>
            <cite class="rd-cred-cite"><b>{{ block.settings.attr }}</b>{%- if block.settings.src != blank -%}<span> &middot; {{ block.settings.src }}</span>{%- endif -%}</cite>
          </blockquote>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- if section.settings.funder_line != blank -%}
      <div class="rd-center rd-mt4">
        {%- if section.settings.funder_logo != blank -%}<img src="{{ section.settings.funder_logo | asset_url }}" alt="The National Lottery Community Fund" loading="lazy" style="height:52px !important;width:auto !important;object-fit:contain;">{%- endif -%}
        <p class="rd-ship-note rd-mt1">{{ section.settings.funder_line }}</p>
      </div>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- WHAT WE MEASURE ---------- {%- endcomment -%}
  {%- if section.settings.measure_title != blank -%}
  <section class="rd-pad-sm rd-paper">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.measure_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.measure_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.measure_title }}</h2>
      {%- if section.settings.measure_body != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.measure_body }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- THE YEAR AHEAD ---------- {%- endcomment -%}
  {%- if section.settings.ahead_title != blank -%}
  <section class="rd-pad">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.ahead_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.ahead_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.ahead_title }}</h2>
      <ol class="rd-steps rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'plan' -%}
          <li {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
          </li>
        {%- endif -%}{%- endfor -%}
      </ol>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- CTA ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-680px">
      <h2 class="rd-reveal">{{ section.settings.cta_title }}</h2>
      {%- if section.settings.cta_lede != blank -%}<p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.cta_lede }}</p>{%- endif -%}
      <div class="rd-flex rd-mt3 rd-jc-center">
        {%- if section.settings.cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ cta1 }}">{{ section.settings.cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ cta2 }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
  </section>

</div>

{% schema %}
