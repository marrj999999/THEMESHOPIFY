{% comment %}
  BBC Timeline — Distinctive Brand Version
  
  Design Principles:
  - Vertical bamboo stripe as timeline
  - Sharp milestone cards
  - Gold accent for current year
  - Asymmetric layout
  - Bold year numbers
{% endcomment %}

<section class="bbc-timeline">
  <div class="bbc-timeline__container page-width">
    <header class="bbc-timeline__header">
      {% if section.settings.eyebrow != blank %}
        <span class="bbc-timeline__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 class="bbc-timeline__heading">{{ section.settings.heading }}</h2>
      {% if section.settings.subheading != blank %}
        <p class="bbc-timeline__subheading">{{ section.settings.subheading }}</p>
      {% endif %}
    </header>
    
    <div class="bbc-timeline__track">
      {%- comment -%} Bamboo stripe timeline {%- endcomment -%}
      <div class="bbc-timeline__line" aria-hidden="true"></div>
      
      {%- for block in section.blocks -%}
        <article class="bbc-milestone{% if block.settings.current %} bbc-milestone--current{% endif %}" {{ block.shopify_attributes }}>
          <div class="bbc-milestone__marker">
            <span class="bbc-milestone__year">{{ block.settings.year }}</span>
          </div>
          <div class="bbc-milestone__content">
            <h3 class="bbc-milestone__title">{{ block.settings.title }}</h3>
            <p class="bbc-milestone__description">{{ block.settings.description }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .bbc-timeline {
    padding: 100px 20px;
    background: var(--bbc-cream, #f8f7f4);
    overflow: hidden;
  }
  
  .bbc-timeline__header {
    margin-bottom: 60px;
    max-width: 500px;
  }
  
  .bbc-timeline__eyebrow {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--bbc-teal, #3f8b66);
    margin-bottom: 12px;
  }
  
  .bbc-timeline__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: var(--bbc-forest, #073e27);
    letter-spacing: -0.02em;
    margin: 0 0 12px 0;
    line-height: 1.1;
  }
  
  .bbc-timeline__subheading {
    font-size: 1.125rem;
    color: var(--bbc-forest, #073e27);
    opacity: 0.7;
    margin: 0;
    line-height: 1.5;
  }
  
  .bbc-timeline__track {
    position: relative;
    max-width: 800px;
    padding-left: 100px;
  }
  
  /* Bamboo stripe as timeline */
  .bbc-timeline__line {
    position: absolute;
    left: 36px;
    top: 0;
    bottom: 0;
    width: 8px;
    background: linear-gradient(
      to bottom,
      var(--bbc-teal, #3f8b66) 0%,
      var(--bbc-teal, #3f8b66) 30%,
      transparent 30%,
      transparent 35%,
      var(--bbc-teal, #3f8b66) 35%,
      var(--bbc-teal, #3f8b66) 65%,
      transparent 65%,
      transparent 70%,
      var(--bbc-gold, #ffa900) 70%,
      var(--bbc-gold, #ffa900) 100%
    );
  }
  
  .bbc-milestone {
    position: relative;
    padding-bottom: 48px;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 32px;
    align-items: start;
  }
  
  .bbc-milestone:last-child {
    padding-bottom: 0;
  }
  
  .bbc-milestone__marker {
    position: relative;
    left: -100px;
    width: 80px;
    display: flex;
    justify-content: flex-end;
  }
  
  .bbc-milestone__year {
    font-family: var(--font-heading-family);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--bbc-forest, #073e27);
    letter-spacing: -0.02em;
  }
  
  .bbc-milestone--current .bbc-milestone__year {
    color: var(--bbc-gold, #ffa900);
    font-size: 2rem;
  }
  
  .bbc-milestone__content {
    background: white;
    padding: 28px 32px;
    border-left: 4px solid transparent;
    transition: border-color 0.2s ease;
  }
  
  .bbc-milestone:hover .bbc-milestone__content {
    border-left-color: var(--bbc-teal, #3f8b66);
  }
  
  .bbc-milestone--current .bbc-milestone__content {
    border-left-color: var(--bbc-gold, #ffa900);
    box-shadow: 8px 8px 0 var(--bbc-gold, #ffa900);
  }
  
  .bbc-milestone--current:hover .bbc-milestone__content {
    border-left-color: var(--bbc-gold, #ffa900);
  }
  
  @media (prefers-reduced-motion: reduce) {
    .bbc-milestone__content {
      transition: none;
    }
  }
  
  .bbc-milestone__title {
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--bbc-forest, #073e27);
    margin: 0 0 8px 0;
  }
  
  .bbc-milestone__description {
    font-size: 0.9375rem;
    color: var(--bbc-forest, #073e27);
    opacity: 0.8;
    line-height: 1.6;
    margin: 0;
  }
  
  @media (max-width: 768px) {
    .bbc-timeline {
      padding: 60px 16px;
    }
    
    .bbc-timeline__track {
      padding-left: 0;
    }
    
    .bbc-timeline__line {
      left: 0;
      width: 6px;
    }
    
    .bbc-milestone {
      grid-template-columns: 1fr;
      gap: 16px;
      padding-left: 32px;
    }
    
    .bbc-milestone__marker {
      position: static;
      width: auto;
      justify-content: flex-start;
    }
    
    .bbc-milestone__year {
      font-size: 1.25rem;
    }
    
    .bbc-milestone--current .bbc-milestone__year {
      font-size: 1.5rem;
    }
    
    .bbc-milestone__content {
      padding: 24px;
    }
    
    .bbc-milestone--current .bbc-milestone__content {
      box-shadow: 6px 6px 0 var(--bbc-gold, #ffa900);
    }
  }
</style>

{% schema %}
{
  "name": "BBC Timeline",
  "tag": "section",
  "class": "bbc-timeline-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Journey"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "From a small London workshop to a global community"
    }
  ],
  "blocks": [
    {
      "type": "milestone",
      "name": "Milestone",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "2024"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "checkbox",
          "id": "current",
          "label": "Current/Latest",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Timeline",
      "settings": {
        "eyebrow": "Our Story",
        "heading": "Our Journey",
        "subheading": "From a small London workshop to a global community"
      },
      "blocks": [
        {
          "type": "milestone",
          "settings": {
            "year": "2012",
            "title": "The Beginning",
            "description": "Bamboo Bicycle Club founded in London by James Marr and Ian McMillan.",
            "current": false
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2015",
            "title": "Design Museum",
            "description": "Featured in the Cycle Revolution exhibition. World's first aerodynamic bamboo bicycle unveiled.",
            "current": false
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2018",
            "title": "Green Heroes",
            "description": "Kevin McCloud's Green Heroes award. Kate Rawles completes 8,288-mile Andes journey.",
            "current": false
          }
        },
        {
          "type": "milestone",
          "settings": {
            "year": "2025",
            "title": "Today",
            "description": "4,000+ people trained across 36+ countries. Investec Beyond Business winner. Financial Times feature.",
            "current": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
