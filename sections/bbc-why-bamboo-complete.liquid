{%- comment -%}
  BBC — Why Bamboo? (2026 "complete", light-touch rebuild). Hardcoded, no editor blocks.
  Website voice: big statements, images, a video, scannable data, "read more" links into
  case studies / research / other pages. Same .rd-* / .wbx-* / .rdr-* system as the theme.
  Order: Feel > Build > Strength > "understanding = sustainability" > proof (data + research).
  Claim-safe: verified figures only; no absolute steel-strength boast, no carbon % claims.
  Prison references stay GENERIC (no site named, no learner identified) per BBC policy.
{%- endcomment -%}

{%- liquid
  assign hero_fb = section.settings.hero_fallback   | default: 'bbc-rd-hero-ride.jpg'
  assign sci_fb  = section.settings.science_image_fb | default: 'bbc-rd-gravel-sunset.jpg'
  assign acc_fb  = section.settings.access_image_fb  | default: 'bbc-rd-frame-build.jpg'
  assign str_fb  = section.settings.strength_image_fb | default: 'bbc-rd-detail.jpg'
  assign vid_src = section.settings.video_url | default: 'https://cdn.shopify.com/videos/c/vp/a66c9c6ad4e54ed5b506582dbb7d751c/a66c9c6ad4e54ed5b506582dbb7d751c.HD-720p-1.6Mbps-76173427.mp4'
-%}

<div class="bbc-rd bbc-rd-whybamboo">
  <style>
    .bbc-rd-whybamboo{ overflow-x:hidden; }
    .bbc-rd-whybamboo img{ max-width:100%; }
    .bbc-rd-whybamboo .rd-pad{ padding:clamp(40px,7vw,80px) 0; }
    .bbc-rd-whybamboo .rd-hero{ min-height:66vh; }
    .bbc-rd-whybamboo .rd-hero .rd-bg img{ object-position:center 42%; }
    .bbc-rd-whybamboo .rd-hero h1{ font-size:clamp(32px,5.2vw,60px); line-height:1.02; letter-spacing:-.02em; }
