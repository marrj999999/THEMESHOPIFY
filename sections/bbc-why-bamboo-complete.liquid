    .bbc-rd-whybamboo .rd-wb-statsband{ background:var(--forest,#003C32); padding:clamp(26px,3.2vw,42px) 0; }
    .bbc-rd-whybamboo .rd-wb-statsband .rd-dark{ background:var(--forest,#003C32); }
    .bbc-rd-whybamboo .rd-wb-statsband .rd-num{ text-shadow:none; }
