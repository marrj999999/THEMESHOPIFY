{%- comment -%}
  BBC New Design (2026) — "Back the mission" funder/supporter destination page.
  Single self-contained section, fully schema-driven, scoped under .bbc-rd /
  .bbc-rd-support. Built 2026-07-02 from the funder-page research blueprint:
  hero (report-as-proof, Redemption Roasters pattern) → problem (one vivid
  number, Bike Project pattern) → theory-of-change pillars (Elvis & Kresse
  pattern) → dated numbers strip (Redemption live-data pattern) → one Maker
  story (Fine Cell Work dignity pattern) → where the money goes (charity:water
  plumbing-narrative pattern) → giving ladder (Fine Cell Work work-units +
  Movember scoped-envelope pattern) → trust strip (named-authority quote
  outranks a logo wall) → closing ask + email capture.

  CONTENT POLICY (hard rules):
  - Never link a named/identifiable participant to a named prison.
  - "Makers", never "prisoners"/"offenders"/"beneficiaries".
  - Green stats only: 90%+ completion · 4,000+ builders · 3,500+ frames ·
    OCN L1/L2. No SROI figure. No per-learner contract pricing (the ladder
    uses grant-budget framing: kit ~£180 · cohort ~£8,500 · capex £7–10k ·
    site-year ~£45k).
  - Strength/carbon claims: only the BS ISO 22157 / "grown, not mined" framings.
{%- endcomment -%}

{%- comment -%}
  MAINTENANCE: presets are scaffolding — once this section is on a page, the
  template owns all content and preset edits change NOTHING live. To improve
  live copy, give James an editor checklist; never edit presets expecting a
  live change, and never push templates/*.json.
  Preset changelog: 2026-07-02 v1 (initial, review-gated).
{%- endcomment -%}

{%- liquid
  assign enquiry_url = section.settings.enquiry_url | default: '/pages/contact-us'
  assign anchor_id = 'fund-the-work'
  assign hero_cta1 = section.settings.hero_cta1_url | default: '#how-it-works'
  assign hero_cta2 = section.settings.hero_cta2_url | default: '#fund-the-work'
-%}

<div class="bbc-rd bbc-rd-support">

  {%- comment -%} ---------- BAND 1 · HERO ---------- {%- endcomment -%}
  <header class="rd-hero rd-mh-74">
    <div class="rd-bg">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 1600 }} 1600w, {{ section.settings.hero_image | image_url: width: 2000 }} 2000w" sizes="100vw" alt="{{ section.settings.hero_image_alt | default: 'Hands shaping a bamboo frame on the jig' | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high" loading="eager">
      {%- else -%}
        <img src="{{ section.settings.hero_fallback | default: 'bbc-rd-wb-jig.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | default: 'Hands shaping a bamboo frame on the jig' | escape }}" width="1500" height="999" fetchpriority="high" loading="eager">
      {%- endif -%}
    </div>
    <div class="rd-scrim"></div>
    <div class="rd-inner">
      <div class="rd-wrap">
        <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><span class="rd-here">Back the mission</span></nav>
        {%- if section.settings.hero_eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1 class="rd-mt2 rd-mw-20ch">{{ section.settings.hero_title }}</h1>
        <div class="rd-lede">{{ section.settings.hero_lede }}</div>
        <div class="rd-cta-row">
          <a class="rd-btn rd-lime" href="{{ hero_cta1 }}">{{ section.settings.hero_cta1_label | default: 'Read how it works' }} <span class="rd-arrow" aria-hidden="true">&darr;</span></a>
          <a class="rd-btn rd-on-dark" href="{{ hero_cta2 }}">{{ section.settings.hero_cta2_label | default: 'Fund the work' }}</a>
        </div>
        {%- if section.settings.hero_proof != blank -%}<p class="rd-mt2 rd-c-lime" style="font-size:14px;font-weight:700;letter-spacing:.02em;">{{ section.settings.hero_proof }}</p>{%- endif -%}
      </div>
    </div>
  </header>

  {%- comment -%} ---------- BAND 2 · THE PROBLEM ---------- {%- endcomment -%}
  <section class="rd-pad-sm">
    <div class="rd-wrap rd-mw-70ch">
      {%- if section.settings.problem_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.problem_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal bbc-sup__sr">The problem we work on</h2>
      <p class="bbc-sup__problem">{{ section.settings.problem_body }}</p>
      {%- if section.settings.problem_stat != blank -%}
        <p class="bbc-sup__problem-stat"><strong>{{ section.settings.problem_stat }}</strong> <span>{{ section.settings.problem_stat_source }}</span></p>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- BAND 3 · THEORY OF CHANGE PILLARS ---------- {%- endcomment -%}
  <section class="rd-pad rd-paper" id="how-it-works">
    <div class="rd-wrap">
      {%- if section.settings.toc_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.toc_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.toc_title | default: 'one build. three things change.' }}</h2>
      <p class="rd-lede rd-mw-70ch">{{ section.settings.toc_lede }}</p>
      <div class="bbc-sup__pillars">
        {%- for block in section.blocks -%}{%- if block.type == 'pillar' -%}
          <article class="rd-reveal bbc-sup__pillar" {{ block.shopify_attributes }}>
            {%- assign pimg = block.settings.image_fallback | default: 'bbc-rd-wb-hand.jpg' -%}
            <div class="rd-reveal bbc-sup__pillar-media">
              {%- render "bbc-media", image: block.settings.image, src: pimg, video: block.settings.video_file, youtube: block.settings.video_url, alt: block.settings.image_alt -%}
            </div>
            <h3 class="rd-reveal bbc-sup__pillar-title">{{ block.settings.title }}</h3>
            <p class="rd-reveal bbc-sup__pillar-body">{{ block.settings.body }}</p>
            {%- if block.settings.link_url != blank -%}
              <a class="bbc-sup__textlink" href="{{ block.settings.link_url }}">{{ block.settings.link_label | default: 'See this in practice' }} <span class="rd-arrow" aria-hidden="true">&rarr;</span></a>
            {%- endif -%}
          </article>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- BAND 4 · DATED NUMBERS ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-dark">
    <div class="rd-wrap">
      {%- if section.settings.numbers_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.numbers_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal bbc-sup__sr">Our numbers</h2>
      <div class="bbc-sup__numbers">
        {%- comment -%} DEVICE C — dimension callouts, ported from the About page (2026-08-01).
           A number in a plain block reads as a claim; a number on a dimension line, with
           extension ticks and its source as a datum note, reads as something measured. That is
           the register a funder needs on the page that asks them for money. {%- endcomment -%}
        {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}
          <div class="bbc-sup__stat bbc-sup__stat--dim" {{ block.shopify_attributes }}>
            <span class="rd-dimt" aria-hidden="true"></span>
            <span class="bbc-sup__stat-number">{{ block.settings.number }}</span>
            <span class="bbc-sup__stat-label">{{ block.settings.label }}</span>
            {%- if block.settings.comparator != blank -%}<span class="bbc-sup__stat-comparator">{{ block.settings.comparator }}</span>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- if section.settings.stats_dated != blank -%}
        <p class="bbc-sup__dated">{{ section.settings.stats_dated }}</p>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- BAND 5 · ONE MAKER STORY ---------- {%- endcomment -%}
  {%- if section.settings.maker_quote != blank -%}
  <section class="rd-pad">
    <div class="rd-wrap rd-mw-70ch">
      {%- if section.settings.story_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.story_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal bbc-sup__sr">One Maker's story</h2>
      <figure class="bbc-sup__quote">
        <blockquote><p>&ldquo;{{ section.settings.maker_quote }}&rdquo;</p></blockquote>
        <figcaption>{{ section.settings.maker_attribution | default: 'Maker · Build to Bond' }}</figcaption>
      </figure>
      {%- if section.settings.maker_note != blank -%}
        <p class="bbc-sup__quote-note">{{ section.settings.maker_note }}</p>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- BAND 6 · WHERE THE MONEY GOES ---------- {%- endcomment -%}
  <section class="rd-pad rd-paper bbc-sup__money">
    <div class="rd-wrap">
      {%- if section.settings.money_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.money_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.money_title | default: 'where the money goes' }}</h2>
      <div class="bbc-sup__flow" role="group" aria-label="How Bamboo Bicycle Club is structured: the Ltd company gives {{ section.settings.flow_pledge | default: '10% of profits' }} to the CIC">
        <div class="bbc-sup__flow-box">
          <h3>{{ section.settings.flow_ltd_title | default: 'bamboo bicycle club ltd' }}</h3>
          <p>{{ section.settings.flow_ltd_body | default: 'The commercial side — kits, workshops and team-building days.' }}</p>
        </div>
        <div class="bbc-sup__flow-arrow"><span>{{ section.settings.flow_pledge | default: '10% of profits' }}</span> <span class="bbc-sup__flow-glyph" aria-hidden="true">&rarr;</span></div>
        <div class="bbc-sup__flow-box bbc-sup__flow-box--cic">
          <h3>{{ section.settings.flow_cic_title | default: 'bamboo mobility project CIC' }}</h3>
          <p>{{ section.settings.flow_cic_body | default: 'The social side — accredited skills programmes in prisons and schools. Community interest company no. 16257348, asset-locked.' }}</p>
        </div>
      </div>
      {%- assign faq_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}{%- assign faq_count = faq_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if faq_count > 0 -%}
        <div class="bbc-sup__faqs">
          {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}
            <details class="bbc-sup__faq" {{ block.shopify_attributes }}>
              <summary>{{ block.settings.question }}</summary>
              <div class="bbc-sup__faq-a">{{ block.settings.answer }}</div>
            </details>
          {%- endif -%}{%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- BAND 7 · THE GIVING LADDER ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark" id="{{ anchor_id }}">
    <div class="rd-wrap">
      {%- if section.settings.ladder_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.ladder_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.ladder_title | default: 'fund the work' }}</h2>
      <p class="rd-lede rd-mw-70ch">{{ section.settings.ladder_lede }}</p>
      <div class="bbc-sup__ladder">
        {%- for block in section.blocks -%}{%- if block.type == 'rung' -%}
          {%- assign rung_url = block.settings.cta_url | default: enquiry_url -%}
          <article class="bbc-sup__rung" {{ block.shopify_attributes }}>
            <span class="bbc-sup__rung-amount">{{ block.settings.amount }}</span>
            <h3 class="bbc-sup__rung-title">{{ block.settings.title }}</h3>
            <p class="bbc-sup__rung-body">{{ block.settings.body }}</p>
            {%- if block.settings.cta_label != blank -%}
              <a class="rd-btn {% if block.settings.primary %}rd-lime{% else %}rd-on-dark{% endif %}" href="{{ rung_url }}">{{ block.settings.cta_label }}</a>
            {%- endif -%}
          </article>
        {%- endif -%}{%- endfor -%}
      </div>
      <p class="bbc-sup__ladder-note">{{ section.settings.ladder_note }}</p>
    </div>
  </section>

  {%- comment -%} ---------- BAND 8 · TRUST STRIP ---------- {%- endcomment -%}
  <section class="rd-pad">
    <div class="rd-wrap">
      {%- if section.settings.backers_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.backers_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal bbc-sup__sr">{{ section.settings.backers_label | default: 'Backing and coverage' }}</h2>
      {%- if section.settings.endorsement_quote != blank -%}
      <figure class="bbc-sup__endorsement">
        <blockquote><p>&ldquo;{{ section.settings.endorsement_quote }}&rdquo;</p></blockquote>
        <figcaption>&mdash; {{ section.settings.endorsement_attribution }}</figcaption>
      </figure>
      {%- endif -%}
      {%- assign backer_count = 0 -%}
      {%- for block in section.blocks -%}{%- if block.type == 'backer' -%}{%- assign backer_count = backer_count | plus: 1 -%}{%- endif -%}{%- endfor -%}
      {%- if backer_count > 0 -%}
        <ul class="bbc-sup__backers" aria-label="{{ section.settings.backers_label | default: 'Backing and coverage' | escape }}">
          {%- for block in section.blocks -%}{%- if block.type == 'backer' -%}
            <li class="bbc-sup__backer" {{ block.shopify_attributes }}>
              <span class="bbc-sup__backer-name">{{ block.settings.name }}</span>
              {%- if block.settings.detail != blank -%}<span class="bbc-sup__backer-detail">{{ block.settings.detail }}</span>{%- endif -%}
            </li>
          {%- endif -%}{%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- BAND 9 · CLOSING ASK ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-paper bbc-sup__close">
    <div class="rd-wrap">
      {%- if section.settings.close_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.close_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.close_title | default: 'start a conversation' }}</h2>
      <p class="rd-lede rd-mw-70ch">{{ section.settings.close_body }}</p>
      <div class="rd-cta-row">
        <a class="rd-btn rd-lime" href="{{ enquiry_url }}">{{ section.settings.close_cta1_label | default: 'Talk to James about funding' }} <span class="rd-arrow" aria-hidden="true">&rarr;</span></a>
        {%- if section.settings.close_cta2_url != blank -%}
          <a class="rd-btn" href="{{ section.settings.close_cta2_url }}">{{ section.settings.close_cta2_label | default: 'Get one build story a month' }}</a>
        {%- endif -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- MOBILE STICKY CTA ---------- {%- endcomment -%}
  {%- if section.settings.sticky_cta -%}
    <div class="bbc-sup__sticky">
      <a class="rd-btn rd-lime" href="#{{ anchor_id }}">{{ section.settings.sticky_label | default: 'Support the work' }}</a>
    </div>
  {%- endif -%}


  {%- render 'bbc-stories-band', section: section -%}
</div>

<script>
  /* COUNT-UP REMOVED 2026-08-01.
     qa/MOTION.md Hard Rule 1: "Evidence, credibility numbers and prices NEVER move. No marquee,
     no count-up, no parallax on anything an assessor reads." This band carries 90%+ course
     completion and the live prison-site count, on the page that asks funders for money — the
     exact case the rule exists for. A figure that animates from zero reads as a marketing
     flourish; the dimension-callout treatment now says "measured" instead, which is the point.
     Deliberately left as a comment, not deleted silently, so the decision is visible here. */
</script>

{% stylesheet %}
  .bbc-rd-support .bbc-sup__sr { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  .bbc-rd-support .rd-mw-70ch { max-width: 70ch; }
  .bbc-rd-support [id] { scroll-margin-top: 90px; }
  .bbc-rd-support .bbc-sup__textlink { color: var(--forest, #003C32); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }

  .bbc-rd-support .bbc-sup__problem { font-size: clamp(18px, 1.6vw, 21px); line-height: 1.55; }
  .bbc-rd-support .bbc-sup__problem-stat { margin-top: 16px; font-size: 16px; }
  .bbc-rd-support .bbc-sup__problem-stat strong { color: var(--forest, #003C32); font-size: 22px; display: block; }
  .bbc-rd-support .bbc-sup__problem-stat span { color: rgba(0,60,50,.78); }

  .bbc-rd-support .bbc-sup__pillars { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 28px; margin-top: 32px; }
  .bbc-rd-support .bbc-sup__pillar-media img { width: 100%; aspect-ratio: 3 / 2; height: auto; object-fit: cover; border-radius: 10px; display: block; }
  .bbc-rd-support .bbc-sup__pillar-title { margin: 14px 0 6px; font-size: 18px; }
  .bbc-rd-support .bbc-sup__pillar-body { line-height: 1.5; }

  .bbc-rd-support .bbc-sup__numbers { display: grid; grid-template-columns: repeat(2, 1fr); gap: 24px; max-width: 720px; margin: 0 auto; }
  .bbc-rd-support .bbc-sup__stat { text-align: center; }
  /* Device C — dimension callout, ported from the About page. Left-aligned so the extension
     ticks bracket the figure the way a drawing dimensions a tube. */
  .bbc-rd-support .bbc-sup__stat--dim { position: relative; padding-top: 40px; text-align: left; }
  .bbc-rd-support .bbc-sup__stat--dim::before { content: ""; position: absolute; top: 16px; left: 0; right: 0; height: 1px; background: rgba(230,220,200,.45); }
  .bbc-rd-support .bbc-sup__stat--dim .rd-dimt { position: absolute; top: 8px; left: 0; right: 0; height: 17px; pointer-events: none; }
  .bbc-rd-support .bbc-sup__stat--dim .rd-dimt::before,
  .bbc-rd-support .bbc-sup__stat--dim .rd-dimt::after { content: ""; position: absolute; top: 0; width: 1px; height: 17px; background: rgba(230,220,200,.45); }
  .bbc-rd-support .bbc-sup__stat--dim .rd-dimt::before { left: 0; }
  .bbc-rd-support .bbc-sup__stat--dim .rd-dimt::after { right: 0; }
  .bbc-rd-support .bbc-sup__stat--dim .bbc-sup__stat-comparator { font-family: ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace; letter-spacing: .04em; }
  .bbc-rd-support .bbc-sup__stat-number { display: block; font-size: clamp(34px, 4.4vw, 52px); font-weight: 800; color: var(--lime, #D4FD62); }
  .bbc-rd-support .bbc-sup__stat-label { display: block; margin-top: 4px; }
  .bbc-rd-support .bbc-sup__stat-comparator { display: block; margin-top: 4px; font-size: 13px; color: #BCC8C2; }
  .bbc-rd-support p.bbc-sup__dated { display: block; width: 100%; text-align: center; margin-top: 20px; font-size: 13px; color: #BCC8C2; }

  .bbc-rd-support .bbc-sup__quote p { font-size: clamp(20px, 2.3vw, 28px); line-height: 1.4; font-weight: 700; color: var(--forest, #003C32); }
  .bbc-rd-support .bbc-sup__quote blockquote, .bbc-rd-support .bbc-sup__endorsement blockquote { margin: 0; border: 0; padding: 0; font-style: normal; }
  .bbc-rd-support .bbc-sup__quote blockquote p, .bbc-rd-support .bbc-sup__endorsement blockquote p { font-style: normal; }
  .bbc-rd-support .bbc-sup__quote figcaption { display: block; margin-top: 12px; color: rgba(0,60,50,.78); }
  .bbc-rd-support .bbc-sup__quote-note { margin-top: 16px; font-size: 15px; color: rgba(0,60,50,.78); }

  .bbc-rd-support .bbc-sup__flow { display: grid; grid-template-columns: 1fr auto 1fr; gap: 20px; align-items: center; margin-top: 28px; }
  .bbc-rd-support .bbc-sup__flow-box { border: 2px solid var(--forest, #003C32); border-radius: 12px; padding: 22px; }
  .bbc-rd-support .bbc-sup__flow-box--cic { background: var(--forest, #003C32); color: #fff; }
  .bbc-rd-support .bbc-sup__flow-box--cic h3, .bbc-rd-support .bbc-sup__flow-box--cic p { color: #fff; }
  .bbc-rd-support .bbc-sup__flow-box h3 { margin: 0 0 8px; font-size: 16px; }
  .bbc-rd-support .bbc-sup__flow-arrow { font-weight: 800; text-align: center; color: var(--forest, #003C32); }
  .bbc-rd-support .bbc-sup__flow-arrow span { display: block; font-size: 13px; font-weight: 600; }

  .bbc-rd-support .bbc-sup__faqs { margin-top: 28px; max-width: 720px; }
  .bbc-rd-support .bbc-sup__faq { border-bottom: 1px solid rgba(0,60,50,.15); }
  .bbc-rd-support .bbc-sup__faq summary { padding: 14px 0; cursor: pointer; font-weight: 700; }
  .bbc-rd-support .bbc-sup__faq-a { padding: 0 0 16px; line-height: 1.55; }

  .bbc-rd-support .bbc-sup__ladder { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 20px; margin-top: 32px; }
  .bbc-rd-support .bbc-sup__rung { border: 1px solid rgba(255,255,255,.25); border-radius: 12px; padding: 22px; display: flex; flex-direction: column; }
  .bbc-rd-support .bbc-sup__rung-amount { font-size: clamp(24px, 2.6vw, 30px); font-weight: 800; color: var(--lime, #D4FD62); }
  .bbc-rd-support .bbc-sup__rung-title { margin: 8px 0 6px; font-size: 16px; }
  .bbc-rd-support .bbc-sup__rung-body { flex: 1; line-height: 1.5; font-size: 15px; }
  .bbc-rd-support .bbc-sup__rung .rd-btn { margin-top: 14px; align-self: flex-start; }
  .bbc-rd-support .bbc-sup__ladder-note { margin-top: 20px; font-size: 13px; color: #BCC8C2; }

  .bbc-rd-support .bbc-sup__endorsement p { font-size: clamp(19px, 2vw, 24px); line-height: 1.45; font-weight: 600; max-width: 60ch; }
  .bbc-rd-support .bbc-sup__endorsement blockquote { margin: 0; }
  .bbc-rd-support .bbc-sup__endorsement figcaption { display: block; margin-top: 10px; color: rgba(0,60,50,.78); }
  .bbc-rd-support .bbc-sup__backers { list-style: none; display: flex; flex-wrap: wrap; gap: 28px; margin: 28px 0 0; padding: 0; }
  .bbc-rd-support .bbc-sup__backer-name { display: block; font-weight: 800; }
  .bbc-rd-support .bbc-sup__backer-detail { display: block; font-size: 13px; color: rgba(0,60,50,.78); }

  .bbc-rd-support .bbc-sup__sticky { display: none; }

  @media (max-width: 940px) {
    .bbc-rd-support .bbc-sup__pillars { grid-template-columns: 1fr; }
    .bbc-rd-support .bbc-sup__ladder { grid-template-columns: repeat(2, 1fr); }
    .bbc-rd-support .bbc-sup__flow { grid-template-columns: 1fr; }
    .bbc-rd-support .bbc-sup__flow-glyph { display: inline-block; transform: rotate(90deg); }
    /* clear the theme's fixed bottom tab bar (.rd-botbar, ~60px, z-index 95) plus our sticky CTA */
    .bbc-rd-support .bbc-sup__sticky { display: block; position: fixed; bottom: calc(60px + env(safe-area-inset-bottom)); left: 0; right: 0; padding: 10px 16px; background: rgba(255,255,255,.96); border-top: 1px solid rgba(0,60,50,.12); z-index: 94; text-align: center; }
    .bbc-rd-support .bbc-sup__sticky .rd-btn { width: 100%; max-width: 480px; }
    .bbc-rd-support { padding-bottom: 76px; }
    .bbc-rd-support [id] { scroll-margin-top: 90px; scroll-margin-bottom: 140px; }
  }
  @media (max-width: 640px) {
    .bbc-rd-support .bbc-sup__ladder { grid-template-columns: 1fr; }
    .bbc-rd-support .bbc-sup__numbers { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .bbc-rd-support .bbc-sup__rung { transition: transform .18s ease, border-color .18s ease; }
    .bbc-rd-support .bbc-sup__rung:hover { transform: translateY(-3px); border-color: var(--gold, #FFA900); }
  }
{% endstylesheet %}

