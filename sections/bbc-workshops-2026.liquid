    {
      "type": "text",
      "id": "hero_title",
      "label": "Headline",
      "default": "two to three days. one bike. zero experience."
    },
    {
      "type": "textarea",
      "id": "hero_lede",
      "label": "Lede",
      "default": "If you can hold a tool, you can build a bike."
    },
    {
      "type": "text",
