{%- comment -%}
  BBC New Design (2026) — Workshops page, single self-contained section.
  Structure mirrors the Claude Design handoff (workshops.html):
  hero → reassurance stats → "the whole build" how-it-works (4 numbered steps)
  → "see it before you book" video → give-back funding loop → 3 location cards
  → "good to know" FAQ → final CTA.

  Fully schema-driven (every heading / paragraph / image / link / repeating
  item is editable in the theme editor). Scoped under .bbc-rd via
  bbc-redesign-2026.css so it cannot affect other sections. Uses ONLY existing
  rd-* classes plus the shared rd-* utility layer (no inline style="").

  CONTENT POLICY: the give-back loop refers to accredited skills courses inside prisons and schools (generic).
  No prison is ever named (BBC external-comms rule). Set workshop prices:
  Road £595 (2 days) · Gravel £595 (2–3 days) · MTB £695 (3 days); Cycle to Work
  accepted. Booking is email-first (no instant checkout) — see the "How booking
  works" section. Location cards use real weekend build-day photos
  (bbc-rd-ws-london / -amersfoort / -toulouse.jpg).
{%- endcomment -%}


{%- liquid
  assign hero_cta1 = section.settings.hero_cta1_url | default: '#book'
  assign hero_cta2 = section.settings.hero_cta2_url | default: '#how'
  assign video_url = section.settings.video_url | default: '#'
  assign loop_url  = section.settings.loop_cta_url | default: '/pages/impact'
  assign final_c1  = section.settings.cta1_url | default: 'mailto:info@bamboobicycleclub.org'
  assign final_c2  = section.settings.cta2_url | default: '/pages/contact-us'
  assign book_cta  = section.settings.book_cta_url | default: 'mailto:info@bamboobicycleclub.org'
-%}

<div class="bbc-rd bbc-rd-workshops">

  {%- comment -%} ---------- HERO v2 (2026-08-24, James: "do a hero of Patrick's
    gravel bike build - we modified the video - and rebuild the hero"). Family
    format, self-contained .wvh-* namespace (the cvh/kvh pattern - no shared-file
    edits, no cascade war with the estate's .rd-hero paper styling).
    THE FILM: two stitched cuts (153.2s-158.0s + 160.6s-192.0s) from the ENHANCED
    gravel-frame master in ~/Downloads (Bamboo-Gravel-Bike-Frame_1080p_ENHANCED.mp4):
    the finish-and-ride arc - components go on in the workstand, the finished orange
    gravel bike, then out the workshop door to street, canal, coast and woodland.
    The 158.2s-160.2s "RIDE REVIEW" title-card beat is excised (screenshot-caught);
    presenter-to-camera segments (~48s, ~148s) and the COMPONENTS card (~145s) are
    excluded too - overlay text reads badly in a silent loop. Deliberately a
    DIFFERENT stretch from the impact hero's loop (hands/jig, same build) so the
    two pages never repeat. Playback = the estate's hardened pattern; the photo is
    the universal fallback. {%- endcomment -%}
  <header class="wvh">
    <div class="wvh-copy">
      <nav class="rd-crumb wvh-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><span class="rd-here">{{ section.settings.tx_crumb_workshops | default: "Workshops" }}</span></nav>
      {%- if section.settings.hero_eyebrow != blank -%}<p class="wvh-eyebrow">{{ section.settings.hero_eyebrow }}</p>{%- endif -%}
      <h1 class="wvh-h1">{{ section.settings.hero_title | default: 'two to three days. one bike. zero experience.' }}</h1>
      {%- if section.settings.hero_lede != blank -%}<p class="wvh-lede">{{ section.settings.hero_lede }}</p>{%- endif -%}
      <div class="wvh-cta">
        {%- if section.settings.hero_cta1_label != blank -%}<a class="wvh-btn wvh-btn-lime" href="{{ hero_cta1 }}"><span class="wvh-b1">{{ section.settings.hero_cta1_label }} &rarr;</span></a>{%- endif -%}
        {%- if section.settings.hero_cta2_label != blank -%}<a class="wvh-btn wvh-btn-ghost" href="{{ hero_cta2 }}"><span class="wvh-b2">{{ section.settings.hero_cta2_label }}</span></a>{%- endif -%}
      </div>
    </div>
    <div class="wvh-media">
      {%- if section.settings.hero_image != blank -%}
        <img class="wvh-img" src="{{ section.settings.hero_image | image_url: width: 1400 }}" alt="{{ section.settings.hero_image_alt | default: 'A finished bamboo gravel bike at golden hour' | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high">
      {%- else -%}
        <img class="wvh-img" src="{{ section.settings.hero_fallback | default: 'bbc-rd-gravel-sunset.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | default: 'A finished bamboo gravel bike at golden hour' | escape }}" width="1200" height="800" fetchpriority="high">
      {%- endif -%}
      {%- if section.settings.hero_video_url != blank -%}
        <video class="wvh-film" muted loop playsinline webkit-playsinline preload="metadata"
               {% if section.settings.hero_video_poster != blank %}poster="{{ section.settings.hero_video_poster }}"{% endif %}
               aria-hidden="true" tabindex="-1" src="{{ section.settings.hero_video_url }}"></video>
      {%- endif -%}
      <div class="wvh-scrim" aria-hidden="true"></div>
    </div>
  </header>

  {%- comment -%} ---------- REASSURANCE STATS ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-paper">
    <div class="rd-wrap">
      <div class="rd-stats">
        {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}
          <div class="rd-reveal rd-stat" {{ block.shopify_attributes }}>
            <div class="rd-num bbc-counted">{{ block.settings.number }}</div>
            <div class="rd-lbl">{{ block.settings.label }}</div>
            {%- if block.settings.source != blank -%}<div class="rd-src">{{ block.settings.source }}</div>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- CREDIBILITY STRIP (off by default since 2026-08-24,
     James: "remove these sections") — switch it back on in the editor. {%- endcomment -%}
  {%- if section.settings.show_trustband -%}
  <section class="rd-trustband">
    <div class="rd-wrap"><p class="rd-trustline">Run by Bamboo Mobility Project CIC &middot; enhanced-DBS facilitators &middot; public-liability insured</p></div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- HOW IT WORKS (4 numbered steps) ---------- {%- endcomment -%}
  <section class="rd-pad" id="how">
    <div class="rd-wrap">
      <div class="rd-split rd-tight rd-gap48-as">
        <div>
          <span class="rd-eyebrow">{{ section.settings.how_eyebrow }}</span>
          <h2 class="rd-reveal">{{ section.settings.how_title }}</h2>
          <p class="rd-lede rd-mt2">{{ section.settings.how_lede }}</p>
          <div class="rd-flex rd-mt3">
            {%- for block in section.blocks -%}{%- if block.type == 'how_tag' -%}
              <span class="rd-tag" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
            {%- endif -%}{%- endfor -%}
          </div>
        </div>
        <ol class="rd-steps">
          {%- for block in section.blocks -%}{%- if block.type == 'step' -%}
            <li {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
            </li>
          {%- endif -%}{%- endfor -%}
        </ol>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- WATCH A BUILD (video) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-dark">
    <div class="rd-wrap">
      <div class="rd-split rd-tight rd-gap40-ac">
        <div>
          <span class="rd-eyebrow rd-on-dark">{{ section.settings.video_eyebrow }}</span>
          <h2 class="rd-reveal">{{ section.settings.video_title }}</h2>
          <p class="rd-lede rd-mt2">{{ section.settings.video_lede }}</p>
          {%- if section.settings.video_cta_label != blank and section.settings.video_url != blank -%}<a class="rd-btn rd-lime rd-mt3" href="{{ video_url }}">{{ section.settings.video_cta_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
        </div>
        <div class="rd-video">
          {%- if section.settings.video_url != blank and section.settings.video_url != '#' -%}
            {%- comment -%} standard player (2026-07-22): inline YouTube, auto thumbnail {%- endcomment -%}
            <div style="border-radius:14px;overflow:hidden;">
              {%- render 'bbc-media', image: section.settings.video_image, src: section.settings.video_fallback, youtube: section.settings.video_url, label: 'watch a real build', alt: section.settings.video_title, class: 'bbc-media--ar169', sizes: '(max-width:749px) 100vw, 640px' -%}
            </div>
          {%- else -%}
          {%- assign video_poster = section.settings.video_fallback | default: 'bbc-rd-build-poster.jpg' | asset_url -%}
          {%- if section.settings.video_image != blank -%}{%- assign video_poster = section.settings.video_image | image_url: width: 1400 -%}{%- endif -%}
          <video class="rd-video-el" controls preload="none" playsinline poster="{{ video_poster }}" width="1100" height="619">
            {%- if section.settings.video_mp4 != blank -%}{% # theme-check-disable RemoteAsset %}<source src="{{ section.settings.video_mp4 }}" type="video/mp4">{% # theme-check-enable RemoteAsset %}{%- endif -%}
            <source src="{{ 'bbc-rd-build-teaser.mp4' | asset_url }}" type="video/mp4">
          </video>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- PRESS (standard block, qa/PRESS-BLOCK.md; James kept
     this band — only the empty loop/CTA/trust bands were removed 2026-08-24) ---------- {%- endcomment -%}
  {%- if section.settings.show_press != false and section.settings.press_quote != blank -%}
  <section class="rd-pad-sm rd-paper">
    <div class="rd-wrap rd-center">
      {%- render 'bbc-press', style: 'bar', preset: 'cycling', label: section.settings.press_label, quote: section.settings.press_quote, cite: section.settings.press_cite -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- GIVE-BACK FUNDING LOOP (off by default since 2026-08-24,
     James: "remove these sections" — the template's loop fields were cleared so it
     rendered as an empty skeleton anyway) ---------- {%- endcomment -%}
  {%- if section.settings.show_loop -%}
  <section class="rd-pad-sm rd-steel rd-center rd-reveal">
    <div class="rd-wrap rd-mw-760px">
      <span class="rd-eyebrow">{{ section.settings.loop_eyebrow }}</span>
      <h3 class="rd-fs-clamp22px3vw32">{{ section.settings.loop_heading }}</h3>
      <div class="rd-loop rd-mt3 rd-mt-24px">
        <div class="rd-step"><div class="rd-big">{{ section.settings.loop_s1_big }}</div>{%- if section.settings.loop_s1_sm != blank -%}<div class="rd-sm">{{ section.settings.loop_s1_sm }}</div>{%- endif -%}</div>
        <div class="rd-arr">&rarr;</div>
        <div class="rd-step"><div class="rd-big">{{ section.settings.loop_s2_big }}</div>{%- if section.settings.loop_s2_sm != blank -%}<div class="rd-sm">{{ section.settings.loop_s2_sm }}</div>{%- endif -%}</div>
        <div class="rd-arr">&rarr;</div>
        <div class="rd-step"><div class="rd-big">{{ section.settings.loop_s3_big }}</div>{%- if section.settings.loop_s3_sm != blank -%}<div class="rd-sm">{{ section.settings.loop_s3_sm }}</div>{%- endif -%}</div>
      </div>
      {%- if section.settings.loop_cta_label != blank -%}<a class="rd-btn rd-ghost rd-mt3" href="{{ loop_url }}">{{ section.settings.loop_cta_label }}</a>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- WHERE & WHAT (3 location cards) ---------- {%- endcomment -%}
  <section class="rd-pad" id="dates">
    <div class="rd-wrap">
      <span class="rd-eyebrow">{{ section.settings.loc_eyebrow }}</span>
      <h2 class="rd-reveal">{{ section.settings.loc_title }}</h2>
      {%- if section.settings.loc_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.loc_lede }}</p>{%- endif -%}
      <div class="rd-grid rd-g3 rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'location' -%}
          {%- assign loc_link = block.settings.link_url | default: '/pages/contact-us' -%}
          {%- comment -%} Country-map badge (2026-08-24, James: "show a map of the
             location - the country and an icon where in the country"). Hand-drawn
             simplified silhouettes, lime marker on the city. Auto mode matches the
             card's title/body text; the select overrides it. Decorative -
             aria-hidden, the card title carries the location name. {%- endcomment -%}
          {%- liquid
            assign map_key = block.settings.map | default: 'auto'
            if map_key == 'auto'
              assign map_probe = block.settings.title | append: ' ' | append: block.settings.body | downcase
              assign map_key = 'none'
              if map_probe contains 'london' or map_probe contains 'hackney' or map_probe contains 'united kingdom'
                assign map_key = 'uk'
              elsif map_probe contains 'amersfoort' or map_probe contains 'netherlands'
                assign map_key = 'nl'
              elsif map_probe contains 'toulouse' or map_probe contains 'france'
                assign map_key = 'fr'
              endif
            endif
          -%}
          <div class="rd-reveal rd-card" {{ block.shopify_attributes }}>
            <div class="rd-ph">
              {%- comment -%} v2 (same day): James - "run it as the featured image,
                 the photo is pointless". The map IS the card image now; the photo
                 only renders when the badge select is None. {%- endcomment -%}
              {%- if map_key == 'uk' -%}
              <div class="wmap-panel" role="img" aria-label="Map of the United Kingdom with a marker on London"><svg viewBox="0 0 70 100"><path class="wmap-land" d="M40 6 46 10 44 16 51 16 47 23 44 27 47 32 46 38 52 47 57 56 61 65 59 71 65 77 63 84 66 87 57 89 47 87 39 92 29 90 18 96 12 93 20 88 28 83 31 78 22 76 15 73 20 66 14 61 22 56 27 52 31 49 27 44 31 39 25 35 18 33 24 28 16 25 22 19 15 17 24 12 32 12 36 6 Z"/><circle class="wmap-ring" cx="52" cy="80" r="9"/><circle class="wmap-dot" cx="52" cy="80" r="5"/></svg></div>
              {%- elsif map_key == 'nl' -%}
              <div class="wmap-panel" role="img" aria-label="Map of the Netherlands with a marker on Amersfoort"><svg viewBox="0 0 80 100"><path class="wmap-land" d="M15 24 24 17 30 18 33 27 40 25 44 16 53 12 62 17 62 29 68 42 65 56 58 66 54 72 61 82 57 95 50 86 48 74 38 72 26 76 13 79 18 71 9 72 14 62 15 50 17 37 Z"/><circle class="wmap-ring" cx="41" cy="50" r="9"/><circle class="wmap-dot" cx="41" cy="50" r="5"/></svg></div>
              {%- elsif map_key == 'fr' -%}
              <div class="wmap-panel" role="img" aria-label="Map of France with a marker on Toulouse"><svg viewBox="0 0 100 100"><path class="wmap-land" d="M53 8 66 15 76 21 82 31 80 42 84 52 78 60 86 68 80 76 68 78 58 74 44 79 34 82 22 78 24 68 19 58 22 50 18 45 4 39 3 34 12 31 22 30 28 26 35 27 33 20 42 18 47 13 Z"/><circle class="wmap-ring" cx="41" cy="71" r="9"/><circle class="wmap-dot" cx="41" cy="71" r="5"/></svg></div>
              {%- elsif block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image_alt | default: 'Building a bamboo bike frame in the workshop' | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
              {%- else -%}
                <img src="{{ block.settings.fallback | default: 'bbc-rd-bike-field.jpg' | asset_url }}" alt="{{ block.settings.image_alt | default: 'Building a bamboo bike frame in the workshop' | escape }}" width="1300" height="1300">
              {%- endif -%}
            </div>
            <div class="rd-body">
              <h3 class="rd-fs-21px">{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
              {%- if block.settings.link_label != blank -%}<a class="rd-btn rd-lime rd-mt3" href="{{ loc_link }}">{{ block.settings.link_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      <div class="rd-flex rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'frame_tag' -%}
          {%- if block.settings.lime -%}{%- assign frame_tag_cls = 'rd-tag rd-lime' -%}{%- else -%}{%- assign frame_tag_cls = 'rd-tag' -%}{%- endif -%}
          <span class="{{ frame_tag_cls }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- HOW BOOKING WORKS (signup sheet) ---------- {%- endcomment -%}
  <section class="rd-pad rd-paper" id="book">
    <div class="rd-wrap">
      <div class="rd-split rd-tight rd-gap48-as">
        <div>
          <span class="rd-eyebrow">{{ section.settings.book_eyebrow }}</span>
          <h2 class="rd-reveal">{{ section.settings.book_title }}</h2>
          <p class="rd-lede rd-mt2">{{ section.settings.book_lede }}</p>
          <div class="rd-flex rd-mt3">
            {%- if section.settings.price1 != blank -%}<span class="rd-tag rd-lime">{{ section.settings.price1 }}</span>{%- endif -%}
            {%- if section.settings.price2 != blank -%}<span class="rd-tag">{{ section.settings.price2 }}</span>{%- endif -%}
            {%- if section.settings.price3 != blank -%}<span class="rd-tag">{{ section.settings.price3 }}</span>{%- endif -%}
          </div>
          {%- if section.settings.book_cta_label != blank -%}<a class="rd-btn rd-lime rd-mt3" href="{{ book_cta }}">{{ section.settings.book_cta_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
          {%- if section.settings.book_note != blank -%}<p class="rd-src rd-mt2">{{ section.settings.book_note }}</p>{%- endif -%}
        </div>
        <ol class="rd-steps">
          {%- if section.settings.book_s1_title != blank -%}<li><h3>{{ section.settings.book_s1_title }}</h3><p>{{ section.settings.book_s1_body }}</p></li>{%- endif -%}
          {%- if section.settings.book_s2_title != blank -%}<li><h3>{{ section.settings.book_s2_title }}</h3><p>{{ section.settings.book_s2_body }}</p></li>{%- endif -%}
          {%- if section.settings.book_s3_title != blank -%}<li><h3>{{ section.settings.book_s3_title }}</h3><p>{{ section.settings.book_s3_body }}</p></li>{%- endif -%}
          {%- if section.settings.book_s4_title != blank -%}<li><h3>{{ section.settings.book_s4_title }}</h3><p>{{ section.settings.book_s4_body }}</p></li>{%- endif -%}
        </ol>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- GOOD TO KNOW (FAQ) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-steel">
    <div class="rd-nodediv" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></div>
    <div class="rd-wrap rd-mw-820px">
      <span class="rd-eyebrow">{{ section.settings.faq_eyebrow }}</span>
      <h2 class="rd-reveal">{{ section.settings.faq_title }}</h2>
      <div class="rd-faq rd-mt3">
        {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="rd-a">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- FINAL CTA (off by default since 2026-08-24, James:
     "remove these sections" — its template fields were cleared so it rendered as
     an empty forest band) ---------- {%- endcomment -%}
  {%- if section.settings.show_final_cta -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-760px">
      <span class="rd-eyebrow rd-on-dark">{{ section.settings.cta_kicker }}</span>
      <h2 class="rd-reveal">{{ section.settings.cta_title }}</h2>
      <p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.cta_lede }}</p>
      <div class="rd-flex rd-mt3 rd-jc-center">
        {%- if section.settings.cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ final_c1 }}">{{ section.settings.cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ final_c2 }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}


  {%- comment -%} Stories band — snippets/bbc-stories-band.liquid (2026-08-01). This section
     had no `story` block type, which is why the page carried zero case-study cards. {%- endcomment -%}
  {%- render 'bbc-stories-band', section: section -%}
</div>

{% stylesheet %}
/* .wvh-* workshops hero - family geometry, self-contained (see cvh/kvh). */
.wvh{display:grid;grid-template-columns:0.82fr 1fr;align-items:stretch;min-height:clamp(520px,74vh,840px);min-height:clamp(520px,74svh,840px);background:var(--forest,#003C32);overflow:hidden;isolation:isolate}
.wvh-copy{position:relative;z-index:3;display:flex;flex-direction:column;justify-content:center;padding:clamp(26px,4.8vh,80px) clamp(20px,2.6vw,48px) clamp(30px,5.4vh,84px) var(--bbc-gutter,clamp(32px,6vw,120px));container-type:inline-size}
.wvh-copy::before{content:"";position:absolute;left:calc(var(--bbc-gutter,48px) - 34px);top:13%;bottom:13%;width:3px;border-radius:3px;background:repeating-linear-gradient(to bottom,var(--lime,#D4FD62) 0 20px,rgba(6,35,28,.55) 20px 24px)}
.wvh-crumb{margin-bottom:clamp(12px,2vh,22px)}
.wvh-crumb,.wvh-crumb a{color:rgba(230,220,200,.72)!important;text-shadow:none}
.wvh-crumb a:hover{color:var(--lime,#D4FD62)!important}
.wvh-crumb .rd-here{color:var(--lime,#D4FD62)}
.wvh-eyebrow{margin:0 0 clamp(10px,1.8vh,20px);font-size:12px;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:var(--lime,#D4FD62)}
.wvh .wvh-h1{margin:0;color:var(--bone,#E6DCC8)!important;font-size:clamp(2.4rem,6vw,5rem);line-height:1.04;letter-spacing:-.01em;text-wrap:balance;max-width:16ch}
.wvh-lede{margin:clamp(14px,2.2vh,24px) 0 0;max-width:44ch;color:rgba(238,243,236,.92);font-size:clamp(1rem,2cqw,1.25rem);line-height:1.55}
.wvh-cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:clamp(18px,3vh,30px)}
/* Own-class buttons: the estate's .rd-btn background rules carry !important at
   higher specificity and repainted the lime pill forest even against a scoped
   !important override - so the hero CTAs do not use .rd-btn at all. Nothing else
   targets .wvh-btn, and labels live in spans so no anchor colour rule can repaint
   them (kits lesson, 2026-08-24). Pill look matches the kvh chip family. */
.wvh-btn{display:inline-flex;align-items:center;border-radius:999px;padding:13px 26px;text-decoration:none!important;border:2px solid transparent;transition:background .15s ease,border-color .15s ease}
.wvh-btn .wvh-b1,.wvh-btn .wvh-b2{font-weight:800;font-size:15px;letter-spacing:.01em;line-height:1}
.wvh-btn-lime{background:var(--lime,#D4FD62);border-color:var(--lime,#D4FD62)}
.wvh-btn-lime .wvh-b1{color:#06231C}
.wvh-btn-lime:hover{background:#c6ef54;border-color:#c6ef54}
.wvh-btn-ghost{background:transparent;border-color:rgba(230,220,200,.5)}
.wvh-btn-ghost .wvh-b2{color:var(--bone,#E6DCC8)}
.wvh-btn-ghost:hover{border-color:var(--lime,#D4FD62)}
.wvh-btn-ghost:hover .wvh-b2{color:var(--lime,#D4FD62)}
.wvh-btn:focus-visible{outline:3px solid var(--lime,#D4FD62);outline-offset:3px}
/* Country-map panels: the card's featured image (James - the photos were
   pointless). Forest panel, bone silhouette, lime marker on the city. */
.wmap-panel{display:flex;align-items:center;justify-content:center;width:100%;aspect-ratio:1/1;background:var(--forest,#003C32)}
.wmap-panel svg{width:64%;height:76%;display:block}
.wmap-land{fill:var(--bone,#E6DCC8);stroke:var(--bone,#E6DCC8);stroke-width:5;stroke-linejoin:round}
.wmap-dot{fill:var(--lime,#D4FD62);stroke:#06231C;stroke-width:2}
.wmap-ring{fill:none;stroke:#06231C;stroke-width:2;opacity:.5;transform-box:fill-box;transform-origin:center;animation:wmapPing 2.6s ease-out infinite}
@keyframes wmapPing{0%{transform:scale(.55);opacity:.65}70%{transform:scale(1.3);opacity:0}100%{transform:scale(1.3);opacity:0}}
@media(prefers-reduced-motion:reduce){.wmap-ring{animation:none;transform:none;opacity:.5}}
.wvh-media{position:relative;z-index:1;min-height:0;overflow:hidden}
.wvh-img,.wvh-film{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
.wvh-film{opacity:0;transition:opacity .6s ease;z-index:1}
.wvh-film.is-on{opacity:1}
.wvh-scrim{position:absolute;inset:0;z-index:2;background:linear-gradient(90deg,var(--forest,#003C32) 0%,rgba(0,60,50,.34) 28%,rgba(0,60,50,0) 64%);pointer-events:none}
@media(max-width:1199px){
  .wvh{grid-template-columns:1fr;min-height:0}
  .wvh-media{grid-row:1;height:clamp(240px,38svh,440px)}
  .wvh-copy{grid-row:2;padding-block:clamp(28px,5vw,56px)}
  .wvh-copy::before{position:relative;inset:auto;width:68px;height:3px;margin:0 0 18px;background:repeating-linear-gradient(to right,var(--lime,#D4FD62) 0 20px,rgba(6,35,28,.55) 20px 24px)}
  .wvh-scrim{background:linear-gradient(0deg,var(--forest,#003C32) 0%,rgba(0,60,50,.32) 26%,rgba(0,60,50,0) 62%)}
}
@media(max-width:749px){ .wvh-media{height:clamp(190px,28svh,340px)} }
@media(prefers-reduced-motion:reduce){ .wvh-film{display:none} }
{% endstylesheet %}

{% javascript %}
/* Workshops hero film - the estate's hardened pattern. */
(function () {
  var v = document.querySelector('.wvh-film');
  if (!v) return;
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  /* phone gate removed 2026-08-24 - James: hero films must play on mobile too */
  var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
  if (conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || ''))) return;
  v.muted = true; v.defaultMuted = true;
  function start() { var p = v.play(); if (p && p.catch) p.catch(function () {}); }
  v.addEventListener('playing', function () { v.classList.add('is-on'); }, { once: true });
  v.setAttribute('preload', 'auto');
  v.load();
  if (v.readyState >= 3) start();
  else v.addEventListener('canplay', start, { once: true });
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) { v.pause(); }
    else if (v.classList.contains('is-on')) { start(); }
  });
})();
{% endjavascript %}

