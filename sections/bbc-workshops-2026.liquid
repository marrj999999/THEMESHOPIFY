{%- comment -%}
  BBC New Design (2026) — Workshops page, single self-contained section.
  Structure mirrors the Claude Design handoff (workshops.html):
  hero → reassurance stats → "the whole build" how-it-works (4 numbered steps)
  → "see it before you book" video → give-back funding loop → 3 location cards
  → "good to know" FAQ → final CTA.

  Fully schema-driven (every heading / paragraph / image / link / repeating
  item is editable in the theme editor). Scoped under .bbc-rd via
  bbc-redesign-2026.css so it cannot affect other sections. Uses ONLY existing
  rd-* classes plus the shared rd-* utility layer (no inline style="").

  CONTENT POLICY: the give-back loop refers to accredited skills courses inside prisons and schools (generic).
  No prison is ever named (BBC external-comms rule). Set workshop prices:
  Road £595 (2 days) · Gravel £595 (2–3 days) · MTB £695 (3 days); Cycle to Work
  accepted. Booking is email-first (no instant checkout) — see the "How booking
  works" section. Location cards use real weekend build-day photos
  (bbc-rd-ws-london / -amersfoort / -toulouse.jpg).
{%- endcomment -%}


{%- liquid
  assign hero_cta1 = section.settings.hero_cta1_url | default: '#book'
  assign hero_cta2 = section.settings.hero_cta2_url | default: '#how'
  assign video_url = section.settings.video_url | default: '#'
  assign loop_url  = section.settings.loop_cta_url | default: '/pages/impact'
  assign final_c1  = section.settings.cta1_url | default: 'mailto:info@bamboobicycleclub.org'
  assign final_c2  = section.settings.cta2_url | default: '/pages/contact-us'
  assign book_cta  = section.settings.book_cta_url | default: 'mailto:info@bamboobicycleclub.org'
-%}

<div class="bbc-rd bbc-rd-workshops">

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  <header class="rd-hero">
    <div class="rd-bg">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 1600 }} 1600w, {{ section.settings.hero_image | image_url: width: 2000 }} 2000w, {{ section.settings.hero_image | image_url: width: 2600 }} 2600w" sizes="100vw" alt="{{ section.settings.hero_image_alt | default: 'Building a bamboo bike frame in the workshop' | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high" loading="eager">
      {%- else -%}
        <img src="{{ section.settings.hero_fallback | default: 'bbc-rd-gravel-sunset.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | default: 'Building a bamboo bike frame in the workshop' | escape }}" width="1200" height="800" fetchpriority="high" loading="eager">
      {%- endif -%}
    </div>
    <div class="rd-scrim"></div>
    <div class="rd-inner">
      <div class="rd-wrap">
        <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><span class="rd-here">Workshops</span></nav>
        {%- if section.settings.hero_eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1 class="rd-mt2 rd-mw-14ch">{{ section.settings.hero_title }}</h1>
        <div class="rd-lede">{{ section.settings.hero_lede }}</div>
        <div class="rd-cta-row">
          {%- if section.settings.hero_cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ hero_cta1 }}">{{ section.settings.hero_cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
          {%- if section.settings.hero_cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ hero_cta2 }}">{{ section.settings.hero_cta2_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </header>

  {%- comment -%} ---------- REASSURANCE STATS ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-paper">
    <div class="rd-wrap">
      <div class="rd-stats">
        {%- for block in section.blocks -%}{%- if block.type == 'stat' -%}
          <div class="rd-reveal rd-stat" {{ block.shopify_attributes }}>
            <div class="rd-num bbc-counted">{{ block.settings.number }}</div>
            <div class="rd-lbl">{{ block.settings.label }}</div>
            {%- if block.settings.source != blank -%}<div class="rd-src">{{ block.settings.source }}</div>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- CREDIBILITY STRIP ---------- {%- endcomment -%}
  <section class="rd-trustband">
    <div class="rd-wrap"><p class="rd-trustline">Run by Bamboo Mobility Project CIC &middot; enhanced-DBS facilitators &middot; public-liability insured</p></div>
  </section>

  {%- comment -%} ---------- HOW IT WORKS (4 numbered steps) ---------- {%- endcomment -%}
  <section class="rd-pad" id="how">
    <div class="rd-wrap">
      <div class="rd-split rd-tight rd-gap48-as">
        <div>
          <span class="rd-eyebrow">{{ section.settings.how_eyebrow }}</span>
          <h2 class="rd-reveal">{{ section.settings.how_title }}</h2>
          <p class="rd-lede rd-mt2">{{ section.settings.how_lede }}</p>
          <div class="rd-flex rd-mt3">
            {%- for block in section.blocks -%}{%- if block.type == 'how_tag' -%}
              <span class="rd-tag" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
            {%- endif -%}{%- endfor -%}
          </div>
        </div>
        <ol class="rd-steps">
          {%- for block in section.blocks -%}{%- if block.type == 'step' -%}
            <li {{ block.shopify_attributes }}>
              <h3>{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
            </li>
          {%- endif -%}{%- endfor -%}
        </ol>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- WATCH A BUILD (video) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-dark">
    <div class="rd-wrap">
      <div class="rd-split rd-tight rd-gap40-ac">
        <div>
          <span class="rd-eyebrow rd-on-dark">{{ section.settings.video_eyebrow }}</span>
          <h2 class="rd-reveal">{{ section.settings.video_title }}</h2>
          <p class="rd-lede rd-mt2">{{ section.settings.video_lede }}</p>
          {%- if section.settings.video_cta_label != blank and section.settings.video_url != blank -%}<a class="rd-btn rd-lime rd-mt3" href="{{ video_url }}">{{ section.settings.video_cta_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
        </div>
        <div class="rd-video">
          {%- if section.settings.video_url != blank and section.settings.video_url != '#' -%}
            {%- comment -%} standard player (2026-07-22): inline YouTube, auto thumbnail {%- endcomment -%}
            <div style="border-radius:14px;overflow:hidden;">
              {%- render 'bbc-media', image: section.settings.video_image, src: section.settings.video_fallback, youtube: section.settings.video_url, label: 'watch a real build', alt: section.settings.video_title, class: 'bbc-media--ar169', sizes: '(max-width:749px) 100vw, 640px' -%}
            </div>
          {%- else -%}
          {%- assign video_poster = section.settings.video_fallback | default: 'bbc-rd-build-poster.jpg' | asset_url -%}
          {%- if section.settings.video_image != blank -%}{%- assign video_poster = section.settings.video_image | image_url: width: 1400 -%}{%- endif -%}
          <video class="rd-video-el" controls preload="none" playsinline poster="{{ video_poster }}" width="1100" height="619">
            {%- if section.settings.video_mp4 != blank -%}{% # theme-check-disable RemoteAsset %}<source src="{{ section.settings.video_mp4 }}" type="video/mp4">{% # theme-check-enable RemoteAsset %}{%- endif -%}
            <source src="{{ 'bbc-rd-build-teaser.mp4' | asset_url }}" type="video/mp4">
          </video>
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- PRESS (standard block, qa/PRESS-BLOCK.md) ---------- {%- endcomment -%}
  {%- if section.settings.press_quote != blank -%}
  <section class="rd-pad-sm rd-paper">
    <div class="rd-wrap rd-center">
      {%- render 'bbc-press', style: 'bar', preset: 'cycling', label: section.settings.press_label, quote: section.settings.press_quote, cite: section.settings.press_cite -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- GIVE-BACK FUNDING LOOP ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-steel rd-center rd-reveal">
    <div class="rd-wrap rd-mw-760px">
      <span class="rd-eyebrow">{{ section.settings.loop_eyebrow }}</span>
      <h3 class="rd-fs-clamp22px3vw32">{{ section.settings.loop_heading }}</h3>
      <div class="rd-loop rd-mt3 rd-mt-24px">
        <div class="rd-step"><div class="rd-big">{{ section.settings.loop_s1_big }}</div>{%- if section.settings.loop_s1_sm != blank -%}<div class="rd-sm">{{ section.settings.loop_s1_sm }}</div>{%- endif -%}</div>
        <div class="rd-arr">&rarr;</div>
        <div class="rd-step"><div class="rd-big">{{ section.settings.loop_s2_big }}</div>{%- if section.settings.loop_s2_sm != blank -%}<div class="rd-sm">{{ section.settings.loop_s2_sm }}</div>{%- endif -%}</div>
        <div class="rd-arr">&rarr;</div>
        <div class="rd-step"><div class="rd-big">{{ section.settings.loop_s3_big }}</div>{%- if section.settings.loop_s3_sm != blank -%}<div class="rd-sm">{{ section.settings.loop_s3_sm }}</div>{%- endif -%}</div>
      </div>
      {%- if section.settings.loop_cta_label != blank -%}<a class="rd-btn rd-ghost rd-mt3" href="{{ loop_url }}">{{ section.settings.loop_cta_label }}</a>{%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- WHERE & WHAT (3 location cards) ---------- {%- endcomment -%}
  <section class="rd-pad" id="dates">
    <div class="rd-wrap">
      <span class="rd-eyebrow">{{ section.settings.loc_eyebrow }}</span>
      <h2 class="rd-reveal">{{ section.settings.loc_title }}</h2>
      {%- if section.settings.loc_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.loc_lede }}</p>{%- endif -%}
      <div class="rd-grid rd-g3 rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'location' -%}
          {%- assign loc_link = block.settings.link_url | default: '/pages/contact-us' -%}
          <div class="rd-reveal rd-card" {{ block.shopify_attributes }}>
            <div class="rd-ph">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.image_alt | default: 'Building a bamboo bike frame in the workshop' | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
              {%- else -%}
                <img src="{{ block.settings.fallback | default: 'bbc-rd-bike-field.jpg' | asset_url }}" alt="{{ block.settings.image_alt | default: 'Building a bamboo bike frame in the workshop' | escape }}" width="1300" height="1300">
              {%- endif -%}
            </div>
            <div class="rd-body">
              <h3 class="rd-fs-21px">{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
              {%- if block.settings.link_label != blank -%}<a class="rd-btn rd-lime rd-mt3" href="{{ loc_link }}">{{ block.settings.link_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      <div class="rd-flex rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'frame_tag' -%}
          {%- if block.settings.lime -%}{%- assign frame_tag_cls = 'rd-tag rd-lime' -%}{%- else -%}{%- assign frame_tag_cls = 'rd-tag' -%}{%- endif -%}
          <span class="{{ frame_tag_cls }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</span>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- HOW BOOKING WORKS (signup sheet) ---------- {%- endcomment -%}
  <section class="rd-pad rd-paper" id="book">
    <div class="rd-wrap">
      <div class="rd-split rd-tight rd-gap48-as">
        <div>
          <span class="rd-eyebrow">{{ section.settings.book_eyebrow }}</span>
          <h2 class="rd-reveal">{{ section.settings.book_title }}</h2>
          <p class="rd-lede rd-mt2">{{ section.settings.book_lede }}</p>
          <div class="rd-flex rd-mt3">
            {%- if section.settings.price1 != blank -%}<span class="rd-tag rd-lime">{{ section.settings.price1 }}</span>{%- endif -%}
            {%- if section.settings.price2 != blank -%}<span class="rd-tag">{{ section.settings.price2 }}</span>{%- endif -%}
            {%- if section.settings.price3 != blank -%}<span class="rd-tag">{{ section.settings.price3 }}</span>{%- endif -%}
          </div>
          {%- if section.settings.book_cta_label != blank -%}<a class="rd-btn rd-lime rd-mt3" href="{{ book_cta }}">{{ section.settings.book_cta_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
          {%- if section.settings.book_note != blank -%}<p class="rd-src rd-mt2">{{ section.settings.book_note }}</p>{%- endif -%}
        </div>
        <ol class="rd-steps">
          {%- if section.settings.book_s1_title != blank -%}<li><h3>{{ section.settings.book_s1_title }}</h3><p>{{ section.settings.book_s1_body }}</p></li>{%- endif -%}
          {%- if section.settings.book_s2_title != blank -%}<li><h3>{{ section.settings.book_s2_title }}</h3><p>{{ section.settings.book_s2_body }}</p></li>{%- endif -%}
          {%- if section.settings.book_s3_title != blank -%}<li><h3>{{ section.settings.book_s3_title }}</h3><p>{{ section.settings.book_s3_body }}</p></li>{%- endif -%}
          {%- if section.settings.book_s4_title != blank -%}<li><h3>{{ section.settings.book_s4_title }}</h3><p>{{ section.settings.book_s4_body }}</p></li>{%- endif -%}
        </ol>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- GOOD TO KNOW (FAQ) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-paper">
    <div class="rd-wrap rd-mw-820px">
      <span class="rd-eyebrow">{{ section.settings.faq_eyebrow }}</span>
      <h2 class="rd-reveal">{{ section.settings.faq_title }}</h2>
      <div class="rd-faq rd-mt3">
        {%- for block in section.blocks -%}{%- if block.type == 'faq' -%}
          <details {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <div class="rd-a">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- FINAL CTA ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-760px">
      <span class="rd-eyebrow rd-on-dark">{{ section.settings.cta_kicker }}</span>
      <h2 class="rd-reveal">{{ section.settings.cta_title }}</h2>
      <p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.cta_lede }}</p>
      <div class="rd-flex rd-mt3 rd-jc-center">
        {%- if section.settings.cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ final_c1 }}">{{ section.settings.cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ final_c2 }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
      </div>
    </div>
  </section>


  {%- comment -%} Stories band — snippets/bbc-stories-band.liquid (2026-08-01). This section
     had no `story` block type, which is why the page carried zero case-study cards. {%- endcomment -%}
  {%- render 'bbc-stories-band', section: section -%}
</div>

{% schema %}
{
  "name": "Workshops 2026 (new)",
  "tag": "section",
  "class": "section bbc-workshops-2026-wrap",
  "settings": [
    {
      "type": "header",
      "content": "Hero"
    },
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "Hero background image"
