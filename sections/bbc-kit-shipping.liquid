{%- comment -%} ============================================================
  BBC KIT SHIPPING — the landed cost, stated before checkout.

  Shipping/delivery is the largest single theme in the customer archive (~1,170
  of ~2,440 kit emails) and customs/VAT adds ~740 more. It is also the clearest
  deal-killer on record: the Brazil, Canada and Japan threads all die within one
  or two messages of the landed-cost answer. About 80% of kit sales are
  international (Projects/FAQ Rewrite 2026-08-19.md).

  The live page answered none of it. Rates existed only inside a collapsed
  "warranty, returns & shipping" accordion roughly 7,600px down, and the words
  customs, duty, import and VAT appeared nowhere on the page or in the policies.

  Industry evidence agrees with the archive: ~47% of international shoppers
  abandon over unexpected duties, and publishing the full landed cost is
  consistently reported as a double-digit conversion gain. BBC ships DDP
  (James, 2026-08-19), which is the strongest version of this — so it is a
  headline, not a footnote.

  Rows are blocks so a courier renegotiation is an editor edit.
  Styling lives in bbc-redesign-2026.css (design brief hard req 2).
============================================================ {%- endcomment -%}
{{ 'bbc-redesign-2026.css' | asset_url | stylesheet_tag }}

<div class="bbc-rd {% if section.settings.background == 'paper' %}rd-paper{% else %}rd-dark{% endif %}">
  <section class="rd-pad"{% if section.settings.anchor != blank %} id="{{ section.settings.anchor }}"{% endif %}>
    <div class="rd-wrap">
      {%- if section.settings.eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      {%- if section.settings.heading != blank -%}<h2 class="rd-reveal rd-mt2">{{ section.settings.heading }}</h2>{%- endif -%}

      <div class="rd-kship rd-mt3">
        {%- assign rows = section.blocks | where: 'type', 'rate' -%}
        {%- if rows.size > 0 -%}
          <table class="rd-kship__rates">
            <thead>
              <tr>
                <th scope="col">{{ section.settings.col1 | default: 'Destination' }}</th>
                <th scope="col">{{ section.settings.col2 | default: 'Shipping' }}</th>
                <th scope="col">{{ section.settings.col3 | default: 'Duty &amp; tax' }}</th>
              </tr>
            </thead>
            <tbody>
              {%- for block in rows -%}
                <tr {{ block.shopify_attributes }}>
                  <td>{{ block.settings.place }}</td>
                  <td>{{ block.settings.rate }}</td>
                  <td>{{ block.settings.duty }}</td>
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        {%- endif -%}

        {%- if section.settings.panel_title != blank -%}
          <div class="rd-kship__panel rd-reveal">
            <b>{{ section.settings.panel_title }}</b>
            {%- if section.settings.panel_body != blank -%}<p>{{ section.settings.panel_body }}</p>{%- endif -%}
            {%- if section.settings.worked != blank -%}<p class="rd-kship__worked">{{ section.settings.worked }}</p>{%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.foot != blank -%}
        <p class="rd-kship__foot">{{ section.settings.foot }}</p>
      {%- endif -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "BBC Kit shipping",
  "tag": "section",
  "class": "bbc-kit-shipping-section",
  "settings": [
    { "type": "select", "id": "background", "label": "Background", "default": "forest",
      "options": [
        { "value": "forest", "label": "Forest (dark)" },
        { "value": "paper", "label": "Paper" }
      ] },
    { "type": "text", "id": "anchor", "label": "Anchor id (for in-page links)", "default": "shipping" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "shipped worldwide from London" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "no customs bill at the door" },
    { "type": "header", "content": "Rate table columns" },
    { "type": "text", "id": "col1", "label": "Column 1 heading", "default": "Destination" },
    { "type": "text", "id": "col2", "label": "Column 2 heading", "default": "Shipping" },
    { "type": "text", "id": "col3", "label": "Column 3 heading", "default": "Duty & tax" },
    { "type": "header", "content": "Explainer panel" },
    { "type": "text", "id": "panel_title", "label": "Panel heading", "default": "Delivered duty paid" },
    { "type": "textarea", "id": "panel_body", "label": "Panel body", "default": "The price at checkout is the price the kit costs you. We pay the import duty and tax before it ships, so the courier has nothing to collect when it arrives." },
    { "type": "textarea", "id": "worked", "label": "Worked example", "default": "Sydney, Large kit: £385 kit + £75 shipping = £460 total, and nothing further on delivery." },
    { "type": "header", "content": "Footnote" },
    { "type": "textarea", "id": "foot", "label": "Footnote", "default": "Packed by hand and shipped twice a week, tracked all the way. Kits have reached 45 countries." }
  ],
  "blocks": [
    {
      "type": "rate",
      "name": "Destination rate",
      "settings": [
        { "type": "text", "id": "place", "label": "Destination", "default": "United Kingdom" },
        { "type": "text", "id": "rate", "label": "Shipping cost", "default": "£12" },
        { "type": "text", "id": "duty", "label": "Duty & tax", "default": "Included" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Kit shipping",
      "blocks": [ { "type": "rate" }, { "type": "rate" }, { "type": "rate" }, { "type": "rate" } ]
    }
  ]
}
{% endschema %}
