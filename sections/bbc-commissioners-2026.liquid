    {
      "type": "header",
      "content": "Delivery model"
    },
    {
      "type": "text",
      "id": "model_eyebrow",
      "label": "Eyebrow",
      "default": "The model"
    },
    {
      "type": "text",
      "id": "model_title",
      "label": "Heading",
      "default": "self-delivery: we set up, we train, you run it."
