{%- comment -%}
  BBC New Design (2026) — FOR PRISONS & COMMISSIONERS page (/pages/prisons).
  Single self-contained section, fully schema-driven, scoped under .bbc-rd via
  bbc-redesign-2026.css. Audience: Learning & Skills Managers, Heads of
  Reducing Reoffending, industries managers, education primes and funders.
  Structure: hero → facts strip → the delivery model (numbered steps) →
  budget guide (grant framing) → security & compliance list → three routes to
  commission → credibility quote + named sites → enquiry CTA.

  CONTENT POLICY (hard rules):
  - Prisons MAY be named. NEVER link a named/identifiable participant to a
    named prison. "Makers", never "prisoners"/"offenders".
  - Pricing uses GRANT-BUDGET framing only (kit ~£180 · cohort ~£8,500 ·
    capex £7–10k · site-year ~£45k) — no per-learner contract pricing.
  - Do NOT claim DPS/framework registration until James confirms it's live —
    the routes copy says "start with a conversation" instead.
  - 90% completion cited to BBC programme records only. No SROI figure.
{%- endcomment -%}

{%- liquid
  assign hero_cta1 = section.settings.hero_cta1_url | default: '/pages/contact-us'
  assign hero_cta2 = section.settings.hero_cta2_url | default: '/pages/build-to-bond'
  assign final_c1 = section.settings.cta1_url | default: '/pages/contact-us'
  assign enquiry_email = section.settings.enquiry_email | default: 'info@bamboobicycleclub.org'
-%}

<div class="bbc-rd bbc-rd-commissioners">

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  <header class="rd-hero rd-mh-70">
    <div class="rd-bg">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 1600 }} 1600w, {{ section.settings.hero_image | image_url: width: 2000 }} 2000w" sizes="100vw" alt="{{ section.settings.hero_image_alt | default: 'A prison workshop set up for Build to Bond' | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high" loading="eager">
      {%- else -%}
        <img src="{{ section.settings.hero_fallback | default: 'bbc-rd-prison-wide.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | default: 'A prison workshop set up for Build to Bond' | escape }}" width="1500" height="999" fetchpriority="high" loading="eager">
      {%- endif -%}
    </div>
    <div class="rd-scrim"></div>
    <div class="rd-inner">
      <div class="rd-wrap">
        <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><a href="/pages/impact">Impact</a><span class="rd-sep">/</span><span class="rd-here">{{ section.settings.tx_crumb_prisons | default: "For prisons" }}</span></nav>
        {%- if section.settings.hero_eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1 class="rd-mt2 rd-mw-16ch">{{ section.settings.hero_title }}</h1>
        <div class="rd-lede">{{ section.settings.hero_lede }}</div>
        <div class="rd-cta-row">
          {%- if section.settings.hero_cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ hero_cta1 }}">{{ section.settings.hero_cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
          {%- if section.settings.hero_cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ hero_cta2 }}">{{ section.settings.hero_cta2_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </header>

  {%- comment -%} ---------- THE DELIVERY MODEL (numbered steps) ---------- {%- endcomment -%}
  <section class="rd-pad">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.model_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.model_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.model_title }}</h2>
      {%- if section.settings.model_lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.model_lede }}</p>{%- endif -%}
      <ol class="rd-steps rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'step' -%}
          <li {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.body }}</p>
          </li>
        {%- endif -%}{%- endfor -%}
      </ol>
    </div>
  </section>

  {%- comment -%} ---------- FACTS STRIP ----------
    Moved below THE DELIVERY MODEL (was directly under the hero). Hero and facts strip are both
    dark, so the page opened with two dark bands run together — PAGE-STANDARD S3. Impact's order
    is hero -> light band -> dark stats, and that light band is what lets the stat band stay
    dark, which is what keeps the figures lime. Reordered, not recoloured. (2026-08-04)
  {%- endcomment -%}
  <section class="rd-pad-sm rd-dark">
    <div class="rd-wrap">
      <div class="rd-facts">
        {%- for block in section.blocks -%}{%- if block.type == 'fact' -%}
          <div class="rd-reveal rd-fact" {{ block.shopify_attributes }}><span class="rd-reveal rd-fact-n">{{ block.settings.number }}</span><span class="rd-reveal rd-fact-l">{{ block.settings.label }}</span></div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- BUDGET GUIDE (grant framing, paper) ---------- {%- endcomment -%}
  {%- if section.settings.budget_title != blank -%}
  <section class="rd-pad rd-paper">
    <div class="rd-wrap">
      {%- if section.settings.budget_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.budget_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal rd-mw-22ch">{{ section.settings.budget_title }}</h2>
      {%- if section.settings.budget_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.budget_lede }}</p>{%- endif -%}
      <div class="rd-grid rd-g4 rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'budget' -%}
          <div class="rd-reveal rd-card rd-stamp" {{ block.shopify_attributes }}>
            <div class="rd-body">
              <div class="rd-num bbc-counted">{{ block.settings.figure }}</div>
              <p class="rd-statlbl rd-mt1">{{ block.settings.title }}</p>
              <p>{{ block.settings.body }}</p>
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- if section.settings.budget_note != blank -%}<p class="rd-ship-note rd-mt3">{{ section.settings.budget_note }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- SECURITY & COMPLIANCE ---------- {%- endcomment -%}
  {%- if section.settings.sec_title != blank -%}
  <section class="rd-pad">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.sec_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.sec_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.sec_title }}</h2>
      {%- if section.settings.sec_lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.sec_lede }}</p>{%- endif -%}
      <ul class="rd-list rd-mt3">
        {%- for block in section.blocks -%}{%- if block.type == 'check' -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endif -%}{%- endfor -%}
      </ul>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- THREE ROUTES TO COMMISSION ---------- {%- endcomment -%}
  {%- if section.settings.routes_title != blank -%}
  <section class="rd-pad rd-steel">
    <div class="rd-wrap">
      <div class="rd-center">
        {%- if section.settings.routes_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.routes_eyebrow }}</span>{%- endif -%}
        <h2 class="rd-reveal">{{ section.settings.routes_title }}</h2>
        {%- if section.settings.routes_lede != blank -%}<p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.routes_lede }}</p>{%- endif -%}
      </div>
      <div class="rd-grid rd-g3 rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'route' -%}
          <div class="rd-reveal rd-card rd-stamp" {{ block.shopify_attributes }}>
            <div class="rd-body">
              {%- if block.settings.tag != blank -%}<span class="rd-tag rd-lime">{{ block.settings.tag }}</span>{%- endif -%}
              <h3 class="rd-mt2 rd-fs-21px">{{ block.settings.title }}</h3>
              <p>{{ block.settings.body }}</p>
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- CREDIBILITY (quote + named sites) ---------- {%- endcomment -%}
  {%- if section.settings.cred_quote != blank -%}
  <section class="rd-pad-sm rd-paper rd-center">
    <div class="rd-wrap rd-mw-680px">
      <div class="rd-reveal rd-pull rd-mx-auto">
        <p class="rd-q">{{ section.settings.cred_quote }}</p>
        {%- if section.settings.cred_cite != blank -%}<cite>{{ section.settings.cred_cite }}</cite>{%- endif -%}
      </div>
      {%- if section.settings.sites_list != blank -%}<div class="rd-sitenames rd-mt4">{{ section.settings.sites_list }}</div>{%- endif -%}
      {%- assign plogos = section.blocks | where: 'type', 'plogo' -%}
      {%- if plogos.size > 0 -%}
        <p class="rd-partnerlabel rd-mt4">{{ section.settings.partners_label | default: 'Working with' }}</p>
        <div class="rd-logogrid rd-mt2">
          {%- for block in plogos -%}
            <span class="rd-logocell" {{ block.shopify_attributes }}>{%- if block.settings.asset != blank -%}<img class="rd-logoimg" src="{{ block.settings.asset | asset_url }}" alt="{{ block.settings.alt | escape }}" loading="lazy">{%- else -%}<span class="rd-logotext">{{ block.settings.alt }}</span>{%- endif -%}</span>
          {%- endfor -%}
        </div>
      {%- endif -%}
      {%- if section.settings.funder_logo != blank or section.settings.accred_logo != blank -%}<div class="rd-mt3 rd-flex rd-jc-center" style="gap:32px;align-items:center;">{%- if section.settings.funder_logo != blank -%}<img src="{{ section.settings.funder_logo | asset_url }}" alt="{{ section.settings.funder_logo_alt | default: 'The National Lottery Community Fund' | escape }}" loading="lazy" style="height:56px !important;width:auto !important;max-width:220px;object-fit:contain;">{%- endif -%}{%- if section.settings.accred_logo != blank -%}<img src="{{ section.settings.accred_logo | asset_url }}" alt="{{ section.settings.accred_logo_alt | default: 'OCN London' | escape }}" loading="lazy" style="height:48px !important;width:auto !important;max-width:180px;object-fit:contain;">{%- endif -%}</div>{%- endif -%}
      {%- if section.settings.funder_line != blank -%}<p class="rd-ship-note{% if section.settings.funder_logo != blank %} rd-mt1{% else %} rd-mt3{% endif %}">{{ section.settings.funder_line }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- ENQUIRY CTA (dark, centred) ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-680px">
      {%- if section.settings.cta_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.cta_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.cta_title }}</h2>
      {%- if section.settings.cta_lede != blank -%}<p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.cta_lede }}</p>{%- endif -%}
      <div class="rd-flex rd-mt3 rd-jc-center">
        {%- if section.settings.cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ final_c1 }}">{{ section.settings.cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
        <a class="rd-btn rd-on-dark" href="mailto:{{ enquiry_email }}">{{ section.settings.cta2_label | default: 'Email us' }}</a>
      </div>
    </div>
  </section>


  {%- comment -%} Stories band — snippets/bbc-stories-band.liquid (2026-08-01). This section
     had no `story` block type, which is why the page carried zero case-study cards. {%- endcomment -%}
  {%- render 'bbc-stories-band', section: section -%}
</div>

{% schema %}
{
