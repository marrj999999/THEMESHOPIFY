      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "For prisons & commissioners"
    },
    {
      "type": "text",
      "id": "hero_title",
      "label": "Headline",
      "default": "run build to bond in your prison."
    },
    {
      "type": "textarea",
      "id": "hero_lede",
      "label": "Lede",
      "default": "An OCN Level 2 accredited manufacturing course, delivered in your workshops by your staff — trained by us. One setup, repeatable cohorts, no ongoing fees."
    },
    {
      "type": "text",
      "id": "hero_cta1_label",
      "label": "Primary CTA label",
      "default": "Start a conversation"
    },
    {
      "type": "url",
      "id": "hero_cta1_url",
      "label": "Primary CTA link (defaults to the contact page)"
    },
    {
      "type": "text",
      "id": "hero_cta2_label",
      "label": "Secondary CTA label",
      "default": "See the programme"
    },
    {
      "type": "url",
      "id": "hero_cta2_url",
      "label": "Secondary CTA link (defaults to the Build to Bond page)"
