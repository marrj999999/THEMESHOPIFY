{% comment %}
  BBC Kit Complete - All-in-one product page
  Clean, white background, tabbed content - based on Canyon/Specialized best practices
{% endcomment %}

{%- style -%}
/* ============================================
   BBC KIT COMPLETE - CLEAN MINIMAL DESIGN
   ============================================ */

.bbc-kit {
  --kit-forest: var(--bbc-forest);
  --kit-teal: var(--bbc-teal);
  --kit-gold: var(--bbc-gold);
  --kit-cream: #f8f8f6;
  --kit-border: #e5e5e5;
  --kit-text-muted: rgba(7, 62, 39, 0.65);
  --kit-grey: rgba(7, 62, 39, 0.65);
  --kit-light: #f5f5f5;
  font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
  background: var(--bbc-white);
  color: #1a1a1a;
}

/* HERO SECTION */
.bbc-kit__hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 3rem;
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1.5rem;
}

@media (max-width: 989px) {
  .bbc-kit__hero { 
    grid-template-columns: 1fr; 
    gap: 1.5rem;
    padding: 1rem;
  }
}

/* Gallery */
.bbc-kit__gallery {
  position: relative;
  align-self: start;
}

@media (min-width: 990px) {
  .bbc-kit__gallery {
    position: sticky;
    top: 120px; /* Below header */
    max-height: calc(100vh - 140px);
    z-index: 1; /* Keep below other elements */
  }
}

.bbc-kit__main-img {
  aspect-ratio: 1;
  background: var(--kit-cream);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 0.75rem;
}

.bbc-kit__main-img img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.bbc-kit__thumbs {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 0.5rem;
}

.bbc-kit__thumb {
  aspect-ratio: 1;
  background: var(--kit-cream);
  border: 2px solid transparent;
  cursor: pointer;
  padding: 0;
  transition: border-color 0.15s;
}

.bbc-kit__thumb:hover,
.bbc-kit__thumb.active {
  border-color: var(--kit-forest);
}

.bbc-kit__thumb img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Product Info */
.bbc-kit__info {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.bbc-kit__breadcrumb {
  font-size: 0.8125rem;
  color: var(--kit-grey);
}

.bbc-kit__breadcrumb a {
  color: var(--kit-teal);
  text-decoration: none;
}

.bbc-kit__title {
  font-size: 2rem;
  font-weight: 800;
  color: var(--kit-forest);
  margin: 0;
  line-height: 1.15;
}

.bbc-kit__subtitle {
  font-size: 1rem;
  color: var(--kit-grey);
  margin: 0;
  line-height: 1.5;
}

/* Rating */
.bbc-kit__rating {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  font-size: 0.875rem;
}

.bbc-kit__stars {
  color: var(--kit-gold);
  display: flex;
  gap: 2px;
}

.bbc-kit__stars svg {
  width: 16px;
  height: 16px;
  fill: currentColor;
}

/* Price */
.bbc-kit__price-row {
  display: flex;
  align-items: baseline;
  gap: 0.75rem;
  padding: 1rem 0;
  border-top: 1px solid var(--kit-border);
  border-bottom: 1px solid var(--kit-border);
}

.bbc-kit__price {
  font-size: 1.75rem;
  font-weight: 800;
  color: var(--kit-forest);
}

.bbc-kit__compare {
  font-size: 1rem;
  color: var(--kit-grey);
  text-decoration: line-through;
}

/* Trust Icons */
.bbc-kit__trust {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem 1rem;
  font-size: 0.8125rem;
}

.bbc-kit__trust-item {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  color: var(--kit-forest);
}

.bbc-kit__trust-item svg {
  width: 16px;
  height: 16px;
  color: var(--kit-teal);
  flex-shrink: 0;
}

/* Add to Cart */
.bbc-kit__cart {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.bbc-kit__add-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  background: var(--kit-forest);
  color: var(--bbc-white);
  border: none;
  padding: 1rem 1.5rem;
  font-size: 1rem;
  font-weight: 700;
  cursor: pointer;
  font-family: inherit;
  transition: background 0.15s;
}

.bbc-kit__add-btn:hover {
  background: #0a5535;
}

.bbc-kit__add-btn:disabled {
  background: var(--bbc-gray-400, #999);
  cursor: not-allowed;
}

.bbc-kit__secondary {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.5rem;
}

.bbc-kit__link-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  background: var(--bbc-white);
  border: 1px solid var(--kit-border);
  color: var(--kit-forest);
  padding: 0.75rem;
  font-size: 0.8125rem;
  font-weight: 600;
  cursor: pointer;
  text-decoration: none;
  font-family: inherit;
  transition: all 0.15s;
}

.bbc-kit__link-btn:hover {
  border-color: var(--kit-forest);
  background: var(--kit-cream);
}

/* Shipping */
.bbc-kit__shipping {
  background: var(--kit-cream);
  padding: 1rem;
  font-size: 0.8125rem;
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.bbc-kit__shipping-item {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.bbc-kit__shipping-item svg {
  width: 16px;
  height: 16px;
  color: var(--kit-teal);
}

/* ============================================
   TABBED CONTENT SECTION
   ============================================ */

.bbc-kit__tabs-wrapper {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 1.5rem 3rem;
}

.bbc-kit__tabs {
  display: flex;
  gap: 0;
  border-bottom: 1px solid var(--kit-border);
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.bbc-kit__tab {
  flex-shrink: 0;
  padding: 1rem 1.5rem;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--kit-grey);
  background: none;
  border: none;
  border-bottom: 2px solid transparent;
  cursor: pointer;
  font-family: inherit;
  transition: all 0.15s;
  white-space: nowrap;
}

.bbc-kit__tab:hover {
  color: var(--kit-forest);
}

.bbc-kit__tab.active {
  color: var(--kit-forest);
  border-bottom-color: var(--kit-forest);
}

@media (max-width: 768px) {
  .bbc-kit__tab {
    padding: 0.875rem 1rem;
    font-size: 0.8125rem;
  }
}

/* Tab Panels */
.bbc-kit__panel {
  display: none;
  padding: 2rem 0;
}

.bbc-kit__panel.active {
  display: block;
}

.bbc-kit__panel-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--kit-forest);
  margin: 0 0 1rem 0;
}

.bbc-kit__panel-subtitle {
  color: var(--kit-grey);
  margin: 0 0 1.5rem 0;
}

/* Included Items Grid */
.bbc-kit__included-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

@media (max-width: 768px) {
  .bbc-kit__included-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }
}

.bbc-kit__included-item {
  display: flex;
  gap: 0.75rem;
}

.bbc-kit__included-icon {
  width: 40px;
  height: 40px;
  background: var(--kit-cream);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.bbc-kit__included-icon svg {
  width: 20px;
  height: 20px;
  color: var(--kit-teal);
}

.bbc-kit__included-title {
  font-weight: 600;
  color: var(--kit-forest);
  margin: 0 0 0.25rem 0;
  font-size: 0.9375rem;
}

.bbc-kit__included-desc {
  font-size: 0.8125rem;
  color: var(--kit-grey);
  margin: 0;
}

/* Build Time */
.bbc-kit__time-hero {
  text-align: center;
  margin-bottom: 2rem;
}

.bbc-kit__time-number {
  font-size: 3rem;
  font-weight: 800;
  color: var(--kit-forest);
}

.bbc-kit__time-label {
  color: var(--kit-grey);
}

.bbc-kit__steps {
  display: flex;
  flex-direction: column;
  gap: 1rem;
}

.bbc-kit__step {
  display: grid;
  grid-template-columns: 2rem 1fr auto;
  gap: 1rem;
  align-items: start;
  padding: 1rem;
  background: var(--kit-cream);
}

.bbc-kit__step-num {
  width: 2rem;
  height: 2rem;
  background: var(--kit-forest);
  color: var(--bbc-white);
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 0.875rem;
}

.bbc-kit__step-title {
  font-weight: 600;
  margin: 0 0 0.25rem 0;
}

.bbc-kit__step-desc {
  font-size: 0.8125rem;
  color: var(--kit-grey);
  margin: 0;
}

.bbc-kit__step-time {
  font-weight: 600;
  color: var(--kit-teal);
  white-space: nowrap;
}

/* Durability Stats */
.bbc-kit__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
  margin-bottom: 2rem;
  text-align: center;
}

@media (max-width: 768px) {
  .bbc-kit__stats {
    grid-template-columns: 1fr;
    gap: 1rem;
  }
}

.bbc-kit__stat-value {
  font-size: 2rem;
  font-weight: 800;
  color: var(--kit-forest);
}

.bbc-kit__stat-label {
  font-size: 0.8125rem;
  color: var(--kit-grey);
}

/* Reviews */
.bbc-kit__reviews-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
}

@media (max-width: 768px) {
  .bbc-kit__reviews-grid {
    grid-template-columns: 1fr;
  }
}

.bbc-kit__review {
  padding: 1.5rem;
  background: var(--kit-cream);
}

.bbc-kit__review-quote {
  font-style: italic;
  margin: 0 0 1rem 0;
  line-height: 1.6;
}

.bbc-kit__review-author {
  font-weight: 600;
  color: var(--kit-forest);
}

.bbc-kit__review-meta {
  font-size: 0.8125rem;
  color: var(--kit-grey);
}

/* FAQ Accordion */
.bbc-kit__faq-item {
  border-bottom: 1px solid var(--kit-border);
}

.bbc-kit__faq-q {
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 1.25rem 0;
  font-size: 1rem;
  font-weight: 600;
  color: var(--kit-forest);
  background: none;
  border: none;
  cursor: pointer;
  text-align: left;
  font-family: inherit;
}

.bbc-kit__faq-q svg {
  width: 20px;
  height: 20px;
  transition: transform 0.2s;
  flex-shrink: 0;
}

.bbc-kit__faq-q.open svg {
  transform: rotate(180deg);
}

.bbc-kit__faq-a {
  display: none;
  padding: 0 0 1.25rem 0;
  color: var(--kit-grey);
  line-height: 1.6;
}

.bbc-kit__faq-a.open {
  display: block;
}

/* Upsell */
.bbc-kit__upsell {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.5rem;
  margin-top: 1rem;
}

@media (max-width: 768px) {
  .bbc-kit__upsell {
    grid-template-columns: 1fr;
  }
}

.bbc-kit__upsell-card {
  padding: 1.5rem;
  border: 1px solid var(--kit-border);
}

.bbc-kit__upsell-title {
  font-weight: 600;
  color: var(--kit-forest);
  margin: 0 0 0.5rem 0;
}

.bbc-kit__upsell-desc {
  font-size: 0.875rem;
  color: var(--kit-grey);
  margin: 0 0 1rem 0;
}

.bbc-kit__upsell-price {
  font-weight: 700;
  color: var(--kit-forest);
  margin-bottom: 0.75rem;
}

.bbc-kit__upsell-btn {
  display: inline-block;
  background: var(--kit-forest);
  color: var(--bbc-white);
  padding: 0.625rem 1.25rem;
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: none;
}
{%- endstyle -%}

<div class="bbc-kit" data-testid="kit-page">
  <!-- HERO SECTION -->
  <div class="bbc-kit__hero">
    <!-- Gallery -->
    <div class="bbc-kit__gallery">
      <div class="bbc-kit__main-img">
        {% if product.featured_image %}
          <img 
            src="{{ product.featured_image | image_url: width: 800 }}"
            alt="{{ product.featured_image.alt | default: product.title }}"
            id="kit-main-image"
            loading="eager"
          >
        {% endif %}
      </div>
      {% if product.images.size > 1 %}
        <div class="bbc-kit__thumbs">
          {% for image in product.images limit: 5 %}
            <button 
              class="bbc-kit__thumb {% if forloop.first %}active{% endif %}"
              data-src="{{ image | image_url: width: 800 }}"
              type="button"
            >
              <img src="{{ image | image_url: width: 120 }}" alt="" loading="lazy">
            </button>
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <!-- Product Info -->
    <div class="bbc-kit__info">
      <nav class="bbc-kit__breadcrumb">
        <a href="/">Home</a> / <a href="/collections/home-build-kits">Kits</a> / {{ product.title }}
      </nav>

      <h1 class="bbc-kit__title">{{ product.title }}</h1>
      <p class="bbc-kit__subtitle">{{ section.settings.tagline }}</p>

      <div class="bbc-kit__rating">
        <span class="bbc-kit__stars">
          {% for i in (1..5) %}
            <svg viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
          {% endfor %}
        </span>
        <span>4.9 · {{ section.settings.review_count }} reviews</span>
      </div>

      <div class="bbc-kit__price-row">
        <span class="bbc-kit__price">{{ product.price | money }}</span>
        {% if product.compare_at_price > product.price %}
          <span class="bbc-kit__compare">{{ product.compare_at_price | money }}</span>
        {% endif %}
      </div>

      <div class="bbc-kit__trust">
        <div class="bbc-kit__trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          95% first-time builders
        </div>
        <div class="bbc-kit__trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          {{ section.settings.build_time }} hours
        </div>
        <div class="bbc-kit__trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
          Everything included
        </div>
        <div class="bbc-kit__trust-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
          4,000+ builders
        </div>
      </div>

      <div class="bbc-kit__cart">
        {%- form 'product', product, novalidate: 'novalidate' -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
          <button type="submit" class="bbc-kit__add-btn" {% unless product.available %}disabled{% endunless %}>
            {% if product.available %}Add to Cart — {{ product.price | money }}{% else %}Sold Out{% endif %}
          </button>
        {%- endform -%}
        <div class="bbc-kit__secondary">
          <a href="#included" class="bbc-kit__link-btn">What's Included</a>
          <a href="/pages/contact-us" class="bbc-kit__link-btn">Ask a Question</a>
        </div>
      </div>

      <div class="bbc-kit__shipping">
        <div class="bbc-kit__shipping-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <strong>Free UK shipping</strong> · Ships in 3-5 days
        </div>
        <div class="bbc-kit__shipping-item">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
          Worldwide delivery available
        </div>
      </div>
    </div>
  </div>

  <!-- TABBED CONTENT -->
  <div class="bbc-kit__tabs-wrapper">
    <div class="bbc-kit__tabs" role="tablist">
      <button class="bbc-kit__tab active" data-tab="included" role="tab">What's Included</button>
      <button class="bbc-kit__tab" data-tab="build" role="tab">Build Time</button>
      <button class="bbc-kit__tab" data-tab="durability" role="tab">Durability</button>
      <button class="bbc-kit__tab" data-tab="reviews" role="tab">Reviews</button>
      <button class="bbc-kit__tab" data-tab="faq" role="tab">FAQ</button>
    </div>

    <!-- INCLUDED TAB -->
    <div class="bbc-kit__panel active" id="included" role="tabpanel">
      <h2 class="bbc-kit__panel-title">What's In The Box</h2>
      <p class="bbc-kit__panel-subtitle">Everything you need to build your bamboo bicycle frame</p>
      <div class="bbc-kit__included-grid">
        <div class="bbc-kit__included-item">
          <div class="bbc-kit__included-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
          </div>
          <div>
            <p class="bbc-kit__included-title">Bamboo Tube Set</p>
            <p class="bbc-kit__included-desc">5 heat-treated Moso bamboo tubes</p>
          </div>
        </div>
        <div class="bbc-kit__included-item">
          <div class="bbc-kit__included-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
          </div>
          <div>
            <p class="bbc-kit__included-title">Carbon Fibre & Epoxy</p>
            <p class="bbc-kit__included-desc">Pre-cut tow + marine-grade resin</p>
          </div>
        </div>
        <div class="bbc-kit__included-item">
          <div class="bbc-kit__included-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
          </div>
          <div>
            <p class="bbc-kit__included-title">Alignment Jig</p>
            <p class="bbc-kit__included-desc">Plywood jig for perfect geometry</p>
          </div>
        </div>
        <div class="bbc-kit__included-item">
          <div class="bbc-kit__included-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          </div>
          <div>
            <p class="bbc-kit__included-title">Metal Components</p>
            <p class="bbc-kit__included-desc">Headtube, BB shell, dropouts</p>
          </div>
        </div>
        <div class="bbc-kit__included-item">
          <div class="bbc-kit__included-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>
          </div>
          <div>
            <p class="bbc-kit__included-title">Video Tutorials</p>
            <p class="bbc-kit__included-desc">15+ hours of step-by-step guidance</p>
          </div>
        </div>
        <div class="bbc-kit__included-item">
          <div class="bbc-kit__included-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
          </div>
          <div>
            <p class="bbc-kit__included-title">Community Access</p>
            <p class="bbc-kit__included-desc">Support from 4,000+ builders</p>
          </div>
        </div>
      </div>

      <!-- Upsell -->
      <div class="bbc-kit__upsell">
        <div class="bbc-kit__upsell-card">
          <p class="bbc-kit__upsell-title">Carbon Fork</p>
          <p class="bbc-kit__upsell-desc">Disc brake compatible. 72% of builders add one.</p>
          <p class="bbc-kit__upsell-price">£225</p>
          <a href="/products/gravel-carbon-fork" class="bbc-kit__upsell-btn">Add Fork</a>
        </div>
        <div class="bbc-kit__upsell-card">
          <p class="bbc-kit__upsell-title">Component Pack</p>
          <p class="bbc-kit__upsell-desc">Everything to complete your bike: wheels, groupset, finishing kit.</p>
          <p class="bbc-kit__upsell-price">From £499</p>
          <a href="/collections/component-packs" class="bbc-kit__upsell-btn">View Options</a>
        </div>
      </div>
    </div>

    <!-- BUILD TIME TAB -->
    <div class="bbc-kit__panel" id="build" role="tabpanel">
      <h2 class="bbc-kit__panel-title">Build Timeline</h2>
      <div class="bbc-kit__time-hero">
        <div class="bbc-kit__time-number">{{ section.settings.build_time }}</div>
        <div class="bbc-kit__time-label">hours total</div>
      </div>
      <div class="bbc-kit__steps">
        <div class="bbc-kit__step">
          <span class="bbc-kit__step-num">1</span>
          <div>
            <p class="bbc-kit__step-title">Preparation</p>
            <p class="bbc-kit__step-desc">Unbox, inventory parts, watch tutorials</p>
          </div>
          <span class="bbc-kit__step-time">2-3 hrs</span>
        </div>
        <div class="bbc-kit__step">
          <span class="bbc-kit__step-num">2</span>
          <div>
            <p class="bbc-kit__step-title">Jig Assembly</p>
            <p class="bbc-kit__step-desc">Set up jig, prepare bamboo tubes</p>
          </div>
          <span class="bbc-kit__step-time">4-6 hrs</span>
        </div>
        <div class="bbc-kit__step">
          <span class="bbc-kit__step-num">3</span>
          <div>
            <p class="bbc-kit__step-title">Bonding</p>
            <p class="bbc-kit__step-desc">Join tubes with epoxy, wrap with fibre</p>
          </div>
          <span class="bbc-kit__step-time">8-12 hrs</span>
        </div>
        <div class="bbc-kit__step">
          <span class="bbc-kit__step-num">4</span>
          <div>
            <p class="bbc-kit__step-title">Curing</p>
            <p class="bbc-kit__step-desc">Wait for epoxy to fully cure</p>
          </div>
          <span class="bbc-kit__step-time">24-48 hrs</span>
        </div>
        <div class="bbc-kit__step">
          <span class="bbc-kit__step-num">5</span>
          <div>
            <p class="bbc-kit__step-title">Finishing</p>
            <p class="bbc-kit__step-desc">Sand joints, apply sealant, add components</p>
          </div>
          <span class="bbc-kit__step-time">6-10 hrs</span>
        </div>
      </div>
    </div>

    <!-- DURABILITY TAB -->
    <div class="bbc-kit__panel" id="durability" role="tabpanel">
      <h2 class="bbc-kit__panel-title">Durability & Strength</h2>
      <p class="bbc-kit__panel-subtitle">Yes, it's strong enough. Here's the proof.</p>
      <div class="bbc-kit__stats">
        <div>
          <div class="bbc-kit__stat-value">8-12</div>
          <div class="bbc-kit__stat-label">Years lifespan</div>
        </div>
        <div>
          <div class="bbc-kit__stat-value">&lt;1%</div>
          <div class="bbc-kit__stat-label">Failure rate</div>
        </div>
        <div>
          <div class="bbc-kit__stat-value">28K</div>
          <div class="bbc-kit__stat-label">PSI tensile strength</div>
        </div>
      </div>
      <div class="bbc-kit__review" style="margin-bottom: 1.5rem;">
        <p class="bbc-kit__review-quote">"Woody turned out to be the most reliable bike I've ever owned. I had hardly any mechanical problems on the whole journey."</p>
        <p class="bbc-kit__review-author">Kate Rawles</p>
        <p class="bbc-kit__review-meta">8,288 miles through South America</p>
      </div>
    </div>

    <!-- REVIEWS TAB -->
    <div class="bbc-kit__panel" id="reviews" role="tabpanel">
      <h2 class="bbc-kit__panel-title">What Builders Say</h2>
      <div class="bbc-kit__reviews-grid">
        <div class="bbc-kit__review">
          <p class="bbc-kit__review-quote">"I had zero woodworking experience. The videos walk you through everything. Finished in 3 weekends."</p>
          <p class="bbc-kit__review-author">Jamie</p>
          <p class="bbc-kit__review-meta">Romania · 7 years riding</p>
        </div>
        <div class="bbc-kit__review">
          <p class="bbc-kit__review-quote">"More rewarding than I expected. When people ask about my bike, I tell them I built it. Their reaction is priceless."</p>
          <p class="bbc-kit__review-author">Louise</p>
          <p class="bbc-kit__review-meta">London · Road kit builder</p>
        </div>
        <div class="bbc-kit__review">
          <p class="bbc-kit__review-quote">"The community support is incredible. Whenever I got stuck, someone on the forum had the answer within hours."</p>
          <p class="bbc-kit__review-author">Marcus</p>
          <p class="bbc-kit__review-meta">Berlin · First-time builder</p>
        </div>
        <div class="bbc-kit__review">
          <p class="bbc-kit__review-quote">"My bamboo gravel bike has been through the Pamir Highway in winter. Still going strong after 5 years."</p>
          <p class="bbc-kit__review-author">Adventure Cyclist</p>
          <p class="bbc-kit__review-meta">Multi-continent touring</p>
        </div>
      </div>
    </div>

    <!-- FAQ TAB -->
    <div class="bbc-kit__panel" id="faq" role="tabpanel">
      <h2 class="bbc-kit__panel-title">Common Questions</h2>
      
      <div class="bbc-kit__faq-item">
        <button class="bbc-kit__faq-q" type="button">
          Do I need special tools?
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="bbc-kit__faq-a">No power tools required. Basic hand tools: hacksaw, files, sandpaper, measuring tape, and a work surface. Everything else is included.</div>
      </div>
      
      <div class="bbc-kit__faq-item">
        <button class="bbc-kit__faq-q" type="button">
          What if I make a mistake?
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="bbc-kit__faq-a">Most mistakes are fixable. Epoxy can be sanded and re-applied. Bamboo is forgiving. If you're stuck, our community forum has seen every problem.</div>
      </div>
      
      <div class="bbc-kit__faq-item">
        <button class="bbc-kit__faq-q" type="button">
          What else do I need to complete the bike?
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="bbc-kit__faq-a">Fork, wheels, groupset, handlebars, saddle, and finishing components. We offer component packs, or source parts from any bike shop.</div>
      </div>
      
      <div class="bbc-kit__faq-item">
        <button class="bbc-kit__faq-q" type="button">
          How strong is bamboo?
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </button>
        <div class="bbc-kit__faq-a">28,000 PSI tensile strength — comparable to steel. Our frames are tested to 100,000+ fatigue cycles. Builders tour continents and race on them.</div>
      </div>
    </div>
  </div>
</div>

<script>
// Tab switching
document.querySelectorAll('.bbc-kit__tab').forEach(tab => {
  tab.addEventListener('click', () => {
    document.querySelectorAll('.bbc-kit__tab').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.bbc-kit__panel').forEach(p => p.classList.remove('active'));
    tab.classList.add('active');
    document.getElementById(tab.dataset.tab).classList.add('active');
  });
});

// FAQ accordion
document.querySelectorAll('.bbc-kit__faq-q').forEach(q => {
  q.addEventListener('click', () => {
    q.classList.toggle('open');
    q.nextElementSibling.classList.toggle('open');
  });
});

// Image gallery
document.querySelectorAll('.bbc-kit__thumb').forEach(thumb => {
  thumb.addEventListener('click', () => {
    document.getElementById('kit-main-image').src = thumb.dataset.src;
    document.querySelectorAll('.bbc-kit__thumb').forEach(t => t.classList.remove('active'));
    thumb.classList.add('active');
  });
});
</script>

{% schema %}
{
  "name": "BBC Kit Complete",
  "tag": "section",
  "class": "bbc-kit-section",
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline",
      "default": "Build your own bamboo bicycle frame at home — no experience needed."
    },
    {
      "type": "text",
      "id": "build_time",
      "label": "Build Time",
      "default": "20-40"
    },
    {
      "type": "number",
      "id": "review_count",
      "label": "Review Count",
      "default": 127
    }
  ],
  "presets": [{ "name": "BBC Kit Complete" }]
}
{% endschema %}
