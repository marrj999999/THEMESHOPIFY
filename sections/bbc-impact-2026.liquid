{%- comment -%}
  BBC New Design (2026) — "Our Impact / Build to Bond" page.
  Single self-contained section, fully schema-driven (editable in the theme
  editor) and scoped under .bbc-rd via bbc-redesign-2026.css so it cannot
  affect other sections. Structure mirrors the design handoff (impact.html):
  hero → 4-stat block (dark) → "a real workshop, inside" → Build to Bond
  feature split → "more than a bike — a pathway" 3 cards → "three ways to be
  part of it" 3 CTA cards → final CTA.

  CONTENT POLICY (hard rules, updated 2026-06-20):
  - Prisons MAY be named (rule changed 2026-06-17). Active named sites:
    HMP Lowdham Grange, HMP Foston Hall, HMP Lindholme, HMYOI Feltham (four active sites).
    NEVER link a named/identifiable participant to a named prison (GDPR/safeguarding).
  - Source-of-truth figures only: 90% completion
    (NO attribution — figure unconfirmed across sources) · 4,000+ builders · 45 countries.
    The 39% lower-reoffending figure is MoJ RESEARCH (family ties), never a BBC outcome.
  Image fields fall back to bundled placeholder assets until real photos are
  uploaded.
{%- endcomment -%}
{%- comment -%} css-fix: grid the national-priorities stats (was single column) {%- endcomment -%}
<style>
  .rd-policy{ display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:clamp(24px,3vw,44px); text-align:left; }
  @media(max-width:900px){ .rd-policy{ grid-template-columns:1fr 1fr; } }
  @media(max-width:560px){ .rd-policy{ grid-template-columns:1fr; } }
  /* Two arms → aligned side-by-side columns (rd-arms was undefined in the CSS, so it stacked) */
  @media(max-width:760px){ .bbc-rd-impact .rd-arms{ grid-template-columns:1fr; } }
  /* Delivery-partner (HMPPS) logo header in the "Where we work" band */
  .bbc-rd-impact .rd-deliver-logo{ display:block; width:60px; height:60px; margin:0 auto 20px; border-radius:8px; }
  /* Credibility pull-quotes → large block-text impact statements */
  .bbc-rd-impact .bbc-impact-cred .rd-cred-q{ font-size:clamp(22px,2.7vw,32px); line-height:1.32; }
  .bbc-rd-impact .bbc-impact-cred .rd-cred-card{ gap:20px; }
</style>



{%- liquid
  assign hero_cta1 = section.settings.hero_cta1_url | default: '/pages/schools'
  assign hero_cta2 = section.settings.hero_cta2_url | default: '/pages/contact-us'
  assign b2b_cta1   = section.settings.b2b_cta1_url | default: '/pages/schools'
  assign final_c1   = section.settings.cta1_url | default: '/pages/schools'
  assign final_c2   = section.settings.cta2_url | default: '/pages/contact-us'
-%}

<div class="bbc-rd bbc-rd-impact">

  {%- comment -%} ---------- HERO ---------- {%- endcomment -%}
  <header class="rd-hero rd-mh-74">
    <div class="rd-bg">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 1600 }} 1600w, {{ section.settings.hero_image | image_url: width: 2000 }} 2000w, {{ section.settings.hero_image | image_url: width: 2600 }} 2600w" sizes="100vw" alt="{{ section.settings.hero_image_alt | default: 'Inside a Bamboo Bicycle Club workshop' | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high" loading="eager">
      {%- else -%}
        {%- comment -%}
          The theme-asset fallback is what actually renders until an editor picks a hero
          image — and it had NO srcset, so every visitor got the full 1600px/436KB file.
          On a 390px phone that is the LCP element and ~2x more pixels than the screen can
          use. Theme assets are CDN-resizable with &width= (verified 2026-07-28: 600w =
          105KB vs 436KB), and asset_url always returns a ?v= versioned URL, so &width
          appends safely. Mirrors the srcset the hero_image branch above already has.
        {%- endcomment -%}
        {%- assign hero_fb = section.settings.hero_fallback | default: 'bbc-rd-workshop.jpg' | asset_url -%}
        <img src="{{ hero_fb }}&width=1600"
             srcset="{{ hero_fb }}&width=600 600w, {{ hero_fb }}&width=900 900w, {{ hero_fb }}&width=1200 1200w, {{ hero_fb }}&width=1600 1600w"
             sizes="100vw"
             alt="{{ section.settings.hero_image_alt | default: 'Inside a Bamboo Bicycle Club workshop' | escape }}" width="1600" height="1066" fetchpriority="high" loading="eager">
      {%- endif -%}
    </div>
    <div class="rd-scrim"></div>
    <div class="rd-inner">
      <div class="rd-wrap">
        <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><span class="rd-here">Impact</span></nav>
        {%- if section.settings.hero_eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1 class="rd-mt2 rd-mw-15ch">{{ section.settings.hero_title }}</h1>
        <div class="rd-lede">{{ section.settings.hero_lede }}</div>
        {%- comment -%}
          Proof strip (2026-07-27). Same device as the homepage hero, for the same measured reason:
          the presentation audit found our first figure at y3897 — about four screens down and 5x
          later than any peer — with ZERO figures above the fold. The stats band on this page sits
          below the hero, so a funder or commissioner sees the claim before any evidence of it.
          Peers who do this well (Recycling Lives "132 / people into paid employment", Belu at 96px)
          ISOLATE the number so the eye catches it before the sentence. Every default below is
          Claims-Register approved wording; all are editable in the theme editor.
        {%- endcomment -%}
        {%- if section.settings.hero_proof_on -%}
          <ul class="rd-heroproof" aria-label="Impact in numbers">
            <li><b>{{ section.settings.hero_proof1_num | default: '4,000+' }}</b><span>{{ section.settings.hero_proof1_label | default: 'people trained' }}</span></li>
            <li><b>{{ section.settings.hero_proof2_num | default: '90%+' }}</b><span>{{ section.settings.hero_proof2_label | default: 'prison-course completion' }}</span></li>
            <li><b>{{ section.settings.hero_proof3_num | default: '2012' }}</b><span>{{ section.settings.hero_proof3_label | default: 'delivering since' }}</span></li>
          </ul>
        {%- endif -%}
        <div class="rd-cta-row">
          {%- if section.settings.hero_cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ hero_cta1 }}">{{ section.settings.hero_cta1_label }} <span class="rd-arrow">&rarr;</span></a>{%- endif -%}
          {%- if section.settings.hero_cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ hero_cta2 }}">{{ section.settings.hero_cta2_label }}</a>{%- endif -%}
        </div>
      </div>
    </div>
  </header>

  {%- comment -%} ---------- WAYS IN band — REMOVED 2026-08-18 (James) ----------
     Was <section id="book-a-call">: the `start here` eyebrow, three route text links
     (build or own a bike · run it in your school or prison · fund or champion, from the
     `help` blocks) and the ON THIS PAGE chapter nav. It began life as the BOOK A DISCOVERY
     CALL band, added above the fold 2026-07-20 per Chris Barrett as the page's main CTA;
     the discovery call went earlier today and James then took the rest.
     The hero now runs straight into the stats band, so the page's only asks above the
     evidence are the hero's own two buttons.
     The `help` blocks and the chapters/help_eyebrow settings are LEFT IN PLACE — they cost
     nothing, they hold James's copy, and re-adding the band is then a markup-only change.
     ---------- {%- endcomment -%}

  {%- comment -%} ---------- STATS (dark) ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-dark rd-band--stats">
    <div class="rd-wrap">
      <span class="rd-ghostnum" aria-hidden="true">{{ section.settings.ghost_stat | default: "2012" }}</span>
      {%- if section.settings.stats_label != blank -%}<span class="rd-eyebrow">{{ section.settings.stats_label }}</span>{%- endif -%}
      <div class="rd-stats">
        {%- for block in section.blocks -%}{%- if block.type == 'stat' and block.settings.source != blank -%}
          <div class="rd-stat rd-reveal" {{ block.shopify_attributes }}>
            <div class="rd-num bbc-counted">{{ block.settings.number }}</div>
            <div class="rd-lbl">{{ block.settings.label }}</div>
            <div class="rd-src">{{ block.settings.source }}</div>
            {%- if block.settings.comparator != blank -%}<div class="rd-comparator">{{ block.settings.comparator }}</div>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- if section.settings.data_as_of != blank -%}<p class="rd-dataasof rd-on-dark">{{ section.settings.data_as_of }}</p>{%- endif -%}
    {%- comment -%} The underlined text link that used to sit here was a DUPLICATE: same
      report_label condition, same report_url, same text as the pill button below, so the
      stat band always rendered the identical CTA twice. PAGE-STANDARD's stat-band recipe is
      eyebrow -> ghost numeral -> figures -> ONE CTA. S4 never caught it because S4 counts
      .rd-btn only and this was a .rd-textlink. Removed 2026-08-05. {%- endcomment -%}
      {%- if section.settings.report_label != blank -%}<div class="rd-mt3"><a class="rd-btn rd-on-dark" href="{{ section.settings.report_url | default: '/pages/impact-report' }}">{{ section.settings.report_label }} <span class="rd-arrow">&rarr;</span></a></div>{%- endif -%}
    </div>
  </section>

  {%- comment -%} ---------- ONE CRAFT, TWO ARMS (infographic) ---------- {%- endcomment -%}
  {%- if section.settings.arms_title != blank -%}
  <section class="rd-pad-sm rd-paper">
    <div class="rd-wrap">
      <div class="rd-center">
        {%- if section.settings.arms_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.arms_eyebrow }}</span>{%- endif -%}
        <h2 class="rd-reveal rd-mw-26ch rd-mx-auto">{{ section.settings.arms_title }}</h2>
      </div>
      {%- if section.settings.frame_info_enable -%}
      <div class="rd-frameinfo rd-reveal" aria-hidden="false"><svg class="rd-frame-info" viewBox="0 0 960 560" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="One frame, two triangles: the schools pathway on the front triangle, the prisons pathway on the rear — both meeting at the saddle: a way forward.">
  <g fill="none" stroke="var(--mist,#CFC5B0)" stroke-width="2.5">
    <circle cx="203" cy="430" r="184"/><circle cx="758" cy="430" r="184"/>
  </g>
  <g fill="none" stroke="var(--forest,#003C32)" stroke-width="5" stroke-linecap="round">
    <path d="M340,135 L640,150" pathLength="1"/> <path d="M640,150 L667,228" pathLength="1"/>
    <path d="M430,430 L667,228" pathLength="1"/> <path d="M430,430 L340,135" pathLength="1"/>
    <path d="M667,228 L758,430" stroke-width="3.5"/>
    <path d="M430,430 L203,430" pathLength="1"/> <path d="M203,430 L340,135" pathLength="1"/>
    <path d="M306,109 l60,-6" stroke-width="7"/>
  </g>
  <g class="rd-fi__route rd-fi__route--a" stroke="var(--lime,#D4FD62)" stroke-width="7" fill="none" stroke-linecap="round" opacity=".85">
    <path d="M430,430 L667,228 L640,150 L340,135" pathLength="1"/>
  </g>
  <g class="rd-fi__route rd-fi__route--b" stroke="var(--steel,#DEE6F0)" stroke-width="7" fill="none" stroke-linecap="round" opacity=".9">
    <path d="M430,430 L203,430 L340,135" pathLength="1"/>
  </g>
  <g class="rd-fi__nodes" font-family="inherit" font-weight="800" font-size="17" text-anchor="middle">
    <circle cx="560" cy="319" r="17" fill="var(--lime,#D4FD62)" stroke="var(--forest,#003C32)" stroke-width="2.5"/>
    <text x="560" y="325" fill="var(--forest,#003C32)">1</text>
    <circle cx="667" cy="228" r="17" fill="var(--lime,#D4FD62)" stroke="var(--forest,#003C32)" stroke-width="2.5"/>
    <text x="667" y="234" fill="var(--forest,#003C32)">2</text>
    <circle cx="640" cy="150" r="17" fill="var(--lime,#D4FD62)" stroke="var(--forest,#003C32)" stroke-width="2.5"/>
    <text x="640" y="156" fill="var(--forest,#003C32)">3</text>
    <circle cx="475" cy="142" r="17" fill="var(--lime,#D4FD62)" stroke="var(--forest,#003C32)" stroke-width="2.5"/>
    <text x="475" y="148" fill="var(--forest,#003C32)">4</text>
    <circle cx="316" cy="430" r="17" fill="var(--steel,#DEE6F0)" stroke="var(--forest,#003C32)" stroke-width="2.5"/>
    <text x="316" y="436" fill="var(--forest,#003C32)">1</text>
    <circle cx="203" cy="430" r="17" fill="var(--steel,#DEE6F0)" stroke="var(--forest,#003C32)" stroke-width="2.5"/>
    <text x="203" y="436" fill="var(--forest,#003C32)">2</text>
    <circle cx="265" cy="297" r="17" fill="var(--steel,#DEE6F0)" stroke="var(--forest,#003C32)" stroke-width="2.5"/>
    <text x="265" y="303" fill="var(--forest,#003C32)">3</text>
    <circle cx="430" cy="430" r="26" fill="var(--forest,#003C32)"/>
    <text x="430" y="438" font-size="26" fill="var(--lime,#D4FD62)">&#10033;</text>
    <circle cx="340" cy="135" r="13" fill="var(--forest,#003C32)" stroke="var(--lime,#D4FD62)" stroke-width="3"/>
  </g>
  <g class="rd-fi__labels" font-size="15" font-weight="700" fill="var(--ink,#0E1A17)">
    <text x="430" y="497" text-anchor="middle">one mission</text>
    <text x="294" y="91" text-anchor="end" font-size="17">a way forward.</text>
    <text x="595" y="331">{{ section.settings.arm1_name | default: 'make engineers' }}</text>
    <text x="316" y="392" text-anchor="middle">{{ section.settings.arm2_name | default: 'build to bond' }}</text>
  </g>
</svg>
        <p class="rd-frameinfo__caption">{{ section.settings.frame_info_caption | default: 'one frame, two triangles — the power goes in at the same place, and both routes end at the saddle.' }}</p>
      </div>
      {%- else -%}
      {%- if section.settings.fork_label != blank -%}<span class="rd-eyebrow rd-mt3">{{ section.settings.fork_label }}</span>{%- endif -%}
      {%- endif -%}
      <div class="rd-paths rd-stagger">
        <div class="rd-path rd-path--schools rd-reveal">
          <span class="rd-duotone rd-path__media">
            <img src="{% if section.settings.arm1_image != blank %}{{ section.settings.arm1_image | image_url: width: 900 }}{% else %}{{ 'bbc-rd-wb-group.jpg' | asset_url }}{% endif %}" alt="{{ section.settings.arm1_image_alt | default: 'A school group with the bamboo bike frame they built' | escape }}" loading="lazy" width="900" height="500">
          </span>
          <span class="rd-path__chip">{{ section.settings.arm1_chip | default: 'in schools · before exclusion' }}</span>
          <h3 class="rd-path__name">{{ section.settings.arm1_name | default: 'make engineers' }}</h3>
          <p class="rd-path__who">{{ section.settings.arm1_who | default: "for SEND, PRU and at-risk young people being pushed out of the classroom — often their first positive encounter with engineering." }}</p>
          {%- assign a1 = section.settings.arm1_flow | split: '|' -%}
          <div class="rd-flow">{%- for st in a1 -%}{%- assign parts = st | split: "::" -%}<span class="rd-flow__step"><b>{{ parts[0] | strip }}</b>{%- if parts[1] -%}<small>{{ parts[1] | strip }}</small>{%- endif -%}</span>{%- endfor -%}</div>
          {%- if section.settings.arm1_cta_label != blank -%}
            <a class="rd-path__cta" href="{{ section.settings.arm1_cta_url | default: '/pages/schools' }}">{{ section.settings.arm1_cta_label }}</a>
          {%- endif -%}
        </div>
        <div class="rd-path rd-path--prisons rd-reveal">
          <span class="rd-duotone rd-path__media">
            <img src="{% if section.settings.arm2_image != blank %}{{ section.settings.arm2_image | image_url: width: 900 }}{% else %}{{ 'bbc-rd-prison-empty.jpg' | asset_url }}{% endif %}" alt="{{ section.settings.arm2_image_alt | default: 'Inside the Build to Bond workshop — benches, jigs and frames' | escape }}" loading="lazy" width="900" height="500">
          </span>
          <span class="rd-path__chip">{{ section.settings.arm2_chip | default: 'in prisons · after' }}</span>
          <h3 class="rd-path__name">{{ section.settings.arm2_name | default: 'build to bond' }}</h3>
          <p class="rd-path__who">{{ section.settings.arm2_who | default: 'for people inside prison rebuilding skills, family ties and a route to work on release.' }}</p>
          {%- assign a2 = section.settings.arm2_flow | split: '|' -%}
          <div class="rd-flow">{%- for st in a2 -%}{%- assign parts = st | split: "::" -%}<span class="rd-flow__step"><b>{{ parts[0] | strip }}</b>{%- if parts[1] -%}<small>{{ parts[1] | strip }}</small>{%- endif -%}</span>{%- endfor -%}</div>
          {%- if section.settings.arm2_cta_label != blank -%}
            <a class="rd-path__cta" href="{{ section.settings.arm2_cta_url | default: '/pages/contact-us' }}">{{ section.settings.arm2_cta_label }}</a>
          {%- endif -%}
        </div>
      </div>
      {%- if section.settings.converge_title != blank -%}
      <div class="rd-converge rd-reveal">
        <p class="rd-converge__title">{{ section.settings.converge_title }}</p>
        {%- if section.settings.converge_note != blank -%}<p class="rd-converge__note">{{ section.settings.converge_note }}</p>{%- endif -%}
      </div>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- THE STORY: a real workshop, inside ----------
     Gated on the title (2026-07-24): with story_title cleared it rendered a 176px
     empty dark shell — the third member of the gating-bug family. {%- endcomment -%}
  {%- if section.settings.story_title != blank -%}
  <section class="rd-pad rd-band--workshop">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.story_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.story_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.story_title }}</h2>
      {%- if section.settings.story_body_1 != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.story_body_1 }}</p>{%- endif -%}
      {%- if section.settings.story_body_2 != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.story_body_2 }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- BUILD TO BOND FEATURE (split, dark) ----------
     Behind show_b2b (2026-07-24 genre alignment): its story duplicated the flagship
     #proof card directly below; the Allsopp voice moved onto the flagship. One
     checkbox restores the band — all its settings are preserved. {%- endcomment -%}
  {%- if section.settings.show_b2b != false -%}
  <section class="rd-split rd-dark">
    <div class="rd-reveal rd-media">
      {%- if section.settings.b2b_image != blank -%}
        <img src="{{ section.settings.b2b_image | image_url: width: 1400 }}" alt="{{ section.settings.b2b_image_alt | default: 'Inside a Bamboo Bicycle Club workshop' | escape }}" width="{{ section.settings.b2b_image.width }}" height="{{ section.settings.b2b_image.height }}">
      {%- else -%}
        <img src="{{ section.settings.b2b_fallback | default: 'bbc-rd-b2b.jpg' | asset_url }}" alt="{{ section.settings.b2b_image_alt | default: 'Inside a Bamboo Bicycle Club workshop' | escape }}" width="1400" height="933">
      {%- endif -%}
    </div>
    <div class="rd-txt">
      {%- if section.settings.b2b_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.b2b_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.b2b_title }}</h2>
      {%- if section.settings.b2b_body_1 != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.b2b_body_1 }}</p>{%- endif -%}
      {%- if section.settings.b2b_body_2 != blank -%}<p class="rd-mt2">{{ section.settings.b2b_body_2 }}</p>{%- endif -%}
      {%- if section.settings.b2b_quote != blank -%}
        <div class="rd-reveal rd-pull rd-mt3">
          <p class="rd-q">{{ section.settings.b2b_quote }}</p>
          {%- if section.settings.b2b_cite != blank -%}<cite>{{ section.settings.b2b_cite }}</cite>{%- endif -%}
        </div>
      {%- endif -%}
      {%- if section.settings.b2b_cta1_label != blank -%}
        <div class="rd-flex rd-mt3">
          <a class="rd-btn rd-lime" href="{{ b2b_cta1 }}">{{ section.settings.b2b_cta1_label }} <span class="rd-arrow">&rarr;</span></a>
        </div>
      {%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- WHY NOW (policy backdrop, sourced) ---------- {%- endcomment -%}
  {%- if section.settings.policy_title != blank -%}
  <section class="rd-pad-sm rd-dark rd-band--policy">
    <div class="rd-wrap">
      <div class="rd-center">
        {%- if section.settings.policy_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.policy_eyebrow }}</span>{%- endif -%}
        <h2 class="rd-reveal rd-mw-22ch">{{ section.settings.policy_title }}</h2>
      </div>
      <div class="rd-policy rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'policy' -%}
          <div class="rd-stat rd-reveal" {{ block.shopify_attributes }}>
            <div class="rd-num bbc-counted">{{ block.settings.number }}</div>
            <div class="rd-lbl">{{ block.settings.label }}</div>
            {%- if block.settings.source != blank -%}<div class="rd-src">{{ block.settings.source }}</div>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- IMPACT STORIES — one per pillar (every kind of impact) ---------- {%- endcomment -%}
  {%- if section.settings.stories_title != blank -%}
  <section class="rd-pad-sm" id="evidence">
    <div class="rd-wrap">
      {%- if section.settings.stories_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.stories_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal rd-mw-20ch">{{ section.settings.stories_title }}</h2>
      {%- if section.settings.stories_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.stories_lede }}</p>{%- endif -%}
      {%- comment -%} filter tabs built from the kinds present (Redemption tabbed-programmes / WaterAid filter pattern); no-JS = all visible {%- endcomment -%}
      {%- assign _kinds = '' -%}
      {%- for block in section.blocks -%}{%- if block.type == 'story' and block.settings.kind != blank -%}
        {%- assign _k = block.settings.kind | downcase | strip -%}
        {%- unless _kinds contains _k -%}{%- assign _kinds = _kinds | append: _k | append: ',' -%}{%- endunless -%}
      {%- endif -%}{%- endfor -%}
      {%- assign _kindlist = _kinds | split: ',' -%}
      {%- if _kindlist.size > 1 -%}
      <div class="rd-evfilter rd-mt3" role="group" aria-label="Filter the evidence by programme">
        <button type="button" class="rd-evfilter__tab is-on" data-kind="all" aria-pressed="true">all</button>
        {%- for k in _kindlist -%}<button type="button" class="rd-evfilter__tab" data-kind="{{ k }}" aria-pressed="false">{{ k }}</button>{%- endfor -%}
      </div>
      {%- endif -%}
      <ul class="rd-csgrid rd-mt4 rd-stagger" data-evwall role="list">
        {%- comment -%} FEATURED case study — the flagship, first item in the evidence wall.
           Renders the SAME snippet as every other card; only the variant differs. Before
           2026-07-31 this was 30 lines of bespoke markup in its own section, which is how it
           drifted into a different slot order and a wrapper <a>. {%- endcomment -%}
        {%- if section.settings.cs_blurb != blank or section.settings.cs_quote != blank -%}
        {%- comment -%} Quote-as-headline: for a people-centred story the strongest heading is the
           person's own words, in the format `Name, place: "their words"`. It also removes the
           old conflict where a big pull-quote and a headline competed for the same slot.
           NOT truncated — a machine-cut heading ("…creativity, teamwork, a…") loses exactly the
           words a reader scans for. Editable via cs_heading. {%- endcomment -%}
        {%- comment -%} Liquid FILTERS ARE NOT ALLOWED IN render ARGUMENTS. Writing
           `url: section.settings.cs_url | default: '…'` fails silently — the argument arrives
           blank, so the flagship card rendered with no link and no CTA at all. Resolve defaults
           into a variable first, then pass the variable. {%- endcomment -%}
        {%- assign _cs_url = section.settings.cs_url | default: '/blogs/impact/build-to-bond-the-full-story-of-how-bamboo-bikes-are-rebuilding-family-connections-in-prison-2' -%}
        {%- assign _cs_head = section.settings.cs_heading -%}
        {%- if _cs_head == blank -%}{%- assign _cs_head = section.settings.cs_site | default: 'Build to Bond · HMP Lowdham Grange' -%}{%- endif -%}
        {%- render 'bbc-cscard',
             variant: 'featured',
             kind: section.settings.cs_kind,
             heading: _cs_head,
             url: _cs_url,
             context: section.settings.cs_blurb,
             attr: section.settings.cs_site,
             chips: section.settings.cs_outcomes,
             image_pic: section.settings.cs_image_pic,
             image: section.settings.cs_image,
             cta: section.settings.cs_link_label,
             anchor: 'proof' -%}
        {%- comment -%} id="proof" is load-bearing twice over: it is a deep-link target used by
           in-page links, and bbc-statement.css scopes real layout rules to #proof. Migrating the
           featured card to the snippet dropped the wrapper that carried it, which killed the
           anchor silently — estate-check caught it as "1 dead in-page anchor". {%- endcomment -%}
        {%- endif -%}
        {%- for block in section.blocks -%}{%- if block.type == 'story' -%}
          {%- comment -%} heading = the OUTCOME line. It is the most specific, unique sentence on
             the card, so it makes the best link text (WCAG 2.4.4 — the descriptive text must be
             INSIDE the anchor, not a sibling). `title` used to render as a second, near-duplicate
             summary line under it: "A 100kg-payload electric cargo bike, built by masters
             students." above "masters students built a 100kg electric bamboo cargo bike." One
             line per card now; title is the fallback when a block has no outcome. {%- endcomment -%}
          {%- assign _head = block.settings.outcome | default: block.settings.title -%}
          {%- render 'bbc-cscard',
               variant: 'grid',
               kind: block.settings.kind,
               heading: _head,
               url: block.settings.url,
               context: block.settings.blurb,
               chips: block.settings.chips,
               date: block.settings.date,
               source_label: block.settings.source_label,
               source_url: block.settings.source_url,
               image_pic: block.settings.image_pic,
               image: block.settings.image,
               youtube: block.settings.video_url,
               video_file: block.settings.video_file -%}
        {%- endif -%}{%- endfor -%}
      </ul>
      {%- comment -%} provenance stays a SIBLING of the card group, never inside a card: press
         links inside a card either nest anchors in the card link or create a second tab stop. {%- endcomment -%}
      {%- if section.settings.cs_show_prov != false -%}
