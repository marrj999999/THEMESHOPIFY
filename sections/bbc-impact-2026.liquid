        <ul class="rd-promises" role="list">
          {%- for i in (1..3) -%}
          {%- assign pk = 'promise' | append: i -%}{%- assign pu = 'promise' | append: i | append: '_url' -%}
          {%- if section.settings[pk] != blank -%}
          <li class="rd-promises__row"><span class="rd-promises__star">&#10033;</span> {{ section.settings[pk] }}{%- if section.settings[pu] != blank %} <a href="{{ section.settings[pu] }}">see for yourself &rarr;</a>{%- endif -%}</li>
          {%- endif -%}
          {%- endfor -%}
        </ul>
      </div>
      {%- elsif section.settings.cred_mech != blank -%}<div class="rd-callout-steel rd-mt3" style="text-align:left;"><p>{{ section.settings.cred_mech }}</p></div>{%- endif -%}
      {%- if section.settings.report_card_title != blank -%}
      <div class="rd-reveal rd-dlcard rd-mt3">
        <span class="rd-dlcard__badge">report</span>
        <div class="rd-dlcard__body">
          <p class="rd-dlcard__title">{{ section.settings.report_card_title }}</p>
          {%- if section.settings.report_card_meta != blank -%}<p class="rd-dlcard__meta">{{ section.settings.report_card_meta }}</p>{%- endif -%}
        </div>
        <a class="rd-path__cta" style="margin-top:0;" href="{{ section.settings.report_card_url | default: '/pages/impact-report' }}">read it &rarr;</a>
      </div>
      {%- endif -%}

      {%- comment -%} press strip — THE standard block (2026-07-22, qa/PRESS-BLOCK.md);
         quiet style here (the pull-quote above already carries the voice) {%- endcomment -%}
      <div class="rd-center">
        {%- render 'bbc-press',
            style: 'quiet',
            preset: 'national',
            label: section.settings.press_label,
            more_label: section.settings.press_more,
            more_url: section.settings.press_more_url -%}
        {%- if section.settings.awards_line != blank -%}<p class="rd-partnerlabel rd-mt3">{{ section.settings.awards_line }}</p>{%- endif -%}
        {%- if section.settings.funder_line != blank -%}<p class="rd-ship-note{% if section.settings.funder_logo != blank %} rd-mt1{% else %} rd-mt3{% endif %}">{{ section.settings.funder_line }}</p>{%- endif -%}
        {%- assign backers = section.blocks | where: "type", "backer" -%}
        {%- if backers.size > 0 -%}
        <span class="rd-backers__label">{{ section.settings.backers_label | default: 'backed by & accredited by' }}</span>
        <ul class="rd-backers" role="list">
          {%- for block in backers -%}
          <li class="rd-backers__cell" {{ block.shopify_attributes }}>
            {%- if block.settings.url != blank -%}<a href="{{ block.settings.url }}" class="rd-backers__link">{%- endif -%}
            {%- if block.settings.logo != blank -%}
            <img class="rd-backers__logo" src="{{ block.settings.logo | asset_url }}" alt="{{ block.settings.label | escape }}" loading="lazy">
            {%- else -%}
            <span class="rd-backers__chip">{{ block.settings.label }}</span>
            {%- endif -%}
            {%- if block.settings.url != blank -%}</a>{%- endif -%}
          </li>
          {%- endfor -%}
        </ul>
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  
