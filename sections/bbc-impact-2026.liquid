        <a href="https://www.ft.com/content/6ebe2eba-b832-4289-9924-2e9f948d5f98?ref=impact-evidence" target="_blank" rel="noopener">{{ section.settings.tx_financial_times | default: "Financial Times" }}</a> &middot;
        <a href="/blogs/news/inside-time-bamboozling-way-to-build-bikes-bamboo-bicycle-club-at-lowdham-grange?ref=impact-evidence">{{ section.settings.tx_inside_time | default: "Inside Time" }}</a> &middot;
        <a href="/blogs/news/bamboo-bicycle-club-wins-investec-beyond-business-2025?ref=impact-evidence">{{ section.settings.tx_investec_beyond_business | default: "Investec Beyond Business" }}</a></p>
      {%- endif -%}
      {%- if section.settings.stories_proofline != blank -%}<p class="rd-evproof-line">{{ section.settings.stories_proofline }}</p>{%- endif -%}
      <div class="rd-mt4"><a class="rd-btn rd-ghost" href="{{ section.settings.stories_all_url | default: '/blogs/impact' }}">{{ section.settings.stories_all_label | default: 'See all impact stories' }} <span class="rd-arrow">&rarr;</span></a></div>
      {% render 'bbc-video-lightbox' %}
