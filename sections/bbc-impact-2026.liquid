    { "type": "header", "content": "A real workshop, inside" },
    { "type": "text", "id": "story_title", "label": "Heading", "default": "A real workshop, inside." },
    { "type": "textarea", "id": "story_body_1", "label": "Paragraph 1", "default": "Inside HMP Lowdham Grange — a Category-B men's prison in Nottinghamshire — we've built a 2,000 sq ft workshop where learners take a six-week, OCN-accredited course: from workshop safety and material science through frame construction, mechanics and finishing." },
    { "type": "textarea", "id": "story_body_2", "label": "Paragraph 2", "default": "They earn an OCN Level 2 accreditation in sustainable design and manufacturing. Trusted learners are trained as instructors and help deliver the course. In the final week, frames are taken apart so the materials serve the next cohort — which is also what keeps it affordable." },

    { "type": "header", "content": "Build to Bond feature" },
    { "type": "image_picker", "id": "b2b_image", "label": "Feature image (workshop, no identifiable learners)" },
