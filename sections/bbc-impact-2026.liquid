{% stylesheet %}
/* ---- evidence system (2026-07-22, visual tour: Redemption/Switchback/charity:water/Fine Cell) ---- */
/* flagship outcome chips — the number leads (tabular via universal) */
.rd-cscard__outs{list-style:none;display:flex;flex-wrap:wrap;gap:8px 10px;margin:16px 0 0;padding:0}
.rd-cscard__outs li{font-size:14px;font-weight:800;letter-spacing:.01em;padding:6px 12px;border:2px solid currentColor;border-radius:999px;white-space:nowrap}
.rd-cscard__prov{margin:14px 2px 0;font-size:13px;font-weight:700;opacity:.85}
.rd-cscard__prov a{text-decoration:underline;text-underline-offset:3px;font-weight:800}
/* FEATURED case study (2026-07-31) — the flagship spans the whole evidence wall and splits
   media | body, so it reads as the lead item of this section rather than a second section.
   Scoped here rather than in a shared sheet to keep the blast radius on one page. The
   #proof-scoped rules in bbc-statement.css still apply: the id moved with the card. */
.bbc-rd-impact .rd-csfeat{grid-column:1/-1}
.bbc-rd-impact .rd-csfeat .rd-cscard--featured{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:32px;align-items:start}
.bbc-rd-impact .rd-csfeat .rd-cscard__media{aspect-ratio:16/10;border-radius:0;overflow:clip}
.bbc-rd-impact .rd-csfeat .rd-cscard__media img{width:100%;height:100%;object-fit:cover}
.bbc-rd-impact .rd-csfeat .rd-cscard__body{padding:0}
/* the featured quote is display copy and must not inherit the 3-up card's small type */
.bbc-rd-impact .rd-csfeat .rd-cscard__quote{font-size:clamp(19px,1.7vw,23px);line-height:1.35}
@media(max-width:860px){
  .bbc-rd-impact .rd-csfeat .rd-cscard--featured{grid-template-columns:1fr;gap:18px}
}
/* evidence-wall card anatomy: outcome line leads the body */
.rd-cscard__out{margin:0 0 8px;font-size:18px;line-height:1.35;font-weight:800}
.rd-cscard__evq{margin:10px 0 0;padding:0;border:0;font-size:15px;line-height:1.5;font-style:italic}
.rd-cscard__evq cite{display:block;margin-top:4px;font-style:normal;font-size:13px;font-weight:800;letter-spacing:.04em;text-transform:uppercase}
.rd-cscard__meta{margin:10px 0 0;font-size:13px;font-weight:700;opacity:.8}
.rd-cscard__meta .rd-cscard__dot{margin:0 6px}
.rd-cscard__meta a{text-decoration:underline;text-underline-offset:3px}
/* filter tabs — quiet pills, lime = active (one accent per band rule) */
.rd-evfilter{display:flex;flex-wrap:wrap;gap:10px}
.rd-evfilter__tab{font:inherit;font-size:14px;font-weight:800;letter-spacing:.02em;text-transform:lowercase;padding:8px 16px;border:2px solid currentColor;border-radius:999px;background:transparent;color:inherit;cursor:pointer}
.rd-evfilter__tab.is-on{background:var(--lime);border-color:var(--ink);color:var(--ink)}
.rd-evfilter__tab:focus-visible{outline:3px solid var(--lime-aaa);outline-offset:2px}
[data-evwall] [data-kind][hidden]{display:none}
/* stretched-link: whole evidence card clickable via the foot link; inner source/quote links stay above */
.rd-cscard--ev{position:relative}
.rd-cscard--ev .rd-cscard__stretch::after{content:"";position:absolute;inset:0}
.rd-cscard--ev .rd-cscard__meta a,.rd-cscard--ev .rd-cscard__evq cite{position:relative;z-index:1}
/* mechanism sentence — bold single line, the funder contract */
.rd-mech{font-size:17px;font-weight:800;letter-spacing:.01em;max-width:56ch}
.rd-helplinks{display:flex;flex-wrap:wrap;gap:10px 26px}
/* flagship (#proof) sits on the page's left axis — its 820px wrap was centring
   at wide viewports and drifting off-grid (caught in James's 1568px Chrome) */
#proof .rd-mw-820px{margin-left:0}
/* under-wall proof line — the archive statement (editable) */
.rd-evproof-line{margin:26px 0 0;font-size:14px;font-weight:800;letter-spacing:.02em;opacity:.75}
/* evidence motion PROMOTED to bbc-universal.css §11 (2026-07-24) — chip stagger,
   .rd-evin filter rise and the card hover grammar are now sitewide vocabulary.
   Contract: qa/MOTION.md. No motion keyframes may live in this section. */
{% endstylesheet %}

{% javascript %}
document.addEventListener('click', function (e) {
  var tab = e.target.closest('.rd-evfilter__tab');
  if (!tab) return;
  var band = tab.closest('section');
  var wall = band && band.querySelector('[data-evwall]');
  if (!wall) return;
  band.querySelectorAll('.rd-evfilter__tab').forEach(function (t) {
    var on = t === tab;
    t.classList.toggle('is-on', on);
    t.setAttribute('aria-pressed', on ? 'true' : 'false');
  });
  var kind = tab.getAttribute('data-kind');
  wall.querySelectorAll(':scope > [data-kind]').forEach(function (card) {
    if (kind === 'all' || card.getAttribute('data-kind') === kind) {
      card.removeAttribute('hidden');
      card.classList.add('rd-evin');
      card.addEventListener('animationend', function () { card.classList.remove('rd-evin'); }, { once: true });
    } else card.setAttribute('hidden', '');
  });
});
/* deep link: #evidence-<kind> pre-filters the wall. Runs at load AND on hashchange
   (in-page chapter/segment links) — hash-only anchors have no element, so we also
   scroll to the wall ourselves. Registered AFTER the click handler (order matters). */
(function () {
  function applyEvidenceHash(scroll) {
    var m = location.hash.match(/^#evidence-([a-z]+)$/);
    if (!m) return;
    var tab = document.querySelector('.rd-evfilter__tab[data-kind="' + m[1] + '"]');
    if (tab) tab.click();
    if (scroll) {
      var wall = document.getElementById('evidence');
      if (wall) wall.scrollIntoView();
    }
  }
  applyEvidenceHash(false);
  window.addEventListener('hashchange', function () { applyEvidenceHash(true); });
})();
