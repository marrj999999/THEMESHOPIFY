{%- comment -%}
  BBC theme block — Stat (number + label + source). From the monolith `stat` block.
  Reuses .rd-stat / .rd-num / .rd-lbl / .rd-src. Sits inside the stat band (.bbc-rd .rd-stats grid).
{%- endcomment -%}
<div class="rd-stat" {{ block.shopify_attributes }}>
  <div class="rd-num bbc-counted">{{ block.settings.number }}</div>
  <div class="rd-lbl">{{ block.settings.label }}</div>
  {%- if block.settings.source != blank -%}<div class="rd-src">{{ block.settings.source }}</div>{%- endif -%}
</div>

{% schema %}
{
  "name": "BBC Stat",
  "tag": null,
  "settings": [
    { "type": "text", "id": "number", "label": "Number", "default": "4,000+" },
    { "type": "text", "id": "label", "label": "Label", "default": "people have built a bike" },
    { "type": "text", "id": "source", "label": "Source" }
  ],
  "presets": [
    { "name": "BBC Stat" }
  ]
}
{% endschema %}
