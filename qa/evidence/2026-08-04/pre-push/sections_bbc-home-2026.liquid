  <script>
    (function(){
      var hero = document.querySelector('.bbc-rd-home .ew');
      if(!hero) return;
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var mobile = window.matchMedia('(max-width: 749px)').matches;
      if(reduce || typeof document.body.animate !== 'function'){
        hero.classList.add('is-on','photo-in');
        return;
      }
      hero.classList.add('will-anim');

      var K = mobile ? 0.62 : 1;
      var T = 1.55; /* global tempo - draw read as rushed at 1.0 */
      var EASE = 'cubic-bezier(0.65,0,0.35,1)';
      function tempo(a){ return a.map(function(s){ return [s[0], s[1]*T, s[2]*T]; }); }
      var seq = tempo([
        ['g1',  500,  820], ['g2',  1010, 640], ['g3a', 1330, 600], ['g3b', 1690, 380],
        ['g4',  1280, 700], ['g5',  1580, 500], ['g6a', 1795, 480], ['g6b', 1985, 420],
        ['g7',  1950, 780], ['g8',  2130, 780], ['g9',  2430, 500], ['g10a',2780, 430], ['g10b',2960, 320]
      ]);
      var chase = tempo([['c1',500,820],['c2',1010,640],['c3',1330,600],['c4',1280,700],['c5',1580,500],['c6',1795,480]]);
      var scaf = tempo([['sc-bb',900,1500],['sc-dim',1150,1200],['sc-rw',1700,900],['sc-fw',1880,900],['sc-stamp',1300,1300]]);
      var FLOOD = 3160*T*K, RESOLVE = (3520*T + 450)*K; /* +450ms hold on the finished drawing */

      function startAnims(){
        seq.forEach(function(s){
          var el = document.getElementById(s[0]); if(!el) return;
          el.animate([{strokeDashoffset:1},{strokeDashoffset:0}],
            {duration:s[2]*K, delay:s[1]*K, easing:EASE, fill:'forwards'});
        });
        if(!mobile){
          chase.forEach(function(s){
            var el = document.getElementById(s[0]); if(!el) return;
            el.animate([{strokeDashoffset:1,opacity:1},{strokeDashoffset:0,opacity:1}],
              {duration:s[2], delay:s[1]-110, easing:EASE, fill:'forwards'});
            el.animate([{opacity:0},{opacity:1}],{duration:120, delay:s[1]-110, fill:'forwards'});
            el.animate([{opacity:1},{opacity:0}],{duration:200, delay:s[1]+s[2]-160, fill:'forwards'});
          });
          scaf.forEach(function(s){
            var el = document.getElementById(s[0]); if(!el) return;
            el.animate([{opacity:0},{opacity:.55}],{duration:200, delay:s[1], easing:'ease-out', fill:'forwards'});
            el.animate([{opacity:.55},{opacity:0}],{duration:380, delay:s[1]+s[2], easing:'ease-in', fill:'forwards'});
          });
          var pop = document.getElementById('sc-pop');
          if(pop){
            pop.animate([{opacity:0,transform:'scale(0.2)'},{opacity:.9,transform:'scale(1.06)',offset:.7},{opacity:0,transform:'scale(1.18)'}],
              {duration:560, delay:2820*T, easing:'cubic-bezier(0.2,0.7,0.4,1.65)', fill:'forwards'});
          }
        }
        var flood = document.getElementById('gflood');
        if(flood){ flood.animate([{opacity:0},{opacity:1}],{duration:380*K, delay:FLOOD, easing:'ease-in', fill:'forwards'}); }
      }

      function run(){
        hero.classList.add('is-on');
        startAnims();
        setTimeout(function(){ hero.classList.add('photo-in'); }, RESOLVE);
      }

      // ---- art: fetch our line-art SVG from the Shopify CDN, namespace its classes, inject under the mask ----
      var ART = 'https://cdn.shopify.com/s/files/1/0502/8695/2631/files/bbc-frame-line.svg?v=1781292517';
      var artState = 0; // 0 pending, 1 ready, -1 failed
      var inView = false, started = false;

      function maybe(){
        if(started || !inView || artState === 0) return;
        started = true;
        if(artState === 1){ run(); }
        else { hero.classList.add('is-on'); setTimeout(function(){ hero.classList.add('photo-in'); }, 600); }
      }

      fetch(ART).then(function(r){ if(!r.ok){ throw new Error('art'); } return r.text(); }).then(function(t){
        t = t.replace(/\.b(\d)\{/g, '.bbcb$1{').replace(/class="b(\d)"/g, 'class="bbcb$1"');
        var doc = new DOMParser().parseFromString(t, 'image/svg+xml');
        var root = doc.documentElement;
        var g = document.getElementById('bbcArt');
        if(!g || !root || root.nodeName !== 'svg' || doc.querySelector('parsererror')){ throw new Error('art'); }
        while(root.firstChild){ g.appendChild(document.adoptNode(root.firstChild)); }
        artState = 1; maybe();
      }).catch(function(){ artState = -1; maybe(); });

      var io = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
          if(e.isIntersecting && !inView){ inView = true; io.disconnect(); maybe(); }
        });
      }, {threshold:.35});
      io.observe(hero);
      setTimeout(function(){ if(!inView){ inView = true; maybe(); } }, 2500);
      setTimeout(function(){ if(!started){ if(artState === 0){ artState = -1; } inView = true; maybe(); } }, 6000);

      // ?frame=<ms> — freeze the composition at one timestamp (verification rig; inert without the param)
      var qsm = location.search.match(/[?&]frame=(\d+)/);
      if(qsm){
        var seekT = +qsm[1];
        started = true; io.disconnect();
        var poll = setInterval(function(){
          if(artState === 0){ return; }
          clearInterval(poll);
          hero.classList.add('is-on');
          startAnims();
          requestAnimationFrame(function(){
            var pre = document.getAnimations();
            pre.forEach(function(a){ a.pause(); try{ a.currentTime = seekT; }catch(e){} });
            if(seekT >= RESOLVE){
              hero.classList.add('photo-in');
              requestAnimationFrame(function(){ requestAnimationFrame(function(){
                document.getAnimations().forEach(function(a){
                  if(pre.indexOf(a) === -1){ a.pause(); try{ a.currentTime = seekT - RESOLVE; }catch(e){} }
                });
                document.title = 'FROZEN@' + seekT;
              }); });
            } else {
              document.title = 'FROZEN@' + seekT;
            }
          });
        }, 50);
      }
    }());
  </script>

