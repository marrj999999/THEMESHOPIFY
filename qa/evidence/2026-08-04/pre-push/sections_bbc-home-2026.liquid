    .bbc-rd-home .acc-lede{ font-family:'Atkinson Hyperlegible',var(--rd-sans),sans-serif; font-size:clamp(16px,1.3vw,19px);
      line-height:1.55; color:var(--bbc-ink,#14211c); max-width:60ch; margin:1rem 0 0; }
    .bbc-rd-home .acc-stats{ list-style:none; display:flex; flex-wrap:wrap; gap:0; margin:2.2rem 0 0; padding:0; }
    .bbc-rd-home .acc-stats li{ padding:0 1.6rem; border-right:1px solid rgba(7,62,39,.18); }
    .bbc-rd-home .acc-stats li:first-child{ padding-left:0; }
    .bbc-rd-home .acc-stats li:last-child{ border-right:0; }
