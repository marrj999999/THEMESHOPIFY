  <section class="rd-pad acc" id="why-bamboo">
    <div class="rd-wrap">
      <div class="acc-head">
        <span class="rd-eyebrow">{{ section.settings.why_kicker | default: 'Built by anyone' }}</span>
        <h2 class="rd-reveal acc-title">{{ section.settings.why_title | default: 'no workshop. no welding. no experience needed.' }}</h2>
        <p class="acc-lede">{{ section.settings.why_lede | default: 'Bamboo frames go together with a few hand tools, a jig and a weekend — and most builders have never made anything before.' }}</p>
      </div>
      <ul class="acc-stats">
        <li><b>{{ section.settings.why_stat1_num | default: '4,000+' }}</b><span>{{ section.settings.why_stat1_label | default: 'builders trained' }}</span></li>
        <li><b>{{ section.settings.why_stat2_num | default: '45' }}</b><span>{{ section.settings.why_stat2_label | default: 'countries' }}</span></li>
        <li><b>{{ section.settings.why_stat3_num | default: '80%' }}</b><span>{{ section.settings.why_stat3_label | default: 'built outside the UK' }}</span></li>
      </ul>
      <ul class="acc-cards">
        <li class="acc-card"><a href="{{ section.settings.why_card1_url | default: '/pages/workshops' }}">
          {%- render "bbc-media", image: section.settings.why_card1_img, fallback: "bbc-rd-wb-kit.jpg", video: section.settings.why_card1_video_file, youtube: section.settings.why_card1_video_url, alt: section.settings.why_card1_alt -%}
          <h3>{{ section.settings.why_card1_title | default: 'simple hand tools' }}</h3>
          <p>{{ section.settings.why_card1_body | default: 'A file, a saw, some sandpaper — everything else comes in the kit.' }}</p>
        </a></li>
        <li class="acc-card"><a href="{{ section.settings.why_card2_url | default: '/pages/workshops' }}">
          {%- render "bbc-media", image: section.settings.why_card2_img, fallback: "bbc-rd-wb-builder.jpg", video: section.settings.why_card2_video_file, youtube: section.settings.why_card2_video_url, alt: section.settings.why_card2_alt -%}
          <h3>{{ section.settings.why_card2_title | default: 'no experience needed' }}</h3>
          <p>{{ section.settings.why_card2_body | default: 'Most builders have never made anything before. We guide every step.' }}</p>
        </a></li>
        <li class="acc-card"><a href="{{ section.settings.why_card3_url | default: '/pages/workshops' }}">
          {%- render "bbc-media", image: section.settings.why_card3_img, fallback: "bbc-rd-wb-group.jpg", video: section.settings.why_card3_video_file, youtube: section.settings.why_card3_video_url, alt: section.settings.why_card3_alt -%}
          <h3>{{ section.settings.why_card3_title | default: 'any age, anywhere' }}</h3>
          <p>{{ section.settings.why_card3_body | default: 'Built at kitchen tables in 45 countries, by people of all ages.' }}</p>
        </a></li>
        <li class="acc-card"><a href="{{ section.settings.why_card4_url | default: '/pages/workshops' }}">
          <img src="{% if section.settings.why_card4_img != blank %}{{ section.settings.why_card4_img | image_url: width: 480 }}{% else %}{{ 'bbc-rd-wb-ride.jpg' | asset_url }}{% endif %}" alt="{{ section.settings.why_card4_alt | default: 'Riding a finished bamboo bike on the road' | escape }}" width="480" height="360" loading="lazy">
          <h3>{{ section.settings.why_card4_title | default: 'built to last' }}</h3>
          <p>{{ section.settings.why_card4_body | default: 'Light, strong and it soaks up the road. These bikes get ridden hard.' }}</p>
        </a></li>
      </ul>
      <div class="acc-cta">
        <a class="ew-btn is-lime" href="{{ section.settings.why_cta_url | default: '/pages/workshops' }}">{{ section.settings.why_cta_label | default: 'See how a build works &rarr;' }}</a>
      </div>
    </div>
  </section>


  {%- comment -%} ---------- PROVEN RIDE (comfort + press, GCN video) ---------- {%- endcomment -%}
  <section class="rd-pad rd-paper">
    <div class="rd-wrap">
      <span class="rd-eyebrow">Proven on the road</span>
      <h2 class="rd-reveal rd-mw-20ch">bamboo soaks up the road — riders and reviewers agree.</h2>
      <p class="rd-lede rd-mt2">Not just our word. National press, pro reviewers and ten-year riders all land on the same thing: it rides beautifully.</p>
      {%- comment -%} Two component types used to share one class here, 2026-07-31. The GCN film and
         Taro's build are case studies; the Guardian and BikeRadar lines are PRESS QUOTES — no image,
         no link, no story behind them. Forcing a pull-quote into a case-study card would give it a
         heading link it has no destination for, so the quotes now carry their own class and sit
         outside the case-study contract, while the two real cards render THE standard card.
      {%- endcomment -%}
      <ul class="rd-csgrid rd-mt4" role="list">
        {%- render 'bbc-cscard',
             variant: 'grid',
             kind: 'GCN review',
             heading: 'Global Cycling Network puts a bamboo bike to the test.',
             url: 'https://www.youtube.com/watch?v=cQxbC-njbGQ',
             context: '&ldquo;Are bamboo bikes actually any good?&rdquo;',
             image: 'bbc-rd-gcn.jpg',
             youtube: 'https://www.youtube.com/watch?v=cQxbC-njbGQ',
             cta: 'Watch the film' -%}
        {%- render 'bbc-cscard',
             variant: 'grid',
             kind: 'builder story',
             heading: 'Taro still rides the same frame after 10 years of daily commuting.',
             url: '/blogs/club-news/taro-10-years-riding-my-hand-built-bamboo-bike',
             context: 'One frame, built by hand, ridden every day for a decade.',
             image: 'bbc-rd-bike-field.jpg',
             cta: 'Read his story' -%}
      </ul>
      <ul class="rd-pressquotes rd-mt3" role="list">
        <li class="rd-pressquote rd-reveal"><p>Bamboo naturally dampens vibration, allowing the smoothest ride.</p><cite>The Guardian</cite></li>
        <li class="rd-pressquote rd-reveal"><p>A really, really comfortable ride &mdash; smooth but not too flexy.</p><cite>Kate Rawles &middot; BikeRadar</cite></li>
      </ul>
      {% render 'bbc-video-lightbox' %}
    </div>
  </section>

  {%- comment -%} ---------- KITS ---------- {%- endcomment -%}
  <section class="rd-pad">
    <div class="rd-wrap">
      <div class="rd-flex rd-between rd-mb-36px">
        <div><span class="rd-eyebrow">{{ section.settings.kits_kicker }}</span><h2 class="rd-reveal">{{ section.settings.kits_title }}</h2></div>
        {%- if section.settings.kits_link_label != blank -%}<a class="rd-btn rd-ghost" href="{{ kits_url }}">{{ section.settings.kits_link_label }}</a>{%- endif -%}
      </div>
      <div class="rd-grid rd-g4">
        {%- for block in section.blocks -%}{%- if block.type == 'kit' -%}
          {%- assign kit_link = block.settings.link_url | default: kits_url -%}
          <a class="rd-reveal rd-card" href="{{ kit_link }}" {{ block.shopify_attributes }}>
            <div class="rd-ph">
              {%- if block.settings.image != blank -%}
                <img src="{{ block.settings.image | image_url: width: 900 }}" srcset="{{ block.settings.image | image_url: width: 400 }} 400w, {{ block.settings.image | image_url: width: 600 }} 600w, {{ block.settings.image | image_url: width: 900 }} 900w, {{ block.settings.image | image_url: width: 1200 }} 1200w" sizes="(max-width:749px) 92vw, 30vw" alt="{{ block.settings.image_alt | default: 'A hand-built bamboo bicycle' | escape }}" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}" loading="lazy">
              {%- else -%}
                {%- case block.settings.fallback -%}
                  {%- when 'bbc-rd-prod-gravel.jpg' -%}<img src="https://cdn.shopify.com/s/files/1/0502/8695/2631/files/gravel-bundle.webp?v=1781533204&width=900" srcset="https://cdn.shopify.com/s/files/1/0502/8695/2631/files/gravel-bundle.webp?v=1781533204&width=400 400w, https://cdn.shopify.com/s/files/1/0502/8695/2631/files/gravel-bundle.webp?v=1781533204&width=600 600w, https://cdn.shopify.com/s/files/1/0502/8695/2631/files/gravel-bundle.webp?v=1781533204&width=900 900w" sizes="(max-width:749px) 92vw, 42vw" alt="Gravel lugged bamboo frame kit — parts laid out flat" width="1600" height="1000" loading="lazy">
                  {%- when 'bbc-rd-prod-build.jpg' -%}<img src="https://cdn.shopify.com/s/files/1/0502/8695/2631/files/components.webp?v=1781533169&width=900" srcset="https://cdn.shopify.com/s/files/1/0502/8695/2631/files/components.webp?v=1781533169&width=400 400w, https://cdn.shopify.com/s/files/1/0502/8695/2631/files/components.webp?v=1781533169&width=600 600w, https://cdn.shopify.com/s/files/1/0502/8695/2631/files/components.webp?v=1781533169&width=900 900w" sizes="(max-width:749px) 92vw, 42vw" alt="Bamboo bike components and tools laid out — wheels, saddle and fittings" width="1600" height="1000" loading="lazy">
                  {%- else -%}<img src="{{ block.settings.fallback | default: 'bbc-rd-prod-gravel.jpg' | asset_img_url: '900x' }}" srcset="{{ block.settings.fallback | default: 'bbc-rd-prod-gravel.jpg' | asset_img_url: '400x' }} 400w, {{ block.settings.fallback | default: 'bbc-rd-prod-gravel.jpg' | asset_img_url: '600x' }} 600w, {{ block.settings.fallback | default: 'bbc-rd-prod-gravel.jpg' | asset_img_url: '900x' }} 900w, {{ block.settings.fallback | default: 'bbc-rd-prod-gravel.jpg' | asset_img_url: '1400x' }} 1400w" sizes="(max-width:749px) 92vw, 42vw" alt="{{ block.settings.image_alt | default: 'A hand-built bamboo bicycle' | escape }}" width="1600" height="1000">
                {%- endcase -%}
              {%- endif -%}
            </div>
            <div class="rd-body"><h3 class="rd-fs-21px">{{ block.settings.title }}</h3><p>{{ block.settings.body }}</p></div>
          </a>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ---------- WATCH A BUILD (YouTube, inline-play) ----------
     Rebuilt 2026-07-22 (James): complete-build film sourced from the BBC channel —
     UhuzVI2yVNU "Building a Bamboo Bike Frame from a Home Kit (Full Build)", the
     channel's best-performing full build (16.4k views, 9m25s, box of raw bamboo →
     rideable frame). Poster + lime play → plays inline via bbc-media (no iframe
     until click). Legacy video_mp4 path kept only when no YouTube URL is set.
  ---------- {%- endcomment -%}
  {%- comment -%} NOTE: no rd-center — the homepage's one-left-axis rule
     (bbc-statement.css:172) forces mw-wraps left inside rd-center; we follow
     the axis instead: left-aligned head, full-wrap cinematic video. {%- endcomment -%}
  {%- if section.settings.show_video != false -%}
  <section class="rd-pad rd-dark">
    <div class="rd-wrap">
      {%- if section.settings.video_eyebrow != blank -%}<span class="rd-eyebrow rd-on-dark">{{ section.settings.video_eyebrow }}</span>{%- endif -%}
      {%- if section.settings.video_title != blank -%}<h2 class="rd-reveal rd-mt2">{{ section.settings.video_title }}</h2>{%- endif -%}
      {%- if section.settings.video_lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.video_lede }}</p>{%- endif -%}
      {%- assign yt = section.settings.video_url | default: 'https://www.youtube.com/watch?v=DAMHyvr698k' -%}
      {%- if yt != blank -%}
      <div class="rd-reveal rd-mt3" style="border-radius:14px;overflow:hidden;">
        {%- render 'bbc-media', image: section.settings.video_poster, youtube: yt, label: section.settings.video_chip, alt: section.settings.video_title, class: 'bbc-media--ar169', sizes: '(max-width:749px) 100vw, 1136px' -%}
      </div>
      {%- elsif section.settings.video_mp4 != blank -%}
      <div class="rd-video rd-mt3" style="position:relative;aspect-ratio:16/9;border-radius:14px;overflow:hidden;background:#06231C;">
        <video poster="{% if section.settings.video_poster != blank %}{{ section.settings.video_poster | image_url: width: 1600 }}{% else %}{{ 'bbc-rd-workshop.jpg' | asset_url }}{% endif %}" controls preload="none" playsinline aria-label="{{ section.settings.video_title | escape }}" style="position:absolute;inset:0;width:100%;height:100%;border:0;object-fit:cover;">
          <source src="{{ section.settings.video_mp4 }}" type="video/mp4">
        </video>
      </div>
      {%- endif -%}
      {%- if section.settings.video_credit != blank -%}<p class="rd-ship-note rd-mt2">{{ section.settings.video_credit }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- PRESS (standard block, 2026-07-22) ----------
     Rendered via snippets/bbc-press.liquid — the sitewide standard
     (research: quote-anchored logo bar; contract in qa/PRESS-BLOCK.md).
     Styled-text fake logos REMOVED (real logos only, house rule).
  ---------- {%- endcomment -%}
  <section class="rd-pad-sm rd-steel">
    <div class="rd-wrap">
      {%- render 'bbc-press',
          style: 'bar',
          align: 'left',
          reel: true,
          preset: 'national',
          label: section.settings.press_kicker,
          quote: section.settings.press_quote,
          cite: section.settings.press_cite,
          more_label: section.settings.press_more_label,
          more_url: section.settings.press_more_url -%}
    </div>
  </section>

  {%- comment -%} ---------- FINAL CTA ---------- {%- endcomment -%}
  <section class="rd-pad rd-dark rd-center">
    <div class="rd-wrap rd-mw-760px">
      <span class="rd-eyebrow rd-on-dark">{{ section.settings.cta_kicker }}</span>
      <h2 class="rd-reveal">{{ section.settings.cta_title }}</h2>
      <p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.cta_lede }}</p>
      <div class="rd-flex rd-mt3 rd-jc-center">
        {%- if section.settings.cta1_label != blank -%}<a class="rd-btn rd-lime" href="{{ final_c1 }}">{{ section.settings.cta1_label }}</a>{%- endif -%}
        {%- if section.settings.cta2_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ final_c2 }}">{{ section.settings.cta2_label }}</a>{%- endif -%}
        {%- if section.settings.cta3_label != blank -%}<a class="rd-btn rd-on-dark" href="{{ final_c3 }}">{{ section.settings.cta3_label }}</a>{%- endif -%}
      </div>
    </div>
  </section>

</div>

