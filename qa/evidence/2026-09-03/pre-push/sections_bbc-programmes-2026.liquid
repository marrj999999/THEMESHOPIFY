{%- comment -%}
  BBC New Design (2026) — PROGRAMMES page (/pages/programmes).
  THE EDUCATION PAGE (/pages/programmes, title "Education"). Audience: schools,
  colleges, councils and youth services. PRISONS REMOVED 2026-08-27 (James) —
  prison commissioning lives on /pages/build-to-bond and the impact page; home
  door_2 repointed there. The pri_*/step/budget/routes schema remains dormant.

  CONTENT POLICY (hard rules):
  - Prisons MAY be named. NEVER link a named/identifiable participant to a
    named prison. "Makers", never "prisoners"/"offenders".
  - Pricing = GRANT-BUDGET framing only (kit ~£180 · cohort ~£8,500 ·
    capex £7–10k · site-year ~£45k). No per-learner contract pricing.
  - OCN: two Level 2 courses (1130735, 1131207). No schools-award claim until OCN evidence is filed. 90%+ completion = BBC records only.
  - Every section ends in "start a conversation" → contact. Detail lives in the
    conversation, not a full advert.
{%- endcomment -%}

{%- liquid
  assign contact_url = section.settings.contact_url | default: '/pages/contact-us'
  assign enquiry_email = section.settings.enquiry_email | default: 'info@bamboobicycleclub.org'
-%}

<div class="bbc-rd bbc-rd-programmes">

  {%- comment -%} ---------- HERO (both arms) ----------
     FILM HERO added 2026-08-27 (James: "match the hero from other pages") — same
     hardened pattern as .wvh/.cvh: poster first, film starts on canplay, reveals on
     playing, pauses off-tab. Gates: prefers-reduced-motion + Save-Data honoured;
     NO phone gate (James 2026-08-24: films must play on mobile). Film default:
     bbc-rd-stopmotion-build.mp4 (20s frame-assembly stop-motion, no faces). {%- endcomment -%}
  <header class="rd-hero rd-mh-70 evh">
    <div class="rd-bg">
      {%- if section.settings.hero_image != blank -%}
        <img src="{{ section.settings.hero_image | image_url: width: 1600 }}" srcset="{{ section.settings.hero_image | image_url: width: 800 }} 800w, {{ section.settings.hero_image | image_url: width: 1200 }} 1200w, {{ section.settings.hero_image | image_url: width: 1600 }} 1600w" sizes="100vw" alt="{{ section.settings.hero_image_alt | escape }}" width="{{ section.settings.hero_image.width }}" height="{{ section.settings.hero_image.height }}" fetchpriority="high" loading="eager">
      {%- else -%}
        <img src="{{ section.settings.hero_fallback | default: 'bbc-rd-workshop.jpg' | asset_url }}" alt="{{ section.settings.hero_image_alt | escape }}" width="1500" height="999" fetchpriority="high" loading="eager">
      {%- endif -%}
      {%- assign _evfilm = section.settings.evh_film_url -%}
      {%- if _evfilm == blank -%}{%- assign _evfilm = 'bbc-rd-stopmotion-build.mp4' | asset_url -%}{%- endif -%}
      {%- if section.settings.evh_film_on -%}
      <video class="evh-film" muted playsinline loop preload="metadata" poster="{{ section.settings.hero_fallback | default: 'bbc-rd-workshop.jpg' | asset_url }}" aria-hidden="true" tabindex="-1">
        <source src="{{ _evfilm }}" type="video/mp4">
      </video>
      {%- endif -%}
    </div>
    <div class="rd-scrim"></div>
    <div class="rd-inner">
      <div class="rd-wrap">
        <nav class="rd-crumb"><a href="{{ routes.root_url }}">Home</a><span class="rd-sep">/</span><span class="rd-here">Education</span></nav>
        {%- if section.settings.hero_eyebrow != blank -%}<span class="rd-frame-label rd-c-lime">{{ section.settings.hero_eyebrow }}</span>{%- endif -%}
        <h1 class="rd-mt2 rd-mw-18ch">{{ section.settings.hero_title }}</h1>
        <div class="rd-lede">{{ section.settings.hero_lede }}</div>
        {%- if section.settings.hero_proof_on != false -%}
        <ul class="rd-heroproof" aria-label="Education in numbers">
          <li><b>{{ section.settings.hero_proof1_num | default: '1,500+' }}</b><span>{{ section.settings.hero_proof1_label | default: 'students taught' }}</span></li>
          <li><b>{{ section.settings.hero_proof2_num | default: '22' }}</b><span>{{ section.settings.hero_proof2_label | default: 'schools, colleges & universities' }}</span></li>
          <li><b>{{ section.settings.hero_proof3_num | default: '2' }}</b><span>{{ section.settings.hero_proof3_label | default: 'OCN London Level 2 courses' }}</span></li>
        </ul>
        {%- endif -%}
        <div class="rd-cta-row">
          <a class="rd-btn rd-lime" href="{{ contact_url }}">{{ section.settings.hero_cta1_label | default: 'start a conversation' }} <span class="rd-arrow">&rarr;</span></a>
          <a class="rd-btn rd-on-dark" href="#schools">{{ section.settings.hero_cta2_label | default: 'for schools & colleges' }}</a>
          <a class="rd-btn rd-on-dark" href="#community">{{ section.settings.hero_cta3_label | default: 'for councils & youth services' }}</a>
        </div>
        {%- if section.settings.hero_quote != blank -%}
        <div class="rd-heroquote rd-mt3">
          <p class="rd-q">{{ section.settings.hero_quote }}</p>
          {%- if section.settings.hero_quote_cite != blank -%}<cite>{{ section.settings.hero_quote_cite }}</cite>{%- endif -%}
        </div>
        {%- endif -%}
      </div>
    </div>
  </header>
  <style>
    .evh .evh-film{ position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0; opacity:0; transition:opacity .8s ease; }
    .evh .evh-film.evh-on{ opacity:1; }
    .evh .rd-bg img{ z-index:0; }
    @media (prefers-reduced-motion: reduce){ .evh .evh-film{ display:none; } }
    .bbc-rd-programmes .rd-hero h1,
    .bbc-rd-programmes .rd-hero .rd-lede,
    .bbc-rd-programmes .rd-hero .rd-heroproof,
    .bbc-rd-programmes .rd-hero .rd-cta-row,
    .bbc-rd-programmes .rd-hero .rd-heroquote,
    .bbc-rd-programmes .rd-hero .rd-crumb{ text-align:left !important; margin-left:0 !important; margin-right:0 !important; }
    .bbc-rd-programmes .rd-hero .rd-heroproof{ justify-content:flex-start !important; }
    .bbc-rd-programmes .rd-hero .rd-cta-row{ justify-content:flex-start !important; }
    .bbc-rd .rd-heroquote{ max-width:58ch; }
    .bbc-rd .rd-heroquote .rd-q{ font-size:clamp(14.5px,1.3vw,17px); line-height:1.55; margin:0 0 4px; opacity:.94; color:var(--bone,#E6DCC8); }
    .bbc-rd .rd-heroquote cite{ color:var(--bone,#E6DCC8); }
    .bbc-rd .rd-heroquote cite{ font-style:normal; font-size:11.5px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; opacity:.7; }
  
  .bbc-rd .edt-instgrp{ max-width:820px; margin-left:auto; margin-right:auto; }
  .bbc-rd .edt-instk{ display:block; font-size:11px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; opacity:.55; margin-bottom:6px; }
  .bbc-rd .edt-instnames{ font-size:15px; line-height:1.9; margin:0; }
</style>
  <script>
    (function () {
      var v = document.querySelector('.evh .evh-film');
      if (!v) return;
      if (navigator.connection && navigator.connection.saveData) { v.remove(); return; }
      if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) { v.remove(); return; }
      v.muted = true; v.setAttribute('muted', '');
      var started = false;
      function go() {
        if (started) return; started = true;
        var p = v.play();
        if (p && p.catch) p.catch(function () { started = false; });
      }
      v.addEventListener('playing', function () { v.classList.add('evh-on'); });
      v.addEventListener('canplay', go);
      v.load();
      if (v.readyState >= 3) go();
      document.addEventListener('visibilitychange', function () {
        if (document.hidden) { v.pause(); } else if (started) { v.play().catch(function(){}); }
      });
    })();
  </script>

  {%- comment -%} ---------- TWO PATHS (overview — the fork) ---------- {%- endcomment -%}
  <style>
    .edt-ic{ width:38px; height:38px; color:var(--forest,#003C32); display:block; margin:0 0 10px; }
    .edt-ic .edt-ic-a{ color:#7aa000; }
    .edt-media{ aspect-ratio:8/5; overflow:hidden; background:var(--forest-700,#002A23); }
    .edt-media img{ width:100%; height:100%; object-fit:cover; display:block; }
    .edt-tools{ display:grid; grid-template-columns:repeat(3,1fr); gap:14px; }
    @media (max-width:860px){ .edt-tools{ grid-template-columns:1fr; } }
    .edt-tool{ border:2.5px solid var(--ink,#0E241E); border-radius:12px; overflow:hidden; background:#fff; }
    .edt-tool img{ width:100%; display:block; }
    .edt-tool figcaption{ padding:10px 14px; font-size:13.5px; font-weight:700; letter-spacing:.03em; }
  </style>
  <section class="rd-pad rd-paper">
    <div class="rd-wrap">
      <div class="rd-center">
        {%- if section.settings.paths_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.paths_eyebrow }}</span>{%- endif -%}
        <h2 class="rd-mw-22ch rd-mx-auto">{{ section.settings.paths_title }}</h2>
        {%- if section.settings.paths_lede != blank -%}<p class="rd-lede rd-mt2 rd-mx-auto">{{ section.settings.paths_lede }}</p>{%- endif -%}
      </div>
      <div class="rd-grid rd-g2 rd-mt4">
        <a class="rd-card rd-stamp rd-cardlink" href="#schools">
          <div class="rd-body">
            <svg class="edt-ic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="8" y="3" width="16" height="26" rx="3" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="11" r="2.4" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="21" r="4.6" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="21" r="1.2" fill="currentColor" class="edt-ic-a"/></svg>
            <span class="rd-tag rd-lime">{{ section.settings.sch_tag | default: 'in schools · ages 11–19' }}</span>
            <h3 class="rd-mt2 rd-fs-21px">{{ section.settings.sch_card_title | default: 'real engineering' }}</h3>
            <p>{{ section.settings.sch_card_body | default: "A free bamboo-speaker STEM build for schools and colleges — OCN-accredited routes when you build up. Teachers run it; no engineering background needed." }}</p>
            <span class="rd-arrow-link">for schools <span class="rd-arrow">&rarr;</span></span>
          </div>
        </a>
        <a class="rd-card rd-stamp rd-cardlink" href="#community">
          <div class="rd-body">
            <svg class="edt-ic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M9 2v28M23 2v28" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M9 9h14M9 16h14M9 23h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="26.5" cy="5" r="2" fill="currentColor" class="edt-ic-a"/></svg>
            <span class="rd-tag rd-lime">{{ section.settings.comc_tag | default: 'for councils · youth services' }}</span>
            <h3 class="rd-mt2 rd-fs-21px">{{ section.settings.comc_card_title | default: 'prevention through making' }}</h3>
            <p>{{ section.settings.comc_card_body | default: "A five-step ladder for youth settings — free taster talks to accredited builds and enterprise skills. Delivered with Project Zero in Waltham Forest; piloted with Camden." }}</p>
            <span class="rd-arrow-link">for councils &amp; youth services <span class="rd-arrow">&rarr;</span></span>
          </div>
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- FACTS STRIP (shared proof) ----------
    Moved below TWO PATHS (was directly under the hero). Hero and facts strip are both dark, so
    the page opened with two dark bands run together — PAGE-STANDARD S3. Impact's order is
    hero -> light band -> dark stats, and that light band is what lets the stat band stay dark,
    which is what keeps the figures lime. Reordered, not recoloured: no content changed.
    (2026-08-04)
  {%- endcomment -%}
  <section class="rd-pad-sm rd-dark rd-band--stats">
    <div class="rd-wrap">
      {%- if section.settings.ghost_stat != blank -%}<span class="rd-ghostnum" aria-hidden="true">{{ section.settings.ghost_stat }}</span>{%- endif -%}
      {%- if section.settings.stats_label != blank -%}<span class="rd-eyebrow">{{ section.settings.stats_label }}</span>{%- endif -%}
      <div class="rd-stats">
        {%- for block in section.blocks -%}{%- if block.type == 'fact' -%}
          <div class="rd-reveal rd-stat" {{ block.shopify_attributes }}>
            <div class="rd-num bbc-counted">{{ block.settings.number }}</div>
            <div class="rd-lbl">{{ block.settings.label }}</div>
            {%- if block.settings.source != blank -%}<div class="rd-src">{{ block.settings.source }}</div>{%- endif -%}
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- if section.settings.facts_note != blank -%}<p class="rd-dataasof rd-on-dark">{{ section.settings.facts_note }}</p>{%- endif -%}
      {%- if section.settings.facts_cta_label != blank -%}<div class="rd-mt3"><a class="rd-btn rd-on-dark" href="{{ section.settings.facts_cta_url | default: '#institutions' }}">{{ section.settings.facts_cta_label }} <span class="rd-arrow">&rarr;</span></a></div>{%- endif -%}
    </div>
  </section>

  {%- comment -%} ========== SCHOOLS ARM ========== {%- endcomment -%}
  <section id="schools" class="rd-split">
    <div class="rd-reveal rd-media">
      <img src="{{ section.settings.sch_image | default: 'bbc-edu-class.jpg' | asset_url }}" alt="{{ section.settings.sch_image_alt | default: 'A school group learning frame-building in the Bamboo Bicycle Club workshop' | escape }}" loading="lazy" width="1063" height="1600">
    </div>
    <div class="rd-txt">
      {%- if section.settings.sch_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.sch_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-reveal">{{ section.settings.sch_title }}</h2>
      {%- if section.settings.sch_lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.sch_lede }}</p>{%- endif -%}
      {%- assign ssteps = section.blocks | where: 'type', 'sstep' -%}
      {%- if ssteps.size > 0 -%}
      <ol class="rd-steps rd-mt4">
        {%- for block in ssteps -%}
          <li {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3><p>{{ block.settings.body }}</p></li>
        {%- endfor -%}
      </ol>
      {%- endif -%}
      <div class="rd-cta-row rd-mt4">
        <a class="rd-btn rd-ghost" href="{{ contact_url }}?subject=schools">{{ section.settings.sch_cta_label | default: 'enquire for your school' }} <span class="rd-arrow">&rarr;</span></a>
      </div>
    </div>
  </section>

  {%- comment -%} ---------- THE SCHOOLS PATHWAY (5 tiered programmes) ----------
     Merged in from the unpublished bbc-education-2026 draft (2026-08-27, James:
     "make this the education page — analyse both and merge"). Advert cards, not
     links — pure estate classes, block type `programme` ported verbatim from the
     education section. Frame I updated per Claims Register: the balance-bike
     course is OCN London Level 2 accredited (1131207, 31 Jul 2026). {%- endcomment -%}
  {%- if section.settings.prog_title != blank -%}
  <section class="rd-pad" id="pathway">
    <div class="rd-wrap">
      <span class="rd-eyebrow">{{ section.settings.prog_eyebrow }}</span>
      <h2 class="rd-reveal rd-mw-16ch">{{ section.settings.prog_title }}</h2>
      {%- if section.settings.prog_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.prog_lede }}</p>{%- endif -%}
      <div class="rd-grid rd-g3 rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'programme' -%}
          <div class="rd-reveal rd-card rd-stamp{% if block.settings.free %} rd-card-free{% endif %}" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
            <div class="edt-media"><img src="{{ block.settings.image | image_url: width: 720 }}"
                 srcset="{{ block.settings.image | image_url: width: 480 }} 480w, {{ block.settings.image | image_url: width: 720 }} 720w"
                 sizes="(max-width: 749px) 92vw, 30vw" alt="" loading="lazy"
                 width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}"></div>
            {%- endif -%}
            <div class="rd-body">
              {%- comment -%} tier pictograms (2026-08-27) — same hand-drawn family as the
                 community ladder; forest stroke, lime accent class edt-ic-a {%- endcomment -%}
              {%- case block.settings.icon -%}
              {%- when 'speakerbox' -%}
                <svg class="edt-ic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><rect x="8" y="3" width="16" height="26" rx="3" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="11" r="2.4" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="21" r="4.6" stroke="currentColor" stroke-width="2"/><circle cx="16" cy="21" r="1.2" fill="currentColor" class="edt-ic-a"/></svg>
              {%- when 'balance' -%}
                <svg class="edt-ic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="8" cy="22" r="5" stroke="currentColor" stroke-width="2"/><circle cx="24" cy="22" r="5" stroke="currentColor" stroke-width="2"/><path d="M8 22l4-9h6l6 9" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M12 13l-2-4h3M18 13l3-5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><circle cx="21.6" cy="7.4" r="1.8" fill="currentColor" class="edt-ic-a"/></svg>
              {%- when 'framebike' -%}
                <svg class="edt-ic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="7" cy="22" r="5.5" stroke="currentColor" stroke-width="2"/><circle cx="25" cy="22" r="5.5" stroke="currentColor" stroke-width="2"/><path d="M7 22l5-11h9l4 11M12 11h9M16 22l-4-11M16 22l5-11" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M21 11l-1.6-4h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="edt-ic-a"/></svg>
              {%- when 'ai3d' -%}
                <svg class="edt-ic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M16 12l9 4.5v9L16 30l-9-4.5v-9L16 12z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M7 16.5l9 4.5 9-4.5M16 21v9" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M16 2v7M12.5 5.5h7" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M25 3.5l.9-1.9.9 1.9 1.9.9-1.9.9-.9 1.9-.9-1.9-1.9-.9 1.9-.9z" fill="currentColor" class="edt-ic-a"/></svg>
              {%- when 'ebike' -%}
                <svg class="edt-ic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="7" cy="23" r="5" stroke="currentColor" stroke-width="2"/><circle cx="25" cy="23" r="5" stroke="currentColor" stroke-width="2"/><path d="M7 23l5-10h8l5 10M12 13l-2-3h4" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/><path d="M20 4l-4 8h5l-4 8" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" class="edt-ic-a"/></svg>
              {%- endcase -%}
              <div class="rd-flex rd-between rd-gap-24">
                <span class="rd-frame-label rd-c-subtle">{{ block.settings.tier }}</span>
                {%- if block.settings.status == 'coming' -%}
                  <span class="rd-tag">{{ section.settings.tx_in_development | default: "In development" }}</span>
                {%- elsif block.settings.free -%}
                  <span class="rd-tag rd-lime">Free</span>
                {%- else -%}
                  <span class="rd-tag">{{ block.settings.price_tag | default: 'Request a quote' }}</span>
                {%- endif -%}
              </div>
              <h3 class="rd-fs-21px rd-mt2">{{ block.settings.title }}</h3>
              {%- if block.settings.detail != blank -%}<p class="rd-c-subtle rd-mt-10px">{{ block.settings.detail }}</p>{%- endif -%}
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ========== COMMUNITY & COUNCILS ARM ==========
     Added 2026-08-26 from Chris's "Website" doc (Google Doc 1ppl_5413…): a five-rung
     product ladder for the community sector — prevention work aimed at councils, VRUs,
     youth hubs and PRUs. Design: the "culm ladder" — vertical rail on phones (same
     family as the our-story timeline), rising baseline steps on desktop, so the
     progression is the composition. Rung blocks are `crung` in the template; a rung
     with `dev` ticked renders ghosted ("in development") — Chris's own "?" on rung 5.
     COPY GATES: System/Claims Register + person-first language (TRR declaration, Chris
     19 Aug). Camden is a PILOT — never a success story or endorsement. No outcome
     claims beyond the published Project Zero case study. {%- endcomment -%}
  {%- if section.settings.com_title != blank -%}
  <section id="community" class="rd-pad">
    <div class="rd-wrap">
      {%- if section.settings.com_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.com_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-mw-22ch">{{ section.settings.com_title }}</h2>
      {%- if section.settings.com_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.com_lede }}</p>{%- endif -%}
      {%- if section.settings.com_audiences != blank -%}
        <ul class="cml-aud rd-mt2" role="list">
          {%- assign _auds = section.settings.com_audiences | split: ',' -%}
          {%- for a in _auds -%}<li>{{ a | strip }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
      {%- assign crungs = section.blocks | where: 'type', 'crung' -%}
      {%- if crungs.size > 0 -%}
      <ol class="cml-ladder rd-mt4">
        {%- for block in crungs -%}
          <li class="cml-rung{% if block.settings.dev %} cml-dev{% endif %}" {{ block.shopify_attributes }}>
            <span class="cml-n" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <div class="cml-card">
              {%- comment -%} Hand-drawn-style pictograms (2026-08-26, James: "use symbols").
                 Icons not photos on rungs: step/tier devices scan on symbols; photography
                 lives in the proof card below so the ladder stays crisp. {%- endcomment -%}
              {%- case block.settings.icon -%}
              {%- when 'speaker' -%}
                <svg class="cml-ic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><path d="M4 14v6l5 1V13l-5 1z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M9 13l13-6v18l-13-6" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M25 12c1.4 1 2.2 2.4 2.2 4s-.8 3-2.2 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/><path d="M27.5 9.5A9 9 0 0 1 30.6 16a9 9 0 0 1-3.1 6.5" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="cml-ic-a"/></svg>
              {%- when 'balance' -%}
