      <div class="rd-cta-row rd-mt4">
        <a class="rd-btn rd-ghost" href="{{ contact_url }}?subject=community">{{ section.settings.com_cta_label | default: 'start a conversation' }} <span class="rd-arrow">&rarr;</span></a>
      </div>
    </div>
  </section>
  <style>
    /* Community culm ladder — self-owned .cml-* classes (estate cascade lesson) */
    .cml-aud{ list-style:none; margin:0; padding:0; display:flex; flex-wrap:wrap; gap:8px; }
    .cml-aud li{ font-size:12.5px; font-weight:700; letter-spacing:.07em; text-transform:uppercase; color:var(--forest,#003C32); background:rgba(0,60,50,.08); border:1.5px solid rgba(0,60,50,.25); border-radius:999px; padding:5px 12px; }
    .cml-ladder{ list-style:none; margin:0; padding:0 0 0 46px; position:relative; }
    .cml-ladder::before{ content:""; position:absolute; left:13px; top:8px; bottom:8px; width:4px; border-radius:2px;
      background:repeating-linear-gradient(to bottom, var(--forest,#003C32) 0 16px, rgba(0,60,50,.16) 16px 22px); }
    .cml-rung{ position:relative; padding:0 0 26px; }
    .cml-rung:last-child{ padding-bottom:0; }
    .cml-n{ position:absolute; left:-46px; top:0; width:30px; height:30px; border-radius:50%; background:var(--lime,#D4FD62); color:var(--forest,#003C32); font-weight:800; font-size:13px; display:flex; align-items:center; justify-content:center; box-shadow:0 0 0 3px rgba(0,60,50,.9); }
    .cml-t{ margin:2px 0 2px; font-size:20px; line-height:1.2; }
    .cml-tag{ display:inline-block; font-size:12px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--forest,#003C32); opacity:.65; margin:0 0 6px; }
    .cml-b{ margin:4px 0 0; font-size:15.5px; line-height:1.55; max-width:52ch; }
    .cml-dev .cml-card{ opacity:.62; }
    .cml-dev .cml-n{ background:transparent; color:var(--forest,#003C32); border:2px dashed var(--forest,#003C32); box-shadow:none; }
    .cml-devtag{ font-size:11px; font-weight:700; letter-spacing:.08em; text-transform:uppercase; color:var(--forest,#003C32); background:rgba(0,60,50,.1); border-radius:999px; padding:3px 9px; vertical-align:middle; margin-left:6px; }
    .cml-ic{ width:40px; height:40px; color:var(--forest,#003C32); display:block; margin:0 0 8px; }
    .cml-ic .cml-ic-a{ color:inherit; }
    .cml-rung:not(.cml-dev) .cml-ic .cml-ic-a{ color:#7aa000; }
    .cml-proofcard{ display:flex; gap:18px; align-items:center; max-width:760px; background:rgba(0,60,50,.06); border-radius:14px; padding:14px; }
    .cml-proofimg{ width:190px; aspect-ratio:4/3; object-fit:cover; border-radius:10px; flex:none; }
    .cml-proof{ font-size:15.5px; max-width:64ch; border-left:4px solid var(--lime,#D4FD62); padding-left:14px; margin:0; }
    .cml-proof a{ font-weight:700; white-space:nowrap; }
    @media (max-width:600px){ .cml-proofcard{ flex-direction:column; align-items:stretch; } .cml-proofimg{ width:100%; } }
    @media (min-width:900px){
      /* rising staircase: cards share a baseline, each rung starts higher */
      .cml-ladder{ display:grid; grid-template-columns:repeat(5,1fr); gap:14px; padding:0; align-items:start; }
      .cml-ladder::before{ content:none; }
      .cml-rung{ padding:0; display:flex; flex-direction:column; height:100%; }
      .cml-rung:nth-child(1){ margin-top:120px; } .cml-rung:nth-child(2){ margin-top:90px; }
      .cml-rung:nth-child(3){ margin-top:60px; } .cml-rung:nth-child(4){ margin-top:30px; }
      .cml-rung:nth-child(5){ margin-top:0; }
      .cml-n{ position:static; margin-bottom:10px; }
      .cml-card{ border-top:3px solid var(--forest,#003C32); padding-top:10px; flex:1; }
      .cml-dev .cml-card{ border-top-style:dashed; }
      .cml-t{ font-size:19px; }
      .cml-b{ font-size:14.5px; }
    }
    @media (min-width:900px) and (max-width:1100px){ .cml-ladder{ grid-template-columns:repeat(5,1fr); gap:10px; } .cml-t{ font-size:17px; } }
  </style>
  {%- endif -%}

  {%- comment -%} ---------- HOW COMMISSIONING WORKS (2026-08-27) ----------
     Stakeholder refocus (James): councils + education institutions. Steps mirror the
     REAL Camden commissioning thread (supplier setup, RA, safeguarding + photography
     agreed, SEND adjustments, surveys + report back) — practice claims only, no
     framework name-drops until James/Chris confirm (Gatsby/DfE Enrichment/YEF are in
     the workstream note as pending decisions). {%- endcomment -%}
  {%- if section.settings.hcw_title != blank -%}
  <section class="rd-pad-sm rd-paper" id="commissioning">
    <div class="rd-wrap">
      <span class="rd-eyebrow">{{ section.settings.hcw_eyebrow }}</span>
      <h2 class="rd-mw-22ch">{{ section.settings.hcw_title }}</h2>
      <ol class="rd-steps rd-mt4">
        <li><h3>{{ section.settings.hcw_s1_t }}</h3><p>{{ section.settings.hcw_s1_b }}</p></li>
        <li><h3>{{ section.settings.hcw_s2_t }}</h3><p>{{ section.settings.hcw_s2_b }}</p></li>
        <li><h3>{{ section.settings.hcw_s3_t }}</h3><p>{{ section.settings.hcw_s3_b }}</p></li>
        <li><h3>{{ section.settings.hcw_s4_t }}</h3><p>{{ section.settings.hcw_s4_b }}</p></li>
      </ol>
      {%- if section.settings.hcw_note != blank -%}<p class="rd-c-subtle rd-mt2" style="max-width:64ch;">{{ section.settings.hcw_note }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- THE INSTRUCTOR APP (2026-08-27, James: dashboard screenshots) ----------
     Screens are curriculum-delivery UI from the instructor app slide decks — run-of-day,
     safety checklist, evidence hand-in. NO learner data (lesson screens only; never
     screenshot live cohort views). {%- endcomment -%}
  {%- if section.settings.tools_title != blank -%}
  <section class="rd-pad" id="tools">
    <div class="rd-wrap">
      <span class="rd-eyebrow">{{ section.settings.tools_eyebrow }}</span>
      <h2 class="rd-mw-22ch">{{ section.settings.tools_title }}</h2>
      {%- if section.settings.tools_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.tools_lede }}</p>{%- endif -%}
      <div class="edt-tools rd-mt4">
        {%- for i in (1..3) -%}
          {%- assign _img = 'tools_img' | append: i -%}
          {%- assign _cap = 'tools_cap' | append: i -%}
          {%- if section.settings[_img] != blank -%}
          <figure class="edt-tool rd-reveal">
            <img src="{{ section.settings[_img] | image_url: width: 900 }}" alt="{{ section.settings[_cap] | escape }}" loading="lazy"
                 width="{{ section.settings[_img].width }}" height="{{ section.settings[_img].height }}">
            {%- if section.settings[_cap] != blank -%}<figcaption>{{ section.settings[_cap] }}</figcaption>{%- endif -%}
          </figure>
          {%- endif -%}
        {%- endfor -%}
      </div>
