              {%- when 'ebike' -%}
                <svg class="cml-ic" viewBox="0 0 32 32" fill="none" aria-hidden="true"><circle cx="7" cy="23" r="5" stroke="currentColor" stroke-width="2"/><circle cx="25" cy="23" r="5" stroke="currentColor" stroke-width="2"/><path d="M7 23l5-10h8l5 10M12 13l-2-3h4" stroke="currentColor" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/><path d="M20 4l-4 8h5l-4 8" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round" stroke-linecap="round" class="cml-ic-a"/></svg>
