  {%- endif -%}



  {%- comment -%} ---------- BUDGET GUIDE (grant framing) ---------- {%- endcomment -%}
  {%- if section.settings.budget_title != blank -%}
  <section class="rd-pad rd-paper">
    <div class="rd-wrap">
      {%- if section.settings.budget_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.budget_eyebrow }}</span>{%- endif -%}
      <h2 class="rd-mw-22ch">{{ section.settings.budget_title }}</h2>
      {%- if section.settings.budget_lede != blank -%}<p class="rd-lede rd-mt2 rd-maxw">{{ section.settings.budget_lede }}</p>{%- endif -%}
      <div class="rd-grid rd-g4 rd-mt4">
        {%- for block in section.blocks -%}{%- if block.type == 'budget' -%}
          <div class="rd-card rd-stamp" {{ block.shopify_attributes }}>
            <div class="rd-body">
              <div class="rd-num bbc-counted">{{ block.settings.figure }}</div>
              <p class="rd-statlbl rd-mt1">{{ block.settings.title }}</p>
              <p>{{ block.settings.body }}</p>
            </div>
          </div>
        {%- endif -%}{%- endfor -%}
      </div>
      {%- if section.settings.budget_note != blank -%}<p class="rd-ship-note rd-mt3">{{ section.settings.budget_note }}</p>{%- endif -%}
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- SECURITY & COMPLIANCE ---------- {%- endcomment -%}
  {%- if section.settings.sec_title != blank -%}
  <section class="rd-pad">
    <div class="rd-wrap rd-mw-820px">
      {%- if section.settings.sec_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.sec_eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.sec_title }}</h2>
      {%- if section.settings.sec_lede != blank -%}<p class="rd-lede rd-mt2">{{ section.settings.sec_lede }}</p>{%- endif -%}
      <ul class="rd-list rd-mt3">
        {%- for block in section.blocks -%}{%- if block.type == 'check' -%}
          <li {{ block.shopify_attributes }}>{{ block.settings.text }}</li>
        {%- endif -%}{%- endfor -%}
      </ul>
    </div>
  </section>
  {%- endif -%}

  {%- comment -%} ---------- ROUTES TO COMMISSION ---------- {%- endcomment -%}
  {%- if section.settings.routes_title != blank -%}
  <section class="rd-pad rd-steel">
    <div class="rd-wrap">
      <div class="rd-center">
        {%- if section.settings.routes_eyebrow != blank -%}<span class="rd-eyebrow">{{ section.settings.routes_eyebrow }}</span>{%- endif -%}
