{% comment %}
  BBC Awards — Clean Professional Version
  
  Design Rules:
  - SVG icons only (no emojis)
  - Consistent icon sizing
  - Clean typography
{% endcomment %}

<section class="bbc-awards">
  <div class="bbc-awards__container page-width">
    <header class="bbc-awards__header">
      {% if section.settings.eyebrow != blank %}
        <span class="bbc-awards__eyebrow">{{ section.settings.eyebrow }}</span>
      {% endif %}
      <h2 class="bbc-awards__heading">{{ section.settings.heading }}</h2>
    </header>
    
    <div class="bbc-awards__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'award' -%}
          <article class="bbc-award{% if block.settings.style == 'gold' %} bbc-award--gold{% elsif block.settings.style == 'featured' %} bbc-award--featured{% endif %}" {{ block.shopify_attributes }}>
            <span class="bbc-award__icon" aria-hidden="true">
              {% render 'bbc-icons', icon: block.settings.icon %}
            </span>
            <h3 class="bbc-award__title">{{ block.settings.title }}</h3>
            <span class="bbc-award__year">{{ block.settings.year }}</span>
            <p class="bbc-award__description">{{ block.settings.description }}</p>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
    
    {%- for block in section.blocks -%}
      {%- if block.type == 'endorsement' -%}
        <blockquote class="bbc-awards__endorsement" {{ block.shopify_attributes }}>
          <p>"{{ block.settings.quote }}"</p>
          <footer>
            <strong>{{ block.settings.name }}</strong>
            {% if block.settings.title != blank %}
              <span>{{ block.settings.title }}</span>
            {% endif %}
          </footer>
        </blockquote>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

<style>
  .bbc-awards {
    padding: 100px 20px;
    background: var(--bbc-forest, var(--bbc-forest));
    position: relative;
    overflow: hidden;
  }
  
  .bbc-awards__header {
    margin-bottom: 48px;
    position: relative;
  }
  
  .bbc-awards__eyebrow {
    display: inline-block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--bbc-gold, var(--bbc-gold));
    margin-bottom: 12px;
  }
  
  .bbc-awards__heading {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 800;
    color: white;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1.1;
  }
  
  .bbc-awards__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 24px;
  }
  
  /* Award card */
  .bbc-award {
    padding: 32px 28px;
    background: rgba(255, 255, 255, 0.05);
    border-left: 4px solid transparent;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  
  .bbc-award:hover {
    background: rgba(255, 255, 255, 0.08);
    border-left-color: var(--bbc-teal, var(--bbc-teal));
  }
  
  .bbc-award--gold {
    border-left-color: var(--bbc-gold, var(--bbc-gold));
    background: rgba(255, 169, 0, 0.1);
  }
  
  .bbc-award--gold:hover {
    border-left-color: var(--bbc-gold, var(--bbc-gold));
  }
  
  .bbc-award--featured {
    background: var(--bbc-gold, var(--bbc-gold));
    border-left-color: transparent;
  }
  
  .bbc-award--featured:hover {
    background: var(--bbc-gold, var(--bbc-gold));
    border-left-color: transparent;
  }
  
  .bbc-award--featured .bbc-award__icon,
  .bbc-award--featured .bbc-award__title,
  .bbc-award--featured .bbc-award__year,
  .bbc-award--featured .bbc-award__description {
    color: var(--bbc-forest, var(--bbc-forest));
  }
  
  @media (prefers-reduced-motion: reduce) {
    .bbc-award {
      transition: none;
    }
  }
  
  /* Icon styling - Material Symbols */
  .bbc-award__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin-bottom: 16px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 12px;
  }
  
  .bbc-award__icon .material-symbols-outlined {
    font-size: 28px;
    color: var(--bbc-gold, var(--bbc-gold));
  }
  
  .bbc-award--gold .bbc-award__icon {
    background: rgba(255, 169, 0, 0.2);
  }
  
  .bbc-award--featured .bbc-award__icon {
    background: rgba(7, 62, 39, 0.15);
  }
  
  .bbc-award--featured .bbc-award__icon .material-symbols-outlined {
    color: var(--bbc-forest, var(--bbc-forest));
  }
  
  .bbc-award__title {
    font-family: var(--font-heading-family);
    font-size: 1.125rem;
    font-weight: 700;
    color: white;
    margin: 0 0 8px 0;
  }
  
  .bbc-award__year {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--bbc-gold, var(--bbc-gold));
    margin-bottom: 12px;
  }
  
  .bbc-award--featured .bbc-award__year {
    background: var(--bbc-forest, var(--bbc-forest));
    color: white;
    padding: 4px 10px;
  }
  
  .bbc-award__description {
    font-size: 0.875rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.75);
    margin: 0;
  }
  
  /* Endorsement quote */
  .bbc-awards__endorsement {
    margin: 60px 0 0;
    padding: 40px 0 0 32px;
    border-left: 6px solid var(--bbc-gold, var(--bbc-gold));
    max-width: 800px;
    position: relative;
  }
  
  .bbc-awards__endorsement::before {
    content: '"';
    position: absolute;
    top: 20px;
    left: 32px;
    font-family: var(--font-body-family);
    font-size: 5rem;
    line-height: 1;
    color: var(--bbc-gold, var(--bbc-gold));
    opacity: 0.2;
  }
  
  .bbc-awards__endorsement p {
    font-size: 1.25rem;
    font-style: italic;
    line-height: 1.6;
    color: white;
    margin: 0 0 24px 0;
    position: relative;
  }
  
  .bbc-awards__endorsement footer {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .bbc-awards__endorsement strong {
    font-size: 1rem;
    color: var(--bbc-gold, var(--bbc-gold));
  }
  
  .bbc-awards__endorsement span {
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.6);
  }
  
  @media (max-width: 768px) {
    .bbc-awards {
      padding: 60px 16px;
    }
    
    .bbc-awards__grid {
      grid-template-columns: 1fr 1fr;
    }
    
    .bbc-award {
      padding: 24px 20px;
    }
    
    .bbc-award__icon {
      width: 48px;
      height: 48px;
    }
    
    .bbc-award__icon svg {
      width: 24px;
      height: 24px;
    }
    
    .bbc-awards__endorsement {
      padding-left: 24px;
    }
    
    .bbc-awards__endorsement p {
      font-size: 1.0625rem;
    }
  }
  
  @media (max-width: 480px) {
    .bbc-awards__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

