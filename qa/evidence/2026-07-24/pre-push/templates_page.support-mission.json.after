{
  "sections": {
    "main": {
      "type": "bbc-support-mission-2026",
      "blocks": {
        "pillar-education": {
          "type": "pillar",
          "settings": {
            "title": "education",
            "body": "OCN-accredited courses at Level 1 and Level 2 — proper qualifications, earned with tools in hand.",
            "image_fallback": "bbc-rd-wb-lug.jpg",
            "image_alt": "Wrapping a bamboo frame joint by hand"
          }
        },
        "pillar-employment": {
          "type": "pillar",
          "settings": {
            "title": "employment",
            "body": "Skills the labour market is short of — fabrication, finishing, tolerances — plus peer instructors trained from within the programme.",
            "image_fallback": "bbc-rd-wb-jig.jpg",
            "image_alt": "A frame set up on the building jig"
          }
        },
        "pillar-rehabilitation": {
          "type": "pillar",
          "settings": {
            "title": "rehabilitation",
            "body": "Build to Bond Makers build a balance bike for their own child — family contact is one of the strongest factors in staying out, and the bike is the bridge.",
            "image_fallback": "bbc-rd-wb-bond.jpg",
            "image_alt": "A finished child-size balance bike in the workshop"
          }
        },
        "stat-completion": {
          "type": "stat",
          "settings": {
            "number": "90%+",
            "label": "of Makers complete the course",
            "comparator": "across every cohort to date"
          }
        },
        "stat-sites": {
          "type": "stat",
          "settings": {
            "number": "3",
            "label": "prison sites running",
            "comparator": "more sites onboarding with HMPPS — we count only what's live"
          }
        },
        "faq-cic": {
          "type": "faq",
          "settings": {
            "question": "Why a CIC and not a charity?",
            "answer": "Because the workshops pay for most of it. The CIC is asset-locked — money in stays in — but it lets us run like the business we are, with kits and workshops funding the mission instead of a fundraising department."
          }
        },
        "faq-grants": {
          "type": "faq",
          "settings": {
            "question": "What does grant funding pay for that sales don't?",
            "answer": "Scale and start-up. A new prison workshop needs benches, jigs and tools before the first cohort starts — that's what backers fund. Once running, sites are sustained by earned income and prison education budgets."
          }
        },
        "faq-accounts": {
          "type": "faq",
          "settings": {
            "question": "Can we see the accounts?",
            "answer": "Yes — both companies file at Companies House: Bamboo Bicycle Club Ltd (10809302) and Bamboo Mobility Project CIC (16257348). Ask and we'll walk you through them."
          }
        },
        "rung-kit": {
          "type": "rung",
          "settings": {
            "amount": "~£180",
            "title": "one kit",
            "body": "Puts a frame kit and tools on one Maker's bench for a full build.",
            "cta_label": "Fund a kit",
            "primary": false
          }
        },
        "rung-cohort": {
          "type": "rung",
          "settings": {
            "amount": "~£8,500",
            "title": "a full cohort",
            "body": "Six Makers through a complete accredited programme — instructor, coordinator, kits, materials, and the assessment at the end.",
            "cta_label": "Fund a cohort",
            "primary": true
          }
        },
        "rung-workshop": {
          "type": "rung",
          "settings": {
            "amount": "~£7–10k",
            "title": "a workshop, kitted out",
            "body": "Benches, jigs and tools for a new site — one-off capital that stays with the prison permanently, whatever happens next.",
            "cta_label": "Fund a workshop",
            "primary": false
          }
        },
        "rung-siteyear": {
          "type": "rung",
          "settings": {
            "amount": "~£45k",
            "title": "a site, for a year",
            "body": "Four cohorts, twenty-four Makers, one prison workshop running all year.",
            "cta_label": "Talk to James",
            "primary": false
          }
        },
        "backer-investec": {
          "type": "backer",
          "settings": {
            "name": "Investec",
            "detail": "Beyond Business 2025 — £24,000, chosen from 148 applicants"
          }
        },
        "backer-lsbu": {
          "type": "backer",
          "settings": {
            "name": "London South Bank University",
            "detail": "Engineering lab access, 2025"
          }
        },
        "backer-ft": {
          "type": "backer",
          "settings": {
            "name": "Financial Times",
            "detail": "\"How Bamboo Bicycle Club is helping to break the prison cycle\" — Sept 2025"
          }
        }
      },
