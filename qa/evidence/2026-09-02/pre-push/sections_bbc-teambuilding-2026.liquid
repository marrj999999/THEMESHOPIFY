{%- comment -%} in-page anchor fix 2026-08-19: root overflow-x clip + smooth scroll no-ops
   same-document hash jumps in Chromium, so every #anchor click silently failed. Delegated
   handler scrolls explicitly; reduced-motion gets an instant jump. {%- endcomment -%}
<script>
  (function(){
    if (window.__bbcAnchorFix) return; window.__bbcAnchorFix = 1;
    document.addEventListener('click', function(e){
      var a = e.target.closest('a[href^="#"]');
      if (!a || a.getAttribute('href').length < 2) return;
      var el = document.getElementById(a.getAttribute('href').slice(1));
      if (!el) return;
      e.preventDefault();
      history.pushState(null, '', a.getAttribute('href'));
      window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 64, left: 0, behavior: 'instant' });
    });
  })();
</script>

{% stylesheet %}
  /* chapter pills — estate jump-nav (2026-08-19) */
  .rd-tbchap-wrap{position:sticky;top:0;z-index:90}
  .rd-tbchap{background:rgba(230,220,200,.96);border-bottom:1.5px solid rgba(14,26,23,.14);display:flex;gap:10px;flex-wrap:nowrap;overflow-x:auto;scrollbar-width:none;padding:10px 24px;justify-content:center}
  .rd-tbchap::-webkit-scrollbar{display:none}
  .rd-tbchap a{flex:none;font-size:14px;font-weight:800;letter-spacing:.02em;text-transform:lowercase;padding:7px 16px;border:2px solid currentColor;border-radius:999px;color:#2A332F;text-decoration:none !important;background:transparent}
  .rd-tbchap a:hover,.rd-tbchap a:focus-visible{background:#D4FD62;border-color:#0E1A17;color:#003C32}
  @media (prefers-reduced-motion: no-preference){ .rd-tbchap a{transition:background .15s cubic-bezier(.2,.7,.2,1),color .15s cubic-bezier(.2,.7,.2,1)} }
  #days,#how,#stories,#faq,#team-enquiry{scroll-margin-top:64px}
  @media (max-width:749px){ .rd-tbchap{padding:8px 14px;gap:8px;justify-content:flex-start} .rd-tbchap a{font-size:12.5px;padding:6px 13px} }
  /* phone film height, THIS page only (2026-08-24). The shared family rule in
     bbc-align gives the stacked hero film 32svh, which fits impact and why-bamboo -
     but this hero's headline runs THREE lines and its lede four, so at 390x844 the
     secondary CTA landed 11px under the fold (measured: 855 vs 844). 28svh buys the
     ~34px back: primary ~759, secondary ~821, both above the fold. [class] bump
     because the shared rule is (0,4,0)+!important in a LATER stylesheet - this
     section bundle loads first, so it must win on specificity, (0,5,0). */
  @media (max-width:749px){ .bbc-rd.bbc-rd-tb .rd-hero > .rd-bg[class]{height:clamp(190px,28svh,340px)!important} }
{% endstylesheet %}

{% javascript %}
/* Team-building hero film. Same hardened pattern as impact/why-bamboo: play() can
   resolve while still paused at t=0, so start on `canplay` and reveal only on
   `playing`. Gates (reduced-motion / phones / save-data) leave the photo in place. */
(function () {
  var v = document.querySelector('.bbc-rd-tb .rd-hero .imp-film');
  if (!v) return;
  if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  /* phone gate removed 2026-08-24 - James: hero films must play on mobile too */
  var conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
  if (conn && (conn.saveData || /(^|-)2g$/.test(conn.effectiveType || ''))) return;
  v.muted = true; v.defaultMuted = true;
  function start() {
    var p = v.play();
    if (p && p.catch) p.catch(function () { /* autoplay refused - photo stays */ });
  }
  v.addEventListener('playing', function () { v.classList.add('is-on'); }, { once: true });
  v.setAttribute('preload', 'auto');
  v.load();
  if (v.readyState >= 3) start();
  else v.addEventListener('canplay', start, { once: true });
  document.addEventListener('visibilitychange', function () {
    if (document.hidden) { v.pause(); }
    else if (v.classList.contains('is-on')) { start(); }
  });
})();
{% endjavascript %}

