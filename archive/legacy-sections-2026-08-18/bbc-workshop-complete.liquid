{% comment %}
  BBC Workshop Complete — Full workshop page with images
  
  Hardcoded content to bypass Shopify block caching issues.
  Includes image placeholders with visual strategy guidance.
{% endcomment %}

<div class="bbc-workshop-page">
  
  {%- comment -%} HERO SECTION WITH BACKGROUND IMAGE {%- endcomment -%}
  <section class="bbc-workshop-hero" {% if section.settings.hero_image %}style="background-image: url('{{ section.settings.hero_image | image_url: width: 1920 }}');"{% endif %}>
    <div class="bbc-workshop-hero__overlay"></div>
    <div class="bbc-workshop-hero__content page-width">
      <span class="bbc-workshop-hero__eyebrow">{{ section.settings.hero_eyebrow | default: 'Hands-On Experience' }}</span>
      <h1 class="bbc-workshop-hero__title">{{ section.settings.hero_title | default: 'Build Your Own Bamboo Bicycle' }}</h1>
      <p class="bbc-workshop-hero__subtitle">{{ section.settings.hero_subtitle | default: "2-3 days. Expert guidance. A frame that's truly yours." }}</p>
      <div class="bbc-workshop-hero__cta">
        <a href="#booking" class="bbc-btn bbc-btn--primary bbc-btn--lg">Book a Workshop</a>
        <a href="#experience" class="bbc-btn bbc-btn--outline bbc-btn--lg">See How It Works</a>
      </div>
    </div>
  </section>

  {%- comment -%} TRUST BAR {%- endcomment -%}
  <section class="bbc-workshop-trust">
    <div class="page-width">
      <div class="bbc-workshop-trust__grid">
        <div class="bbc-workshop-trust__item">
          <span class="bbc-workshop-trust__number">4,000+</span>
          <span class="bbc-workshop-trust__label">Bikes Built</span>
        </div>
        <div class="bbc-workshop-trust__item">
          <span class="bbc-workshop-trust__number">13</span>
          <span class="bbc-workshop-trust__label">Years Experience</span>
        </div>
        <div class="bbc-workshop-trust__item">
          <span class="bbc-workshop-trust__number">3</span>
          <span class="bbc-workshop-trust__label">Workshop Locations</span>
        </div>
        <div class="bbc-workshop-trust__item">
          <span class="bbc-workshop-trust__number">95%</span>
          <span class="bbc-workshop-trust__label">First-Time Builders</span>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} INTRO WITH SIDE IMAGE {%- endcomment -%}
  <section class="bbc-workshop-intro">
    <div class="page-width">
      <div class="bbc-workshop-intro__grid">
        <div class="bbc-workshop-intro__content">
          <h2 class="bbc-workshop-intro__heading">{{ section.settings.intro_heading | default: 'No Experience? No Problem.' }}</h2>
          <p class="bbc-workshop-intro__text">{{ section.settings.intro_text | default: "Since 2012, we've taught thousands of people — most with zero framebuilding experience — to create their own bamboo bicycles. Our workshops are designed for complete beginners. If you can hold a tool, you can build a bike." }}</p>
          <ul class="bbc-workshop-intro__highlights">
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 20 %} Small groups (max 6 builders)</li>
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 20 %} Expert guidance every step</li>
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 20 %} Take home a rideable frame</li>
          </ul>
        </div>
        <div class="bbc-workshop-intro__image">
          {% if section.settings.intro_image %}
            {{ section.settings.intro_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'Workshop participant building' }}
          {% else %}
            <div class="bbc-placeholder bbc-placeholder--green">
              <span class="bbc-placeholder__icon">{% render 'bbc-icons', icon: 'person', size: 48 %}</span>
              <span class="bbc-placeholder__text">Participant learning to build</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} THE EXPERIENCE - DAY BY DAY WITH IMAGES {%- endcomment -%}
  <section class="bbc-workshop-experience" id="experience">
    <div class="page-width">
      <header class="bbc-workshop-experience__header">
        <span class="bbc-section-eyebrow">The Workshop Experience</span>
        <h2 class="bbc-section-heading">What Happens Over 2-3 Days</h2>
        <p class="bbc-section-subheading">From raw bamboo to finished frame — here's your journey</p>
      </header>
      
      <div class="bbc-workshop-days">
        {%- comment -%} DAY 1 {%- endcomment -%}
        <div class="bbc-workshop-day">
          <div class="bbc-workshop-day__image">
            {% if section.settings.day1_image %}
              {{ section.settings.day1_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'Day 1: Design and setup' }}
            {% else %}
              <div class="bbc-placeholder bbc-placeholder--blue">
                <span class="bbc-placeholder__icon">{% render 'bbc-icons', icon: 'straighten', size: 40 %}</span>
                <span class="bbc-placeholder__text">Geometry setup in jig</span>
              </div>
            {% endif %}
          </div>
          <div class="bbc-workshop-day__content">
            <div class="bbc-workshop-day__number">1</div>
            <h3 class="bbc-workshop-day__title">{{ section.settings.day1_title | default: 'Design & Setup' }}</h3>
            <ul class="bbc-workshop-day__list">
              <li>Custom geometry consultation based on your riding style</li>
              <li>Select your bamboo tubes from our sustainably-sourced stock</li>
              <li>Set up your frame in our precision jig system</li>
              <li>Learn tube mitering and preparation techniques</li>
            </ul>
            <p class="bbc-workshop-day__duration">
              {% render 'bbc-icons', icon: 'timer', size: 16 %} Approx 6-8 hours
            </p>
          </div>
        </div>
        
        {%- comment -%} DAY 2 {%- endcomment -%}
        <div class="bbc-workshop-day bbc-workshop-day--reverse">
          <div class="bbc-workshop-day__image">
            {% if section.settings.day2_image %}
              {{ section.settings.day2_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'Day 2: Building joints' }}
            {% else %}
              <div class="bbc-placeholder bbc-placeholder--green">
                <span class="bbc-placeholder__icon">{% render 'bbc-icons', icon: 'handyman', size: 40 %}</span>
                <span class="bbc-placeholder__text">Wrapping joints with fiber</span>
              </div>
            {% endif %}
          </div>
          <div class="bbc-workshop-day__content">
            <div class="bbc-workshop-day__number">2</div>
            <h3 class="bbc-workshop-day__title">{{ section.settings.day2_title | default: 'Building & Joining' }}</h3>
            <ul class="bbc-workshop-day__list">
              <li>Heat treat bamboo joints for strength</li>
              <li>Wrap joints with natural fibers and epoxy</li>
              <li>Learn the BBC lug system for perfect alignment</li>
              <li>Build bottom bracket and headtube assemblies</li>
            </ul>
            <p class="bbc-workshop-day__duration">
              {% render 'bbc-icons', icon: 'timer', size: 16 %} Approx 8-10 hours
            </p>
          </div>
        </div>
        
        {%- comment -%} DAY 3 {%- endcomment -%}
        <div class="bbc-workshop-day">
          <div class="bbc-workshop-day__image">
            {% if section.settings.day3_image %}
              {{ section.settings.day3_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: 'Day 3: Finishing' }}
            {% else %}
              <div class="bbc-placeholder bbc-placeholder--gold">
                <span class="bbc-placeholder__icon">{% render 'bbc-icons', icon: 'celebration', size: 40 %}</span>
                <span class="bbc-placeholder__text">Proud builder with finished frame</span>
              </div>
            {% endif %}
          </div>
          <div class="bbc-workshop-day__content">
            <div class="bbc-workshop-day__number">3</div>
            <h3 class="bbc-workshop-day__title">{{ section.settings.day3_title | default: 'Finishing & Completion' }}</h3>
            <ul class="bbc-workshop-day__list">
              <li>Final wrapping and joint finishing</li>
              <li>Sand and prep for clear coat</li>
              <li>Apply protective finish</li>
              <li>Final inspection and celebration!</li>
            </ul>
            <p class="bbc-workshop-day__duration">
              {% render 'bbc-icons', icon: 'timer', size: 16 %} Approx 4-6 hours
            </p>
          </div>
        </div>
      </div>
      
      <p class="bbc-workshop-experience__note">
        {% render 'bbc-icons', icon: 'info', size: 20 %}
        <span>Build times vary by frame type. Road frames typically complete in 2 days. MTB and complex geometries may need 3 days.</span>
      </p>
    </div>
  </section>

  {%- comment -%} GALLERY SECTION {%- endcomment -%}
  <section class="bbc-workshop-gallery">
    <div class="page-width">
      <header class="bbc-workshop-gallery__header">
        <span class="bbc-section-eyebrow">The Results</span>
        <h2 class="bbc-section-heading">Workshop Builds</h2>
        <p class="bbc-section-subheading">Frames built by first-time builders just like you</p>
      </header>
      
      <div class="bbc-workshop-gallery__grid">
        {% for i in (1..6) %}
          {% assign img_key = 'gallery_image_' | append: i %}
          {% if section.settings[img_key] %}
            <div class="bbc-workshop-gallery__item">
              {{ section.settings[img_key] | image_url: width: 400 | image_tag: loading: 'lazy', alt: 'Workshop build gallery' }}
            </div>
          {% else %}
            <div class="bbc-workshop-gallery__item">
              <div class="bbc-placeholder bbc-placeholder--light">
                <span class="bbc-placeholder__icon">{% render 'bbc-icons', icon: 'pedal_bike', size: 32 %}</span>
                <span class="bbc-placeholder__text">Gallery {{ i }}</span>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      
      <div class="bbc-workshop-gallery__cta">
        <a href="https://instagram.com/bamboobicycleclub" target="_blank" rel="noopener" class="bbc-link">
          See more on Instagram →
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} VIDEO SECTION — only shows when video_url is set {%- endcomment -%}
  {% if section.settings.video_url != blank %}
  <section class="bbc-workshop-video">
    <div class="page-width">
      <header class="bbc-workshop-video__header">
        <h2 class="bbc-section-heading">See the Workshop in Action</h2>
      </header>
      <div class="bbc-workshop-video__wrapper">
        {% assign video_id = section.settings.video_url | split: 'v=' | last | split: '&' | first %}
        {% if section.settings.video_url contains 'youtu.be' %}
          {% assign video_id = section.settings.video_url | split: 'youtu.be/' | last | split: '?' | first %}
        {% endif %}
        <iframe 
          src="https://www.youtube.com/embed/{{ video_id }}" 
          title="BBC Workshop Experience"
          frameborder="0" 
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" 
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>
    </div>
  </section>
  {% endif %}

  {%- comment -%} WHAT'S INCLUDED {%- endcomment -%}
  <section class="bbc-workshop-included">
    <div class="page-width">
      <header class="bbc-workshop-included__header">
        <span class="bbc-section-eyebrow">Everything You Need</span>
        <h2 class="bbc-section-heading">What's Included</h2>
      </header>
      
      <div class="bbc-workshop-included__grid">
        <div class="bbc-workshop-included__item">
          <div class="bbc-workshop-included__icon">{% render 'bbc-icons', icon: 'inventory', size: 32 %}</div>
          <h3>Complete Frame Kit</h3>
          <p>All bamboo tubes, lugs, dropouts, and materials needed to build your frame</p>
        </div>
        <div class="bbc-workshop-included__item">
          <div class="bbc-workshop-included__icon">{% render 'bbc-icons', icon: 'support_agent', size: 32 %}</div>
          <h3>Expert Guidance</h3>
          <p>Step-by-step instruction from experienced frame builders (max 6 per session)</p>
        </div>
        <div class="bbc-workshop-included__item">
          <div class="bbc-workshop-included__icon">{% render 'bbc-icons', icon: 'build', size: 32 %}</div>
          <h3>Professional Tools</h3>
          <p>Access to all tools, jigs, and equipment — nothing to buy or bring</p>
        </div>
        <div class="bbc-workshop-included__item">
          <div class="bbc-workshop-included__icon">{% render 'bbc-icons', icon: 'restaurant', size: 32 %}</div>
          <h3>Lunch & Refreshments</h3>
          <p>Tea, coffee, snacks, and lunch provided throughout your build days</p>
        </div>
        <div class="bbc-workshop-included__item">
          <div class="bbc-workshop-included__icon">{% render 'bbc-icons', icon: 'groups', size: 32 %}</div>
          <h3>Community Access</h3>
          <p>Join our global builder community for ongoing support and inspiration</p>
        </div>
        <div class="bbc-workshop-included__item">
          <div class="bbc-workshop-included__icon">{% render 'bbc-icons', icon: 'play_circle', size: 32 %}</div>
          <h3>Video Tutorials</h3>
          <p>Full access to our tutorial library for component assembly and maintenance</p>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} TESTIMONIALS WITH IMAGES {%- endcomment -%}
  <section class="bbc-workshop-testimonials">
    <div class="page-width">
      <header class="bbc-workshop-testimonials__header">
        <span class="bbc-section-eyebrow">Builder Stories</span>
        <h2 class="bbc-section-heading">What Our Workshop Graduates Say</h2>
      </header>
      
      <div class="bbc-workshop-testimonials__grid">
        <blockquote class="bbc-workshop-testimonial">
          <div class="bbc-workshop-testimonial__image">
            {% if section.settings.testimonial_1_image %}
              {{ section.settings.testimonial_1_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: section.settings.testimonial_1_name }}
            {% else %}
              <div class="bbc-placeholder bbc-placeholder--avatar">
                {% render 'bbc-icons', icon: 'person', size: 32 %}
              </div>
            {% endif %}
          </div>
          <p class="bbc-workshop-testimonial__quote">"{{ section.settings.testimonial_1_quote | default: "An incredible experience. I came with zero framebuilding experience and left with a bike I'm genuinely proud of. The instructors were patient, knowledgeable, and clearly passionate." }}"</p>
          <footer class="bbc-workshop-testimonial__footer">
            <strong>{{ section.settings.testimonial_1_name | default: 'Workshop Participant' }}</strong>
            <span>{{ section.settings.testimonial_1_detail | default: 'First-time builder, London' }}</span>
          </footer>
        </blockquote>
        
        <blockquote class="bbc-workshop-testimonial">
          <div class="bbc-workshop-testimonial__image">
            {% if section.settings.testimonial_2_image %}
              {{ section.settings.testimonial_2_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: section.settings.testimonial_2_name }}
            {% else %}
              <div class="bbc-placeholder bbc-placeholder--avatar">
                {% render 'bbc-icons', icon: 'person', size: 32 %}
              </div>
            {% endif %}
          </div>
          <p class="bbc-workshop-testimonial__quote">"{{ section.settings.testimonial_2_quote | default: "Best birthday present I ever gave myself. Two days of pure focus and creativity. Now I ride past bike shops and think I made something better than anything in there." }}"</p>
          <footer class="bbc-workshop-testimonial__footer">
            <strong>{{ section.settings.testimonial_2_name | default: 'Marcus' }}</strong>
            <span>{{ section.settings.testimonial_2_detail | default: 'Gravel build, Netherlands' }}</span>
          </footer>
        </blockquote>
        
        <blockquote class="bbc-workshop-testimonial">
          <div class="bbc-workshop-testimonial__image">
            {% if section.settings.testimonial_3_image %}
              {{ section.settings.testimonial_3_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: section.settings.testimonial_3_name }}
            {% else %}
              <div class="bbc-placeholder bbc-placeholder--avatar">
                {% render 'bbc-icons', icon: 'person', size: 32 %}
              </div>
            {% endif %}
          </div>
          <p class="bbc-workshop-testimonial__quote">"{{ section.settings.testimonial_3_quote | default: "The small group size meant we got loads of individual attention. James and the team were brilliant at explaining the why, not just the how." }}"</p>
          <footer class="bbc-workshop-testimonial__footer">
            <strong>{{ section.settings.testimonial_3_name | default: 'Sarah' }}</strong>
            <span>{{ section.settings.testimonial_3_detail | default: 'Road bike build, Bristol' }}</span>
          </footer>
        </blockquote>
      </div>
    </div>
  </section>

  {%- comment -%} LOCATIONS WITH IMAGES {%- endcomment -%}
  <section class="bbc-workshop-locations">
    <div class="page-width">
      <header class="bbc-workshop-locations__header">
        <span class="bbc-section-eyebrow">Where We Build</span>
        <h2 class="bbc-section-heading">Workshop Locations</h2>
      </header>
      
      <div class="bbc-workshop-locations__grid">
        <div class="bbc-workshop-location">
          <div class="bbc-workshop-location__image">
            {% if section.settings.london_image %}
              {{ section.settings.london_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: 'London workshop' }}
            {% else %}
              <div class="bbc-placeholder bbc-placeholder--location">
                {% render 'bbc-icons', icon: 'location_on', size: 32 %}
                <span>London</span>
              </div>
            {% endif %}
          </div>
          <h3>London, UK</h3>
          <p>Our original workshop in East London. The heart of Bamboo Bicycle Club since 2012.</p>
          <span class="bbc-workshop-location__address">Hackney, London E8</span>
          <a href="#booking" class="bbc-workshop-location__link">Book London →</a>
        </div>
        
        <div class="bbc-workshop-location">
          <div class="bbc-workshop-location__image">
            {% if section.settings.amersfoort_image %}
              {{ section.settings.amersfoort_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: 'Amersfoort workshop' }}
            {% else %}
              <div class="bbc-placeholder bbc-placeholder--location">
                {% render 'bbc-icons', icon: 'location_on', size: 32 %}
                <span>Amersfoort</span>
              </div>
            {% endif %}
          </div>
          <h3>Amersfoort, Netherlands</h3>
          <p>Our European hub serving the Netherlands, Belgium, and Germany.</p>
          <span class="bbc-workshop-location__address">Amersfoort, NL</span>
          <a href="#booking" class="bbc-workshop-location__link">Book Amersfoort →</a>
        </div>
        
        <div class="bbc-workshop-location">
          <div class="bbc-workshop-location__image">
            {% if section.settings.toulouse_image %}
              {{ section.settings.toulouse_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: 'Toulouse workshop' }}
            {% else %}
              <div class="bbc-placeholder bbc-placeholder--location">
                {% render 'bbc-icons', icon: 'location_on', size: 32 %}
                <span>Toulouse</span>
              </div>
            {% endif %}
          </div>
          <h3>Toulouse, France</h3>
          <p>Our newest location serving southern France and Spain.</p>
          <span class="bbc-workshop-location__address">Toulouse, France</span>
          <a href="/pages/toulouse-workshop" class="bbc-workshop-location__link">Book Toulouse →</a>
        </div>
      </div>
    </div>
  </section>

  {%- comment -%} PRICING {%- endcomment -%}
  <section class="bbc-workshop-pricing" id="booking">
    <div class="page-width">
      <header class="bbc-workshop-pricing__header">
        <span class="bbc-section-eyebrow">Book Your Build</span>
        <h2 class="bbc-section-heading">Workshop Options</h2>
        <p class="bbc-section-subheading">Choose your frame type. All include complete materials and expert guidance.</p>
      </header>
      
      <div class="bbc-workshop-pricing__grid">
        <div class="bbc-workshop-option">
          <h3>Road Frame</h3>
          <div class="bbc-workshop-option__price">£500</div>
          <ul class="bbc-workshop-option__features">
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 16 %} 2-day workshop</li>
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 16 %} Lightweight road geometry</li>
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 16 %} All materials included</li>
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 16 %} Lunch & refreshments</li>
          </ul>
          <a href="{{ section.settings.road_booking_url | default: '/products/road-frame-workshop' }}" class="bbc-btn bbc-btn--primary">Check Availability</a>
        </div>
        
        <div class="bbc-workshop-option bbc-workshop-option--featured">
          <span class="bbc-workshop-option__badge">Most Popular</span>
          <h3>Gravel / Adventure</h3>
          <div class="bbc-workshop-option__price">£550</div>
          <ul class="bbc-workshop-option__features">
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 16 %} 2-3 day workshop</li>
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 16 %} Versatile adventure geometry</li>
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 16 %} Disc brake compatible</li>
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 16 %} All materials included</li>
          </ul>
          <a href="{{ section.settings.gravel_booking_url | default: '/products/gravel-frame-workshop' }}" class="bbc-btn bbc-btn--primary">Check Availability</a>
        </div>
        
        <div class="bbc-workshop-option">
          <h3>Hardtail MTB</h3>
          <div class="bbc-workshop-option__price">£595</div>
          <ul class="bbc-workshop-option__features">
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 16 %} 3-day workshop</li>
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 16 %} Trail-ready geometry</li>
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 16 %} Disc brake compatible</li>
            <li>{% render 'bbc-icons', icon: 'check_circle', size: 16 %} Boost or standard spacing</li>
          </ul>
          <a href="{{ section.settings.mtb_booking_url | default: '/products/mtb-frame-workshop' }}" class="bbc-btn bbc-btn--primary">Check Availability</a>
        </div>
      </div>
      
      <div class="bbc-workshop-pricing__note">
        <p>
          {% render 'bbc-icons', icon: 'pedal_bike', size: 20 %}
          <strong>Cycle to Work Accepted</strong> — Save 25-39% through your employer's scheme. We're registered with all major providers.
        </p>
      </div>
    </div>
  </section>

  {%- comment -%} FAQ {%- endcomment -%}
  <section class="bbc-workshop-faq">
    <div class="page-width">
      <header class="bbc-workshop-faq__header">
        <span class="bbc-section-eyebrow">Common Questions</span>
        <h2 class="bbc-section-heading">Workshop FAQ</h2>
      </header>
      
      <div class="bbc-workshop-faq__grid">
        <details class="bbc-workshop-faq__item">
          <summary>Do I need any experience?</summary>
          <p>None at all. 95% of our workshop participants have never built anything like this before. We guide you through every step, from selecting your bamboo to the final finish.</p>
        </details>
        
        <details class="bbc-workshop-faq__item">
          <summary>What should I bring?</summary>
          <p>Just yourself and old clothes you don't mind getting epoxy on. We provide everything else — tools, materials, safety equipment, lunch, tea and coffee.</p>
        </details>
        
        <details class="bbc-workshop-faq__item">
          <summary>Can I bring a friend?</summary>
          <p>Absolutely! Many people book with partners or friends. Building together is a great experience. Group discounts available for 3+ bookings.</p>
        </details>
        
        <details class="bbc-workshop-faq__item">
          <summary>Can I use Cycle to Work?</summary>
          <p>Yes! We're registered with all major Cycle to Work providers including Cyclescheme, Cycle Solutions, and Bike2Work. You can typically save 25-39%.</p>
        </details>
        
        <details class="bbc-workshop-faq__item">
          <summary>How do I get my frame home?</summary>
          <p>Most people carry their frame on public transport or in a car boot. We can also arrange courier shipping (additional cost) if you're traveling from further away.</p>
        </details>
        
        <details class="bbc-workshop-faq__item">
          <summary>What about components?</summary>
          <p>The workshop produces a complete frame ready for components. We can advise on component choices, and sell complete groupset packages separately.</p>
        </details>
        
        <details class="bbc-workshop-faq__item">
          <summary>How long will the frame last?</summary>
          <p>With proper care, bamboo frames ride for 8-12+ years. We've had frames from our earliest workshops still going strong. Our support doesn't end when you leave.</p>
        </details>
        
        <details class="bbc-workshop-faq__item">
          <summary>What's your cancellation policy?</summary>
          <p>Full refund if cancelled 14+ days before. 50% refund or date transfer 7-13 days before. No refund within 7 days, but you can transfer your booking to someone else.</p>
        </details>
      </div>
    </div>
  </section>

