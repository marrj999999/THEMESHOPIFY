  .bbc-workshop-pricing__note {
    max-width: 600px;
    margin: 40px auto 0;
    background: var(--bbc-white);
    padding: 20px 24px;
    border-left: 4px solid var(--bbc-gold);
  }
  
  .bbc-workshop-pricing__note p {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: 0.9375rem;
    color: var(--bbc-steel);
  }
  
  @media (max-width: 900px) {
    .bbc-workshop-pricing__grid { grid-template-columns: 1fr; max-width: 400px; }
  }
  
  /* ===== FAQ ===== */
  .bbc-workshop-faq {
    padding: 100px 20px;
    background: var(--bbc-white);
  }
  
  .bbc-workshop-faq__header {
    text-align: center;
    margin-bottom: 60px;
  }
  
  .bbc-workshop-faq__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    max-width: 900px;
    margin: 0 auto;
  }
  
  .bbc-workshop-faq__item {
    background: var(--bbc-cream);
  }
  
  .bbc-workshop-faq__item summary {
    padding: 20px 24px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--bbc-forest);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .bbc-workshop-faq__item summary::-webkit-details-marker { display: none; }
  
  .bbc-workshop-faq__item summary::after {
    content: '+';
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--bbc-teal);
    transition: transform 0.2s ease;
  }
  
  .bbc-workshop-faq__item[open] summary::after { transform: rotate(45deg); }
  
  .bbc-workshop-faq__item p {
    padding: 0 24px 20px;
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--bbc-steel);
    margin: 0;
  }
  
  @media (max-width: 768px) {
    .bbc-workshop-faq__grid { grid-template-columns: 1fr; }
  }
  
  /* ===== PRESS ===== */
  .bbc-workshop-press {
    padding: 60px 20px;
    background: var(--bbc-cream);
    text-align: center;
  }
  
  .bbc-workshop-press__label {
    font-size: 0.8125rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--bbc-steel);
    margin: 0 0 24px 0;
  }
  
  .bbc-workshop-press__logos {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 48px;
    flex-wrap: wrap;
    opacity: 0.6;
  }
  
  .bbc-workshop-press__logos svg { height: 32px; width: auto; }
  
  /* ===== CONTACT CTA ===== */
  .bbc-workshop-contact {
    padding: 80px 20px;
    background: var(--bbc-forest);
  }
  
  .bbc-workshop-contact__content {
    max-width: 600px;
    margin: 0 auto;
    text-align: center;
  }
  
  .bbc-workshop-contact__content h2 {
    font-family: var(--font-heading-family);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--bbc-white);
    margin: 0 0 12px 0;
  }
  
  .bbc-workshop-contact__content p {
    font-size: 1rem;
    color: rgba(255,255,255,0.8);
    margin: 0 0 24px 0;
  }
  
  .bbc-workshop-contact__buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .bbc-workshop-contact__buttons .bbc-btn--primary {
    background: var(--bbc-gold);
    border-color: var(--bbc-gold);
    color: var(--bbc-forest);
  }
  
  .bbc-workshop-contact__buttons .bbc-btn--primary:hover {
    background: var(--bbc-white);
    border-color: var(--bbc-white);
  }
  
  .bbc-workshop-contact__buttons .bbc-btn--outline {
    color: var(--bbc-white);
    border-color: var(--bbc-white);
  }
  
  .bbc-workshop-contact__buttons .bbc-btn--outline:hover {
    background: var(--bbc-white);
    color: var(--bbc-forest);
  }
  
  /* ===== RESPONSIVE ===== */
  @media (max-width: 600px) {
    .bbc-workshop-hero { min-height: 60vh; }
    .bbc-workshop-hero__content { padding: 60px 16px; }
    .bbc-workshop-press__logos { gap: 24px; }
    .bbc-workshop-press__logos svg { height: 24px; }
  }
  
  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .bbc-btn,
    .bbc-workshop-gallery__item img,
    .bbc-workshop-faq__item summary::after {
      transition: none;
    }
    .bbc-workshop-gallery__item:hover img { transform: none; }
  }
</style>

