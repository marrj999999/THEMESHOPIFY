{% comment %}
  BBC Kit Reviews — Tag-Filtered Testimonials
  
  This section filters testimonials based on product tags.
  If product has tag "road", shows road-specific reviews.
  If product has tag "gravel", shows gravel-specific reviews.
  Falls back to generic reviews if no matching tag found.
  
  Usage: Add to product.kit-*.json templates
{% endcomment %}

{%- liquid
  assign bike_type = ''
  assign has_matching_reviews = false
  
  if product.tags contains 'road'
    assign bike_type = 'road'
  elsif product.tags contains 'Gravel' or product.tags contains 'gravel'
    assign bike_type = 'gravel'
  elsif product.tags contains 'MTB' or product.tags contains 'mtb'
    assign bike_type = 'mtb'
  elsif product.tags contains 'City' or product.tags contains 'city'
    assign bike_type = 'city'
  elsif product.tags contains 'fatbike' or product.tags contains 'fat'
    assign bike_type = 'fatbike'
  elsif product.tags contains 'balance' or product.tags contains 'kids'
    assign bike_type = 'balance'
  elsif product.tags contains 'custom'
    assign bike_type = 'custom'
  endif
-%}

<section class="bbc-kit-reviews">
  <div class="bbc-kit-reviews__container page-width">
    <header class="bbc-kit-reviews__header">
      <span class="bbc-kit-reviews__eyebrow">{{ section.settings.eyebrow | default: 'Testimonials' }}</span>
      <h2 class="bbc-kit-reviews__heading">
        {% case bike_type %}
          {% when 'road' %}
            What Road Bike Builders Say
          {% when 'gravel' %}
            What Gravel Bike Builders Say
          {% when 'mtb' %}
            What Mountain Bike Builders Say
          {% when 'city' %}
            What City Bike Builders Say
          {% when 'fatbike' %}
            What Fat Bike Builders Say
          {% when 'balance' %}
            What Parents Say
          {% when 'custom' %}
            What Custom Frame Builders Say
          {% else %}
            What Builders Say
        {% endcase %}
      </h2>
      <p class="bbc-kit-reviews__subheading">{{ section.settings.subheading | default: 'Real feedback from home kit builders' }}</p>
    </header>
    
    <div class="bbc-kit-reviews__grid">
      {%- comment -%} ROAD BIKE REVIEWS {%- endcomment -%}
