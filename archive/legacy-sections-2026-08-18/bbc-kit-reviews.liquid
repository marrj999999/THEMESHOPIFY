            <cite class="bbc-kit-review__name">Louise</cite>
            <span class="bbc-kit-review__role">Road Bike Builder</span>
            <span class="bbc-kit-review__location">UK</span>
          </footer>
        </article>
      
      {%- comment -%} GRAVEL BIKE REVIEWS {%- endcomment -%}
      {% elsif bike_type == 'gravel' %}
