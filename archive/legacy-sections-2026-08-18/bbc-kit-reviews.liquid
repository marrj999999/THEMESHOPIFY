            <cite class="bbc-kit-review__name">Jamie</cite>
            <span class="bbc-kit-review__role">Road Bike Builder</span>
            <span class="bbc-kit-review__location">Romania</span>
            <span class="bbc-kit-review__badge">{% render 'bbc-icons', icon: 'verified', size: 14 %} Verified Builder</span>
