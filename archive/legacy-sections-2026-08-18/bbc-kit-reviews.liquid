</section>

<style>
  .bbc-kit-reviews {
    padding: 60px 0;
    background: #f8f9fa;
  }
  
  .bbc-kit-reviews__container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
  }
  
  .bbc-kit-reviews__header {
    text-align: center;
    margin-bottom: 48px;
  }
  
  .bbc-kit-reviews__eyebrow {
    display: block;
    font-size: 0.6875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--bbc-teal, var(--bbc-teal));
    margin-bottom: 8px;
  }
  
  .bbc-kit-reviews__heading {
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--bbc-forest, var(--bbc-forest));
    margin: 0 0 8px 0;
  }
  
  .bbc-kit-reviews__subheading {
    font-size: 1rem;
    color: var(--bbc-gray-600);
    margin: 0;
  }
  
  .bbc-kit-reviews__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }
  
  .bbc-kit-review {
    background: var(--bbc-white);
    padding: 32px;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    position: relative;
  }
  
  .bbc-kit-review--featured {
    border-left: 4px solid var(--bbc-gold, var(--bbc-gold));
  }
  
  .bbc-kit-review__quote-mark {
    font-size: 4rem;
    font-weight: 700;
    color: var(--bbc-teal, var(--bbc-teal));
    opacity: 0.15;
    line-height: 1;
    position: absolute;
    top: 16px;
    left: 24px;
  }
  
  .bbc-kit-review__quote {
    font-size: 1rem;
    line-height: 1.6;
    color: var(--bbc-gray-900);
    margin: 0 0 24px 0;
    padding: 0;
    border: none;
    position: relative;
    z-index: 1;
  }
  
  .bbc-kit-review__author {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .bbc-kit-review__name {
    font-weight: 600;
    color: var(--bbc-forest, var(--bbc-forest));
    font-style: normal;
  }
  
  .bbc-kit-review__role {
    font-size: 0.875rem;
    color: var(--bbc-gray-600);
  }
  
  .bbc-kit-review__location {
    font-size: 0.875rem;
    color: #999;
  }
  
  .bbc-kit-review__badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--bbc-teal, var(--bbc-teal));
    margin-top: 8px;
  }
  
  .bbc-kit-reviews__footer {
    text-align: center;
    margin-top: 40px;
  }
  
  .bbc-kit-reviews__count {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--bbc-gray-600);
  }
  
  @media (max-width: 768px) {
    .bbc-kit-reviews {
      padding: 40px 0;
    }
    
    .bbc-kit-review {
      padding: 24px;
    }
  }
</style>

{% schema %}
{
  "name": "BBC Kit Reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Testimonials"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real feedback from home kit builders"
    }
  ],
  "presets": [
    {
      "name": "BBC Kit Reviews"
    }
  ]
}
{% endschema %}
