{{ 'bbc-why-bamboo.css' | asset_url | stylesheet_tag }}

<section class="bbc-wb-content-block {% if section.settings.layout == 'text_first' %}bbc-wb-content-block--reverse{% endif %} {% if section.settings.dark %}bbc-wb-content-block--dark{% endif %}"
  aria-labelledby="wb-block-{{ section.id }}">

  <div class="bbc-wb-content-block__image">
    {%- assign media = section.settings.media_type | default: 'image' -%}

    {%- if media == 'video' and section.settings.video_url != blank -%}
      <div class="bbc-wb-video-embed">
        {%- if section.settings.video_url.type == 'youtube' -%}
          <iframe
            src="https://www.youtube.com/embed/{{ section.settings.video_url.id }}?rel=0&modestbranding=1&color=white"
            title="{{ section.settings.heading | escape }}"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy">
          </iframe>
        {%- elsif section.settings.video_url.type == 'vimeo' -%}
          <iframe
            src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?title=0&byline=0&portrait=0&color=ffa900"
            title="{{ section.settings.heading | escape }}"
            frameborder="0"
            allow="autoplay; fullscreen; picture-in-picture"
            allowfullscreen
            loading="lazy">
          </iframe>
        {%- endif -%}
      </div>
    {%- elsif section.settings.image -%}
      {{ section.settings.image | image_url: width: 1200 | image_tag: loading: 'lazy', alt: section.settings.image_alt | default: section.settings.heading | escape }}
    {%- elsif section.settings.image_asset != blank -%}
      <img src="{{ section.settings.image_asset | asset_url }}" loading="lazy" alt="{{ section.settings.image_alt | default: section.settings.heading | escape }}">
    {%- else -%}
      <div class="bbc-wb-placeholder">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {%- endif -%}
  </div>

  <div class="bbc-wb-content-block__text">
    {%- if section.settings.eyebrow != blank -%}
      <p class="bbc-wb-content-block__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}

    <h2 id="wb-block-{{ section.id }}" class="bbc-wb-content-block__heading">
      {{ section.settings.heading }}
    </h2>

    <div class="bbc-wb-content-block__body">
      {{ section.settings.text }}
    </div>

    {%- if section.settings.button_text != blank or section.settings.button2_text != blank -%}
      <div class="bbc-wb-btn-row">
        {%- if section.settings.button_text != blank -%}
          {%- assign s1 = section.settings.btn1_style | default: 'link' -%}
          <a href="{{ section.settings.button_link }}" class="bbc-wb-btn bbc-wb-btn--{{ s1 }}">
            {{ section.settings.button_text }}
            {%- if s1 == 'link' -%}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.333 8h9.334M8.667 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endif -%}
          </a>
        {%- endif -%}
        {%- if section.settings.button2_text != blank -%}
          {%- assign s2 = section.settings.btn2_style | default: 'link' -%}
          <a href="{{ section.settings.button2_link }}" class="bbc-wb-btn bbc-wb-btn--{{ s2 }}">
            {{ section.settings.button2_text }}
            {%- if s2 == 'link' -%}
              <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3.333 8h9.334M8.667 4l4 4-4 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Content Block",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "Media type",
      "options": [
        { "value": "image", "label": "Image" },
        { "value": "video", "label": "Video (YouTube / Vimeo)" }
      ],
      "default": "image",
      "info": "Choose what to show on the media side of this block"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Or theme-asset image filename",
      "info": "Filename of an image in /assets (e.g. bbc-rd-detail.jpg). Used only if no Image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Describe the image for screen readers and SEO. Leave blank to use the heading."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Video URL",
      "accept": ["youtube", "vimeo"],
      "info": "Paste a YouTube or Vimeo link. Set media type to 'Video' above to display it."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Media position",
      "options": [
        { "value": "image_first", "label": "Media left, text right" },
        { "value": "text_first", "label": "Text left, media right" }
      ],
      "default": "image_first"
    },
    {
      "type": "checkbox",
      "id": "dark",
      "label": "Dark background",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text"
    },
    {
      "type": "header",
      "content": "Links"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button 1 text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button 1 URL"
    },
    {
      "type": "select",
      "id": "btn1_style",
      "label": "Button 1 style",
      "options": [
        { "value": "link",          "label": "↗ Text link (with arrow)" },
        { "value": "secondary",     "label": "■ Forest green — filled" },
        { "value": "primary",       "label": "■ Gold — filled" },
        { "value": "outline",       "label": "□ Outline green (light backgrounds)" },
        { "value": "outline-light", "label": "□ Outline white (dark backgrounds)" },
        { "value": "white",         "label": "■ White — filled (dark backgrounds)" }
      ],
      "default": "link",
      "info": "Choose how Button 1 looks. Use 'outline white' or 'white' on dark (forest) backgrounds."
    },
    {
      "type": "text",
      "id": "button2_text",
      "label": "Button 2 text (optional)"
    },
    {
      "type": "url",
      "id": "button2_link",
      "label": "Button 2 URL (optional)"
    },
    {
      "type": "select",
      "id": "btn2_style",
      "label": "Button 2 style",
      "options": [
        { "value": "link",          "label": "↗ Text link (with arrow)" },
        { "value": "secondary",     "label": "■ Forest green — filled" },
        { "value": "primary",       "label": "■ Gold — filled" },
        { "value": "outline",       "label": "□ Outline green (light backgrounds)" },
        { "value": "outline-light", "label": "□ Outline white (dark backgrounds)" },
        { "value": "white",         "label": "■ White — filled (dark backgrounds)" }
      ],
      "default": "link"
    }
  ],
  "presets": [
    {
      "name": "Content Block"
    }
  ]
}
{% endschema %}
