            "text": "15+ hours step-by-step on YouTube"
          }
        },
        {
          "type": "bonus",
          "settings": {
            "icon": "users",
            "badge": "Free",
            "badge_style": "green",
            "title": "Community Access",
            "text": "4,000+ builders worldwide"
          }
        },
        {
          "type": "bonus",
