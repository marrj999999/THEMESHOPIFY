    margin: 0 auto;
    text-align: center;
  }
  
  .bbc-workshop-contact__content h2 {
    font-family: var(--font-heading-family);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--bbc-white);
    margin: 0 0 12px 0;
  }
  
  .bbc-workshop-contact__content p {
    font-size: 1rem;
    color: rgba(255,255,255,0.8);
    margin: 0 0 24px 0;
  }
  
  .bbc-workshop-contact__buttons {
    display: flex;
    gap: 16px;
    justify-content: center;
    flex-wrap: wrap;
  }
  
  .bbc-workshop-contact__buttons .bbc-btn--primary {
    background: var(--bbc-gold);
    border-color: var(--bbc-gold);
    color: var(--bbc-forest);
  }
  
  .bbc-workshop-contact__buttons .bbc-btn--primary:hover {
    background: var(--bbc-white);
    border-color: var(--bbc-white);
  }
  
  .bbc-workshop-contact__buttons .bbc-btn--outline {
    color: var(--bbc-white);
    border-color: var(--bbc-white);
  }
  
  .bbc-workshop-contact__buttons .bbc-btn--outline:hover {
    background: var(--bbc-white);
    color: var(--bbc-forest);
  }
  
  /* ===== RESPONSIVE ===== */
  @media (max-width: 600px) {
    .bbc-workshop-hero { min-height: 60vh; }
    .bbc-workshop-hero__content { padding: 60px 16px; }
    .bbc-workshop-press__logos { gap: 24px; }
    .bbc-workshop-press__logos svg { height: 24px; }
  }
  
  /* Reduced motion */
  @media (prefers-reduced-motion: reduce) {
    .bbc-btn,
    .bbc-workshop-gallery__item img,
    .bbc-workshop-faq__item summary::after {
      transition: none;
    }
    .bbc-workshop-gallery__item:hover img { transform: none; }
  }
  
  /* Smooth scroll for anchor links */
  .bbc-workshop-page {
    scroll-behavior: smooth;
  }
</style>

<script>
  // Smooth scroll for internal anchor links
  document.querySelectorAll('.bbc-workshop-page a[href^="#"]').forEach(function(anchor) {
    anchor.addEventListener('click', function(e) {
      var target = document.querySelector(this.getAttribute('href'));
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });
</script>

