{% comment %}
  BBC Enhanced Collection Layout
  Improved spacing, typography, and customization for collection pages
{% endcomment %}

{{ 'bbc-collection-enhanced.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- unless section.settings.quick_add == 'none' -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endunless -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  .bbc-collection-enhanced .collection-filters {
    --filter-text-size: {{ section.settings.filter_text_size }}rem;
    --filter-spacing: {{ section.settings.filter_spacing }}px;
    --filter-border-radius: {{ section.settings.filter_border_radius }}px;
  }

  .bbc-collection-enhanced .product-grid {
    gap: {{ section.settings.product_grid_gap }}px;
  }

  @media screen and (max-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }
  }
{%- endstyle -%}

<div class="section-{{ section.id }}-padding color-{{ section.settings.color_scheme }} bbc-collection-enhanced">
  {%- paginate collection.products by section.settings.products_per_page -%}
    
    {%- if section.settings.show_collection_info -%}
      <div class="collection-info page-width">
        {%- if section.settings.collection_heading != blank -%}
          <h1 class="collection-title">{{ section.settings.collection_heading }}</h1>
        {%- elsif collection.title -%}
          <h1 class="collection-title">{{ collection.title }}</h1>
        {%- endif -%}
        
        {%- if section.settings.collection_description != blank -%}
          <div class="collection-description">
            {{ section.settings.collection_description }}
          </div>
        {%- elsif collection.description != blank -%}
          <div class="collection-description">
            {{ collection.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
      <div class="collection-filters page-width">
        <div class="collection-toolbar">
          
          {%- if section.settings.show_product_count -%}
            <div class="product-count">
              <span class="product-count__text">
                {%- if collection.products_count == collection.all_products_count -%}
                  {{- 'products.facets.product_count_simple' | t: count: collection.products_count -}}
                {%- else -%}
                  {{- 'products.facets.product_count' | t: product_count: collection.products_count, count: collection.all_products_count -}}
                {%- endif -%}
              </span>
            </div>
          {%- endif -%}

          {%- if section.settings.enable_sorting -%}
            <div class="collection-sort">
              <label for="SortBy-{{ section.id }}" class="sort-label">
                {{ section.settings.sort_label | default: 'Sort by:' }}
              </label>
              <div class="select-wrapper">
                <select
                  name="sort_by"
                  id="SortBy-{{ section.id }}"
                  class="collection-sort__select"
                  onchange="window.location.href=this.value"
                >
                  {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}
                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.url }}"
                      {% if option.value == sort_by %}selected="selected"{% endif %}
                    >
                      {{ option.name | escape }}
                    </option>
                  {%- endfor -%}
                </select>
                <span class="select-arrow">
                  <svg viewBox="0 0 10 6" aria-hidden="true">
                    <path d="M9 0L5 4L1 0" stroke="currentColor" stroke-width="1.5" fill="none"/>
                  </svg>
                </span>
              </div>
            </div>
          {%- endif -%}

        </div>

        {%- if section.settings.enable_filtering and collection.filters != empty -%}
          <div class="collection-filters__container">
            {%- if section.settings.show_filter_heading -%}
              <h3 class="filters-heading">
                {{ section.settings.filter_heading | default: 'Filter products' }}
              </h3>
            {%- endif -%}

            <div class="filters-list">
              {%- for filter in collection.filters -%}
                {%- case filter.type -%}
                  {%- when 'list', 'boolean' -%}
                    <details class="filter-group" {% if section.settings.open_first_filter and forloop.first %}open{% endif %}>
                      <summary class="filter-summary">
                        <span class="filter-name">{{ filter.label | escape }}</span>
                        {%- if filter.active_values.size > 0 -%}
                          <span class="filter-count">({{ filter.active_values.size }})</span>
                        {%- endif -%}
                        <span class="filter-toggle">
                          <svg viewBox="0 0 12 8" aria-hidden="true">
                            <path d="M10 1L6 5L2 1" stroke="currentColor" stroke-width="1.5" fill="none"/>
                          </svg>
                        </span>
                      </summary>
                      <div class="filter-options">
                        {%- for value in filter.values -%}
                          {%- if value.count > 0 or value.active -%}
                            <label class="filter-option">
                              <input
                                type="checkbox"
                                name="{{ value.param_name }}"
                                value="{{ value.value }}"
                                {% if value.active %}checked{% endif %}
                                onchange="window.location.href=this.checked ? '{{ value.url_to_add }}' : '{{ value.url_to_remove }}'"
                              >
                              <span class="filter-checkbox"></span>
                              <span class="filter-label">{{ value.label | escape }}</span>
                              <span class="filter-count">({{ value.count }})</span>
                            </label>
                          {%- endif -%}
                        {%- endfor -%}
                      </div>
                    </details>

                  {%- when 'price_range' -%}
                    <details class="filter-group filter-group--price">
                      <summary class="filter-summary">
                        <span class="filter-name">{{ filter.label | escape }}</span>
                        <span class="filter-toggle">
                          <svg viewBox="0 0 12 8" aria-hidden="true">
                            <path d="M10 1L6 5L2 1" stroke="currentColor" stroke-width="1.5" fill="none"/>
                          </svg>
                        </span>
                      </summary>
                      <div class="filter-options filter-options--price">
                        <div class="price-range-inputs">
                          <label for="Filter-Price-From-{{ section.id }}" class="visually-hidden">
                            {{ 'products.facets.from' | t }}
                          </label>
                          <input
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            id="Filter-Price-From-{{ section.id }}"
                            placeholder="{{ 'products.facets.from' | t }}"
                            value="{{ filter.min_value.value | default: '' }}"
                            min="0"
                            max="{{ filter.range_max }}"
                          >
                          <span class="price-range-separator">{{ 'products.facets.to' | t }}</span>
                          <label for="Filter-Price-To-{{ section.id }}" class="visually-hidden">
                            {{ 'products.facets.to' | t }}
                          </label>
                          <input
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            id="Filter-Price-To-{{ section.id }}"
                            placeholder="{{ 'products.facets.to' | t }}"
                            value="{{ filter.max_value.value | default: '' }}"
                            min="0"
                            max="{{ filter.range_max }}"
                          >
                        </div>
                        <button type="submit" class="price-range-apply button button--secondary">
                          {{ 'products.facets.apply' | t }}
                        </button>
                      </div>
                    </details>
                {%- endcase -%}
              {%- endfor -%}
            </div>

            {%- assign total_active_filters = 0 -%}
            {%- for filter in collection.filters -%}
              {%- assign total_active_filters = total_active_filters | plus: filter.active_values.size -%}
            {%- endfor -%}

            {%- if total_active_filters > 0 -%}
              <div class="active-filters">
                <span class="active-filters__label">{{ section.settings.active_filters_label | default: 'Active filters:' }}</span>
                {%- for filter in collection.filters -%}
                  {%- for value in filter.active_values -%}
                    <a href="{{ value.url_to_remove }}" class="active-filter">
                      {{ filter.label }}: {{ value.label }}
                      <span class="active-filter__remove" aria-label="{{ 'products.facets.clear_filter' | t }}">×</span>
                    </a>
                  {%- endfor -%}
                {%- endfor -%}
                <a href="{{ collection.url }}" class="clear-all-filters">
                  {{ section.settings.clear_all_label | default: 'Clear all' }}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="collection-products page-width">
      {%- if collection.products.size == 0 -%}
        <div class="collection-empty">
          <h2 class="collection-empty__title">{{ section.settings.empty_title | default: 'No products found' }}</h2>
          <p class="collection-empty__text">{{ section.settings.empty_text | default: 'Try adjusting your filters or search terms.' }}</p>
          {%- if total_active_filters > 0 -%}
            <a href="{{ collection.url }}" class="button button--primary">
              {{ section.settings.clear_filters_button | default: 'Clear all filters' }}
            </a>
          {%- endif -%}
        </div>
      {%- else -%}
        <div 
          class="product-grid grid grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
          {% if section.settings.enable_infinite_scroll %}
            data-infinite-scroll
          {% endif %}
        >
          {%- for product in collection.products -%}
            <div class="grid__item">
              {% render 'card-product',
                card_product: product,
                media_aspect_ratio: section.settings.image_ratio,
                image_shape: section.settings.image_shape,
                show_secondary_image: section.settings.show_secondary_image,
                show_vendor: section.settings.show_vendor,
                show_rating: section.settings.show_rating,
                lazy_load: forloop.index > 2,
                quick_add: section.settings.quick_add,
                section_id: section.id
              %}
            </div>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 and section.settings.enable_infinite_scroll == false -%}
          {% render 'pagination', paginate: paginate, anchor: '' %}
        {%- endif -%}
      {%- endif -%}
    </div>

  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "BBC Enhanced Collection",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Collection Information"
    },
    {
      "type": "checkbox",
      "id": "show_collection_info",
      "default": true,
      "label": "Show collection info"
    },
    {
      "type": "text",
      "id": "collection_heading",
      "label": "Custom heading",
      "info": "Leave blank to use collection title"
    },
    {
      "type": "richtext",
      "id": "collection_description",
      "label": "Custom description",
      "info": "Leave blank to use collection description"
    },
    {
      "type": "header",
      "content": "Product Grid"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 16,
      "label": "Products per page"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "Desktop columns"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "default": "2",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ]
    },
    {
      "type": "range",
      "id": "product_grid_gap",
      "min": 16,
      "max": 48,
      "step": 8,
      "unit": "px",
      "default": 24,
      "label": "Grid spacing"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait (4:5)"
        },
        {
          "value": "square",
          "label": "Square (1:1)"
        }
      ],
      "default": "adapt",
      "label": "Image ratio"
    },
    {
      "type": "select",
      "id": "image_shape",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "round",
          "label": "Round"
        }
      ],
      "default": "default",
      "label": "Image shape"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show second product image on hover"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show product rating"
    },
    {
      "type": "select",
      "id": "quick_add",
      "default": "none",
      "label": "Quick add",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "standard",
          "label": "Standard"
        }
      ]
    },
    {
      "type": "checkbox",
      "id": "enable_infinite_scroll",
      "default": false,
      "label": "Enable infinite scroll",
      "info": "Products load automatically as you scroll"
    },
    {
      "type": "header",
      "content": "Filtering & Sorting"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "default": true,
      "label": "Enable filtering"
    },
    {
      "type": "checkbox",
      "id": "show_filter_heading",
      "default": true,
      "label": "Show filter heading"
    },
    {
      "type": "text",
      "id": "filter_heading",
      "label": "Filter heading",
      "default": "Filter products"
    },
    {
      "type": "checkbox",
      "id": "open_first_filter",
      "default": true,
      "label": "Open first filter by default"
    },
    {
      "type": "range",
      "id": "filter_text_size",
      "min": 1.2,
      "max": 1.8,
      "step": 0.1,
      "unit": "rem",
      "default": 1.4,
      "label": "Filter text size"
    },
    {
      "type": "range",
      "id": "filter_spacing",
      "min": 8,
      "max": 24,
      "step": 4,
      "unit": "px",
      "default": 12,
      "label": "Filter spacing"
    },
    {
      "type": "range",
      "id": "filter_border_radius",
      "min": 0,
      "max": 12,
      "step": 2,
      "unit": "px",
      "default": 4,
      "label": "Filter border radius"
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "default": true,
      "label": "Enable sorting"
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort label",
      "default": "Sort by:"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "default": true,
      "label": "Show product count"
    },
    {
      "type": "header",
      "content": "Active Filters"
    },
    {
      "type": "text",
      "id": "active_filters_label",
      "label": "Active filters label",
      "default": "Active filters:"
    },
    {
      "type": "text",
      "id": "clear_all_label",
      "label": "Clear all label",
      "default": "Clear all"
    },
    {
      "type": "header",
      "content": "Empty State"
    },
    {
      "type": "text",
      "id": "empty_title",
      "label": "Empty state title",
      "default": "No products found"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "Try adjusting your filters or search terms."
    },
    {
      "type": "text",
      "id": "clear_filters_button",
      "label": "Clear filters button text",
      "default": "Clear all filters"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 96,
      "step": 8,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 96,
      "step": 8,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "BBC Enhanced Collection",
      "settings": {
        "show_collection_info": true,
        "enable_filtering": true,
        "enable_sorting": true,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "products_per_page": 16
      }
    }
  ]
}
{% endschema %}