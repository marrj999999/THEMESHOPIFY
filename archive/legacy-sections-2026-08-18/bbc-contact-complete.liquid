{% comment %}
  BBC Contact Complete — Community-Focused Contact Page
  
  Features:
  - Hero with optional background image
  - Editable community stats
  - Editable contact methods (blocks)
  - Topic selection contact form
  - FAQ (blocks)
  - Editable location with image
  - Editable social/CTA section
  - Uses bbc-foundation.css variables only
{% endcomment %}

<div class="bbc-contact-page">
  
  {%- comment -%} HERO {%- endcomment -%}
  <section class="bbc-contact-hero{% if section.settings.hero_image != blank %} bbc-contact-hero--has-image{% endif %}" style="--hero-overlay-opacity: {{ section.settings.hero_overlay_opacity | divided_by: 100.0 }}">
    {% if section.settings.hero_image != blank %}
      <div class="bbc-contact-hero__bg">
        {{ section.settings.hero_image | image_url: width: 1920 | image_tag: loading: 'eager', class: 'bbc-contact-hero__bg-img', sizes: '100vw' }}
        <div class="bbc-contact-hero__overlay" data-overlay></div>
      </div>
    {% endif %}
    <div class="page-width">
      <div class="bbc-contact-hero__content">
        {% if section.settings.hero_eyebrow != blank %}
          <span class="bbc-contact-hero__eyebrow">{{ section.settings.hero_eyebrow }}</span>
        {% endif %}
        <h1 class="bbc-contact-hero__title">{{ section.settings.hero_title }}</h1>
        {% if section.settings.hero_subtitle != blank %}
          <p class="bbc-contact-hero__subtitle">{{ section.settings.hero_subtitle }}</p>
        {% endif %}
      </div>
    </div>
  </section>

  {%- comment -%} COMMUNITY STATS {%- endcomment -%}
  {% if section.settings.show_stats %}
  <section class="bbc-contact-community">
    <div class="page-width">
      <div class="bbc-contact-community__grid">
        {% if section.settings.stat1_number != blank %}
        <div class="bbc-contact-community__stat">
          <span class="bbc-contact-community__number">{{ section.settings.stat1_number }}</span>
          <span class="bbc-contact-community__label">{{ section.settings.stat1_label }}</span>
        </div>
        {% endif %}
        {% if section.settings.stat2_number != blank %}
        <div class="bbc-contact-community__stat">
          <span class="bbc-contact-community__number">{{ section.settings.stat2_number }}</span>
          <span class="bbc-contact-community__label">{{ section.settings.stat2_label }}</span>
        </div>
        {% endif %}
        {% if section.settings.stat3_number != blank %}
        <div class="bbc-contact-community__stat">
          <span class="bbc-contact-community__number">{{ section.settings.stat3_number }}</span>
          <span class="bbc-contact-community__label">{{ section.settings.stat3_label }}</span>
        </div>
        {% endif %}
      </div>
    </div>
  </section>
  {% endif %}

  {%- comment -%} CONTACT METHODS {%- endcomment -%}
  {% assign method_blocks = section.blocks | where: "type", "contact_method" %}
  {% if method_blocks.size > 0 %}
  <section class="bbc-contact-methods">
    <div class="page-width">
      <header class="bbc-contact-methods__header">
        <h2>{{ section.settings.methods_heading | default: "Quick Ways to Reach Us" }}</h2>
        {% if section.settings.methods_subheading != blank %}
          <p>{{ section.settings.methods_subheading }}</p>
        {% endif %}
      </header>
      
      <div class="bbc-contact-methods__grid bbc-contact-methods__grid--{{ method_blocks.size }}">
        {% for block in method_blocks %}
          <a href="{{ block.settings.url }}" class="bbc-contact-method" {{ block.shopify_attributes }}
            {% if block.settings.open_new_tab %}target="_blank" rel="noopener"{% endif %}>
            {% if block.settings.icon != 'none' %}
              <span class="bbc-contact-method__icon">{% render 'bbc-icons', icon: block.settings.icon, size: 28 %}</span>
            {% endif %}
            <h3>{{ block.settings.title }}</h3>
            <p class="bbc-contact-method__primary">{{ block.settings.primary_text }}</p>
            {% if block.settings.secondary_text != blank %}
              <p class="bbc-contact-method__secondary">{{ block.settings.secondary_text }}</p>
            {% endif %}
          </a>
        {% endfor %}
      </div>
    </div>
  </section>
  {% endif %}

  {%- comment -%} CONTACT FORM WITH TOPIC SELECTION {%- endcomment -%}
  {% if section.settings.show_form %}
  <section class="bbc-contact-form-section" id="contact-form">
    <div class="page-width">
      <div class="bbc-contact-form-wrapper">
        <div class="bbc-bamboo-stripe" aria-hidden="true"></div>
        <header class="bbc-contact-form__header">
          <h2>{{ section.settings.form_heading | default: "Send Us a Message" }}</h2>
          {% if section.settings.form_subheading != blank %}
            <p>{{ section.settings.form_subheading }}</p>
          {% endif %}
        </header>
        
        {%- form 'contact', class: 'bbc-contact-form' -%}
          {%- if form.posted_successfully? -%}
            <div class="bbc-contact-form__success" role="alert">
              <span class="bbc-contact-form__success-icon">{% render 'bbc-icons', icon: 'check-circle', size: 24 %}</span>
              <div>
                <strong>{{ section.settings.form_success_heading | default: "Message sent!" }}</strong>
                <p>{{ section.settings.form_success_message | default: "Thanks for reaching out. We'll get back to you soon — usually within a few hours." }}</p>
              </div>
            </div>
          {%- endif -%}
          
          {%- if form.errors -%}
            <div class="bbc-contact-form__error" role="alert">
              <span class="bbc-contact-form__error-icon">{% render 'bbc-icons', icon: 'close', size: 24 %}</span>
              <div>
                <strong>Please fix these issues:</strong>
                {{ form.errors | default_errors }}
              </div>
            </div>
          {%- endif -%}
          
          {%- comment -%} Topic Selection {%- endcomment -%}
          {% if section.settings.show_topics %}
          <fieldset class="bbc-contact-form__topics">
            <legend>{{ section.settings.topics_label | default: "What can we help you with?" }}</legend>
            <div class="bbc-contact-form__topic-grid">
              {% assign topic_blocks = section.blocks | where: "type", "topic" %}
              {% for block in topic_blocks %}
                <label class="bbc-contact-form__topic" {{ block.shopify_attributes }}>
                  <input type="radio" name="contact[topic]" value="{{ block.settings.value }}" {% if forloop.first %}required{% endif %}>
                  <span class="bbc-contact-form__topic-card">
                    {% if block.settings.icon != 'none' %}
                      <span class="bbc-contact-form__topic-icon">{% render 'bbc-icons', icon: block.settings.icon, size: 24 %}</span>
                    {% endif %}
                    <span class="bbc-contact-form__topic-title">{{ block.settings.title }}</span>
                    {% if block.settings.description != blank %}
                      <span class="bbc-contact-form__topic-desc">{{ block.settings.description }}</span>
                    {% endif %}
                  </span>
                </label>
              {% endfor %}
            </div>
          </fieldset>
          {% endif %}
          
          {%- comment -%} Contact Details {%- endcomment -%}
          <div class="bbc-contact-form__fields">
            <div class="bbc-contact-form__row">
              <div class="bbc-contact-form__field">
                <label for="contact-name">Your Name <span class="required">*</span></label>
                <input type="text" id="contact-name" name="contact[name]" required autocomplete="name" placeholder="What should we call you?">
              </div>
              
              <div class="bbc-contact-form__field">
                <label for="contact-email">Email Address <span class="required">*</span></label>
                <input type="email" id="contact-email" name="contact[email]" required autocomplete="email" placeholder="Where can we reply?">
              </div>
            </div>
            
            <div class="bbc-contact-form__field">
              <label for="contact-phone">Phone Number <span class="optional">(optional)</span></label>
              <input type="tel" id="contact-phone" name="contact[phone]" autocomplete="tel" placeholder="If you'd prefer a call">
            </div>
            
            <div class="bbc-contact-form__field">
              <label for="contact-message">Your Message <span class="required">*</span></label>
              <textarea id="contact-message" name="contact[body]" required rows="5" placeholder="Tell us what's on your mind..."></textarea>
            </div>
            
            {% if section.settings.show_newsletter_checkbox %}
            <div class="bbc-contact-form__field bbc-contact-form__field--checkbox">
              <label class="bbc-checkbox">
                <input type="checkbox" name="contact[newsletter]" value="Yes">
                <span class="bbc-checkbox__box"></span>
                <span class="bbc-checkbox__text">{{ section.settings.newsletter_text | default: "Keep me updated on workshops and new products" }}</span>
              </label>
            </div>
            {% endif %}
          </div>
          
          <div class="bbc-contact-form__submit">
            <button type="submit" class="bbc-btn bbc-btn--primary bbc-btn--lg">
              {{ section.settings.submit_text | default: "Send Message" }}
            </button>
            {% if section.settings.privacy_text != blank %}
              <p class="bbc-contact-form__privacy">{{ section.settings.privacy_text }}</p>
            {% endif %}
          </div>
        {%- endform -%}
      </div>
    </div>
  </section>
  {% endif %}

  {%- comment -%} QUICK FAQ {%- endcomment -%}
  {% assign faq_blocks = section.blocks | where: "type", "faq" %}
  {% if faq_blocks.size > 0 %}
  <section class="bbc-contact-faq">
    <div class="page-width">
      <header class="bbc-contact-faq__header">
        <h2>{{ section.settings.faq_heading | default: "Before You Ask..." }}</h2>
        {% if section.settings.faq_subheading != blank %}
          <p>{{ section.settings.faq_subheading }}</p>
        {% endif %}
      </header>
      
      <div class="bbc-contact-faq__grid">
        {% for block in faq_blocks %}
          <details class="bbc-contact-faq__item" {{ block.shopify_attributes }}>
            <summary>{{ block.settings.question }}</summary>
            <p>{{ block.settings.answer }}</p>
          </details>
        {% endfor %}
      </div>
      
      {% if section.settings.faq_link != blank %}
      <div class="bbc-contact-faq__more">
        <a href="{{ section.settings.faq_link }}" class="bbc-link">{{ section.settings.faq_link_text | default: "View all FAQs →" }}</a>
      </div>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {%- comment -%} LOCATION {%- endcomment -%}
  {% if section.settings.show_location %}
  <section class="bbc-contact-location">
    <div class="page-width">
      <div class="bbc-contact-location__wrapper">
        <div class="bbc-contact-location__info">
          <h2>{{ section.settings.location_heading | default: "Visit Our Workshop" }}</h2>
          <address>
            <strong>{{ section.settings.location_name | default: "Bamboo Bicycle Club" }}</strong><br>
            {{ section.settings.address_line1 }}<br>
            {{ section.settings.address_line2 }}<br>
            {{ section.settings.postcode }}
          </address>
          <div class="bbc-contact-location__meta">
            {% if section.settings.transport != blank %}
            <p>
              <span class="bbc-contact-location__icon">{% render 'bbc-icons', icon: 'globe', size: 18 %}</span>
              {{ section.settings.transport }}
            </p>
            {% endif %}
            {% if section.settings.hours != blank %}
            <p>
              <span class="bbc-contact-location__icon">{% render 'bbc-icons', icon: 'clock', size: 18 %}</span>
              {{ section.settings.hours }}
            </p>
            {% endif %}
          </div>
          {% if section.settings.directions_url != blank %}
          <a href="{{ section.settings.directions_url }}" target="_blank" rel="noopener" class="bbc-btn bbc-btn--outline">
            {% render 'bbc-icons', icon: 'map-pin', size: 18 %}
            {{ section.settings.directions_text | default: "Get Directions" }}
          </a>
          {% endif %}
        </div>
        
        <div class="bbc-contact-location__image">
          {% if section.settings.location_image != blank %}
            {{ section.settings.location_image | image_url: width: 600 | image_tag: loading: 'lazy', alt: section.settings.location_name | default: 'BBC Workshop' }}
          {% else %}
            <div class="bbc-contact-location__placeholder">
              {% render 'bbc-icons', icon: 'map-pin', size: 48 %}
              <span>Workshop Photo</span>
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  {%- comment -%} COMMUNITY CTA {%- endcomment -%}
  {% if section.settings.show_social %}
  <section class="bbc-contact-social">
    <div class="page-width">
      <div class="bbc-contact-social__content">
        <h2>{{ section.settings.social_heading | default: "Join the Community" }}</h2>
        {% if section.settings.social_subheading != blank %}
          <p>{{ section.settings.social_subheading }}</p>
        {% endif %}
        <div class="bbc-contact-social__links">
          {% if section.settings.social_instagram != blank %}
          <a href="{{ section.settings.social_instagram }}" target="_blank" rel="noopener" aria-label="Instagram">
            {% render 'bbc-icons', icon: 'instagram' %}
          </a>
          {% endif %}
          {% if section.settings.social_facebook != blank %}
          <a href="{{ section.settings.social_facebook }}" target="_blank" rel="noopener" aria-label="Facebook">
            {% render 'bbc-icons', icon: 'facebook' %}
          </a>
          {% endif %}
          {% if section.settings.social_youtube != blank %}
          <a href="{{ section.settings.social_youtube }}" target="_blank" rel="noopener" aria-label="YouTube">
            {% render 'bbc-icons', icon: 'youtube' %}
          </a>
          {% endif %}
          {% if section.settings.social_strava != blank %}
          <a href="{{ section.settings.social_strava }}" target="_blank" rel="noopener" aria-label="Strava">
            {% render 'bbc-icons', icon: 'strava' %}
          </a>
          {% endif %}
        </div>
      </div>
    </div>
  </section>
  {% endif %}

</div>

<style>
  /* ===== BBC CONTACT PAGE STYLES ===== */
  
  .bbc-contact-page {
    --bbc-forest: var(--bbc-forest);
    --bbc-teal: var(--bbc-teal);
    --bbc-gold: var(--bbc-gold);
    --bbc-cream: #f8f7f4;
    --bbc-steel: #8da4c1;
    --bbc-white: var(--bbc-white);
    --bbc-error: #dc2626;
    --bbc-success: #16a34a;
  }
  
  /* ===== HERO ===== */
  .bbc-contact-hero {
    position: relative;
    padding: 100px 20px 80px;
    background: var(--bbc-forest);
    text-align: center;
  }
  
  .bbc-contact-hero--has-image {
    background: transparent;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .bbc-contact-hero__bg {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }
  
  .bbc-contact-hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .bbc-contact-hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--bbc-forest);
    opacity: var(--hero-overlay-opacity, 0.5);
  }
  
  .bbc-contact-hero--has-image .bbc-contact-hero__content {
    position: relative;
    z-index: 2;
  }
  
  .bbc-contact-hero__content {
    max-width: 700px;
    margin: 0 auto;
  }
  
  .bbc-contact-hero__eyebrow {
    display: block;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--bbc-gold);
    margin-bottom: 12px;
  }

  .bbc-contact-hero__title {
    font-family: var(--font-heading-family);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    color: var(--bbc-white);
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  .bbc-contact-hero__subtitle {
    font-size: 1.125rem;
    color: rgba(255,255,255,0.85);
    margin: 0;
    line-height: 1.6;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  
  /* ===== COMMUNITY STATS ===== */
  .bbc-contact-community {
    padding: 40px 20px;
    background: var(--bbc-forest);
  }
  
  .bbc-contact-community__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
    text-align: center;
  }
  
  .bbc-contact-community__number {
    display: block;
    font-family: var(--font-heading-family);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--bbc-gold);
  }
  
  .bbc-contact-community__label {
    font-size: 0.875rem;
    color: rgba(255,255,255,0.8);
  }
  
  @media (max-width: 600px) {
    .bbc-contact-community__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
  
  /* ===== CONTACT METHODS ===== */
  .bbc-contact-methods {
    padding: 80px 20px;
    background: var(--bbc-white);
  }
  
  .bbc-contact-methods__header {
    text-align: center;
    margin-bottom: 48px;
  }
  
  .bbc-contact-methods__header h2 {
    font-family: var(--font-heading-family);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--bbc-forest);
    margin: 0 0 8px 0;
  }
  
  .bbc-contact-methods__header p {
    font-size: 1rem;
    color: var(--bbc-steel);
    margin: 0;
  }
  
  .bbc-contact-methods__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
    max-width: 900px;
    margin: 0 auto;
  }
  
  .bbc-contact-methods__grid--2 {
    grid-template-columns: repeat(2, 1fr);
    max-width: 600px;
  }
  
  .bbc-contact-methods__grid--4 {
    grid-template-columns: repeat(4, 1fr);
    max-width: 1100px;
  }
  
  .bbc-contact-method {
    display: block;
    padding: 32px 24px;
    background: var(--bbc-cream);
    text-align: center;
    text-decoration: none;
    border: 2px solid transparent;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }
  
  .bbc-contact-method:hover {
    border-left: 4px solid var(--bbc-gold);
    border-color: var(--bbc-gold);
  }
  
  .bbc-contact-method:focus-visible {
    outline: 3px solid var(--bbc-gold);
    outline-offset: 2px;
  }
  
  .bbc-contact-method__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    margin: 0 auto 16px;
    background: var(--bbc-white);
    border-radius: 0;
    color: var(--bbc-teal);
  }
  
  .bbc-contact-method h3 {
    font-family: var(--font-heading-family);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--bbc-forest);
    margin: 0 0 8px 0;
  }
  
  .bbc-contact-method__primary {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--bbc-teal);
    margin: 0 0 4px 0;
  }
  
  .bbc-contact-method__secondary {
    font-size: 0.8125rem;
    color: var(--bbc-steel);
    margin: 0;
  }
  
  @media (max-width: 768px) {
    .bbc-contact-methods__grid,
    .bbc-contact-methods__grid--4 {
      grid-template-columns: 1fr;
    }
  }
  
  /* ===== CONTACT FORM ===== */
  .bbc-contact-form-section {
    padding: 80px 20px;
    background: var(--bbc-cream);
  }
  
  .bbc-contact-form-wrapper {
    max-width: 800px;
    margin: 0 auto;
    background: var(--bbc-white);
    padding: 48px;
    position: relative;
    overflow: hidden;
  }

  /* Bamboo Stripe Device */
  .bbc-bamboo-stripe {
    position: absolute;
    top: 0;
    left: 0;
    width: 6px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      var(--bbc-teal) 0%,
      var(--bbc-teal) 47%,
      transparent 47%,
      transparent 53%,
      var(--bbc-teal) 53%,
      var(--bbc-teal) 100%
    );
  }

  .bbc-bamboo-stripe::after {
    content: '';
    position: absolute;
    top: 0;
    left: 8px;
    width: 3px;
    height: 100%;
    background: linear-gradient(
      to bottom,
      var(--bbc-gold) 0%,
      var(--bbc-gold) 45%,
      transparent 45%,
      transparent 55%,
      var(--bbc-gold) 55%,
      var(--bbc-gold) 100%
    );
  }
  
  .bbc-contact-form__header {
    text-align: center;
    margin-bottom: 40px;
  }
  
  .bbc-contact-form__header h2 {
    font-family: var(--font-heading-family);
    font-size: 1.75rem;
    font-weight: 800;
    color: var(--bbc-forest);
    margin: 0 0 8px 0;
  }
  
  .bbc-contact-form__header p {
    font-size: 1rem;
    color: var(--bbc-steel);
    margin: 0;
  }
  
  /* Success/Error Messages */
  .bbc-contact-form__success,
  .bbc-contact-form__error {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 20px;
    margin-bottom: 32px;
    border-radius: 4px;
  }
  
  .bbc-contact-form__success {
    background: rgba(63, 139, 102, 0.08);
    border-left: 4px solid var(--bbc-success);
  }
  
  .bbc-contact-form__success-icon {
    color: var(--bbc-success);
    flex-shrink: 0;
  }
  
  .bbc-contact-form__error {
    background: rgba(220, 38, 38, 0.05);
    border-left: 4px solid var(--bbc-error);
  }
  
  .bbc-contact-form__error-icon {
    color: var(--bbc-error);
    flex-shrink: 0;
  }
  
  .bbc-contact-form__success strong,
  .bbc-contact-form__error strong {
    display: block;
    font-size: 1rem;
    color: var(--bbc-forest);
    margin-bottom: 4px;
  }
  
  .bbc-contact-form__success p,
  .bbc-contact-form__error p {
    font-size: 0.875rem;
    color: var(--bbc-steel);
    margin: 0;
  }
  
  /* Topic Selection */
  .bbc-contact-form__topics {
    border: none;
    padding: 0;
    margin: 0 0 32px 0;
  }
  
  .bbc-contact-form__topics legend {
    font-size: 1rem;
    font-weight: 700;
    color: var(--bbc-forest);
    margin-bottom: 16px;
    display: block;
  }
  
  .bbc-contact-form__topic-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }
  
  .bbc-contact-form__topic {
    cursor: pointer;
  }
  
  .bbc-contact-form__topic input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  
  .bbc-contact-form__topic-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px 12px;
    background: var(--bbc-cream);
    border: 2px solid transparent;
    text-align: center;
    transition: border-color 0.2s ease, background 0.2s ease;
  }
  
  .bbc-contact-form__topic input:checked + .bbc-contact-form__topic-card {
    border-color: var(--bbc-teal);
    background: var(--bbc-white);
  }
  
  .bbc-contact-form__topic input:focus-visible + .bbc-contact-form__topic-card {
    outline: 3px solid var(--bbc-gold);
    outline-offset: 2px;
  }
  
  .bbc-contact-form__topic:hover .bbc-contact-form__topic-card {
    border-color: var(--bbc-teal);
  }
  
  .bbc-contact-form__topic-icon {
    color: var(--bbc-teal);
    margin-bottom: 8px;
  }
  
  .bbc-contact-form__topic-title {
    font-size: 0.875rem;
    font-weight: 700;
    color: var(--bbc-forest);
    margin-bottom: 4px;
  }
  
  .bbc-contact-form__topic-desc {
    font-size: 0.6875rem;
    color: var(--bbc-steel);
    line-height: 1.4;
  }
  
  @media (max-width: 768px) {
    .bbc-contact-form__topic-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 480px) {
    .bbc-contact-form__topic-grid {
      grid-template-columns: 1fr 1fr;
      gap: 8px;
    }
    
    .bbc-contact-form__topic-card {
      padding: 16px 8px;
    }
    
    .bbc-contact-form__topic-desc {
      display: none;
    }
  }
  
  /* Form Fields */
  .bbc-contact-form__fields {
    margin-bottom: 32px;
  }
  
  .bbc-contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  
  @media (max-width: 600px) {
    .bbc-contact-form__row {
      grid-template-columns: 1fr;
    }
  }
  
  .bbc-contact-form__field {
    margin-bottom: 20px;
  }
  
  .bbc-contact-form__field label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--bbc-forest);
    margin-bottom: 8px;
  }
  
  .bbc-contact-form__field label .required {
    color: var(--bbc-error);
  }
  
  .bbc-contact-form__field label .optional {
    font-weight: 400;
    color: var(--bbc-steel);
  }
  
  .bbc-contact-form__field input,
  .bbc-contact-form__field textarea {
    width: 100%;
    padding: 14px 16px;
    font-size: 1rem;
    font-family: inherit;
    color: var(--bbc-forest);
    background: var(--bbc-cream);
    border: 2px solid transparent;
    border-radius: 0;
    transition: border-color 0.2s ease, background 0.2s ease;
    -webkit-appearance: none;
  }
  
  .bbc-contact-form__field input::placeholder,
  .bbc-contact-form__field textarea::placeholder {
    color: var(--bbc-steel);
    opacity: 0.6;
  }
  
  .bbc-contact-form__field input:focus,
  .bbc-contact-form__field textarea:focus {
    outline: none;
    border-color: var(--bbc-teal);
    background: var(--bbc-white);
  }
  
  .bbc-contact-form__field textarea {
    resize: vertical;
    min-height: 120px;
  }
  
  /* Checkbox */
  .bbc-contact-form__field--checkbox {
    margin-top: 24px;
  }
  
  .bbc-checkbox {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    cursor: pointer;
  }
  
  .bbc-checkbox input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  
  .bbc-checkbox__box {
    flex-shrink: 0;
    width: 22px;
    height: 22px;
    background: var(--bbc-cream);
    border: 2px solid var(--bbc-steel);
    border-radius: 4px;
    position: relative;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  
  .bbc-checkbox input:checked + .bbc-checkbox__box {
    background: var(--bbc-teal);
    border-color: var(--bbc-teal);
  }
  
  .bbc-checkbox input:checked + .bbc-checkbox__box::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 7px;
    width: 5px;
    height: 10px;
    border: solid white;
    border-width: 0 2px 2px 0;
    transform: rotate(45deg);
  }
  
  .bbc-checkbox input:focus-visible + .bbc-checkbox__box {
    outline: 3px solid var(--bbc-gold);
    outline-offset: 2px;
  }
  
  .bbc-checkbox__text {
    font-size: 0.875rem;
    color: var(--bbc-steel);
    line-height: 1.5;
  }
  
  /* Submit */
  .bbc-contact-form__submit {
    text-align: center;
  }
  
  .bbc-contact-page .bbc-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 14px 28px;
    font-size: 0.875rem;
    font-weight: 700;
    text-decoration: none;
    border: 2px solid transparent;
    cursor: pointer;
    transition: all 0.2s ease;
    border-radius: 0;
  }
  
  .bbc-contact-page .bbc-btn--primary {
    background: var(--bbc-gold);
    color: var(--bbc-forest);
    border-color: var(--bbc-gold);
    font-weight: 800;
  }

  .bbc-contact-page .bbc-btn--primary:hover {
    background: var(--bbc-forest);
    color: var(--bbc-white);
    border-color: var(--bbc-forest);
  }
  
  .bbc-contact-page .bbc-btn--outline {
    background: transparent;
    color: var(--bbc-forest);
    border-color: var(--bbc-forest);
  }
  
  .bbc-contact-page .bbc-btn--outline:hover {
    background: var(--bbc-forest);
    color: var(--bbc-white);
  }
  
  .bbc-contact-page .bbc-btn--lg {
    padding: 16px 40px;
    font-size: 1rem;
  }
  
  .bbc-contact-page .bbc-btn:focus-visible {
    outline: 3px solid var(--bbc-gold);
    outline-offset: 2px;
  }
  
  .bbc-contact-form__privacy {
    font-size: 0.8125rem;
    color: var(--bbc-steel);
    margin-top: 16px;
  }
  
  .bbc-contact-form__privacy a {
    color: var(--bbc-teal);
    text-decoration: none;
  }
  
  .bbc-contact-form__privacy a:hover {
    text-decoration: underline;
  }
  
  @media (max-width: 600px) {
    .bbc-contact-form-wrapper {
      padding: 32px 20px 32px 24px;
    }
  }
  
  /* ===== FAQ ===== */
  .bbc-contact-faq {
    padding: 80px 20px;
    background: var(--bbc-white);
  }
  
  .bbc-contact-faq__header {
    text-align: center;
    margin-bottom: 48px;
  }
  
  .bbc-contact-faq__header h2 {
    font-family: var(--font-heading-family);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--bbc-forest);
    margin: 0 0 8px 0;
  }
  
  .bbc-contact-faq__header p {
    font-size: 1rem;
    color: var(--bbc-steel);
    margin: 0;
  }
  
  .bbc-contact-faq__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    max-width: 900px;
    margin: 0 auto;
  }
  
  .bbc-contact-faq__item {
    background: var(--bbc-cream);
    padding: 0;
  }
  
  .bbc-contact-faq__item summary {
    padding: 20px 24px;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--bbc-forest);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  .bbc-contact-faq__item summary::-webkit-details-marker {
    display: none;
  }
  
  .bbc-contact-faq__item summary::after {
    content: '+';
    font-size: 1.25rem;
    font-weight: 300;
    color: var(--bbc-teal);
    flex-shrink: 0;
    margin-left: 16px;
    transition: transform 0.2s ease;
  }
  
  .bbc-contact-faq__item[open] summary::after {
    transform: rotate(45deg);
  }
  
  .bbc-contact-faq__item p {
    padding: 0 24px 20px;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--bbc-steel);
    margin: 0;
  }
  
  .bbc-contact-faq__more {
    text-align: center;
    margin-top: 32px;
  }
  
  .bbc-contact-page .bbc-link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--bbc-teal);
    text-decoration: none;
  }
  
  .bbc-contact-page .bbc-link:hover {
    text-decoration: underline;
  }
  
  @media (max-width: 768px) {
    .bbc-contact-faq__grid {
      grid-template-columns: 1fr;
    }
  }
  
  /* ===== LOCATION ===== */
  .bbc-contact-location {
    padding: 80px 20px;
    background: var(--bbc-cream);
  }
  
  .bbc-contact-location__wrapper {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    max-width: 1000px;
    margin: 0 auto;
    align-items: center;
  }
  
  .bbc-contact-location__info h2 {
    font-family: var(--font-heading-family);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 800;
    color: var(--bbc-forest);
    margin: 0 0 20px 0;
  }
  
  .bbc-contact-location__info address {
    font-style: normal;
    font-size: 1rem;
    line-height: 1.7;
    color: var(--bbc-forest);
    margin-bottom: 20px;
  }
  
  .bbc-contact-location__meta {
    margin-bottom: 24px;
  }
  
  .bbc-contact-location__meta p {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.875rem;
    color: var(--bbc-steel);
    margin: 8px 0;
  }
  
  .bbc-contact-location__icon {
    color: var(--bbc-teal);
    flex-shrink: 0;
  }
  
  .bbc-contact-location__image img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }
  
  .bbc-contact-location__placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    height: 300px;
    background: var(--bbc-white);
    color: var(--bbc-steel);
  }
  
  @media (max-width: 768px) {
    .bbc-contact-location__wrapper {
      grid-template-columns: 1fr;
    }
  }
  
  /* ===== SOCIAL ===== */
  .bbc-contact-social {
    padding: 60px 20px;
    background: var(--bbc-forest);
    text-align: center;
  }
  
  .bbc-contact-social h2 {
    font-family: var(--font-heading-family);
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--bbc-white);
    margin: 0 0 8px 0;
  }
  
  .bbc-contact-social p {
    font-size: 1rem;
    color: rgba(255,255,255,0.8);
    margin: 0 0 24px 0;
  }
  
  .bbc-contact-social__links {
    display: flex;
    justify-content: center;
    gap: 24px;
  }
  
  .bbc-contact-social__links a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    background: rgba(255,255,255,0.1);
    border-radius: 0;
    color: var(--bbc-white);
    text-decoration: none;
    transition: background 0.2s ease;
  }
  
  .bbc-contact-social__links a:hover {
    background: var(--bbc-gold);
    color: var(--bbc-forest);
  }
  
  .bbc-contact-social__links a:focus-visible {
    outline: 3px solid var(--bbc-gold);
    outline-offset: 2px;
  }
  
  /* ===== REDUCED MOTION ===== */
  @media (prefers-reduced-motion: reduce) {
    .bbc-contact-method,
    .bbc-contact-form__topic-card,
    .bbc-contact-form__field input,
    .bbc-contact-form__field textarea,
    .bbc-checkbox__box,
    .bbc-contact-page .bbc-btn,
    .bbc-contact-faq__item summary::after,
    .bbc-contact-social__links a {
      transition: none;
    }
  }
</style>

