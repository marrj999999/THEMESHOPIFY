{% comment %}
  BBC FAQ — LSV Style + FAQ structured data (JSON-LD) for Google rich results
{% endcomment %}

{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
    {
      "@type": "Question",
      "name": {{ block.settings.question | json }},
      "acceptedAnswer": {
        "@type": "Answer",
        "text": {{ block.settings.answer | strip_html | json }}
      }
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

<section class="bbc-section bbc-section--{{ section.settings.background }}">
  <div class="bbc-container bbc-container--narrow">
    
    <div class="bbc-center bbc-mb-xl">
      {% if section.settings.label != blank %}
        <p class="bbc-label">{{ section.settings.label }}</p>
      {% endif %}
      <h2 class="bbc-h2">{{ section.settings.heading }}</h2>
    </div>
    
    <div class="bbc-faq-list">
      {%- for block in section.blocks -%}
        <details class="bbc-faq-item" {{ block.shopify_attributes }}>
          <summary class="bbc-faq-question">
            <span>{{ block.settings.question }}</span>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="bbc-faq-icon">
              <line x1="12" y1="5" x2="12" y2="19"></line>
              <line x1="5" y1="12" x2="19" y2="12"></line>
            </svg>
          </summary>
          <div class="bbc-faq-answer">
            {{ block.settings.answer }}
          </div>
        </details>
      {%- endfor -%}
    </div>
    
    {% if section.settings.cta_text != blank %}
      <div class="bbc-center bbc-faq__cta">
        <p class="bbc-text bbc-mb-md">{{ section.settings.cta_prefix }}</p>
        <a href="{{ section.settings.cta_link }}" class="bbc-btn bbc-btn--primary">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {% endif %}
    
  </div>
</section>

<style>
  .bbc-faq-list {
    border-top: 2px solid var(--bbc-border, #e2e8f0);
  }
  
  .bbc-faq-item {
    border-bottom: 2px solid var(--bbc-border, #e2e8f0);
  }
  
  .bbc-faq-question {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 24px;
    padding: 28px 0;
    font-family: var(--font-family);
    font-size: var(--text-lg, 1.25rem);
    font-weight: 600;
    color: var(--bbc-heading, var(--bbc-forest));
    cursor: pointer;
    list-style: none;
  }
  
  .bbc-faq-question::-webkit-details-marker {
    display: none;
  }
  
  .bbc-faq-question:hover {
    color: var(--bbc-forest, var(--bbc-forest));
  }
  
  .bbc-faq-icon {
    flex-shrink: 0;
    color: var(--bbc-forest, var(--bbc-forest));
    transition: transform 0.2s ease;
  }
  
  .bbc-faq-item[open] .bbc-faq-icon {
    transform: rotate(45deg);
  }
  
  .bbc-faq-answer {
    padding: 0 0 28px 0;
    font-family: var(--font-family);
    font-size: var(--text-base, 1.125rem);
    line-height: 1.7;
    color: var(--bbc-text, #1e293b);
  }
  
  .bbc-faq-answer p {
    margin: 0;
  }
  
  .bbc-faq-question:focus-visible {
    outline: 3px solid var(--bbc-gold, var(--bbc-gold));
    outline-offset: 4px;
  }
  
  .bbc-faq__cta {
    margin-top: 64px;
  }

  @media (prefers-reduced-motion: reduce) {
    .bbc-faq-icon { transition: none; }
  }
</style>

{% schema %}
{
  "name": "BBC FAQ",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "FAQ" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Common Questions" },
    { "type": "text", "id": "cta_prefix", "label": "CTA prefix" },
    { "type": "text", "id": "cta_text", "label": "CTA button" },
    { "type": "url", "id": "cta_link", "label": "CTA link" },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question" },
        { "type": "richtext", "id": "answer", "label": "Answer" }
      ]
    }
  ],
  "presets": [{ "name": "BBC FAQ" }]
}
{% endschema %}