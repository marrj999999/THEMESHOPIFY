{% comment %}
  BBC Recently Viewed Products
  Shows products the visitor has viewed - uses localStorage
{% endcomment %}

<section class="bbc-recently-viewed" id="recently-viewed-{{ section.id }}" style="display: none;">
  <div class="bbc-container">
    {% if section.settings.heading != blank %}
      <div class="bbc-recently-viewed__header">
        <h2 class="bbc-recently-viewed__title">{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    <div class="bbc-recently-viewed__grid" data-products-container>
      <!-- Products injected via JavaScript -->
    </div>
  </div>
</section>

<style>
.bbc-recently-viewed {
  padding: 60px 0;
  background: {{ section.settings.background_color | default: 'var(--bbc-white)' }};
}

.bbc-recently-viewed__header {
  margin-bottom: 32px;
}

.bbc-recently-viewed__title {
  font-size: clamp(1.5rem, 3vw, 2rem);
  font-weight: 700;
  color: var(--bbc-forest, var(--bbc-forest));
  margin: 0;
}

.bbc-recently-viewed__grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
  gap: 24px;
}

.bbc-recently-viewed__item {
  display: flex;
  flex-direction: column;
  text-decoration: none;
  background: white;
  border-radius: 8px;
  overflow: hidden;
  transition: transform 0.2s, box-shadow 0.2s;
}

.bbc-recently-viewed__item:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
}

.bbc-recently-viewed__image-wrapper {
  position: relative;
  aspect-ratio: 1;
  overflow: hidden;
  background: var(--bbc-cream);
}

.bbc-recently-viewed__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.bbc-recently-viewed__item:hover .bbc-recently-viewed__image {
  transform: scale(1.05);
}

.bbc-recently-viewed__content {
  padding: 16px;
}

.bbc-recently-viewed__product-title {
  font-size: 1rem;
  font-weight: 600;
  color: var(--bbc-forest, var(--bbc-forest));
  margin: 0 0 8px;
  line-height: 1.3;
}

.bbc-recently-viewed__price {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--bbc-teal, var(--bbc-teal));
}

.bbc-recently-viewed__empty {
  grid-column: 1 / -1;
  text-align: center;
  padding: 40px 20px;
  color: var(--bbc-gray-600);
}

@media (max-width: 1024px) {
  .bbc-recently-viewed__grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (max-width: 768px) {
  .bbc-recently-viewed {
    padding: 40px 0;
  }
  
  .bbc-recently-viewed__grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
  }
}

@media (max-width: 480px) {
  .bbc-recently-viewed__content {
    padding: 12px;
  }
  
  .bbc-recently-viewed__product-title {
    font-size: 0.875rem;
  }
  
  .bbc-recently-viewed__price {
    font-size: 1rem;
  }
}
</style>

<script>
(function() {
  const STORAGE_KEY = 'bbc_recently_viewed';
  const MAX_PRODUCTS = {{ section.settings.max_products | default: 8 }};
  const DISPLAY_COUNT = {{ section.settings.products_to_show | default: 4 }};
  
  // Get current product ID if on product page
  const currentProductId = {{ product.id | default: 'null' }};
  
  // Get recently viewed from localStorage
  function getRecentlyViewed() {
    try {
      return JSON.parse(localStorage.getItem(STORAGE_KEY)) || [];
    } catch (e) {
      return [];
    }
  }
  
  // Save product to recently viewed
  function saveProduct(product) {
    if (!product || !product.id) return;
    
    let products = getRecentlyViewed();
    
    // Remove if already exists
    products = products.filter(p => p.id !== product.id);
    
    // Add to beginning
    products.unshift(product);
    
    // Limit to max products
    products = products.slice(0, MAX_PRODUCTS);
    
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(products));
    } catch (e) {
      // Storage full or disabled
    }
  }
  
  // Track current product
  {% if product %}
  saveProduct({
    id: {{ product.id }},
    title: {{ product.title | json }},
    url: {{ product.url | json }},
    price: {{ product.price | money | json }},
    image: {{ product.featured_image | image_url: width: 400 | json }}
  });
  {% endif %}
  
  // Render recently viewed products
  function renderProducts() {
    const section = document.getElementById('recently-viewed-{{ section.id }}');
    const container = section.querySelector('[data-products-container]');
    
    let products = getRecentlyViewed();
    
    // Exclude current product
    if (currentProductId) {
      products = products.filter(p => p.id !== currentProductId);
    }
    
    // Limit to display count
    products = products.slice(0, DISPLAY_COUNT);
    
    if (products.length === 0) {
      section.style.display = 'none';
      return;
    }
    
    // Show section
    section.style.display = 'block';
    
    // Render products
    container.innerHTML = products.map(product => `
      <a href="${product.url}" class="bbc-recently-viewed__item">
        <div class="bbc-recently-viewed__image-wrapper">
          ${product.image 
            ? `<img src="${product.image}" alt="${product.title}" class="bbc-recently-viewed__image" loading="lazy">`
            : `<div class="bbc-recently-viewed__image" style="background: var(--bbc-cream);"></div>`
          }
        </div>
        <div class="bbc-recently-viewed__content">
          <h3 class="bbc-recently-viewed__product-title">${product.title}</h3>
          <div class="bbc-recently-viewed__price">${product.price}</div>
        </div>
      </a>
    `).join('');
  }
  
  // Initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', renderProducts);
  } else {
    renderProducts();
  }
})();
</script>

{% schema %}
{
  "name": "BBC Recently Viewed",
  "tag": "section",
  "class": "bbc-recently-viewed-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Recently Viewed"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to Show",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Max Products to Store",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns (Desktop)",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" }
      ],
      "default": "4"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "BBC Recently Viewed"
    }
  ]
}
{% endschema %}
