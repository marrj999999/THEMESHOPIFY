{% comment %}
  BBC Video with Text
  Video beside copy - great for explainers, tutorials, about content
{% endcomment %}

<section class="bbc-video-text {{ section.settings.layout }}" id="video-text-{{ section.id }}">
  <div class="bbc-container">
    <div class="bbc-video-text__grid {% render 'bbc-layout-classes', content_width: section.settings.content_width, visual_position: section.settings.visual_position, vertical_align: section.settings.vertical_align, mobile_order: section.settings.mobile_order, gap_size: section.settings.gap_size %}">
      <div class="bbc-video-text__media bbc-layout__visual">
        {% if section.settings.video_url != blank %}
          {% assign video_host = section.settings.video_url | split: '/' | first %}
          {% if section.settings.video_url contains 'youtube' or section.settings.video_url contains 'youtu.be' %}
            {% assign video_id = section.settings.video_url | split: 'v=' | last | split: '&' | first %}
            {% if section.settings.video_url contains 'youtu.be' %}
              {% assign video_id = section.settings.video_url | split: '/' | last | split: '?' | first %}
            {% endif %}
            <div class="bbc-video-text__video-wrapper">
              <div class="bbc-video-text__video-container" data-video-id="{{ video_id }}" data-video-type="youtube">
                {% if section.settings.cover_image != blank %}
                  {{ section.settings.cover_image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    class: 'bbc-video-text__cover',
                    alt: section.settings.heading | default: 'Video cover'
                  }}
                {% else %}
                  <img src="https://img.youtube.com/vi/{{ video_id }}/maxresdefault.jpg" 
                       alt="{{ section.settings.heading | default: 'Video' }}"
                       class="bbc-video-text__cover"
                       loading="lazy">
                {% endif %}
                <button type="button" class="bbc-video-text__play" aria-label="Play video">
                  {% render 'bbc-icons', icon: 'play', size: 48 %}
                </button>
              </div>
            </div>
          {% elsif section.settings.video_url contains 'vimeo' %}
            {% assign video_id = section.settings.video_url | split: '/' | last | split: '?' | first %}
            <div class="bbc-video-text__video-wrapper">
              <div class="bbc-video-text__video-container" data-video-id="{{ video_id }}" data-video-type="vimeo">
                {% if section.settings.cover_image != blank %}
                  {{ section.settings.cover_image | image_url: width: 800 | image_tag:
                    loading: 'lazy',
                    class: 'bbc-video-text__cover',
                    alt: section.settings.heading | default: 'Video cover'
                  }}
                {% endif %}
                <button type="button" class="bbc-video-text__play" aria-label="Play video">
                  {% render 'bbc-icons', icon: 'play', size: 48 %}
                </button>
              </div>
            </div>
          {% endif %}
        {% elsif section.settings.shopify_video != blank %}
          <div class="bbc-video-text__video-wrapper">
            {{ section.settings.shopify_video | video_tag: 
              controls: true, 
              loop: section.settings.loop,
              muted: section.settings.autoplay,
              autoplay: section.settings.autoplay,
              playsinline: true,
              class: 'bbc-video-text__native-video'
            }}
          </div>
        {% else %}
          <div class="bbc-video-text__placeholder">
            {% render 'bbc-icons', icon: 'video', size: 48 %}
            <span>Add a video URL or upload</span>
          </div>
        {% endif %}
      </div>
      
      <div class="bbc-video-text__content bbc-layout__content">
        {% if section.settings.eyebrow != blank %}
          <span class="bbc-video-text__eyebrow">{{ section.settings.eyebrow }}</span>
        {% endif %}
        
        {% if section.settings.heading != blank %}
          <h2 class="bbc-video-text__title">{{ section.settings.heading }}</h2>
        {% endif %}
        
        {% if section.settings.text != blank %}
          <div class="bbc-video-text__text">{{ section.settings.text }}</div>
        {% endif %}
        
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="bbc-btn bbc-btn--{{ section.settings.button_style | default: 'secondary' }} bbc-video-text__button">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
        
        {% if section.blocks.size > 0 %}
          <div class="bbc-video-text__stats">
            {% for block in section.blocks %}
              {% if block.type == 'stat' %}
                <div class="bbc-video-text__stat" {{ block.shopify_attributes }}>
                  <span class="bbc-video-text__stat-number">{{ block.settings.number }}</span>
                  <span class="bbc-video-text__stat-label">{{ block.settings.label }}</span>
                </div>
              {% endif %}
            {% endfor %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</section>

<style>
.bbc-video-text {
  padding: var(--section-py, 80px) var(--section-px, 24px);
  background: {{ section.settings.background_color | default: 'var(--bbc-white, var(--bbc-white))' }};
}

.bbc-video-text__grid {
  /* Grid layout handled by shared bbc-layout classes */
}

.bbc-video-text__video-wrapper {
  position: relative;
  border-radius: 12px;
  overflow: hidden;
  background: var(--bbc-black);
}

.bbc-video-text__video-container {
  position: relative;
  aspect-ratio: 16/9;
  cursor: pointer;
}

.bbc-video-text__cover {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease, filter 0.3s ease;
}

.bbc-video-text__video-container:hover .bbc-video-text__cover {
  transform: scale(1.02);
  filter: brightness(0.9);
}

.bbc-video-text__play {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80px;
  height: 80px;
  background: var(--bbc-gold, var(--bbc-gold));
  border: none;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--bbc-forest, var(--bbc-forest));
  cursor: pointer;
  transition: transform 0.2s, background 0.2s;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
}

.bbc-video-text__play:hover {
  transform: translate(-50%, -50%) scale(1.1);
  background: #ffb620;
}

.bbc-video-text__native-video {
  width: 100%;
  display: block;
  border-radius: 12px;
}

.bbc-video-text__placeholder {
  aspect-ratio: 16/9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--space-3, 12px);
  background: var(--bbc-cream, var(--bbc-cream));
  border-radius: var(--radius-lg, 12px);
  color: var(--bbc-gray-300, #94a3b8);
}

.bbc-video-text__content {
  padding: 20px 0;
}

.bbc-video-text__eyebrow {
  display: inline-block;
  font-size: 0.8125rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--bbc-teal, var(--bbc-teal));
  margin-bottom: 12px;
}

.bbc-video-text__title {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 700;
  color: var(--bbc-forest, var(--bbc-forest));
  margin: 0 0 20px;
  line-height: 1.2;
}

.bbc-video-text__text {
  font-size: 1.0625rem;
  line-height: 1.7;
  color: var(--bbc-text, #1e293b);
  margin-bottom: 28px;
}

.bbc-video-text__text p {
  margin: 0 0 16px;
}

.bbc-video-text__text p:last-child {
  margin-bottom: 0;
}

.bbc-video-text__button {
  display: inline-block;
  padding: 14px 28px;
  background: var(--bbc-forest, var(--bbc-forest));
  color: white;
  text-decoration: none;
  font-weight: 600;
  border-radius: 8px;
  transition: background 0.2s, transform 0.2s;
}

.bbc-video-text__button:hover {
  background: var(--bbc-teal, var(--bbc-teal));
  transform: translateY(-2px);
}

.bbc-video-text__stats {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
  margin-top: 24px;
}

.bbc-video-text__stat {
  display: flex;
  flex-direction: column;
}

.bbc-video-text__stat-number {
  font-size: 2rem;
  font-weight: 800;
  color: var(--bbc-forest, var(--bbc-forest));
  line-height: 1;
}

.bbc-video-text__stat-label {
  font-size: 0.875rem;
  color: var(--bbc-text-muted, #64748b);
  margin-top: 4px;
}

/* Embedded video iframe */
.bbc-video-text__iframe {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  border: 0;
}

.bbc-video-text__play:focus-visible {
  outline: 3px solid var(--bbc-gold, var(--bbc-gold));
  outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
  .bbc-video-text__cover,
  .bbc-video-text__play,
  .bbc-video-text__button { transition: none; }
  .bbc-video-text__video-container:hover .bbc-video-text__cover { transform: none; filter: none; }
  .bbc-video-text__play:hover { transform: translate(-50%, -50%); }
  .bbc-video-text__button:hover { transform: none; }
}

@media (max-width: 768px) {
  .bbc-video-text {
    padding: 60px 0;
  }

  .bbc-video-text__content {
    padding: 0;
  }
}

@media (max-width: 480px) {
  .bbc-video-text {
    padding: 40px 0;
  }
  
  .bbc-video-text__play {
    width: 64px;
    height: 64px;
  }
  
  .bbc-video-text__button {
    display: block;
    text-align: center;
    margin-bottom: 16px;
  }
  
  .bbc-video-text__stats {
    flex-direction: row;
    gap: 32px;
    margin-top: 16px;
  }
  
  .bbc-video-text__stat-number {
    font-size: 1.5rem;
  }
}
</style>

<script>
(function() {
  const containers = document.querySelectorAll('#video-text-{{ section.id }} .bbc-video-text__video-container');
  
  containers.forEach(container => {
    const playBtn = container.querySelector('.bbc-video-text__play');
    const cover = container.querySelector('.bbc-video-text__cover');
    const videoId = container.dataset.videoId;
    const videoType = container.dataset.videoType;
    
    if (!playBtn || !videoId) return;
    
    function loadVideo() {
      let iframe;
      
      if (videoType === 'youtube') {
        iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&rel=0`;
        iframe.setAttribute('allow', 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
      } else if (videoType === 'vimeo') {
        iframe = document.createElement('iframe');
        iframe.src = `https://player.vimeo.com/video/${videoId}?autoplay=1`;
        iframe.setAttribute('allow', 'autoplay; fullscreen; picture-in-picture');
        iframe.setAttribute('allowfullscreen', '');
      }
      
      if (iframe) {
        iframe.className = 'bbc-video-text__iframe';
        container.innerHTML = '';
        container.appendChild(iframe);
        container.style.cursor = 'default';
      }
    }
    
    playBtn.addEventListener('click', loadVideo);
    container.addEventListener('click', function(e) {
      if (e.target !== playBtn && !playBtn.contains(e.target)) {
        loadVideo();
      }
    });
  });
})();
</script>

{% schema %}
{
  "name": "BBC Video + Text",
  "tag": "section",
  "class": "bbc-video-text-section",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "visual_position",
      "label": "Video position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content/video width ratio",
      "options": [
        { "value": "50-50", "label": "Equal (50/50)" },
        { "value": "60-40", "label": "More text (60/40)" },
        { "value": "40-60", "label": "More video (40/60)" },
        { "value": "70-30", "label": "Mostly text (70/30)" }
      ],
      "default": "50-50"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile stack order",
      "options": [
        { "value": "image_first", "label": "Video first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first",
      "info": "Which appears first when stacked on mobile"
    },
    {
      "type": "select",
      "id": "gap_size",
      "label": "Gap between columns",
      "options": [
        { "value": "sm", "label": "Small (24px)" },
        { "value": "md", "label": "Medium (40px)" },
        { "value": "lg", "label": "Large (64px)" }
      ],
      "default": "lg"
    },
    {
      "type": "header",
      "content": "Video"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "YouTube or Vimeo URL",
      "info": "Paste a YouTube or Vimeo video URL"
    },
    {
      "type": "video",
      "id": "shopify_video",
      "label": "Or Upload Video",
      "info": "Upload a video file instead"
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover Image (optional)",
      "info": "Custom thumbnail for YouTube/Vimeo"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay (uploaded videos)",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop (uploaded videos)",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "See How It's Done"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build Your Frame in 3 Weekends"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Watch our complete build process. From raw bamboo tubes to a rideable frame — no power tools, no special skills, just patience and our guidance.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Watch Full Tutorial"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary (Gold)" },
        { "value": "secondary", "label": "Secondary (Forest)" },
        { "value": "outline", "label": "Outline" },
        { "value": "outline-light", "label": "Outline Light" },
        { "value": "white", "label": "White" },
        { "value": "gold", "label": "Gold" }
      ],
      "default": "secondary"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "4,000+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Frames Built"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Video + Text",
      "blocks": [
        { "type": "stat", "settings": { "number": "4,000+", "label": "Frames Built" } },
        { "type": "stat", "settings": { "number": "36", "label": "Countries" } }
      ]
    }
  ]
}
{% endschema %}
