{% comment %}
  BBC Testimonials v4 — Larger text, visual cards
{% endcomment %}

<section class="bbc-section bbc-section--{{ section.settings.background }}">
  <div class="bbc-container">
    
    <div class="bbc-center bbc-mb-xl">
      {% if section.settings.label != blank %}
        <p class="bbc-label">{{ section.settings.label }}</p>
      {% endif %}
      <h2 class="bbc-h2">{{ section.settings.heading }}</h2>
    </div>
    
    <div class="bbc-testimonials-grid bbc-testimonials-grid--{{ section.settings.columns | default: 3 }}">
      {%- for block in section.blocks -%}
        <blockquote class="bbc-testimonial-card" {{ block.shopify_attributes }}>
          <div class="bbc-testimonial__quote-mark">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
              <path d="M11.192 15.757c0-.88-.23-1.618-.69-2.217-.326-.412-.768-.683-1.327-.812-.55-.128-1.07-.137-1.54-.028-.16-.95.1-1.956.76-3.022.66-1.065 1.515-1.867 2.558-2.403L9.373 5c-.8.396-1.56.898-2.26 1.505-.71.607-1.34 1.305-1.9 2.094s-.98 1.68-1.25 2.69-.346 2.04-.217 3.1c.168 1.4.62 2.52 1.356 3.35.735.84 1.652 1.26 2.748 1.26.965 0 1.766-.29 2.4-.878.628-.576.94-1.365.94-2.368l.002.004zm9.124 0c0-.88-.23-1.618-.69-2.217-.326-.42-.77-.692-1.327-.817-.56-.124-1.074-.13-1.54-.022-.16-.94.09-1.95.75-3.02.66-1.06 1.514-1.86 2.557-2.4L18.49 5c-.8.396-1.555.898-2.26 1.505-.708.607-1.34 1.305-1.894 2.094-.556.79-.97 1.68-1.24 2.69-.273 1-.345 2.04-.217 3.1.168 1.4.62 2.52 1.356 3.35.735.84 1.652 1.26 2.748 1.26.965 0 1.766-.29 2.4-.878.628-.576.94-1.365.94-2.368l-.007.004z"/>
            </svg>
          </div>
          <p class="bbc-testimonial__quote">"{{ block.settings.quote }}"</p>
          <footer class="bbc-testimonial__footer">
            {% if block.settings.image %}
              <img src="{{ block.settings.image | image_url: width: 120 }}" alt="{{ block.settings.name }}" class="bbc-testimonial__avatar">
            {% else %}
              <div class="bbc-testimonial__avatar-placeholder">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                  <circle cx="12" cy="7" r="4"/>
                </svg>
              </div>
            {% endif %}
            <div>
              <span class="bbc-testimonial__name">{{ block.settings.name }}</span>
              {% if block.settings.role != blank %}
                <span class="bbc-testimonial__role">{{ block.settings.role }}</span>
              {% endif %}
            </div>
          </footer>
        </blockquote>
      {%- endfor -%}
    </div>
    
  </div>
</section>

<style>
  .bbc-testimonials-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 32px;
  }

  .bbc-testimonials-grid--2 {
    grid-template-columns: repeat(2, 1fr);
    max-width: 800px;
    margin: 0 auto;
  }
  
  .bbc-testimonial-card {
    margin: 0;
    padding: 40px;
    background: var(--bbc-white, var(--bbc-white));
    /* Fix 2026-02-24: was 24px — inconsistent with rest of site (12–16px).
       Reduced to 16px to match bbc-options__card, bbc-content__image-wrap etc. */
    border-radius: 16px;
    position: relative;
    /* Add subtle elevation so card is distinguishable on white background */
    border: 1px solid rgba(0, 0, 0, 0.06);
    box-shadow: 0 4px 16px -4px rgba(0, 0, 0, 0.08);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }

  .bbc-testimonial-card:hover {
    box-shadow: 0 8px 24px -4px rgba(0, 0, 0, 0.12);
    transform: translateY(-2px);
  }

  .bbc-section--white .bbc-testimonial-card {
    background: var(--bbc-white, var(--bbc-white));
    border-color: rgba(0, 0, 0, 0.07);
  }

  .bbc-section--cream .bbc-testimonial-card {
    background: var(--bbc-white, var(--bbc-white));
    border-color: rgba(63, 139, 102, 0.1);
  }
  
  .bbc-testimonial__quote-mark {
    color: var(--bbc-gold, var(--bbc-gold));
    margin-bottom: 20px;
  }
  
  .bbc-testimonial__quote {
    font-size: var(--text-lg, 1.5rem);
    font-weight: 500;
    line-height: 1.5;
    color: var(--bbc-heading, var(--bbc-forest));
    margin: 0 0 32px 0;
  }
  
  .bbc-testimonial__footer {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  
  .bbc-testimonial__avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
  }
  
  .bbc-testimonial__avatar-placeholder {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--bbc-cream, var(--bbc-cream));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bbc-gray-300, #94a3b8);
  }
  
  .bbc-section--white .bbc-testimonial__avatar-placeholder {
    background: var(--bbc-white, var(--bbc-white));
  }
  
  .bbc-testimonial__name {
    font-size: var(--text-base, 1.25rem);
    font-weight: 700;
    color: var(--bbc-heading, var(--bbc-forest));
    display: block;
  }
  
  .bbc-testimonial__role {
    font-size: 1.125rem;
    color: var(--bbc-text-muted, #64748b);
    display: block;
    margin-top: 4px;
  }
  
  @media (max-width: 768px) {
    .bbc-testimonials-grid,
    .bbc-testimonials-grid--2 {
      grid-template-columns: 1fr;
      max-width: 600px;
      margin: 0 auto;
    }
  }
</style>

{% schema %}
{
  "name": "BBC Testimonials",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Testimonials" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "What Our Builders Say" },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2 columns" },
        { "value": "3", "label": "3 columns" }
      ],
      "default": "3"
    },
    { "type": "select", "id": "background", "label": "Background", "options": [{ "value": "white", "label": "White" }, { "value": "cream", "label": "Cream" }], "default": "cream" }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" },
        { "type": "image_picker", "id": "image", "label": "Photo" }
      ]
    }
  ],
  "presets": [{ "name": "BBC Testimonials" }]
}
{% endschema %}
