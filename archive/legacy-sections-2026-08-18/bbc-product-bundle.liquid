{% comment %}
  BBC Product Bundle
  Kit + component pack together with savings
{% endcomment %}

<section class="bbc-bundle" id="bundle-{{ section.id }}">
  <div class="bbc-container">
    {% if section.settings.heading != blank %}
      <div class="bbc-bundle__header">
        <h2 class="bbc-bundle__title">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="bbc-bundle__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="bbc-bundle__content">
      <div class="bbc-bundle__products">
        {% for block in section.blocks %}
          {% if block.type == 'product' %}
            {% assign bundle_product = block.settings.product %}
            {% if bundle_product != blank %}
              <div class="bbc-bundle__product" {{ block.shopify_attributes }}>
                <div class="bbc-bundle__product-image">
                  {% if bundle_product.featured_image %}
                    {{ bundle_product.featured_image | image_url: width: 300 | image_tag:
                      loading: 'lazy',
                      alt: bundle_product.title
                    }}
                  {% endif %}
                </div>
                <div class="bbc-bundle__product-info">
                  <h3 class="bbc-bundle__product-title">{{ bundle_product.title }}</h3>
                  <p class="bbc-bundle__product-price">{{ bundle_product.price | money }}</p>
                </div>
                <input type="hidden" 
                       class="bbc-bundle__product-id" 
                       value="{{ bundle_product.selected_or_first_available_variant.id }}">
              </div>
              {% unless forloop.last %}
                <div class="bbc-bundle__plus">
                  {% render 'bbc-icons', icon: 'plus', size: 24 %}
                </div>
              {% endunless %}
            {% endif %}
          {% endif %}
        {% endfor %}
      </div>

      <div class="bbc-bundle__summary">
        <div class="bbc-bundle__equals">
          {% render 'bbc-icons', icon: 'equals', size: 32 %}
        </div>
        
        <div class="bbc-bundle__pricing">
          {% assign total_price = 0 %}
          {% for block in section.blocks %}
            {% if block.type == 'product' %}
              {% assign bundle_product = block.settings.product %}
              {% if bundle_product != blank %}
                {% assign total_price = total_price | plus: bundle_product.price %}
              {% endif %}
            {% endif %}
          {% endfor %}
          
          {% assign discount_percent = section.settings.discount_percent | default: 10 %}
          {% assign savings = total_price | times: discount_percent | divided_by: 100 %}
          {% assign bundle_price = total_price | minus: savings %}
          
          <div class="bbc-bundle__badge">
            Save {{ discount_percent }}%
          </div>
          
          <div class="bbc-bundle__price-compare">
            <span class="bbc-bundle__price-original">{{ total_price | money }}</span>
            <span class="bbc-bundle__price-bundle">{{ bundle_price | money }}</span>
          </div>
          
          <p class="bbc-bundle__savings">
            You save {{ savings | money }}
          </p>
          
          <button type="button" 
                  class="bbc-btn bbc-btn--{{ section.settings.button_style | default: 'secondary' }} bbc-bundle__button" 
                  id="bundle-add-{{ section.id }}"
                  data-bundle-price="{{ bundle_price }}">
            {% render 'bbc-icons', icon: 'cart', size: 20 %}
            <span>{{ section.settings.button_text | default: 'Add Bundle to Cart' }}</span>
          </button>
          
          {% if section.settings.note != blank %}
            <p class="bbc-bundle__note">{{ section.settings.note }}</p>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
.bbc-bundle {
  padding: 60px 0;
  background: {{ section.settings.background_color | default: 'var(--bbc-cream)' }};
}

.bbc-bundle__header {
  text-align: center;
  margin-bottom: 40px;
}

.bbc-bundle__title {
  font-size: clamp(1.75rem, 4vw, 2.25rem);
  font-weight: 700;
  color: var(--bbc-forest, var(--bbc-forest));
  margin: 0 0 8px;
}

.bbc-bundle__subtitle {
  font-size: 1.0625rem;
  color: var(--bbc-text-muted, #64748b);
  margin: 0;
}

.bbc-bundle__content {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40px;
  flex-wrap: wrap;
}

.bbc-bundle__products {
  display: flex;
  align-items: center;
  gap: 20px;
  flex-wrap: wrap;
  justify-content: center;
}

.bbc-bundle__product {
  background: white;
  border-radius: 12px;
  padding: 20px;
  text-align: center;
  width: 180px;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
}

.bbc-bundle__product-image {
  width: 120px;
  height: 120px;
  margin: 0 auto 12px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.bbc-bundle__product-image img {
  max-width: 100%;
  max-height: 100%;
  object-fit: contain;
}

.bbc-bundle__product-title {
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--bbc-forest, var(--bbc-forest));
  margin: 0 0 8px;
  line-height: 1.3;
}

.bbc-bundle__product-price {
  font-size: 1rem;
  font-weight: 700;
  color: var(--bbc-text-muted, #64748b);
  margin: 0;
}

.bbc-bundle__plus {
  color: var(--bbc-teal, var(--bbc-teal));
  flex-shrink: 0;
}

.bbc-bundle__summary {
  display: flex;
  align-items: center;
  gap: 24px;
}

.bbc-bundle__equals {
  color: var(--bbc-teal, var(--bbc-teal));
}

.bbc-bundle__pricing {
  background: white;
  border-radius: 16px;
  padding: 28px 36px;
  text-align: center;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.1);
  border: 2px solid var(--bbc-gold, var(--bbc-gold));
}

.bbc-bundle__badge {
  display: inline-block;
  padding: 6px 16px;
  background: var(--bbc-gold, var(--bbc-gold));
  color: var(--bbc-forest, var(--bbc-forest));
  font-size: 0.875rem;
  font-weight: 700;
  border-radius: 20px;
  margin-bottom: 16px;
}

.bbc-bundle__price-compare {
  margin-bottom: 8px;
}

.bbc-bundle__price-original {
  font-size: 1.125rem;
  color: var(--bbc-gray-300, #94a3b8);
  text-decoration: line-through;
  margin-right: 12px;
}

.bbc-bundle__price-bundle {
  font-size: 2rem;
  font-weight: 800;
  color: var(--bbc-forest, var(--bbc-forest));
}

.bbc-bundle__savings {
  font-size: 0.9375rem;
  color: var(--bbc-teal, var(--bbc-teal));
  font-weight: 600;
  margin: 0 0 20px;
}

.bbc-bundle__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  width: 100%;
  padding: 16px 28px;
  background: var(--bbc-forest, var(--bbc-forest));
  color: white;
  border: none;
  border-radius: 8px;
  font-weight: 600;
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.2s, transform 0.1s;
}

.bbc-bundle__button:hover {
  background: var(--bbc-teal, var(--bbc-teal));
}

.bbc-bundle__button:active {
  transform: scale(0.98);
}

.bbc-bundle__button.is-loading {
  opacity: 0.7;
  pointer-events: none;
}

.bbc-bundle__button.is-success {
  background: var(--bbc-teal, var(--bbc-teal));
}

.bbc-bundle__button:focus-visible {
  outline: 3px solid var(--bbc-gold, var(--bbc-gold));
  outline-offset: 3px;
}

@media (prefers-reduced-motion: reduce) {
  .bbc-bundle__button { transition: none; }
  .bbc-bundle__button:active { transform: none; }
}

.bbc-bundle__note {
  font-size: 0.8125rem;
  color: var(--bbc-text-muted, #64748b);
  margin: 16px 0 0;
}

@media (max-width: 768px) {
  .bbc-bundle__content {
    flex-direction: column;
  }
  
  .bbc-bundle__summary {
    flex-direction: column;
  }
  
  .bbc-bundle__equals {
    transform: rotate(90deg);
  }
}

@media (max-width: 480px) {
  .bbc-bundle {
    padding: 40px 0;
  }
  
  .bbc-bundle__product {
    width: 140px;
    padding: 16px;
  }
  
  .bbc-bundle__product-image {
    width: 80px;
    height: 80px;
  }
  
  .bbc-bundle__pricing {
    padding: 24px;
    width: 100%;
    max-width: 300px;
  }
}
</style>

<script>
(function() {
  const addButton = document.getElementById('bundle-add-{{ section.id }}');
  if (!addButton) return;
  
  const productIds = Array.from(document.querySelectorAll('#bundle-{{ section.id }} .bbc-bundle__product-id'))
    .map(input => input.value)
    .filter(id => id);
  
  if (productIds.length === 0) return;
  
  addButton.addEventListener('click', async function() {
    const buttonText = this.querySelector('span');
    const originalText = buttonText.textContent;
    
    this.classList.add('is-loading');
    buttonText.textContent = 'Adding...';
    
    try {
      // Add all products to cart
      const items = productIds.map(id => ({ id: parseInt(id), quantity: 1 }));
      
      const response = await fetch('/cart/add.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items })
      });
      
      if (!response.ok) throw new Error('Failed to add to cart');
      
      this.classList.remove('is-loading');
      this.classList.add('is-success');
      buttonText.textContent = 'Added!';
      
      // Update cart count
      const cartResponse = await fetch('/cart.js');
      const cart = await cartResponse.json();
      document.querySelectorAll('[data-cart-count]').forEach(el => {
        el.textContent = cart.item_count;
      });
      
      setTimeout(() => {
        this.classList.remove('is-success');
        buttonText.textContent = originalText;
      }, 2000);
      
    } catch (error) {
      this.classList.remove('is-loading');
      buttonText.textContent = 'Error - Try Again';
      
      setTimeout(() => {
        buttonText.textContent = originalText;
      }, 2000);
    }
  });
})();
</script>

{% schema %}
{
  "name": "BBC Product Bundle",
  "tag": "section",
  "class": "bbc-bundle-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bundle & Save"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Everything you need to complete your build"
    },
    {
      "type": "range",
      "id": "discount_percent",
      "label": "Discount Percentage",
      "min": 5,
      "max": 30,
      "step": 5,
      "default": 10
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Add Bundle to Cart"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary (Gold)" },
        { "value": "secondary", "label": "Secondary (Forest)" },
        { "value": "outline", "label": "Outline" },
        { "value": "outline-light", "label": "Outline Light" },
        { "value": "white", "label": "White" },
        { "value": "gold", "label": "Gold" }
      ],
      "default": "secondary"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Note (optional)",
      "default": "Bundle discount applied at checkout"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f5f0"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Product Bundle",
      "blocks": [
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}
