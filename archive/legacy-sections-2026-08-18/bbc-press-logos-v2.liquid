{% comment %}
  BBC Press Logos V2 — Real logos with grayscale effect
  Uses actual logo assets uploaded to theme
{% endcomment %}

{%- style -%}
  .bbc-press-logos {
    padding: 64px 24px;
    background: var(--bbc-cream);
  }

  .bbc-press-logos__container {
    max-width: 1100px;
    margin: 0 auto;
  }

  .bbc-press-logos__header {
    text-align: center;
    margin-bottom: 48px;
  }

  .bbc-press-logos__label {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #718096;
    margin-bottom: 8px;
  }

  .bbc-press-logos__heading {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 700;
    color: var(--bbc-forest);
    margin: 0;
  }

  .bbc-press-logos__grid {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 32px 48px;
  }

  .bbc-press-logos__item {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bbc-press-logos__item a {
    display: block;
    transition: transform 0.2s ease;
  }

  .bbc-press-logos__item a:hover {
    transform: scale(1.05);
  }

  .bbc-press-logos__item img {
    max-height: 40px;
    max-width: 140px;
    width: auto;
    filter: grayscale(100%);
    opacity: 0.6;
    transition: filter 0.3s ease, opacity 0.3s ease;
  }

  .bbc-press-logos__item:hover img {
    filter: grayscale(0%);
    opacity: 1;
  }

  /* Specific logo sizing */
  .bbc-press-logos__item--ft img {
    max-height: 28px;
  }

  .bbc-press-logos__item--guardian img {
    max-height: 24px;
  }

  .bbc-press-logos__item--telegraph img {
    max-height: 32px;
  }

  .bbc-press-logos__item--bikeradar img {
    max-height: 36px;
  }

  .bbc-press-logos__item--cyclingweekly img {
    max-height: 32px;
  }

  .bbc-press-logos__item--designmuseum img {
    max-height: 36px;
  }

  .bbc-press-logos__item--granddesigns img {
    max-height: 48px;
  }

  .bbc-press-logos__item--cnn img {
    max-height: 30px;
  }

  .bbc-press-logos__item--metro img {
    max-height: 26px;
  }

  .bbc-press-logos__item--fastcompany img {
    max-height: 22px;
  }

  @media (max-width: 600px) {
    .bbc-press-logos {
      padding: 48px 16px;
    }

    .bbc-press-logos__grid {
      gap: 24px 32px;
    }

    .bbc-press-logos__item img {
      max-height: 32px;
      max-width: 100px;
    }
  }
{%- endstyle -%}

<section class="bbc-press-logos">
  <div class="bbc-press-logos__container">
    <div class="bbc-press-logos__header">
      {% if section.settings.label != blank %}
        <div class="bbc-press-logos__label">{{ section.settings.label }}</div>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="bbc-press-logos__heading">{{ section.settings.heading }}</h2>
      {% endif %}
    </div>

    <div class="bbc-press-logos__grid">
      {% if section.settings.show_ft %}
        <div class="bbc-press-logos__item bbc-press-logos__item--ft">
          <a href="{{ section.settings.ft_link }}" target="_blank" rel="noopener" aria-label="Financial Times">
            <img src="{{ 'logo-financial-times.svg' | asset_url }}" alt="Financial Times" loading="lazy" width="140" height="28">
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_guardian %}
        <div class="bbc-press-logos__item bbc-press-logos__item--guardian">
          <a href="{{ section.settings.guardian_link }}" target="_blank" rel="noopener" aria-label="The Guardian">
            <img src="{{ 'logo-guardian.svg' | asset_url }}" alt="The Guardian" loading="lazy" width="140" height="24">
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_telegraph %}
        <div class="bbc-press-logos__item bbc-press-logos__item--telegraph">
          <a href="{{ section.settings.telegraph_link }}" target="_blank" rel="noopener" aria-label="The Telegraph">
            <img src="{{ 'logo-telegraph.svg' | asset_url }}" alt="The Telegraph" loading="lazy" width="140" height="32">
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_bikeradar %}
