          <a href="{{ section.settings.bikeradar_link }}" target="_blank" rel="noopener" aria-label="BikeRadar">
            <img src="{{ 'logo-bikeradar.svg' | asset_url }}" alt="BikeRadar" loading="lazy" width="120" height="36">
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_cyclingweekly %}
        <div class="bbc-press-logos__item bbc-press-logos__item--cyclingweekly">
          <a href="{{ section.settings.cyclingweekly_link }}" target="_blank" rel="noopener" aria-label="Cycling Weekly">
            <img src="{{ 'logo-cyclingweekly.svg' | asset_url }}" alt="Cycling Weekly" loading="lazy" width="130" height="32">
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_designmuseum %}
        <div class="bbc-press-logos__item bbc-press-logos__item--designmuseum">
          <a href="{{ section.settings.designmuseum_link }}" target="_blank" rel="noopener" aria-label="Design Museum">
            <img src="{{ 'logo-design-museum.svg' | asset_url }}" alt="Design Museum" loading="lazy" width="100" height="36">
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_granddesigns %}
        <div class="bbc-press-logos__item bbc-press-logos__item--granddesigns">
          <a href="{{ section.settings.granddesigns_link }}" target="_blank" rel="noopener" aria-label="Grand Designs">
            <img src="{{ 'logo-grand-designs.svg' | asset_url }}" alt="Grand Designs" loading="lazy" width="120" height="48">
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_roadcc %}
        <div class="bbc-press-logos__item">
          <a href="{{ section.settings.roadcc_link }}" target="_blank" rel="noopener" aria-label="road.cc">
            <img src="{{ 'logo-roadcc.svg' | asset_url }}" alt="road.cc" loading="lazy" width="80" height="32">
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_huck %}
        <div class="bbc-press-logos__item">
          <a href="{{ section.settings.huck_link }}" target="_blank" rel="noopener" aria-label="Huck Magazine">
            <img src="{{ 'logo-huck.svg' | asset_url }}" alt="Huck Magazine" loading="lazy" width="80" height="32">
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_cnn %}
        <div class="bbc-press-logos__item bbc-press-logos__item--cnn">
          <a href="{{ section.settings.cnn_link }}" target="_blank" rel="noopener" aria-label="CNN">
            <img src="{{ 'logo-cnn.svg' | asset_url }}" alt="CNN" loading="lazy" width="74" height="40">
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_metro %}
        <div class="bbc-press-logos__item bbc-press-logos__item--metro">
          <a href="{{ section.settings.metro_link }}" target="_blank" rel="noopener" aria-label="Metro">
            <img src="{{ 'logo-metro.svg' | asset_url }}" alt="Metro" loading="lazy" width="120" height="32">
          </a>
        </div>
      {% endif %}

      {% if section.settings.show_fastcompany %}
        <div class="bbc-press-logos__item bbc-press-logos__item--fastcompany">
          <a href="{{ section.settings.fastcompany_link }}" target="_blank" rel="noopener" aria-label="Fast Company">
            <img src="{{ 'logo-fastcompany.svg' | asset_url }}" alt="Fast Company" loading="lazy" width="120" height="30">
          </a>
        </div>
      {% endif %}
    </div>
  </div>
</section>

