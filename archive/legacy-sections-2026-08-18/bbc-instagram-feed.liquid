{% comment %}
  BBC Instagram Feed
  Display Instagram posts - uses Shopify's Instagram integration or manual images
{% endcomment %}

<section class="bbc-instagram" id="instagram-{{ section.id }}">
  <div class="bbc-container">
    {% if section.settings.heading != blank %}
      <div class="bbc-instagram__header">
        <h2 class="bbc-instagram__title">{{ section.settings.heading }}</h2>
        {% if section.settings.subheading != blank %}
          <p class="bbc-instagram__subtitle">{{ section.settings.subheading }}</p>
        {% endif %}
        {% if section.settings.instagram_handle != blank %}
          <a href="https://instagram.com/{{ section.settings.instagram_handle }}" 
             target="_blank" 
             rel="noopener"
             class="bbc-instagram__handle">
            {% render 'bbc-icons', icon: 'instagram', size: 20 %}
            @{{ section.settings.instagram_handle }}
          </a>
        {% endif %}
      </div>
    {% endif %}

    <div class="bbc-instagram__grid columns-{{ section.settings.columns }}">
      {% for block in section.blocks %}
        <a href="{{ block.settings.post_url | default: 'https://instagram.com/' | append: section.settings.instagram_handle }}" 
           target="_blank" 
           rel="noopener"
           class="bbc-instagram__item"
           {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 600 | image_tag: 
              loading: 'lazy',
              class: 'bbc-instagram__image',
              alt: block.settings.caption | default: 'Instagram post'
            }}
          {% else %}
            <div class="bbc-instagram__placeholder">
              {% render 'bbc-icons', icon: 'image', size: 32 %}
            </div>
          {% endif %}
          <div class="bbc-instagram__overlay">
            <div class="bbc-instagram__stats">
              {% if block.settings.likes != blank %}
                <span class="bbc-instagram__stat">
                  {% render 'bbc-icons', icon: 'heart', size: 18 %}
                  {{ block.settings.likes }}
                </span>
              {% endif %}
              {% if block.settings.comments != blank %}
                <span class="bbc-instagram__stat">
                  {% render 'bbc-icons', icon: 'comment', size: 18 %}
                  {{ block.settings.comments }}
                </span>
              {% endif %}
            </div>
            {% if block.settings.caption != blank %}
              <p class="bbc-instagram__caption">{{ block.settings.caption | truncate: 80 }}</p>
            {% endif %}
            
            {% if block.settings.product_link != blank %}
              <a href="{{ block.settings.product_link }}" class="bbc-instagram__shop-btn">
                {% render 'bbc-icons', icon: 'shopping_cart', size: 16 %}
                Shop This Kit
              </a>
            {% endif %}
          </div>
        </a>
      {% endfor %}
    </div>

    {% if section.settings.button_text != blank %}
      <div class="bbc-instagram__footer">
        <a href="https://instagram.com/{{ section.settings.instagram_handle }}" 
           target="_blank" 
           rel="noopener"
           class="bbc-btn bbc-btn--{{ section.settings.button_style | default: 'secondary' }} bbc-instagram__button">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
  </div>
</section>

<style>
.bbc-instagram {
  padding: var(--section-py, 80px) var(--section-px, 24px);
  background: {{ section.settings.background_color | default: 'var(--bbc-cream, var(--bbc-cream))' }};
}

.bbc-instagram__header {
  text-align: center;
  margin-bottom: 40px;
}

.bbc-instagram__title {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 700;
  color: var(--bbc-forest, var(--bbc-forest));
  margin: 0 0 8px;
}

.bbc-instagram__subtitle {
  font-size: var(--text-lg, 1.125rem);
  color: var(--bbc-text-muted, #64748b);
  margin: 0 0 var(--space-4, 16px);
}

.bbc-instagram__handle {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--bbc-forest, var(--bbc-forest));
  text-decoration: none;
  font-weight: 600;
  transition: color 0.2s;
}

.bbc-instagram__handle:hover {
  color: var(--bbc-teal, var(--bbc-teal));
}

.bbc-instagram__grid {
  display: grid;
  gap: 16px;
}

.bbc-instagram__grid.columns-4 {
  grid-template-columns: repeat(4, 1fr);
}

.bbc-instagram__grid.columns-5 {
  grid-template-columns: repeat(5, 1fr);
}

.bbc-instagram__grid.columns-6 {
  grid-template-columns: repeat(6, 1fr);
}

.bbc-instagram__item {
  position: relative;
  display: block;
  aspect-ratio: 1;
  overflow: hidden;
  border-radius: 8px;
  background: #e0e0e0;
}

.bbc-instagram__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.4s ease;
}

.bbc-instagram__placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: var(--bbc-gray-300, #94a3b8);
}

.bbc-instagram__overlay {
  position: absolute;
  inset: 0;
  background: rgba(7, 62, 39, 0.85);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 16px;
  opacity: 0;
  transition: opacity 0.3s ease;
}

.bbc-instagram__item:hover .bbc-instagram__image {
  transform: scale(1.1);
}

.bbc-instagram__item:hover .bbc-instagram__overlay,
.bbc-instagram__item:focus .bbc-instagram__overlay {
  opacity: 1;
}

.bbc-instagram__stats {
  display: flex;
  gap: 20px;
  color: white;
  margin-bottom: 12px;
}

.bbc-instagram__stat {
  display: flex;
  align-items: center;
  gap: 6px;
  font-weight: 600;
}

.bbc-instagram__caption {
  color: rgba(255, 255, 255, 0.9);
  font-size: 0.8125rem;
  text-align: center;
  margin: 0 0 12px;
  line-height: 1.4;
}

.bbc-instagram__shop-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 8px 16px;
  background: var(--bbc-teal, var(--bbc-teal));
  color: white;
  text-decoration: none;
  font-size: 0.875rem;
  font-weight: 600;
  border-radius: 6px;
  transition: background 0.2s, transform 0.2s;
}

.bbc-instagram__shop-btn:hover {
  background: var(--bbc-forest, var(--bbc-forest));
  transform: translateY(-1px);
}

.bbc-instagram__footer {
  text-align: center;
  margin-top: 32px;
}

.bbc-instagram__button {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 14px 28px;
  background: var(--bbc-forest, var(--bbc-forest));
  color: white;
  text-decoration: none;
  font-weight: 600;
  border-radius: 8px;
  transition: background 0.2s, transform 0.2s;
}

.bbc-instagram__button:hover {
  background: var(--bbc-teal, var(--bbc-teal));
  transform: translateY(-2px);
}

@media (max-width: 1024px) {
  .bbc-instagram__grid.columns-5,
  .bbc-instagram__grid.columns-6 {
    grid-template-columns: repeat(4, 1fr);
  }
}

@media (max-width: 768px) {
  .bbc-instagram__grid.columns-4,
  .bbc-instagram__grid.columns-5,
  .bbc-instagram__grid.columns-6 {
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
  }
  
  .bbc-instagram__item {
    border-radius: 4px;
  }
  
  .bbc-instagram__overlay {
    padding: 8px;
  }
  
  .bbc-instagram__caption {
    display: none;
  }
}

@media (max-width: 480px) {
  .bbc-instagram__grid.columns-4,
  .bbc-instagram__grid.columns-5,
  .bbc-instagram__grid.columns-6 {
    grid-template-columns: repeat(2, 1fr);
  }
}
</style>

{% schema %}
{
  "name": "BBC Instagram Feed",
  "tag": "section",
  "class": "bbc-instagram-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Follow the Build"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Real builds from our community"
    },
    {
      "type": "text",
      "id": "instagram_handle",
      "label": "Instagram Handle (without @)",
      "default": "bamboobicycleclub"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "4", "label": "4" },
        { "value": "5", "label": "5" },
        { "value": "6", "label": "6" }
      ],
      "default": "4"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Follow Us on Instagram"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary (Gold)" },
        { "value": "secondary", "label": "Secondary (Forest)" },
        { "value": "outline", "label": "Outline" },
        { "value": "outline-light", "label": "Outline Light" },
        { "value": "white", "label": "White" },
        { "value": "gold", "label": "Gold" }
      ],
      "default": "secondary"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f5f5f0"
    }
  ],
  "blocks": [
    {
      "type": "post",
      "name": "Post",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "url",
          "id": "post_url",
          "label": "Post URL"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "text",
          "id": "likes",
          "label": "Likes Count"
        },
        {
          "type": "text",
          "id": "comments",
          "label": "Comments Count"
        },
        {
          "type": "url",
          "id": "product_link",
          "label": "Link to Product (Shop This Post)",
          "info": "Optional - adds 'Shop This Kit' button to overlay"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Instagram Feed",
      "blocks": [
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" },
        { "type": "post" }
      ]
    }
  ]
}
{% endschema %}
