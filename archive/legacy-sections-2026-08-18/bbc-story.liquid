{% comment %}
  BBC Story Section — Company origin with Timeline & Unique Stats
  Features editable timeline milestones and distinctive stat badges
{% endcomment %}

<section class="bbc-story" data-testid="bbc-story">
  <div class="page-width">
    
    <div class="bbc-story__header">
      {% if section.settings.eyebrow != blank %}
        <p class="bbc-story__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      <h2 class="bbc-story__heading">{{ section.settings.heading }}</h2>
    </div>
    
    <div class="bbc-story__main {% render 'bbc-layout-classes', content_width: section.settings.content_width, visual_position: section.settings.visual_position, vertical_align: section.settings.vertical_align, mobile_order: section.settings.mobile_order, gap_size: section.settings.gap_size %}">
      {%- comment -%} Left: Story Text {%- endcomment -%}
      <div class="bbc-story__text bbc-layout__content">
        {{ section.settings.story_text }}
        
        {% if section.settings.founder_quote != blank %}
          <blockquote class="bbc-story__quote">
            <p>"{{ section.settings.founder_quote }}"</p>
            {% if section.settings.founder_name != blank %}
              <cite>— {{ section.settings.founder_name }}{% if section.settings.founder_role != blank %}, {{ section.settings.founder_role }}{% endif %}</cite>
            {% endif %}
          </blockquote>
        {% endif %}
      </div>
      
      {%- comment -%} Right: Unique Stats {%- endcomment -%}
      <div class="bbc-story__stats bbc-layout__visual">
        {%- assign stat_blocks = section.blocks | where: "type", "stat" -%}
        {% for block in stat_blocks %}
          <div class="bbc-story__stat bbc-story__stat--{{ forloop.index }}" {{ block.shopify_attributes }}>
            <div class="bbc-story__stat-ring">
              <span class="bbc-story__stat-number">{{ block.settings.number }}</span>
            </div>
            <span class="bbc-story__stat-label">{{ block.settings.label }}</span>
            {% if block.settings.detail != blank %}
              <span class="bbc-story__stat-detail">{{ block.settings.detail }}</span>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    </div>
    
    {%- comment -%} Timeline {%- endcomment -%}
    {%- assign timeline_blocks = section.blocks | where: "type", "milestone" -%}
    {% if timeline_blocks.size > 0 %}
      <div class="bbc-story__timeline">
        <h3 class="bbc-story__timeline-title">{{ section.settings.timeline_title | default: "Our Journey" }}</h3>
        <div class="bbc-story__timeline-track">
          {% for block in timeline_blocks %}
            <div class="bbc-story__milestone" {{ block.shopify_attributes }}>
              <span class="bbc-story__milestone-year">{{ block.settings.year }}</span>
              <div class="bbc-story__milestone-dot"></div>
              <div class="bbc-story__milestone-content">
                <strong>{{ block.settings.title }}</strong>
                {% if block.settings.description != blank %}
                  <p>{{ block.settings.description }}</p>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        </div>
      </div>
    {% endif %}
    
    {%- comment -%} Optional Image {%- endcomment -%}
    {% if section.settings.image != blank or section.settings.image_asset != blank %}
      <div class="bbc-story__image">
        {% if section.settings.image != blank %}
          {{ section.settings.image | image_url: width: 1200 | image_tag:
            loading: 'lazy',
            class: 'bbc-story__img',
            alt: section.settings.image.alt | default: 'BBC workshop'
          }}
        {% else %}
          <img class="bbc-story__img" src="{{ section.settings.image_asset | asset_url }}" loading="lazy" alt="{{ section.settings.image_alt | default: 'BBC workshop' | escape }}">
        {% endif %}
        {% if section.settings.image_caption != blank %}
          <p class="bbc-story__caption">{{ section.settings.image_caption }}</p>
        {% endif %}
      </div>
    {% endif %}
    
  </div>
</section>

<style>
.bbc-story {
  padding: 80px 0;
  background: var(--bbc-cream, var(--bbc-cream));
}

@media (max-width: 600px) {
  .bbc-story {
    padding: 48px 0;
  }
}

.bbc-story__header {
  text-align: center;
  margin-bottom: 48px;
}

.bbc-story__eyebrow {
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.15em;
  color: var(--bbc-teal, var(--bbc-teal));
  margin-bottom: 12px;
}

.bbc-story__heading {
  font-size: clamp(2.25rem, 4.5vw, 3rem);
  font-weight: 800;
  color: var(--bbc-forest, var(--bbc-forest));
  margin: 0;
  max-width: 800px;
  margin-left: auto;
  margin-right: auto;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.bbc-story__main {
  margin-bottom: 64px;
}

/* Story Text */
.bbc-story__text {
  font-size: 1.125rem;
  line-height: 1.8;
  color: var(--bbc-slate, #1e293b);
}

.bbc-story__text p {
  margin-bottom: 20px;
}

.bbc-story__quote {
  margin: 36px 0 0;
  padding: 28px 28px 28px 32px;
  background: var(--bbc-white, var(--bbc-white));
  border-left: 5px solid var(--bbc-gold, var(--bbc-gold));
  border-radius: 0 16px 16px 0;
  box-shadow: 0 4px 20px rgba(0,0,0,0.06);
}

.bbc-story__quote p {
  font-size: clamp(1.25rem, 2vw, 1.5rem);
  font-style: italic;
  font-weight: 500;
  color: var(--bbc-forest, var(--bbc-forest));
  margin-bottom: 16px;
  line-height: 1.55;
}

.bbc-story__quote cite {
  font-size: 0.9375rem;
  font-style: normal;
  font-weight: 600;
  color: var(--bbc-teal, var(--bbc-teal));
}

/* ===================================
   UNIQUE STATS - Bamboo Ring Design
   =================================== */
.bbc-story__stats {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.bbc-story__stat {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 24px;
  background: var(--bbc-white, var(--bbc-white));
  border-radius: 20px;
  border-bottom: 3px solid transparent;
  box-shadow: 0 2px 16px rgba(0,0,0,0.05);
  transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
}

.bbc-story__stat:hover {
  transform: translateY(-6px);
  box-shadow: 0 16px 32px rgba(7,62,39,0.12);
  border-bottom-color: var(--bbc-gold, var(--bbc-gold));
}

@media (prefers-reduced-motion: reduce) {
  .bbc-story__stat:hover {
    transform: none;
  }
}

/* Stat Ring - Bamboo segment inspired */
.bbc-story__stat-ring {
  flex-shrink: 0;
  width: 120px;
  height: 120px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  box-shadow: 0 4px 16px rgba(0,0,0,0.15);
}

/* Different ring colors for each stat */
.bbc-story__stat--1 .bbc-story__stat-ring {
  background: linear-gradient(135deg, var(--bbc-forest, var(--bbc-forest)) 0%, var(--bbc-teal, var(--bbc-teal)) 100%);
}

.bbc-story__stat--2 .bbc-story__stat-ring {
  background: linear-gradient(135deg, var(--bbc-gold, var(--bbc-gold)) 0%, #ffbd3d 100%);
}

.bbc-story__stat--3 .bbc-story__stat-ring {
  background: linear-gradient(135deg, var(--bbc-teal, var(--bbc-teal)) 0%, #5da97f 100%);
}

.bbc-story__stat--1 .bbc-story__stat-number,
.bbc-story__stat--3 .bbc-story__stat-number {
  color: var(--bbc-white);
}

.bbc-story__stat--2 .bbc-story__stat-number {
  color: var(--bbc-forest, var(--bbc-forest));
}

.bbc-story__stat-number {
  font-size: clamp(1.125rem, 1.8vw, 1.5rem);
  font-weight: 800;
  line-height: 1;
  text-align: center;
}

.bbc-story__stat-label {
  font-size: 1.125rem;
  font-weight: 700;
  color: var(--bbc-forest, var(--bbc-forest));
  display: block;
  line-height: 1.25;
}

.bbc-story__stat-detail {
  font-size: 0.875rem;
  color: var(--bbc-slate, #64748b);
  display: block;
  margin-top: 4px;
}

/* ===================================
   TIMELINE - Horizontal Scrollable
   =================================== */
.bbc-story__timeline {
  margin-top: 48px;
  padding-top: 48px;
  border-top: 1px solid rgba(0,0,0,0.1);
}

.bbc-story__timeline-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--bbc-forest, var(--bbc-forest));
  margin: 0 0 32px 0;
  text-align: center;
}

.bbc-story__timeline-track {
  display: flex;
  gap: 0;
  overflow-x: auto;
  padding-bottom: 20px;
  position: relative;
}

/* Timeline line */
.bbc-story__timeline-track::before {
  content: '';
  position: absolute;
  top: 32px;
  left: 0;
  right: 0;
  height: 3px;
  background: linear-gradient(90deg, var(--bbc-teal, var(--bbc-teal)) 0%, var(--bbc-gold, var(--bbc-gold)) 100%);
  z-index: 0;
}

.bbc-story__milestone {
  flex: 0 0 auto;
  width: 200px;
  text-align: center;
  position: relative;
  padding-top: 48px;
}

.bbc-story__milestone-year {
  display: block;
  font-size: 0.875rem;
  font-weight: 800;
  color: var(--bbc-gold, var(--bbc-gold));
  background: var(--bbc-forest, var(--bbc-forest));
  padding: 6px 14px;
  border-radius: 100px;
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  z-index: 2;
}

.bbc-story__milestone-dot {
  width: 16px;
  height: 16px;
  background: var(--bbc-teal, var(--bbc-teal));
  border: 3px solid var(--bbc-white, var(--bbc-white));
  border-radius: 50%;
  position: absolute;
  top: 24px;
  left: 50%;
  transform: translateX(-50%);
  z-index: 1;
  box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}

.bbc-story__milestone-content {
  background: var(--bbc-white, var(--bbc-white));
  padding: 20px 16px;
  border-radius: 12px;
  margin-top: 16px;
  box-shadow: 0 2px 12px rgba(0,0,0,0.06);
}

.bbc-story__milestone-content strong {
  display: block;
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--bbc-forest, var(--bbc-forest));
  margin-bottom: 6px;
}

.bbc-story__milestone-content p {
  font-size: 0.8125rem;
  color: var(--bbc-slate, #64748b);
  margin: 0;
  line-height: 1.5;
}

/* Image */
.bbc-story__image {
  margin-top: 48px;
}

.bbc-story__img {
  width: 100%;
  border-radius: 12px;
}

.bbc-story__caption {
  font-size: 0.875rem;
  color: var(--bbc-slate, #64748b);
  margin-top: 12px;
  text-align: center;
}

/* Mobile Adjustments */
@media (max-width: 768px) {
  .bbc-story {
    padding: 48px 0;
  }
  
  .bbc-story__stats {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
  }
  
  .bbc-story__stat {
    flex-direction: column;
    text-align: center;
    width: calc(50% - 12px);
    padding: 16px;
  }
  
  .bbc-story__stat:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 0 var(--bbc-gold, var(--bbc-gold));
  }
  
  .bbc-story__stat-ring {
    width: 88px;
    height: 88px;
  }
  
  .bbc-story__stat-number {
    font-size: 1.25rem;
  }
  
  .bbc-story__milestone {
    width: 160px;
  }

  /* Fix 2026-02-23: Timeline scroll — add right-edge fade to signal scrollability */
  .bbc-story__timeline {
    position: relative;
  }

  .bbc-story__timeline::after {
    content: '';
    position: absolute;
    right: 0;
    top: 64px; /* below the title */
    bottom: 20px;
    width: 48px;
    background: linear-gradient(to right, transparent, var(--bbc-cream, var(--bbc-cream)));
    pointer-events: none;
    z-index: 1;
  }
}

/* Scroll hint on mobile */
@media (max-width: 480px) {
  .bbc-story__timeline-track {
    -webkit-overflow-scrolling: touch;
    scroll-snap-type: x mandatory;
  }
  
  .bbc-story__milestone {
    scroll-snap-align: center;
  }
}

/* Fix 2026-02-23: Very small screens (≤400px) — stat cards too cramped in 2-column layout */
@media (max-width: 400px) {
  .bbc-story__stats {
    flex-direction: column;
    align-items: center;
  }

  .bbc-story__stat {
    width: 100%;
    max-width: 320px;
    flex-direction: row;
    text-align: left;
    gap: 16px;
  }

  .bbc-story__stat-label,
  .bbc-story__stat-detail {
    text-align: left;
  }
}
</style>

{% schema %}
{
  "name": "BBC Story",
  "tag": "section",
  "class": "section-bbc-story",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Our Story"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "14 years of teaching people to build"
    },
    {
      "type": "richtext",
      "id": "story_text",
      "label": "Story Text",
      "default": "<p>In 2012, James and Ian opened a small workshop in Hackney with one goal: prove that anyone can build a bicycle frame.</p><p>What started as a weekend experiment became a movement. Today, BBC frames have been ridden from London to New Zealand, across the Andes, and through monsoons in India.</p><p>Every bike we help create is someone's first — and usually their favourite.</p>"
    },
    {
      "type": "textarea",
      "id": "founder_quote",
      "label": "Founder Quote",
      "default": "If we want people to choose sustainable options, we need to offer something better than what polluting products can be."
    },
    {
      "type": "text",
      "id": "founder_name",
      "label": "Founder Name",
      "default": "James Marr"
    },
    {
      "type": "text",
      "id": "founder_role",
      "label": "Founder Role",
      "default": "Founder"
    },
    {
      "type": "header",
      "content": "Timeline"
    },
    {
      "type": "text",
      "id": "timeline_title",
      "label": "Timeline Title",
      "default": "Key Milestones"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "visual_position",
      "label": "Stats position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content/stats width ratio",
      "options": [
        { "value": "50-50", "label": "Equal (50/50)" },
        { "value": "60-40", "label": "More text (60/40)" },
        { "value": "40-60", "label": "More stats (40/60)" },
        { "value": "70-30", "label": "Mostly text (70/30)" }
      ],
      "default": "60-40"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "top"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile stack order",
      "options": [
        { "value": "image_first", "label": "Stats first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "text_first",
      "info": "Which appears first when stacked on mobile"
    },
    {
      "type": "select",
      "id": "gap_size",
      "label": "Gap between columns",
      "options": [
        { "value": "sm", "label": "Small (24px)" },
        { "value": "md", "label": "Medium (40px)" },
        { "value": "lg", "label": "Large (64px)" }
      ],
      "default": "lg"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_asset",
      "label": "Or theme-asset image filename",
      "info": "Filename of an image in /assets (e.g. bbc-rd-workshop.jpg). Used only if no Image is picked above."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image Caption"
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "4,000+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Bikes Built"
        },
        {
          "type": "text",
          "id": "detail",
          "label": "Detail (optional)",
          "info": "Additional context, e.g., 'Since 2012'"
        }
      ]
    },
    {
      "type": "milestone",
      "name": "Timeline Milestone",
      "settings": [
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "2012"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "BBC Founded"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "First workshop opens in Hackney"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Story",
      "blocks": [
        { "type": "stat", "settings": { "number": "4,000+", "label": "Bikes Built", "detail": "And counting" } },
        { "type": "stat", "settings": { "number": "36", "label": "Countries", "detail": "Worldwide" } },
        { "type": "stat", "settings": { "number": "13", "label": "Years", "detail": "Since 2012" } },
        { "type": "milestone", "settings": { "year": "2012", "title": "BBC Founded", "description": "James & Ian open first workshop in Hackney" } },
        { "type": "milestone", "settings": { "year": "2015", "title": "Design Museum", "description": "Featured in Cycle Revolution exhibition" } },
        { "type": "milestone", "settings": { "year": "2018", "title": "Green Heroes", "description": "Kevin McCloud award for sustainability" } },
        { "type": "milestone", "settings": { "year": "2020", "title": "Build to Bond", "description": "Prison rehabilitation programme launches" } },
        { "type": "milestone", "settings": { "year": "2025", "title": "Investec Winner", "description": "Beyond Business award for social impact" } }
      ]
    }
  ]
}
{% endschema %}

