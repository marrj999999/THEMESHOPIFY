{% comment %}
  BBC Partner Logos Bar
  Research: 6/8 social enterprises show partner/charity logos (WGAC, Bombas, charity:water)
  Purpose: Build credibility through visible partnerships
{% endcomment %}

{%- style -%}
.bbc-partners {
  padding: 48px 0;
  background: {{ section.settings.background_color }};
  border-top: 1px solid rgba(0,0,0,0.06);
  border-bottom: 1px solid rgba(0,0,0,0.06);
}

.bbc-partners__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

.bbc-partners__heading {
  text-align: center;
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: #718096;
  margin-bottom: 32px;
}

.bbc-partners__logos {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  align-items: center;
  gap: 48px;
}

.bbc-partners__logo {
  max-height: {{ section.settings.logo_height }}px;
  width: auto;
  opacity: 0.7;
  transition: opacity 0.2s ease;
  filter: grayscale(100%);
}

.bbc-partners__logo:hover {
  opacity: 1;
  filter: grayscale(0%);
}

.bbc-partners__logo-link {
  display: block;
}

/* Text-based partner (fallback when no logo) */
.bbc-partners__text-logo {
  font-size: 14px;
  font-weight: 600;
  color: #4a5568;
  white-space: nowrap;
}

@media (max-width: 749px) {
  .bbc-partners {
    padding: 32px 0;
  }
  
  .bbc-partners__logos {
    gap: 32px;
  }
  
  .bbc-partners__logo {
    max-height: {{ section.settings.logo_height | minus: 10 }}px;
  }
}
{%- endstyle -%}

<section class="bbc-partners">
  <div class="bbc-partners__container">
    {% if section.settings.heading != blank %}
      <p class="bbc-partners__heading">{{ section.settings.heading }}</p>
    {% endif %}
    
    <div class="bbc-partners__logos">
      {% for block in section.blocks %}
        {% if block.settings.logo != blank %}
          {% if block.settings.link != blank %}
            <a href="{{ block.settings.link }}" class="bbc-partners__logo-link" target="_blank" rel="noopener">
              {{ block.settings.logo | image_url: height: section.settings.logo_height | image_tag: class: 'bbc-partners__logo', alt: block.settings.name }}
            </a>
          {% else %}
            {{ block.settings.logo | image_url: height: section.settings.logo_height | image_tag: class: 'bbc-partners__logo', alt: block.settings.name }}
          {% endif %}
        {% else %}
          <span class="bbc-partners__text-logo">{{ block.settings.name }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BBC Partner Logos",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Our Partners & Supporters"
    },
    {
      "type": "range",
      "id": "logo_height",
      "label": "Logo height (px)",
      "min": 30,
      "max": 80,
      "step": 5,
      "default": 50
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    }
  ],
  "blocks": [
    {
      "type": "partner",
      "name": "Partner",
      "settings": [
        {
          "type": "text",
          "id": "name",
          "label": "Partner name",
          "default": "Partner Name"
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Partner Logos",
      "blocks": [
        { "type": "partner", "settings": { "name": "London South Bank University" }},
        { "type": "partner", "settings": { "name": "Oxford Brookes University" }},
        { "type": "partner", "settings": { "name": "University of Manchester" }},
        { "type": "partner", "settings": { "name": "HMP Lowdham Grange" }}
      ]
    }
  ]
}
{% endschema %}
