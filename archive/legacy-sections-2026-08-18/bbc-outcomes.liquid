{% comment %}
  BBC Outcomes Section
  Research: Timpson "75% stay long-term", Clink "65.6% less likely to reoffend"
  Pattern: Results-focused stats with clear success metrics
{% endcomment %}

{%- style -%}
.bbc-outcomes {
  padding: 80px 0;
  background: {{ section.settings.background_color }};
}

.bbc-outcomes__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 24px;
}

.bbc-outcomes__header {
  text-align: center;
  max-width: 700px;
  margin: 0 auto 64px;
}

.bbc-outcomes__eyebrow {
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--bbc-gold, var(--bbc-gold));
  margin-bottom: 16px;
}

.bbc-outcomes__heading {
  font-size: 36px;
  font-weight: 800;
  line-height: 1.2;
  color: var(--bbc-forest, var(--bbc-forest));
  margin-bottom: 16px;
}

.bbc-outcomes__intro {
  font-size: 18px;
  line-height: 1.6;
  color: #4a5568;
}

.bbc-outcomes__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 32px;
}

.bbc-outcomes__card {
  background: white;
  padding: 40px 32px;
  text-align: center;
  border-left: 4px solid var(--bbc-gold, var(--bbc-gold));
}

.bbc-outcomes__card-icon {
  width: 56px;
  height: 56px;
  background: var(--bbc-forest, var(--bbc-forest));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 24px;
  color: white;
}

.bbc-outcomes__card-number {
  font-size: 48px;
  font-weight: 800;
  color: var(--bbc-forest, var(--bbc-forest));
  line-height: 1;
  margin-bottom: 8px;
}

.bbc-outcomes__card-label {
  font-size: 18px;
  font-weight: 600;
  color: var(--bbc-forest, var(--bbc-forest));
  margin-bottom: 12px;
}

.bbc-outcomes__card-description {
  font-size: 15px;
  line-height: 1.6;
  color: #4a5568;
}

.bbc-outcomes__card-source {
  font-size: 12px;
  color: #718096;
  margin-top: 16px;
  font-style: italic;
}

@media (max-width: 749px) {
  .bbc-outcomes {
    padding: 48px 0;
  }
  
  .bbc-outcomes__heading {
    font-size: 28px;
  }
  
  .bbc-outcomes__card {
    padding: 32px 24px;
  }
  
  .bbc-outcomes__card-number {
    font-size: 40px;
  }
}
{%- endstyle -%}

<section class="bbc-outcomes">
  <div class="bbc-outcomes__container">
    <div class="bbc-outcomes__header">
      {% if section.settings.eyebrow != blank %}
        <p class="bbc-outcomes__eyebrow">{{ section.settings.eyebrow }}</p>
      {% endif %}
      
      <h2 class="bbc-outcomes__heading">{{ section.settings.heading }}</h2>
      
      {% if section.settings.intro != blank %}
        <p class="bbc-outcomes__intro">{{ section.settings.intro }}</p>
      {% endif %}
    </div>
    
    <div class="bbc-outcomes__grid">
      {% for block in section.blocks %}
        <div class="bbc-outcomes__card" {{ block.shopify_attributes }}>
          {% if block.settings.icon != blank %}
            <div class="bbc-outcomes__card-icon">
              {% render 'bbc-icons', icon: block.settings.icon %}
            </div>
          {% endif %}
          
          <div class="bbc-outcomes__card-number">{{ block.settings.number }}</div>
          <div class="bbc-outcomes__card-label">{{ block.settings.label }}</div>
          
          {% if block.settings.description != blank %}
            <p class="bbc-outcomes__card-description">{{ block.settings.description }}</p>
          {% endif %}
          
          {% if block.settings.source != blank %}
            <p class="bbc-outcomes__card-source">{{ block.settings.source }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BBC Outcomes",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Programme Results"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What We've Achieved"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction text",
      "default": "Measurable outcomes from our rehabilitation and education programmes."
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f8f6"
    }
  ],
  "blocks": [
    {
      "type": "outcome",
      "name": "Outcome",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon name",
          "default": "check-circle"
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number/Stat",
          "default": "High"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Completion Rate"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Programme participants consistently complete the full 6-week course."
        },
        {
          "type": "text",
          "id": "source",
          "label": "Source (optional)",
          "default": "HMP Lowdham Grange Pilot"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Outcomes",
      "blocks": [
        {
          "type": "outcome",
          "settings": {
            "icon": "check-circle",
            "number": "High",
            "label": "Completion Rates",
            "description": "Participants consistently complete the full Build to Bond programme.",
            "source": "HMP Lowdham Grange"
          }
        },
        {
          "type": "outcome",
          "settings": {
            "icon": "trending-up",
            "number": "~26%",
            "label": "Confidence Uplift",
            "description": "Measured improvement in self-confidence and self-esteem.",
            "source": "Participant Surveys"
          }
        },
        {
          "type": "outcome",
          "settings": {
            "icon": "briefcase",
            "number": "2",
            "label": "Employer Partners",
            "description": "Companies offering interviews to programme graduates.",
            "source": "Employment Pathway"
          }
        }
      ]
    }
  ]
}
{% endschema %}
