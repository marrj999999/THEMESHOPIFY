{% comment %}
  BBC Theory of Change Section — Rebuilt with hardcoded CSS
  Explains WHY bamboo bike building works for rehabilitation
{% endcomment %}

{%- style -%}
  .bbc-theory {
    padding: 80px 24px;
    background: white;
  }

  .bbc-theory__container {
    max-width: 1000px;
    margin: 0 auto;
  }

  .bbc-theory__header {
    text-align: center;
    margin-bottom: 56px;
  }

  .bbc-theory__heading {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    color: var(--bbc-forest);
    margin: 0 0 16px 0;
    letter-spacing: -0.02em;
  }

  .bbc-theory__intro {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 1.125rem;
    color: #4a5568;
    max-width: 720px;
    margin: 0 auto;
    line-height: 1.7;
  }

  .bbc-theory__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
  }

  @media (min-width: 768px) {
    .bbc-theory__grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 32px;
    }
  }

  .bbc-theory__card {
    background: var(--bbc-cream);
    padding: 32px;
    border-radius: 16px;
    position: relative;
  }

  .bbc-theory__number {
    position: absolute;
    top: -16px;
    left: 24px;
    width: 40px;
    height: 40px;
    background: var(--bbc-forest);
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .bbc-theory__title {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--bbc-forest);
    margin: 8px 0 12px 0;
  }

  .bbc-theory__description {
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 1rem;
    color: #4a5568;
    line-height: 1.65;
    margin: 0 0 16px 0;
  }

  .bbc-theory__evidence {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    background: white;
    border-radius: 8px;
    font-family: "Plus Jakarta Sans", system-ui, sans-serif;
    font-size: 0.8125rem;
    color: var(--bbc-teal);
    font-weight: 500;
  }

  .bbc-theory__evidence .material-symbols-outlined {
    font-size: 16px;
  }

  @media (max-width: 480px) {
    .bbc-theory {
      padding: 48px 16px;
    }

    .bbc-theory__card {
      padding: 28px 20px;
    }
  }
{%- endstyle -%}

<section class="bbc-theory">
  <div class="bbc-theory__container">
    <div class="bbc-theory__header">
      {% if section.settings.heading != blank %}
        <h2 class="bbc-theory__heading">{{ section.settings.heading }}</h2>
      {% endif %}
      {% if section.settings.intro != blank %}
        <p class="bbc-theory__intro">{{ section.settings.intro }}</p>
      {% endif %}
    </div>

    <div class="bbc-theory__grid">
      {% for block in section.blocks %}
        <div class="bbc-theory__card" {{ block.shopify_attributes }}>
          <div class="bbc-theory__number">{{ forloop.index }}</div>
          <h3 class="bbc-theory__title">{{ block.settings.title }}</h3>
          <p class="bbc-theory__description">{{ block.settings.description }}</p>
          {% if block.settings.evidence != blank %}
            <div class="bbc-theory__evidence">
              {% render 'bbc-icons', icon: 'verified' %}
              <span>{{ block.settings.evidence }}</span>
            </div>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "BBC Theory of Change",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Why Building Bikes Rebuilds Lives"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Introduction",
      "default": "Our rehabilitation programmes aren't just about learning a craft. They're built on proven principles of behavioural change and family connection."
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "The IKEA Effect"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Research shows we value things more when we build them ourselves. When a father builds a bike for his child, that emotional investment creates lasting bonds."
        },
        {
          "type": "text",
          "id": "evidence",
          "label": "Evidence Source",
          "default": "Featured in Financial Times"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Theory of Change",
      "blocks": [
        { "type": "pillar", "settings": { "title": "The IKEA Effect", "description": "Research shows we value things more when we build them ourselves. When a father builds a bike for his child, that emotional investment creates lasting bonds.", "evidence": "Featured in Financial Times" }},
        { "type": "pillar", "settings": { "title": "Family Ties Matter", "description": "Prisoners who maintain family contact are 39% less likely to reoffend. Building a bicycle creates a tangible connection — a present that represents presence.", "evidence": "Farmer Review (MoJ Research)" }},
        { "type": "pillar", "settings": { "title": "Hands-On Learning", "description": "Many people in prison struggled in traditional education. Working with their hands, solving real problems — this is how they learn best.", "evidence": "OCN Level 2 Accredited" }},
        { "type": "pillar", "settings": { "title": "Sustainable Self-Delivery", "description": "We train prison staff to deliver the programme independently. No ongoing dependency — a one-time investment that keeps delivering value.", "evidence": "Self-delivery model" }}
      ]
    }
  ]
}
{% endschema %}
