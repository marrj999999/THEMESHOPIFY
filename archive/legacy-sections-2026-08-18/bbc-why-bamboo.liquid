{% comment %}
  BBC Why Bamboo — Clean v2
{% endcomment %}

<section class="bbc-section bbc-section--{{ section.settings.background }}">
  <div class="bbc-container bbc-container--narrow">
    
    <div class="bbc-text-center bbc-mb-xl">
      {% if section.settings.label != blank %}
        <p class="bbc-label">{{ section.settings.label }}</p>
      {% endif %}
      <h2 class="bbc-heading-lg bbc-mb-md">{{ section.settings.heading }}</h2>
      {% if section.settings.intro != blank %}
        <p class="bbc-body-lg">{{ section.settings.intro }}</p>
      {% endif %}
    </div>
    
    <div class="bbc-why__content">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
        
          {%- when 'text_block' -%}
            <div class="bbc-why__block" {{ block.shopify_attributes }}>
              <h3 class="bbc-heading-sm bbc-mb-sm">{{ block.settings.heading }}</h3>
              <div class="bbc-body">{{ block.settings.text }}</div>
            </div>
          
          {%- when 'quote' -%}
            <blockquote class="bbc-why__quote" {{ block.shopify_attributes }}>
              <p class="bbc-quote__text">"{{ block.settings.quote }}"</p>
              <footer>
                <span class="bbc-quote__name">{{ block.settings.name }}</span>
                {% if block.settings.role != blank %}
                  <span class="bbc-quote__role">{{ block.settings.role }}</span>
                {% endif %}
              </footer>
            </blockquote>
          
          {%- when 'feature_list' -%}
            <div class="bbc-why__block" {{ block.shopify_attributes }}>
              <h3 class="bbc-heading-sm bbc-mb-md">{{ block.settings.heading }}</h3>
              <ul class="bbc-feature-list">
                {% if block.settings.feature_1 != blank %}<li class="bbc-feature-list__item">{{ block.settings.feature_1 }}</li>{% endif %}
                {% if block.settings.feature_2 != blank %}<li class="bbc-feature-list__item">{{ block.settings.feature_2 }}</li>{% endif %}
                {% if block.settings.feature_3 != blank %}<li class="bbc-feature-list__item">{{ block.settings.feature_3 }}</li>{% endif %}
                {% if block.settings.feature_4 != blank %}<li class="bbc-feature-list__item">{{ block.settings.feature_4 }}</li>{% endif %}
                {% if block.settings.feature_5 != blank %}<li class="bbc-feature-list__item">{{ block.settings.feature_5 }}</li>{% endif %}
              </ul>
            </div>
            
        {%- endcase -%}
      {%- endfor -%}
    </div>
    
  </div>
</section>

<style>
  .bbc-why__content {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  
  .bbc-why__block .bbc-body p {
    margin: 0 0 16px 0;
  }
  
  .bbc-why__block .bbc-body p:last-child {
    margin-bottom: 0;
  }
  
  .bbc-why__quote {
    margin: 0;
    padding: 32px;
    background: var(--bbc-cream, var(--bbc-cream));
    border-radius: 12px;
    border-left: 4px solid var(--bbc-gold, var(--bbc-gold));
  }
  
  .bbc-section--cream .bbc-why__quote {
    background: var(--bbc-white, var(--bbc-white));
  }
</style>

{% schema %}
{
  "name": "BBC Why Bamboo",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Why Bamboo?"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The Perfect Frame Material"
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "text_block",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    },
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote" },
        { "type": "text", "id": "name", "label": "Name" },
        { "type": "text", "id": "role", "label": "Role" }
      ]
    },
    {
      "type": "feature_list",
      "name": "Features",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Key Benefits" },
        { "type": "text", "id": "feature_1", "label": "Feature 1" },
        { "type": "text", "id": "feature_2", "label": "Feature 2" },
        { "type": "text", "id": "feature_3", "label": "Feature 3" },
        { "type": "text", "id": "feature_4", "label": "Feature 4" },
        { "type": "text", "id": "feature_5", "label": "Feature 5" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Why Bamboo"
    }
  ]
}
{% endschema %}
