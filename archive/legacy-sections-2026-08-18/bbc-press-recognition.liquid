{% comment %}
  BBC Press & Recognition Section
  Shows press quotes and awards for credibility
{% endcomment %}

<section class="bbc-press" data-testid="bbc-press">
  <div class="page-width">
    
    {% if section.settings.eyebrow != blank %}
      <p class="bbc-press__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    
    <h2 class="bbc-press__heading">{{ section.settings.heading }}</h2>
    
    {%- comment -%} Featured Press Quote {%- endcomment -%}
    {% if section.settings.featured_quote != blank %}
      <blockquote class="bbc-press__featured">
        <p>"{{ section.settings.featured_quote }}"</p>
        <cite>
          {% if section.settings.quote_source_logo != blank %}
            {{ section.settings.quote_source_logo | image_url: width: 120 | image_tag: 
              class: 'bbc-press__source-logo',
              alt: section.settings.quote_source
            }}
          {% endif %}
          <span>{{ section.settings.quote_source }}</span>
          {% if section.settings.quote_date != blank %}
            <span class="bbc-press__date">{{ section.settings.quote_date }}</span>
          {% endif %}
        </cite>
      </blockquote>
    {% endif %}
    
    {%- comment -%} Awards Grid — H3 removed to avoid redundancy with H2 heading {%- endcomment -%}
    {% if section.blocks.size > 0 %}
      <div class="bbc-press__awards">
        <div class="bbc-press__awards-grid">
          {% for block in section.blocks %}
            {% if block.type == 'award' %}
              <div class="bbc-press__award" {{ block.shopify_attributes }}>
                {% if block.settings.icon != blank %}
                  {% render 'bbc-icons', icon: block.settings.icon, size: 24 %}
                {% endif %}
                <div class="bbc-press__award-content">
                  <h4 class="bbc-press__award-name">{{ block.settings.name }}</h4>
                  {% if block.settings.year != blank %}
                    <span class="bbc-press__award-year">{{ block.settings.year }}</span>
                  {% endif %}
                  {% if block.settings.description != blank %}
                    <p class="bbc-press__award-desc">{{ block.settings.description }}</p>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    {% endif %}
    
  </div>
</section>

<style>
.bbc-press {
  padding: var(--bbc-space-16) 0;
  background: var(--bbc-white);
}

.bbc-press__eyebrow {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--bbc-teal, var(--bbc-teal));
  margin-bottom: var(--bbc-space-4);
  text-align: center;
}

.bbc-press__heading {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 700;
  color: var(--bbc-forest, var(--bbc-forest));
  margin: 0 0 var(--bbc-space-10);
  text-align: center;
}

.bbc-press__featured {
  max-width: 800px;
  margin: 0 auto var(--bbc-space-12);
  padding: var(--bbc-space-8);
  background: var(--bbc-cream, var(--bbc-cream));
  border-radius: 12px;
  text-align: center;
}

.bbc-press__featured p {
  font-size: clamp(1.25rem, 3vw, 1.5rem);
  font-style: italic;
  line-height: 1.6;
  color: var(--bbc-forest, var(--bbc-forest));
  margin: 0 0 var(--bbc-space-6);
}

.bbc-press__featured cite {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: var(--bbc-space-2);
  font-style: normal;
}

.bbc-press__source-logo {
  height: 24px;
  width: auto;
}

.bbc-press__featured cite span {
  font-weight: 600;
  color: var(--bbc-slate, #1e293b);
}

.bbc-press__date {
  font-size: 0.875rem;
  color: var(--bbc-slate, #64748b) !important;
  font-weight: 400 !important;
}

.bbc-press__awards {
  margin-bottom: var(--bbc-space-12);
}

.bbc-press__awards-title {
  font-size: 1rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--bbc-slate, #64748b);
  margin-bottom: var(--bbc-space-6);
  text-align: center;
}

.bbc-press__awards-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
  gap: var(--bbc-space-4);
}

.bbc-press__award {
  display: flex;
  align-items: flex-start;
  gap: var(--bbc-space-4);
  padding: var(--bbc-space-4);
  background: var(--bbc-cream, var(--bbc-cream));
  border-radius: 8px;
}

.bbc-press__award-icon {
  font-size: 2rem;
  color: var(--bbc-gold, var(--bbc-gold));
}

.bbc-press__award-name {
  font-size: 1rem;
  font-weight: 600;
  color: var(--bbc-forest, var(--bbc-forest));
  margin: 0;
}

.bbc-press__award-year {
  font-size: 0.875rem;
  color: var(--bbc-teal, var(--bbc-teal));
  font-weight: 500;
}

.bbc-press__award-desc {
  font-size: 0.875rem;
  color: var(--bbc-slate, #64748b);
  margin: var(--bbc-space-1) 0 0;
}
</style>

{% schema %}
{
  "name": "Press & Recognition",
  "tag": "section",
  "class": "section-bbc-press",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Press"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What They Say About Us"
    },
    {
      "type": "textarea",
      "id": "featured_quote",
      "label": "Featured Quote",
      "default": "Bamboo Bicycle Club taps into 'the IKEA effect' — that extra bit of affection people reserve for objects they put together themselves."
    },
    {
      "type": "image_picker",
      "id": "quote_source_logo",
      "label": "Source Logo"
    },
    {
      "type": "text",
      "id": "quote_source",
      "label": "Quote Source",
      "default": "Financial Times"
    },
    {
      "type": "text",
      "id": "quote_date",
      "label": "Quote Date",
      "default": "September 2025"
    },
    {
      "type": "text",
      "id": "awards_title",
      "label": "Awards Section Title",
      "default": "Awards & Recognition"
    }
  ],
  "blocks": [
    {
      "type": "award",
      "name": "Award",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Material Symbol Icon",
          "default": "emoji_events"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Award Name",
          "default": "Investec Beyond Business"
        },
        {
          "type": "text",
          "id": "year",
          "label": "Year",
          "default": "2025 Winner"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "Recognised for educational work in prisons"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Press & Recognition",
      "blocks": [
        { "type": "award", "settings": { "icon": "emoji_events", "name": "Investec Beyond Business", "year": "2025 Winner", "description": "£24,000 for prison education" } },
        { "type": "award", "settings": { "icon": "eco", "name": "Kevin McCloud's Green Heroes", "year": "2018", "description": "Grand Designs Live" } },
        { "type": "award", "settings": { "icon": "school", "name": "OCN Level 2 Accredited", "year": "", "description": "Educational programmes" } }
      ]
    }
  ]
}
{% endschema %}

