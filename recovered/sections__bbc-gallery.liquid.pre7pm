{% comment %}
  BBC Gallery — Clean v2
{% endcomment %}

<section class="bbc-section bbc-section--{{ section.settings.background }}">
  <div class="bbc-container">
    
    <div class="bbc-text-center bbc-mb-xl">
      {% if section.settings.label != blank %}
        <p class="bbc-label">{{ section.settings.label }}</p>
      {% endif %}
      <h2 class="bbc-heading-lg">{{ section.settings.heading }}</h2>
    </div>
    
    <div class="bbc-gallery__grid bbc-gallery__grid--{{ section.settings.columns }} bbc-gallery__grid--ratio-{{ section.settings.image_ratio | default: 'landscape' }}">
      {% for block in section.blocks %}
        <figure class="bbc-gallery__item" {{ block.shopify_attributes }}>
          {% if block.settings.image != blank %}
            {{ block.settings.image | image_url: width: 600 | image_tag:
              loading: 'lazy',
              class: 'bbc-gallery__image',
              alt: block.settings.alt | default: block.settings.image.alt | default: 'Gallery image'
            }}
            {% if block.settings.caption != blank %}
              <figcaption class="bbc-gallery__caption">{{ block.settings.caption }}</figcaption>
            {% endif %}
          {% else %}
            <div class="bbc-gallery__placeholder">
              <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
            </div>
          {% endif %}
        </figure>
      {% endfor %}

      {% if section.blocks.size == 0 %}
        <p class="bbc-gallery__empty">Add images using the theme editor</p>
      {% endif %}
    </div>
    
    {% if section.settings.button_text != blank %}
      <div class="bbc-text-center bbc-gallery__cta">
        <a href="{{ section.settings.button_link }}" class="bbc-btn bbc-btn--{{ section.settings.button_style | default: 'primary' }}">
          {{ section.settings.button_text }}
        </a>
      </div>
    {% endif %}
    
  </div>
</section>

<style>
  .bbc-gallery__grid {
    display: grid;
    gap: 16px;
  }
  
  .bbc-gallery__grid--2 { grid-template-columns: repeat(2, 1fr); }
  .bbc-gallery__grid--3 { grid-template-columns: repeat(3, 1fr); }
  .bbc-gallery__grid--4 { grid-template-columns: repeat(4, 1fr); }
  
  .bbc-gallery__item {
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
  }
  
  .bbc-gallery__image {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    display: block;
  }

  .bbc-gallery__grid--ratio-auto .bbc-gallery__image { aspect-ratio: auto; }
  .bbc-gallery__grid--ratio-square .bbc-gallery__image { aspect-ratio: 1 / 1; }
  .bbc-gallery__grid--ratio-landscape .bbc-gallery__image { aspect-ratio: 4 / 3; }
  .bbc-gallery__grid--ratio-wide .bbc-gallery__image { aspect-ratio: 16 / 9; }

  .bbc-gallery__placeholder {
    aspect-ratio: 4 / 3;
    background: var(--bbc-cream, var(--bbc-cream));
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--bbc-text-muted, #4a4a4a);
    font-size: 0.875rem;
  }
  
  .bbc-section--cream .bbc-gallery__placeholder {
    background: var(--bbc-white, var(--bbc-white));
  }
  
  .bbc-gallery__caption {
    padding: 8px 12px;
    font-size: 0.875rem;
    color: var(--bbc-text-muted, #64748b);
    text-align: center;
    font-style: italic;
  }

  .bbc-gallery__empty {
    grid-column: 1 / -1;
    text-align: center;
    padding: 40px;
    color: var(--bbc-text-muted, #64748b);
    font-size: 0.9375rem;
  }

  .bbc-gallery__cta {
    margin-top: 40px;
  }

  @media (max-width: 768px) {
    .bbc-gallery__grid--3,
    .bbc-gallery__grid--4 {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  
  @media (max-width: 480px) {
    .bbc-gallery__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "BBC Gallery",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Gallery"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Bikes Built by Our Community"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "auto", "label": "Original" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "wide", "label": "Wide (16:9)" }
      ],
      "default": "landscape"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary (Gold)" },
        { "value": "secondary", "label": "Secondary (Forest)" },
        { "value": "outline", "label": "Outline" },
        { "value": "outline-light", "label": "Outline Light" },
        { "value": "white", "label": "White" },
        { "value": "gold", "label": "Gold" }
      ],
      "default": "primary"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" }
      ],
      "default": "cream"
    }
  ],
  "blocks": [
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" },
        { "type": "text", "id": "caption", "label": "Caption", "info": "Optional caption below image" }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Gallery",
      "blocks": [
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" },
        { "type": "image" }
      ]
    }
  ]
}
{% endschema %}
