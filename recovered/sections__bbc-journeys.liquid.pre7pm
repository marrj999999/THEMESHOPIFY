{% comment %}
  BBC Epic Journeys Section
  Showcases where BBC bikes have traveled — authenticity and adventure
{% endcomment %}

<section class="bbc-journeys" data-testid="bbc-journeys">
  <div class="page-width">
    
    {% if section.settings.eyebrow != blank %}
      <p class="bbc-journeys__eyebrow">{{ section.settings.eyebrow }}</p>
    {% endif %}
    
    <h2 class="bbc-journeys__heading">{{ section.settings.heading }}</h2>
    
    {%- comment -%} Featured Journey {%- endcomment -%}
    <div class="bbc-journeys__featured {% render 'bbc-layout-classes', content_width: section.settings.content_width, visual_position: section.settings.visual_position, vertical_align: section.settings.vertical_align, mobile_order: section.settings.mobile_order, gap_size: section.settings.gap_size %}">
      <div class="bbc-journeys__featured-image bbc-layout__visual">
        {% if section.settings.featured_image != blank %}
          {{ section.settings.featured_image | image_url: width: 800 | image_tag:
            loading: 'lazy',
            class: 'bbc-journeys__img',
            alt: section.settings.featured_name
          }}
        {% else %}
          <div class="bbc-journeys__placeholder">
            {% render 'bbc-icons', icon: 'bike' %}
          </div>
        {% endif %}
      </div>
      <div class="bbc-journeys__featured-content bbc-layout__content">
        <span class="bbc-journeys__distance">{{ section.settings.featured_distance }}</span>
        <h3 class="bbc-journeys__featured-title">{{ section.settings.featured_title }}</h3>
        <p class="bbc-journeys__featured-name">{{ section.settings.featured_name }}</p>
        
        {% if section.settings.featured_quote != blank %}
          <blockquote class="bbc-journeys__quote">
            <p>"{{ section.settings.featured_quote }}"</p>
          </blockquote>
        {% endif %}
        
        {% if section.settings.featured_description != blank %}
          <p class="bbc-journeys__featured-desc">{{ section.settings.featured_description }}</p>
        {% endif %}
        
        {% if section.settings.featured_link != blank %}
          <a href="{{ section.settings.featured_link }}" class="bbc-journeys__link">
            Read the story
            <span class="material-symbols-rounded">arrow_forward</span>
          </a>
        {% endif %}
      </div>
    </div>
    
    {%- comment -%} Other Journeys Grid {%- endcomment -%}
    {% if section.blocks.size > 0 %}
      <div class="bbc-journeys__grid">
        {% for block in section.blocks %}
          <div class="bbc-journeys__card" {{ block.shopify_attributes }}>
            {% if block.settings.image != blank %}
              <div class="bbc-journeys__card-image">
                {{ block.settings.image | image_url: width: 400 | image_tag:
                  loading: 'lazy',
                  alt: block.settings.route
                }}
              </div>
            {% endif %}
            <div class="bbc-journeys__card-content">
              {% if block.settings.distance != blank %}
                <span class="bbc-journeys__card-distance">{{ block.settings.distance }}</span>
              {% endif %}
              <h4 class="bbc-journeys__card-route">{{ block.settings.route }}</h4>
              {% if block.settings.rider != blank %}
                <p class="bbc-journeys__card-rider">{{ block.settings.rider }}</p>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
    {% endif %}
    
    {% if section.settings.cta_text != blank %}
      <div class="bbc-journeys__cta">
        <a href="{{ section.settings.cta_link }}" class="bbc-btn bbc-btn--{{ section.settings.button_style | default: 'outline-light' }}">
          {{ section.settings.cta_text }}
        </a>
      </div>
    {% endif %}
    
  </div>
</section>

<style>
.bbc-journeys {
  padding: var(--bbc-space-16) 0;
  background: var(--bbc-forest, var(--bbc-forest));
  color: var(--bbc-white);
}

/* GREEN BACKGROUND RULE: All text white, highlights gold */
.bbc-journeys,
.bbc-journeys * {
  color: var(--bbc-white);
}

.bbc-journeys__eyebrow {
  font-size: 0.75rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--bbc-gold, var(--bbc-gold)) !important;
  margin-bottom: var(--bbc-space-4);
}

.bbc-journeys__heading {
  font-size: clamp(1.75rem, 4vw, 2.5rem);
  font-weight: 700;
  color: var(--bbc-white) !important;
  margin: 0 0 var(--bbc-space-10);
}

.bbc-journeys__featured {
  margin-bottom: var(--bbc-space-12, 3rem);
}

.bbc-journeys__featured-image {
  border-radius: 12px;
  overflow: hidden;
}

.bbc-journeys__img {
  width: 100%;
  display: block;
}

.bbc-journeys__placeholder {
  aspect-ratio: 4/3;
  background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, rgba(255,255,255,0.05) 100%);
  border: 2px dashed rgba(255,255,255,0.2);
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: var(--bbc-space-3);
}

.bbc-journeys__placeholder .material-symbols-rounded {
  font-size: 3rem;
  opacity: 0.4;
}

.bbc-journeys__placeholder::after {
  content: 'Add photo';
  font-size: 0.875rem;
  opacity: 0.4;
}

.bbc-journeys__distance {
  display: inline-block;
  font-size: 0.875rem;
  font-weight: 600;
  color: var(--bbc-gold, var(--bbc-gold)) !important;
  background: rgba(255,169,0,0.2);
  padding: 0.25rem 0.75rem;
  border-radius: 100px;
  margin-bottom: var(--bbc-space-4);
}

.bbc-journeys__featured-title {
  font-size: 1.5rem;
  font-weight: 700;
  color: var(--bbc-white) !important;
  margin: 0 0 var(--bbc-space-2);
}

.bbc-journeys__featured-name {
  font-size: 1rem;
  color: rgba(255,255,255,0.7);
  margin: 0 0 var(--bbc-space-4);
}

.bbc-journeys__quote {
  margin: var(--bbc-space-4) 0;
  padding-left: var(--bbc-space-4);
  border-left: 3px solid var(--bbc-gold, var(--bbc-gold));
}

.bbc-journeys__quote p {
  font-size: 1.125rem;
  font-style: italic;
  line-height: 1.6;
  color: var(--bbc-white) !important;
  margin: 0;
}

.bbc-journeys__featured-desc {
  font-size: 0.9375rem;
  line-height: 1.6;
  color: rgba(255,255,255,0.8);
  margin: var(--bbc-space-4) 0;
}

.bbc-journeys__link {
  display: inline-flex;
  align-items: center;
  gap: var(--bbc-space-2);
  color: var(--bbc-gold, var(--bbc-gold));
  font-weight: 600;
  text-decoration: none;
}

.bbc-journeys__link:hover {
  text-decoration: underline;
}

.bbc-journeys__link .material-symbols-rounded {
  font-size: 1.25rem;
}

.bbc-journeys__grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  gap: var(--bbc-space-4);
}

.bbc-journeys__card {
  background: rgba(255,255,255,0.05);
  border-radius: 8px;
  overflow: hidden;
  transition: background 0.2s;
}

.bbc-journeys__card:hover {
  background: rgba(255,255,255,0.1);
}

@media (prefers-reduced-motion: reduce) {
  .bbc-journeys__card:hover {
    background: rgba(255,255,255,0.05);
  }
}

.bbc-journeys__card-image img {
  width: 100%;
  aspect-ratio: 16/10;
  object-fit: cover;
}

.bbc-journeys__card-content {
  padding: var(--bbc-space-4);
}

.bbc-journeys__card-distance {
  font-size: 0.75rem;
  font-weight: 600;
  color: var(--bbc-gold, var(--bbc-gold)) !important;
}

.bbc-journeys__card-route {
  font-size: 1rem;
  font-weight: 600;
  color: var(--bbc-white) !important;
  margin: var(--bbc-space-1) 0;
}

.bbc-journeys__card-rider {
  font-size: 0.875rem;
  color: rgba(255,255,255,0.6);
  margin: 0;
}

.bbc-journeys__cta {
  margin-top: var(--bbc-space-10);
  text-align: center;
}

.bbc-journeys .bbc-btn--outline {
  border-color: rgba(255,255,255,0.3);
  color: var(--bbc-white);
}

.bbc-journeys .bbc-btn--outline:hover {
  background: rgba(255,255,255,0.1);
  border-color: var(--bbc-white);
}
</style>

{% schema %}
{
  "name": "Epic Journeys",
  "tag": "section",
  "class": "section-bbc-journeys",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Adventure"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where Our Bikes Go"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "visual_position",
      "label": "Featured image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content/image width ratio",
      "options": [
        { "value": "50-50", "label": "Equal (50/50)" },
        { "value": "60-40", "label": "More text (60/40)" },
        { "value": "40-60", "label": "More image (40/60)" },
        { "value": "70-30", "label": "Mostly text (70/30)" }
      ],
      "default": "50-50"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile stack order",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first",
      "info": "Which appears first when stacked on mobile"
    },
    {
      "type": "select",
      "id": "gap_size",
      "label": "Gap between columns",
      "options": [
        { "value": "sm", "label": "Small (24px)" },
        { "value": "md", "label": "Medium (40px)" },
        { "value": "lg", "label": "Large (64px)" }
      ],
      "default": "md"
    },
    {
      "type": "image_picker",
      "id": "featured_image",
      "label": "Featured Image"
    },
    {
      "type": "text",
      "id": "featured_distance",
      "label": "Featured Distance",
      "default": "8,288 miles"
    },
    {
      "type": "text",
      "id": "featured_title",
      "label": "Featured Title",
      "default": "Colombia to Tierra del Fuego"
    },
    {
      "type": "text",
      "id": "featured_name",
      "label": "Featured Rider Name",
      "default": "Kate Rawles, Environmental Advocate"
    },
    {
      "type": "textarea",
      "id": "featured_quote",
      "label": "Featured Quote",
      "default": "Woody turned out to be the most reliable bike I've ever owned. I had hardly any mechanical problems on the whole journey."
    },
    {
      "type": "textarea",
      "id": "featured_description",
      "label": "Featured Description",
      "default": "Kate rode her BBC-built bamboo bike 'Woody' through the Andes, documenting the journey in her book 'The Life Cycle'."
    },
    {
      "type": "url",
      "id": "featured_link",
      "label": "Featured Link"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA Text",
      "default": "See More Adventures"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Gold Button" },
        { "value": "secondary", "label": "Forest Button" },
        { "value": "outline", "label": "Outline" },
        { "value": "outline-light", "label": "Outline Light" },
        { "value": "white", "label": "White Button" },
        { "value": "gold", "label": "Gold Hover" }
      ],
      "default": "outline-light"
    }
  ],
  "blocks": [
    {
      "type": "journey",
      "name": "Journey",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "distance",
          "label": "Distance"
        },
        {
          "type": "text",
          "id": "route",
          "label": "Route",
          "default": "London to New Zealand"
        },
        {
          "type": "text",
          "id": "rider",
          "label": "Rider"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Epic Journeys",
      "blocks": [
        { "type": "journey", "settings": { "route": "London to New Zealand", "distance": "12,000+ miles" } },
        { "type": "journey", "settings": { "route": "Pamir Highway, Winter", "distance": "1,200 miles" } },
        { "type": "journey", "settings": { "route": "Daily Commute, 7 Years", "rider": "Jamie, Romania" } }
      ]
    }
  ]
}
{% endschema %}
