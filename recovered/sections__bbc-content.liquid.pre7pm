{% comment %}
  BBC Content Section v5 — Enhanced with full customization
  - Adjustable image sizes and aspect ratios
  - Icon selection for features
  - Stats blocks
  - Better quote styling
{% endcomment %}

{%- liquid
  assign image_ratio = section.settings.image_ratio | default: 'auto'
  assign image_size = section.settings.image_size | default: 'medium'
-%}

<section class="bbc-section bbc-section--{{ section.settings.background }}">
  <div class="bbc-container">
    
    <div class="{% render 'bbc-layout-classes', content_width: section.settings.content_width, visual_position: section.settings.image_position, vertical_align: section.settings.vertical_align, mobile_order: section.settings.mobile_order, gap_size: section.settings.gap_size %}">
      
      {%- comment -%} Text Content {%- endcomment -%}
      <div class="bbc-content__text bbc-layout__content">
        {% if section.settings.label != blank %}
          <p class="bbc-label">{{ section.settings.label }}</p>
        {% endif %}
        
        {% if section.settings.heading != blank %}
          <h2 class="bbc-h2 bbc-mb-md">{{ section.settings.heading }}</h2>
        {% endif %}
        
        {% if section.settings.text != blank %}
          <div class="bbc-text-lg bbc-mb-lg">{{ section.settings.text }}</div>
        {% endif %}
        
        {%- comment -%} Blocks Container {%- endcomment -%}
        <div class="bbc-content__blocks">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
            
              {%- when 'feature' -%}
                <div class="bbc-content-feature" {{ block.shopify_attributes }}>
                  <div class="bbc-content-feature__icon bbc-content-feature__icon--{{ block.settings.icon_style }}">
                    {%- case block.settings.icon -%}
                      {%- when 'check' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                      {%- when 'star' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {%- when 'award' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="6"/><path d="M15.477 12.89L17 22l-5-3-5 3 1.523-9.11"/></svg>
                      {%- when 'users' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                      {%- when 'heart' -%}
                        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
                      {%- when 'shield' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                      {%- when 'book' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg>
                      {%- when 'target' -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
                      {%- else -%}
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    {%- endcase -%}
                  </div>
                  <div class="bbc-content-feature__content">
                    <span class="bbc-content-feature__text">{{ block.settings.text }}</span>
                    {% if block.settings.subtext != blank %}
                      <span class="bbc-content-feature__subtext">{{ block.settings.subtext }}</span>
                    {% endif %}
                  </div>
                </div>
              
              {%- when 'stat' -%}
                <div class="bbc-content-stat" {{ block.shopify_attributes }}>
                  <span class="bbc-content-stat__number">{{ block.settings.number }}</span>
                  <span class="bbc-content-stat__label">{{ block.settings.label }}</span>
                </div>
            
              {%- when 'quote' -%}
                <blockquote class="bbc-quote {% if block.settings.style == 'highlight' %}bbc-quote--highlight{% endif %}" {{ block.shopify_attributes }}>
                  <p class="bbc-quote__text">"{{ block.settings.quote }}"</p>
                  <footer class="bbc-quote__footer">
                    {% if block.settings.image != blank %}
                      <div class="bbc-quote__avatar">
                        {{ block.settings.image | image_url: width: 80 | image_tag: class: 'bbc-quote__avatar-img' }}
                      </div>
                    {% endif %}
                    <div class="bbc-quote__meta">
                      <span class="bbc-quote__author">{{ block.settings.name }}</span>
                      {% if block.settings.role != blank %}
                        <span class="bbc-quote__role">{{ block.settings.role }}</span>
                      {% endif %}
                    </div>
                  </footer>
                </blockquote>
                
            {%- endcase -%}
          {%- endfor -%}
        </div>
        
        {% if section.settings.button_text != blank %}
          <a href="{{ section.settings.button_link }}" class="bbc-btn bbc-btn--{{ section.settings.button_style | default: 'primary' }} bbc-content__button">
            {{ section.settings.button_text }}
          </a>
        {% endif %}
      </div>
      
      {%- comment -%} Visual Element {%- endcomment -%}
      <div class="bbc-content__visual bbc-content__visual--{{ image_size }} bbc-layout__visual">
        {% if section.settings.image != blank %}
          <div class="bbc-content__image-wrap bbc-content__image-wrap--{{ image_ratio }}">
            {{ section.settings.image | image_url: width: 1200 | image_tag:
              class: 'bbc-content__image',
              loading: 'lazy',
              alt: section.settings.image_alt | default: section.settings.heading
            }}
          </div>
          {% if section.settings.image_caption != blank %}
            <p class="bbc-content__caption">{{ section.settings.image_caption }}</p>
          {% endif %}
        {% else %}
          {%- comment -%} Placeholder — only show in Shopify editor, never on live storefront {%- endcomment -%}
          {% if request.design_mode %}
            <div class="bbc-content__placeholder">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <polyline points="21 15 16 10 5 21"></polyline>
              </svg>
              <span>Click to add image</span>
            </div>
          {% endif %}
        {% endif %}
      </div>
      
    </div>
    
  </div>
</section>

<style>
  /* Text Content */
  .bbc-content__text .bbc-text-lg p {
    margin: 0 0 16px 0;
    line-height: 1.7;
  }
  
  .bbc-content__text .bbc-text-lg p:last-child {
    margin-bottom: 0;
  }
  
  .bbc-content__button {
    margin-top: 32px;
  }
  
  /* Blocks Container */
  .bbc-content__blocks {
    margin-top: 24px;
  }
  
  /* Feature Blocks */
  .bbc-content-feature {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    padding: 12px 0;
  }
  
  .bbc-content-feature__icon {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  
  .bbc-content-feature__icon svg {
    width: 24px;
    height: 24px;
    color: var(--bbc-teal, var(--bbc-teal));
  }
  
  .bbc-content-feature__icon--circle {
    width: 40px;
    height: 40px;
    background: var(--bbc-teal, var(--bbc-teal));
    border-radius: 50%;
  }
  
  .bbc-content-feature__icon--circle svg {
    width: 20px;
    height: 20px;
    color: var(--bbc-white);
  }
  
  .bbc-content-feature__icon--square {
    width: 40px;
    height: 40px;
    background: #f0fdf4;
    border-radius: 8px;
  }
  
  .bbc-content-feature__content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .bbc-content-feature__text {
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--bbc-forest, var(--bbc-forest));
    line-height: 1.5;
  }
  
  .bbc-content-feature__subtext {
    font-size: 0.9375rem;
    color: var(--bbc-gray-500, #64748b);
    line-height: 1.5;
  }
  
  /* Stat Blocks */
  .bbc-content-stat {
    display: inline-flex;
    flex-direction: column;
    padding: 16px 24px 16px 0;
  }
  
  .bbc-content-stat__number {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--bbc-forest, var(--bbc-forest));
    line-height: 1.1;
  }
  
  .bbc-content-stat__label {
    font-size: 0.9375rem;
    color: var(--bbc-gray-500, #64748b);
    margin-top: 4px;
  }
  
  /* Quote Blocks */
  .bbc-quote {
    margin: 24px 0;
    padding: 24px;
    background: var(--bbc-cream);
    border-left: 4px solid var(--bbc-gold, var(--bbc-gold));
    border-radius: 0 12px 12px 0;
  }
  
  .bbc-quote--highlight {
    background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
    border-left-color: var(--bbc-forest, var(--bbc-forest));
  }
  
  .bbc-quote__text {
    font-size: 1.125rem;
    font-style: italic;
    color: var(--bbc-forest, var(--bbc-forest));
    line-height: 1.6;
    margin: 0 0 16px 0;
  }
  
  .bbc-quote__footer {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  
  .bbc-quote__avatar {
    flex-shrink: 0;
  }
  
  .bbc-quote__avatar-img {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    object-fit: cover;
  }
  
  .bbc-quote__meta {
    display: flex;
    flex-direction: column;
  }
  
  .bbc-quote__author {
    font-weight: 600;
    color: var(--bbc-forest, var(--bbc-forest));
  }
  
  .bbc-quote__role {
    font-size: 0.875rem;
    color: var(--bbc-gray-500, #64748b);
  }
  
  /* Image Visual — Fix 2026-02-24: removed padding-top: 32px which created
     32px of background colour above every image, making it look boxed-in.
     Visual alignment with title is handled by the flexbox vertical-align setting. */
  .bbc-content__visual {
    padding-top: 0;
  }
  
  .bbc-content__visual--small { max-width: 300px; }
  .bbc-content__visual--medium { max-width: 100%; }
  .bbc-content__visual--large { max-width: 100%; }
  
  .bbc-content__image-wrap {
    position: relative;
    overflow: hidden;
    border-radius: 16px;
    box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.15);
  }
  
  .bbc-content__image-wrap--auto { aspect-ratio: auto; }
  .bbc-content__image-wrap--square { aspect-ratio: 1 / 1; }
  .bbc-content__image-wrap--landscape { aspect-ratio: 4 / 3; }
  .bbc-content__image-wrap--wide { aspect-ratio: 16 / 9; }
  .bbc-content__image-wrap--portrait { aspect-ratio: 3 / 4; }
  
  .bbc-content__image-wrap:not(.bbc-content__image-wrap--auto) .bbc-content__image {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  .bbc-content__image {
    width: 100%;
    display: block;
  }
  
  .bbc-content__caption {
    margin-top: 12px;
    font-size: 0.875rem;
    color: var(--bbc-gray-500, #64748b);
    text-align: center;
    font-style: italic;
  }
  
  .bbc-content__placeholder {
    width: 100%;
    aspect-ratio: 4 / 3;
    background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%);
    border-radius: 16px;
    border: 2px dashed #86efac;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--bbc-forest, var(--bbc-forest));
    cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  
  .bbc-content__placeholder:hover {
    border-color: var(--bbc-teal, var(--bbc-teal));
    background: linear-gradient(135deg, #dcfce7 0%, #bbf7d0 100%);
  }
  
  .bbc-content__placeholder svg {
    width: 48px;
    height: 48px;
    opacity: 0.5;
  }
  
  .bbc-content__placeholder span {
    font-size: 0.9375rem;
    font-weight: 500;
    opacity: 0.7;
  }
  
  /* Mobile */
  @media (max-width: 768px) {
    .bbc-content-stat__number {
      font-size: 2rem;
    }
  }
</style>

{% schema %}
{
  "name": "BBC Content",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "info": "Small text above heading (e.g., 'Social Impact')"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Body text"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary (Gold)" },
        { "value": "secondary", "label": "Secondary (Forest)" },
        { "value": "outline", "label": "Outline" },
        { "value": "outline-light", "label": "Outline Light" },
        { "value": "white", "label": "White" },
        { "value": "gold", "label": "Gold" }
      ],
      "default": "primary"
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Image alt text",
      "info": "Describe the image for accessibility"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Image caption",
      "info": "Optional caption below image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image aspect ratio",
      "options": [
        { "value": "auto", "label": "Original" },
        { "value": "square", "label": "Square (1:1)" },
        { "value": "landscape", "label": "Landscape (4:3)" },
        { "value": "wide", "label": "Wide (16:9)" },
        { "value": "portrait", "label": "Portrait (3:4)" }
      ],
      "default": "auto"
    },
    {
      "type": "select",
      "id": "image_size",
      "label": "Image size",
      "options": [
        { "value": "small", "label": "Small" },
        { "value": "medium", "label": "Medium" },
        { "value": "large", "label": "Large" }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "right", "label": "Right" },
        { "value": "left", "label": "Left" }
      ],
      "default": "right"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content/Image ratio",
      "options": [
        { "value": "50-50", "label": "Equal (50/50)" },
        { "value": "60-40", "label": "More text (60/40)" },
        { "value": "40-60", "label": "More image (40/60)" },
        { "value": "70-30", "label": "Mostly text (70/30)" }
      ],
      "default": "50-50"
    },
    {
      "type": "select",
      "id": "vertical_align",
      "label": "Vertical alignment",
      "options": [
        { "value": "top", "label": "Top" },
        { "value": "center", "label": "Center" },
        { "value": "bottom", "label": "Bottom" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile stack order",
      "options": [
        { "value": "image_first", "label": "Image first" },
        { "value": "text_first", "label": "Text first" }
      ],
      "default": "image_first",
      "info": "Which appears first when stacked on mobile"
    },
    {
      "type": "select",
      "id": "gap_size",
      "label": "Gap between columns",
      "options": [
        { "value": "sm", "label": "Small (24px)" },
        { "value": "md", "label": "Medium (40px)" },
        { "value": "lg", "label": "Large (64px)" }
      ],
      "default": "lg"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        { "value": "white", "label": "White" },
        { "value": "cream", "label": "Cream" },
        { "value": "forest", "label": "Forest Green (dark)" },
        { "value": "teal", "label": "Teal Green" }
      ],
      "default": "white"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "check", "label": "✓ Checkmark" },
            { "value": "star", "label": "★ Star" },
            { "value": "award", "label": "🏆 Award" },
            { "value": "users", "label": "👥 People" },
            { "value": "heart", "label": "❤ Heart" },
            { "value": "shield", "label": "🛡 Shield" },
            { "value": "book", "label": "📖 Book" },
            { "value": "target", "label": "🎯 Target" }
          ],
          "default": "check"
        },
        {
          "type": "select",
          "id": "icon_style",
          "label": "Icon style",
          "options": [
            { "value": "plain", "label": "Plain" },
            { "value": "circle", "label": "Circle background" },
            { "value": "square", "label": "Square background" }
          ],
          "default": "plain"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Feature text"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Supporting text",
          "info": "Optional smaller text below"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Statistic",
      "settings": [
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "info": "e.g., '200+' or '4,000'"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "info": "e.g., 'graduates' or 'bikes built'"
        }
      ]
    },
    {
      "type": "quote",
      "name": "Quote",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote text"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role/Title"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Avatar image",
          "info": "Optional photo of the person"
        },
        {
          "type": "select",
          "id": "style",
          "label": "Style",
          "options": [
            { "value": "default", "label": "Default" },
            { "value": "highlight", "label": "Highlighted (gold)" }
          ],
          "default": "default"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "BBC Content",
      "blocks": [
        { "type": "feature", "settings": { "icon": "check", "text": "Feature one" } },
        { "type": "feature", "settings": { "icon": "check", "text": "Feature two" } },
        { "type": "feature", "settings": { "icon": "check", "text": "Feature three" } }
      ]
    }
  ]
}
{% endschema %}
