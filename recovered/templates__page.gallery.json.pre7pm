    "testimonials": {
      "type": "bbc-testimonials",
      "blocks": {
        "t1": {
          "type": "testimonial",
          "settings": {
            "quote": "I genuinely thought I'd fail. I have no mechanical skills whatsoever. Two days later I rolled out of the workshop on a bike I built myself. Still can't quite believe it.",
            "name": "Sarah K.",
            "role": "Marketing Manager",
            "location": "London"
          }
        },
        "t2": {
          "type": "testimonial",
          "settings": {
            "quote": "Built the balance bike kit with my daughter over a weekend. She's 7 now and still talks about 'our bike.' Best purchase I've ever made.",
            "name": "Marcus T.",
            "role": "Teacher",
            "location": "Bristol"
          }
        },
        "t3": {
          "type": "testimonial",
          "settings": {
            "quote": "I've built three frames now. Started with the workshop, then kits at home. There's nothing else like it.",
            "name": "Yuki M.",
            "role": "Software Developer",
            "location": "Tokyo"
          }
        },
        "t4": {
          "type": "testimonial",
          "settings": {
            "quote": "Ordered the kit to South Africa, built it in my garage, and now I commute on it every day. The support from the BBC community was incredible.",
            "name": "Johan V.",
            "role": "Architect",
            "location": "Cape Town"
          }
        }
      },
      "block_order": ["t1", "t2", "t3", "t4"],
      "settings": {
        "heading": "Builder Stories",
        "subheading": "What our community says"
      }
    },
    "instagram": {
      "type": "rich-text",
      "blocks": {
        "heading": {
          "type": "heading",
