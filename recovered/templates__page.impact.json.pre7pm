      ],
      "settings": {
        "eyebrow": "Community Impact",
        "section_heading": "Building Beyond Prison Walls",
        "section_sub": "",
        "text_align": "left",
        "quote": "Building the bike taught me more than I ever learned in school. I didn't think I could make something that actually worked — but I did.",
        "quote_mark": true,
        "name": "A young participant",
        "role": "Community programme, London",
        "photo_alt": "",
        "show_placeholder": false,
        "image_position": "right",
