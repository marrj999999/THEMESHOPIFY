      ],
      "settings": {
        "eyebrow": "In Their Words",
        "section_heading": "Stories From the Programme",
        "section_sub": "",
        "text_align": "left",
        "quote": "The bamboo bike course offers more than just technical training — it provides an avenue for creativity, teamwork, and self-expression. Watching the pride on a father's face when he presents a bike to his child is something special.",
        "quote_mark": true,
        "name": "Sally Allsopp",
        "role": "Industries Manager, HMP Lowdham Grange",
        "photo_alt": "",
        "show_placeholder": false,
        "image_position": "left",
        "background_color": "#f8f8f6",
        "padding_top": 80,
        "padding_bottom": 80
      }
    },
    "story-2": {
      "type": "bbc-participant-story",
      "blocks": {
