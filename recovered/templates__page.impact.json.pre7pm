    "mission": {
      "type": "bbc-impact-mission",
      "settings": {
        "eyebrow": "Our Mission",
        "heading": "We Open Pathways. We Build Skills. We Change Lives.",
        "intro": "We open pathways into green careers for people often excluded from traditional education — redefining how skills are learned through practical, hands-on making. By combining sustainable design, vocational training and real-world experience, we create accessible routes into employment and the green economy.",
        "show_pathway": true,
        "pathway": "Hands-on training → Skills development → Confidence & rehabilitation → Employment pathways",
        "background_color": "#f8f8f6",
        "padding_top": 80,
        "padding_bottom": 80
      },
      "blocks": {
        "col-education": {
          "type": "column",
          "settings": {
            "icon": "education",
            "title": "Education",
            "body": "OCN-accredited training (Level 1 & 2) in Sustainable Manufacturing. Practical STEM and vocational learning using industry-relevant skills in manufacturing and engineering.",
            "detail": "Nationally recognised qualification"
          }
        },
        "col-employment": {
          "type": "column",
          "settings": {
            "icon": "employment",
            "title": "Employment",
            "body": "Pathways into sustainable transport, manufacturing, construction and composites. Direct links to employers, apprenticeships and training providers.",
            "detail": "Guaranteed interview on release"
          }
        },
        "col-rehabilitation": {
          "type": "column",
          "settings": {
            "icon": "rehabilitation",
            "title": "Rehabilitation",
            "body": "Therapeutic, hands-on making builds patience, focus and resilience. Strengthens family connections through Build to Bond.",
            "detail": "90% prison course completion"
          }
        }
      },
      "block_order": [
        "col-education",
        "col-employment",
        "col-rehabilitation"
      ]
    },
