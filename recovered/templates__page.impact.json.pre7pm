{
  "sections": {
    "impact-hero": {
      "type": "bbc-impact-hero",
      "settings": {
        "eyebrow": "Our Impact",
        "giant_number": "1,533",
        "number_label": "People Empowered Since 2012",
        "heading": "Build Bikes. Build Skills. Build Futures.",
        "subheading": "Since 2012, we've empowered 1,533 people to build their own bamboo bicycle — developing real skills, confidence, and pathways to employment.",
        "cta_text": "Work With Us",
        "cta_link": "\/pages\/contact-us",
        "report_text": "Download Our Impact Report (PDF)",
        "report_link": "",
        "participant_quote": "The bike was the first thing I ever made with my own hands. When my daughter rode it on family visit day, I felt like a dad again.",
        "participant_name": "A Build to Bond participant, HMP Lowdham Grange",
        "background_color": "#ffffff",
        "cta2_text": "Watch Our Video",
        "cta2_link": "\/pages\/bamboo-bicycle-club-education"
      }
    },
