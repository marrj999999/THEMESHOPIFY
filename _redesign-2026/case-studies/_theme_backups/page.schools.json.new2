        },
        "s2": {
          "type": "stat",
          "settings": {
            "number": "OCN London",
            "label": "accredited outcomes",
            "source": "Level 1 Award, Practical Manufacturing Skills"
          }
        },
        "s3": {
          "type": "stat",
          "settings": {
            "number": "Benchmark 4",
            "label": "links your curriculum to careers",
            "source": "Gatsby Benchmarks"
          }
        },
        "s4": {
          "type": "stat",
          "settings": {
            "number": "KS3–post-16",
            "label": "curriculum-mapped, ages 11 to 19",
            "source": "Make Engineers curriculum maps"
          }
        },
        "p1": {
          "type": "programme",
          "settings": {
            "tier": "Foundation — start here, free",
            "title": "Acoustic Engineering & Sustainable Product Design",
            "detail": "A working bamboo speaker, built by hand — design the chamber, test the sound, learn the physics. A complete STEM project in 2–3 hours, curriculum-mapped and OCN-accredited. Ages 11–16, KS3–KS4. The taster: run it, then decide the rest.",
            "free": true,
            "status": "available"
          }
        },
        "p2": {
          "type": "programme",
          "settings": {
            "tier": "Frame I",
            "title": "Sustainable Product Engineering",
            "detail": "The first frame your students build — a bamboo balance bike. Their entry into structural design and precision fabrication, where a finished object has to hold real weight. The natural next step once the Speaker has hooked them.",
            "free": false,
            "price_tag": "Request a quote",
            "status": "coming"
          }
        },
        "p3": {
          "type": "programme",
          "settings": {
            "tier": "Frame II",
            "title": "Sustainable Bicycle Technical Development",
            "detail": "Students design, build and ride a real bamboo gravel frame — drawings, jig setup, mitring, structural bonding and quality checks, as a frame is made in industry. Multi-session, ages 14–18, KS4 / post-16.",
            "free": false,
            "price_tag": "Request a quote",
            "status": "available"
          }
        },
        "p4": {
          "type": "programme",
          "settings": {
            "tier": "Additive",
            "title": "Additive Manufacturing & Adaptive Design",
            "detail": "Students design and 3D-print the frame lugs themselves — parametric, adaptive design taken from screen to part. Ages 14–19, post-16. Where digital design meets real fabrication.",
            "free": false,
            "price_tag": "Request a quote",
            "status": "available"
          }
        },
        "p5": {
          "type": "programme",
          "settings": {
            "tier": "Systems",
            "title": "Electric Mobility Engineering & Green Technology",
            "detail": "Students wire and integrate the electronics that drive an electric bike — circuits, power and systems thinking, applied to clean transport. KS4 to post-16.",
            "free": false,
            "price_tag": "Request a quote",
            "status": "coming"
          }
        },
