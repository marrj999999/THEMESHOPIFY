      }
    },
    "press": {
      "type": "bbc-press-wall",
      "blocks": {
        "ft": {
          "type": "press_item",
          "settings": {
            "publication": "Financial Times",
            "title": "\"How Bamboo Bicycle Club is helping to break the prison cycle\"",
            "excerpt": "Taps into 'the IKEA effect' — extra affection people reserve for objects they put together themselves.",
            "date": "September 2025",
            "featured": true
          }
        },
        "bikeradar": {
          "type": "press_item",
          "settings": {
            "publication": "BikeRadar",
            "title": "First Ride Video Review",
            "excerpt": "How did it feel riding something that's mostly made from a member of the grass family?",
            "date": "April 2019",
            "featured": false
          }
        },
        "roadcc": {
          "type": "press_item",
          "settings": {
            "publication": "road.cc",
            "title": "5-Part Build Series",
            "excerpt": "Full documentation of the home build process from unboxing to first ride.",
            "date": "2018",
            "featured": false
          }
        },
        "dm": {
          "type": "press_item",
          "settings": {
            "publication": "Design Museum",
            "title": "Cycle Revolution Exhibition",
            "excerpt": "The only bamboo bicycle maker of its kind in Europe — live building demonstrations.",
            "date": "2015-2016",
            "featured": false
          }
        },
        "bikebiz": {
          "type": "press_item",
          "settings": {
            "publication": "BikeBiz",
            "title": "World's First 3D Printed Bamboo Bike",
            "excerpt": "Pioneering new manufacturing techniques which have enormous potential.",
            "date": "April 2016",
            "featured": false
          }
        },
        "huck": {
          "type": "press_item",
          "settings": {
            "publication": "Huck Magazine",
            "title": "Working Artisans Club",
            "excerpt": "Follows a niche-manufacturing business model that prioritises knowledge-sharing over profit-making retail.",
            "date": "2014",
            "featured": false
          }
        }
      },
