            "year": "2025",
            "description": "£24,000 award for Build to Bond prison rehabilitation programme",
            "style": "gold"
          }
        },
        "green-heroes": {
          "type": "award",
          "settings": {
            "icon": "eco",
            "title": "Kevin McCloud's Green Heroes",
            "year": "2018",
            "description": "Featured at Grand Designs Live for sustainable manufacturing innovation",
            "style": "green"
          }
        },
        "design-museum": {
          "type": "award",
          "settings": {
            "icon": "palette",
            "title": "Design Museum",
            "year": "2015-2016",
            "description": "Cycle Revolution exhibition with live building demonstrations",
            "style": "default"
          }
        },
        "ldf": {
          "type": "award",
          "settings": {
            "icon": "auto_awesome",
            "title": "London Design Festival",
            "year": "Partner",
            "description": "Official partner status for design innovation",
            "style": "default"
          }
        },
        "ocn": {
          "type": "award",
          "settings": {
            "icon": "description",
            "title": "OCN London Accredited",
            "year": "Level 2",
            "description": "Nationally recognised qualification in sustainable manufacturing",
            "style": "default"
          }
        },
        "world-first": {
          "type": "award",
          "settings": {
            "icon": "public",
            "title": "World First",
            "year": "2016",
            "description": "3D printed bamboo bicycle with Oxford Brookes University",
            "style": "default"
          }
        },
        "endorsement": {
          "type": "endorsement",
          "settings": {
            "quote": "Innovative projects, such as Build to Bond, support rehabilitation and help offenders build the skills they need for life after prison.",
            "name": "James Timpson",
            "title": "UK Minister for Prisons, Probation and Reducing Reoffending"
          }
        }
      },
      "block_order": [
