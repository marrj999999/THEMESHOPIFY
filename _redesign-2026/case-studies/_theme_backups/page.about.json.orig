      "settings": {
        "label": "Social Impact",
        "heading": "Build to Bond",
        "text": "<p>Through our Build to Bond programme, incarcerated parents build bamboo balance bikes for their children — creating meaningful gifts while developing valuable skills.<\/p><p>The programme delivers OCN Level 2 qualifications in sustainable manufacturing and has achieved remarkable outcomes in prisoner rehabilitation.<\/p>",
        "quote": "Innovative projects, such as Build to Bond, support rehabilitation and help offenders build the skills they need for life after prison.",
        "quote_name": "James Timpson",
        "quote_role": "UK Minister for Prisons, Probation and Reducing Reoffending",
        "button_text": "Learn about our impact",
        "button_link": "shopify:\/\/pages\/impact"
      }
    },
