    "founders": {
      "type": "bbc-founders",
      "blocks": {
        "james": {
          "type": "founder",
          "settings": {
            "name": "James Marr",
            "role": "Co-Founder & CEO",
            "bio": "James developed his bamboo bicycle-building skills in Canada before returning to London in 2012 to share this knowledge. He leads BBC's mission to make sustainable manufacturing accessible to everyone."
          }
        },
        "ian": {
          "type": "founder",
          "settings": {
            "name": "Ian McMillan",
            "role": "Co-Founder",
            "bio": "Ian co-founded BBC with James in 2012, bringing engineering expertise and a passion for sustainable transport to the venture."
          }
        }
      },
      "block_order": [
        "james",
        "ian"
      ],
      "settings": {
        "heading": "Meet the Founders"
      }
    },
    "timeline": {
      "type": "bbc-timeline",
      "blocks": {
        "2012": {
          "type": "milestone",
          "settings": {
            "year": "2012",
            "title": "The Beginning",
            "description": "Bamboo Bicycle Club founded in London by James Marr and Ian McMillan. James brought bamboo bicycle-building skills learned in Canada to share with others.",
            "current": false
          }
        },
        "2014": {
          "type": "milestone",
          "settings": {
            "year": "2014",
            "title": "DIY Kits Launch",
            "description": "After 3 years perfecting the process, we launch home build kits — enabling people worldwide to build their own bamboo bikes. Featured in Huck Magazine and Inhabitat.",
            "current": false
          }
        },
        "2015": {
          "type": "milestone",
          "settings": {
            "year": "2015",
            "title": "Design Museum",
            "description": "Featured in the Cycle Revolution exhibition at the Design Museum London. Live building demonstrations and world's first aerodynamic bamboo bicycle unveiled.",
            "current": false
          }
        },
        "2016": {
          "type": "milestone",
          "settings": {
            "year": "2016",
            "title": "World First",
            "description": "Created world's first 3D printed bamboo bicycle in collaboration with Oxford Brookes University — pioneering new manufacturing techniques.",
            "current": false
          }
        },
        "2018": {
          "type": "milestone",
          "settings": {
            "year": "2018",
            "title": "Green Heroes",
            "description": "Kevin McCloud's Green Heroes award at Grand Designs Live recognises our sustainable manufacturing innovation. Kate Rawles completes 8,288-mile journey through the Andes on her BBC bike.",
            "current": false
          }
        },
        "2020": {
          "type": "milestone",
          "settings": {
            "year": "2020",
            "title": "Social Enterprise",
            "description": "Bamboo Mobility Project CIC registered — our social enterprise arm delivering OCN-accredited courses in sustainable manufacturing to prisons and schools.",
            "current": false
          }
        },
        "2025": {
          "type": "milestone",
          "settings": {
            "year": "2025",
            "title": "Today",
            "description": "4,000+ people trained across 36+ countries. Investec Beyond Business winner. Financial Times feature. James Timpson government endorsement. And we're just getting started.",
            "current": true
          }
        }
      },
      "block_order": [
        "2012",
        "2014",
        "2015",
        "2016",
        "2018",
        "2020",
        "2025"
      ],
      "settings": {
        "heading": "Our Journey",
        "subheading": "From a small London workshop to a global community"
      }
    },
    "awards": {
      "type": "bbc-awards",
      "blocks": {
        "investec": {
