        "b19": {
          "type": "faq",
          "settings": {
            "question": "Does a bamboo bicycle frame crack or split?",
            "answer": "Properly treated and sealed bamboo is very stable. Our tubes are heat-treated to remove moisture and sealed with epoxy resin. Store indoors and avoid prolonged exposure to extreme wet conditions."
          }
        },
        "b20": {
          "type": "faq",
          "settings": {
            "question": "Can I ride a bamboo bike in the rain?",
            "answer": "Yes. Finished frames are fully sealed with epoxy resin. Dry your bike after wet rides and store it indoors — the same care you'd give any quality frame."
          }
        },
        "b21": {
          "type": "faq",
          "settings": {
            "question": "How strong is a bamboo frame?",
            "answer": "Bamboo has a superb strength-to-weight ratio — pound for pound it rivals metal, while being far lighter. In absolute terms it isn't as strong as steel, but it doesn't need to be: every joint in our frames is reinforced with carbon-fibre, and our bamboo is independently tested at Swansea University."
          }
        },
        "b22": {
          "type": "faq",
          "settings": {
            "question": "What about the joints?",
            "answer": "The carbon-and-epoxy lugs are engineered so the joint is never the weak point — in our builds the bamboo itself is the limiting factor, not the joins. The method has been refined over 13 years and 4,000+ builds."
          }
        },
        "b23": {
          "type": "faq",
          "settings": {
            "question": "How long will a bamboo frame last?",
            "answer": "Built to last. Many of our 2012 frames are still ridden daily — 13 years on — and across 4,000+ builds, frame failures are rare. Keep it sealed and stored indoors and it will go the distance."
          }
        },
        "b24": {
          "type": "faq",
          "settings": {
            "question": "Do I need experience to build one?",
            "answer": "No — most of our builders start with no prior experience. Workshop frames are completed in 2 days with full expert guidance; home kits include step-by-step instructions and video tutorials."
          }
        },
        "b25": {
          "type": "faq",
          "settings": {
            "question": "What types of bamboo bicycle can I build?",
            "answer": "Any type — road, gravel, mountain, cargo, tandem, balance bike. The geometry is defined by your jig setup, so the design is up to you."
          }
        },
        "b26": {
          "type": "faq",
          "settings": {
            "question": "Is bamboo a sustainable material for bicycles?",
            "answer": "Yes. Bamboo is a rapidly renewable grass — it matures in 3–5 years (trees take 20–50), regrows from its root system, and needs no pesticides or irrigation. And because you build the frame yourself, you learn to repair it, so it lasts for years rather than being thrown away."
          }
        }
      },
