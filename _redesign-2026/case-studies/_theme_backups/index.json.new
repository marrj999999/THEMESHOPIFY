        "b5": {
          "type": "door",
          "settings": {
            "fallback": "bbc-rd-bike-field.jpg",
            "image_alt": "Finished bamboo road bike leaning against a fence in the countryside",
            "tag": "Make",
            "title": "Build your own",
            "body": "Workshops in London, Amersfoort & Toulouse — or a kit shipped to your door. No experience needed.",
            "link_label": "Workshops & kits →"
          }
        },
        "b6": {
          "type": "door",
          "settings": {
            "fallback": "bbc-rd-workshop.jpg",
            "image_alt": "Inside the bamboo bicycle workshop",
            "tag": "Partner",
            "title": "Work with us",
            "body": "Accredited programmes for prisons, schools and colleges — plus corporate team-building days.",
            "link_label": "Our programmes →"
          }
        },
        "b7": {
          "type": "door",
          "settings": {
            "fallback": "bbc-rd-cohort.jpg",
            "image_alt": "The Bamboo Bicycle Club team in the London workshop",
            "tag": "Support",
            "title": "Back the mission",
            "body": "Fund a cohort, offer placements, or champion our work. £11.41 of social value for every £1.",
            "link_label": "Get involved →"
          }
        },
        "b8": {
          "type": "why",
          "settings": {
            "title": "Simple hand tools",
            "body": "No welding, no factory machinery — just a jig and a few hand tools."
          }
        },
        "b9": {
          "type": "why",
          "settings": {
            "title": "No experience needed",
            "body": "Most builders have never made anything before. We teach you every step."
          }
        },
        "b10": {
          "type": "why",
          "settings": {
            "title": "Low cost to start",
            "body": "A fast-growing, renewable material and a kit that ships worldwide."
          }
        },
        "b11": {
          "type": "why",
          "settings": {
            "title": "All ages & abilities",
            "body": "From schoolkids to Jon, who built a full frame with the use of one hand."
          }
        },
        "b12": {
          "type": "kit",
          "settings": {
            "fallback": "bbc-rd-prod-gravel.jpg",
            "image_alt": "Gravel lugged bamboo frame kit",
            "title": "Road & Gravel",
            "body": "Lugged or flax-joined kits with full video tutorials."
          }
        },
        "b13": {
          "type": "kit",
          "settings": {
            "fallback": "bbc-rd-kit-mtb.jpg",
            "image_alt": "Flax bamboo frame kit",
            "title": "Mountain",
            "body": "Burly geometries for 27.5\" and 29er builds."
          }
        },
        "b14": {
          "type": "kit",
          "settings": {
            "fallback": "bbc-rd-prod-balance.jpg",
            "image_alt": "Children's balance bike kit",
            "title": "Balance bikes",
            "body": "The little build — and the one gifted in Build to Bond."
          }
        },
        "b15": {
          "type": "kit",
          "settings": {
            "fallback": "bbc-rd-prod-build.jpg",
            "image_alt": "Bamboo frame mid-build",
            "title": "Components & tools",
            "body": "Jigs, lugs, glue and everything for the maker shop."
          }
        },
        "b16": {
          "type": "story",
          "settings": {
            "fallback": "bbc-rd-build-mint.jpg",
            "image_alt": "Finished mint-and-bamboo road bike built from a home-build kit",
            "quote": "When broken down, every step was actually simple and achievable. We think building things is a mythical thing only geniuses can do — it isn't.",
            "attribution": "Soraya · first-time builder",
            "lime": false
          }
        },
        "b17": {
          "type": "story",
          "settings": {
            "fallback": "bbc-rd-road-charlie.jpg",
            "image_alt": "Finished bamboo road bike",
            "quote": "Riding it for the first time is so different to one I bought from a shop. With this, I think: I made something.",
            "attribution": "As featured in The Independent",
            "lime": true
          }
        },
        "b18": {
          "type": "story",
          "settings": {
            "fallback": "bbc-rd-gravel-fence.jpg",
            "image_alt": "A flax-and-bamboo gravel bike built from a home kit",
            "quote": "Going to the workshop was hands-down one of the best things I have ever done — a bespoke creation that's structurally sound.",
            "attribution": "As featured in The Guardian",
            "lime": false
          }
        },
