    "pathways": {
      "type": "bbc-impact-funder-cta",
      "settings": {
        "eyebrow": "Where to next",
        "heading": "One club, many ways in",
        "subheading": "Whether you fund the work, teach with it, lead a team or just want to build — here's your way in."
      },
      "blocks": {
        "p1": {
          "type": "card",
          "settings": {
            "icon": "heart",
            "audience": "For funders & partners",
            "title": "See our social impact",
            "body": "Build to Bond rehabilitation, school STEM programmes, and a route into green careers — the difference your support makes.",
            "link_text": "Explore our impact",
            "link_url": "shopify:\/\/pages\/impact",
            "primary": true
          }
        },
        "p2": {
          "type": "card",
          "settings": {
            "icon": "school",
            "audience": "For schools & educators",
            "title": "STEM through making",
            "body": "Curriculum-linked bamboo-build projects that teach materials science, sustainability and engineering by hand.",
            "link_text": "Schools & education",
            "link_url": "shopify:\/\/pages\/schools",
            "primary": false
          }
        },
        "p3": {
          "type": "card",
          "settings": {
            "icon": "briefcase",
            "audience": "For companies",
            "title": "A team day that gives back",
            "body": "Your team builds a real bamboo bike together — often donated to a local cycling charity afterwards.",
            "link_text": "Team building",
            "link_url": "shopify:\/\/pages\/bicycleteambuilding",
            "primary": false
          }
        },
        "p4": {
          "type": "card",
          "settings": {
            "icon": "users",
            "audience": "For makers",
            "title": "Build your own",
            "body": "Join a workshop or take home a build kit — no experience needed. Most builders have never made anything before.",
            "link_text": "Workshops & kits",
            "link_url": "shopify:\/\/pages\/workshops",
            "primary": false
          }
        }
      },
