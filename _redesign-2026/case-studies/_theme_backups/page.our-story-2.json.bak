        "abstory_2": {
          "type": "story",
          "settings": {
            "kind": "Inclusion",
            "title": "Building with one hand",
            "blurb": "Jon built a complete bamboo frame with the use of one hand — proof anyone can.",
            "image": "https:\/\/cdn.shopify.com\/s\/files\/1\/0502\/8695\/2631\/articles\/88d9e8b8012621f5946b32ce93b74c6c_7c3d767e-9d23-46a5-9203-ddad728ff26e.jpg?v=1771793497",
