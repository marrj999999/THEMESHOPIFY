{
  "sections": {
    "main": {
      "type": "bbc-about-2026",
      "blocks": {
        "milestone_1": {
          "type": "milestone",
          "settings": {
            "year": "2012",
            "hot": false,
            "title": "A workshop in Hackney",
            "body": "Design engineers James Marr and Ian McMillan open the UK's first bamboo bike workshop. Within months, hundreds of people are building their own frames."
          }
        },
        "milestone_2": {
          "type": "milestone",
          "settings": {
            "year": "2015",
            "hot": false,
            "title": "The Design Museum, and kits worldwide",
            "body": "Featured in the Cycle Revolution exhibition at London's Design Museum. The home-build kit ships internationally — builders make frames at their kitchen tables, backed by video tutorials."
          }
        },
        "milestone_3": {
          "type": "milestone",
          "settings": {
            "year": "2018",
            "hot": false,
            "title": "Kevin McCloud's Green Heroes",
            "body": "Selected at Grand Designs Live, ExCeL London, as one of Kevin McCloud's Green Heroes for sustainable design."
          }
        },
        "milestone_4": {
          "type": "milestone",
          "settings": {
            "year": "2024",
            "hot": false,
            "title": "A social enterprise is born",
            "body": "Our social mission takes formal shape — the foundations of Bamboo Mobility Project CIC, our community-interest arm delivering accredited courses in prisons and schools."
          }
        },
        "milestone_5": {
          "type": "milestone",
          "settings": {
            "year": "2025",
            "hot": true,
            "title": "Build to Bond, and a breakthrough year",
            "body": "Our accredited frame-building course runs inside prisons, with the most engaged learners building a balance bike for their own child. The Financial Times profiles the work and the Prisons Minister names it directly; the Investec Beyond Business award follows."
          }
        },
        "milestone_6": {
          "type": "milestone",
          "settings": {
            "year": "Now",
            "hot": false,
            "title": "One engine for change",
            "body": "The shop and the mission run as one Community Interest Company — where every build helps fund a place on an accredited skills course."
          }
        },
        "value_1": {
          "type": "value",
          "settings": {
            "tag": "01",
            "lime": false,
            "title": "Craft over consumption",
            "body": "A bike you build yourself is a bike you never throw away. We teach making, not buying."
          }
        },
        "value_2": {
          "type": "value",
          "settings": {
            "tag": "02",
            "lime": false,
            "title": "Grown, not mined",
            "body": "Bamboo regrows in 3–5 years and recycles fully. Sustainability is the material, not the marketing."
          }
        },
        "value_3": {
          "type": "value",
          "settings": {
            "tag": "03",
            "lime": false,
            "title": "Open to everyone",
            "body": "From weekend workshops to prisons and schools, our goal is to put making within reach of people who'd never otherwise get the chance."
          }
        },
        "stat_1": {
          "type": "stat",
          "settings": {
            "number": "4,000+",
            "label": "people have built a bike",
            "source": "since 2012"
          }
        },
        "stat_2": {
          "type": "stat",
          "settings": {
            "number": "90%",
            "label": "prison course completion",
            "source": "BBC programme records"
          }
        },
        "stat_3": {
          "type": "stat",
          "settings": {
            "number": "£11.41",
            "label": "social return per £1",
            "source": "PACT research"
          }
        },
        "stat_4": {
          "type": "stat",
          "settings": {
            "number": "36",
            "label": "countries reached",
            "source": "kits shipped worldwide"
          }
        },
