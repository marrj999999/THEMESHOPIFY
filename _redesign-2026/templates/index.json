          }
        },
        "st1": {
          "type": "story",
          "settings": {
            "fallback": "bbc-rd-build-mint.jpg",
            "image_alt": "Finished mint-and-bamboo road bike built from a home-build kit",
            "quote": "After two years, I still burst with pride riding something completely unique that I made myself. I went from knowing nothing about bicycles to having built one.",
            "attribution": "Louise · home-build road bike",
            "lime": false
          }
        },
        "st2": {
          "type": "story",
          "settings": {
            "fallback": "bbc-rd-road-charlie.jpg",
            "image_alt": "Finished bamboo road bike",
            "quote": "To see the bike the first time and sit on it was euphoria — I still don't believe it. I was more taken than when I got my new car (sorry, car).",
            "attribution": "Tamas · workshop build",
            "lime": true
          }
        },
        "st3": {
          "type": "story",
          "settings": {
            "fallback": "bbc-rd-gravel-fence.jpg",
            "image_alt": "A flax-and-bamboo gravel bike built from a home kit",
            "quote": "Coooool! It feels so light, so natural and smooth — and then you add the feeling of proudness. That's the best part of it.",
            "attribution": "Maialen · home-build gravel, France",
            "lime": false
          }
        },
