          }
        },
        "d3": {
          "type": "door",
          "settings": {
            "fallback": "bbc-rd-team.jpg",
            "image_alt": "A diverse group laughing together while building a bamboo bike",
            "tag": "Support",
            "title": "Back the mission",
            "body": "Fund a cohort, offer placements, or champion our work. £11.41 of social value for every £1.",
            "link_label": "Get involved →"
          }
        },
        "w1": {
          "type": "why",
          "settings": {
            "title": "Strong as steel",
            "body": "Same tensile strength — yet workable with hand tools alone."
          }
        },
        "w2": {
          "type": "why",
          "settings": {
            "title": "Kinder ride",
            "body": "Absorbs road vibration better than carbon fibre."
          }
        },
        "w3": {
          "type": "why",
          "settings": {
            "title": "56.7% less carbon",
            "body": "56.7% lower carbon than an aluminium frame. Bamboo regrows in 3–5 years and recycles fully."
          }
        },
        "w4": {
          "type": "why",
          "settings": {
            "title": "Built to last",
            "body": "Our earliest 2012 frames are still ridden daily — looked after, a bamboo bike goes the distance."
          }
        },
        "k1": {
          "type": "kit",
          "settings": {
            "fallback": "bbc-rd-prod-gravel.jpg",
            "image_alt": "Gravel lugged bamboo frame kit",
            "title": "Road & Gravel",
            "body": "Lugged or flax-joined kits with full video tutorials."
          }
        },
        "k2": {
          "type": "kit",
          "settings": {
            "fallback": "bbc-rd-prod-flax.jpg",
            "image_alt": "Flax bamboo frame kit",
            "title": "Mountain",
            "body": "Burly geometries for 27.5\" and 29er builds."
          }
        },
        "k3": {
          "type": "kit",
          "settings": {
            "fallback": "bbc-rd-prod-balance.jpg",
            "image_alt": "Children's balance bike kit",
